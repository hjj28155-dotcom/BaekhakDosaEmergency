.distributionAux .auxAction{position:relative!important;inset:auto!important;width:100%!important;height:72px!important;min-height:72px!important;margin:0!important;padding:12px!important;border-radius:15px!important;font-size:20px!important}
.distributionHome .homeFooter{margin-top:12px!important;padding-top:12px!important}.distributionHome .exitHome{height:58px!important;min-height:58px!important;width:52%!important;font-size:20px!important}
@media(max-width:700px){.distributionMenu{grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-template-rows:repeat(2,78px)!important}.distributionMenu .homeMenuBtn{height:78px!important;min-height:78px!important;font-size:17px!important}.distributionAux{grid-template-rows:repeat(2,64px)!important}.distributionAux .auxAction{height:64px!important;min-height:64px!important;font-size:17px!important}}
</style><style id="distributionHomeR5">
.heroHot.notice,.heroHot.settings{display:none!important}
.distributionAux{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-template-rows:repeat(3,68px)!important;gap:10px!important}
