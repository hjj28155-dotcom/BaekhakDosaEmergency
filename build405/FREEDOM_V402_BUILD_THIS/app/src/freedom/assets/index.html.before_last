.settingsHome{background:linear-gradient(180deg,#31516a,#173247)!important}
</style><style id="distributionR6Final">
.heroHot.notice,.heroHot.settings{display:none!important}
.r6TopMenu{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-template-rows:96px!important;gap:14px!important}
.r6TopMenu .homeMenuBtn{height:96px!important;min-height:96px!important;font-size:22px!important}
.r6Aux{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-template-rows:repeat(3,72px)!important;gap:12px!important}
