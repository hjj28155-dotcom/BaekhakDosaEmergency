.r6Aux .musicWide{grid-column:1 / -1!important}
</style><style id="distributionR7CompactHome">
/* R7: 사용자 최종배치 — 홈 한눈보기 / 상단 2버튼 축소 / 특별승인 패널 홈 숨김 */
.heroHot.notice,.heroHot.settings{display:none!important}
/* 상단 앱 운영원칙·설정을 하단 기능 버튼과 같은 크기로 */
.r6TopMenu{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-template-rows:60px!important;gap:8px!important;margin:7px 0 8px!important}
.r6TopMenu .homeMenuBtn{height:60px!important;min-height:60px!important;padding:7px 9px!important;border-radius:13px!important;font-size:17px!important;gap:7px!important}
.r6TopMenu .homeMenuBtn .ico{font-size:21px!important}.r6TopMenu .homeMenuBtn small{font-size:10px!important;margin-top:1px!important}
/* 특별승인 기능은 유지하되 홈 패널만 숨김 */
.distributionApproval{display:none!important}
/* 회차 패널도 세로 여백을 줄여 한눈보기 */
.distributionRoundPanel{margin-top:6px!important;padding:8px 10px!important;border-radius:14px!important}
.distributionRoundPanel .homePanelTitle{font-size:16px!important;margin-bottom:5px!important}
.distributionRoundPanel .roundControls{grid-template-columns:1fr 150px 1fr!important;gap:7px!important}
.distributionRoundPanel .miniBtn,.distributionRoundPanel .roundDirectInput{height:34px!important;min-height:34px!important}
.distributionRoundPanel .roundDirectInput{font-size:18px!important}
.distributionRoundPanel .analyzeStart{height:38px!important;min-height:38px!important;margin-top:6px!important}
/* 하단 기능 버튼도 동일 높이로 정리 */
.r6Aux{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-template-rows:repeat(3,60px)!important;gap:8px!important;margin:8px 0 10px!important}
.r6Aux .auxAction{height:60px!important;min-height:60px!important;padding:8px 10px!important;border-radius:13px!important;font-size:17px!important}
.r6Aux .musicWide{grid-column:1 / -1!important}
/* 종료부 압축 */
.distributionHome .homeFooter{margin-top:7px!important;padding-top:7px!important;min-height:86px!important;gap:5px!important}
.distributionHome .exitHome{height:46px!important;min-height:46px!important;font-size:18px!important}
.distributionHome .homeFooterQuote{margin-top:0!important;line-height:1.2!important}
.distributionHome .homeFooterQuote span{font-size:16px!important}.distributionHome .homeFooterQuote small{font-size:9px!important}
/* 태블릿 세로 화면: 배 영역도 약간 압축해 전체 홈이 한 화면에 들어오도록 */
@media (min-width:600px){
 .hero{max-height:35vh!important}
 .hero img{width:100%!important;height:35vh!important;object-fit:cover!important;object-position:center 48%!important}
}
@media (min-width:600px) and (max-width:900px){
 .distributionHome{padding:7px 10px 10px!important}
 .r6TopMenu{grid-template-rows:54px!important;gap:7px!important;margin:6px 0!important}
 .r6TopMenu .homeMenuBtn{height:54px!important;min-height:54px!important;font-size:16px!important}
 .r6Aux{grid-template-rows:repeat(3,54px)!important;gap:7px!important;margin:7px 0 8px!important}
 .r6Aux .auxAction{height:54px!important;min-height:54px!important;font-size:16px!important}
 .distributionRoundPanel{padding:7px 9px!important;margin-top:5px!important}
 .distributionRoundPanel .roundControls{grid-template-columns:1fr 140px 1fr!important}
 .distributionRoundPanel .miniBtn,.distributionRoundPanel .roundDirectInput{height:32px!important;min-height:32px!important}
 .distributionRoundPanel .analyzeStart{height:35px!important;min-height:35px!important}
 .distributionHome .homeFooter{min-height:78px!important;padding-bottom:7px!important}
 .distributionHome .exitHome{height:42px!important;min-height:42px!important}
}
@media (max-width:599px){
 .r6TopMenu{grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-template-rows:56px!important}
 .r6TopMenu .homeMenuBtn{height:56px!important;min-height:56px!important;font-size:15px!important}
 .r6Aux{grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-template-rows:repeat(3,54px)!important}
 .r6Aux .auxAction{height:54px!important;min-height:54px!important;font-size:15px!important}
 .distributionRoundPanel .roundControls{grid-template-columns:1fr 105px 1fr!important;gap:5px!important}
 .distributionHome .homeFooter{padding-bottom:40px!important}
}
</style>
<style id="stage459FinalFullscreenHome">
/* ===== STAGE4.59 FINAL FULLSCREEN HOME =====
   최종 승인안: 배경 전체 화면 + 기능 버튼 투명 오버레이 */
html,body{width:100%;height:100%;margin:0!important;overflow:hidden!important;background:#001428!important}
#wrap{position:relative!important;width:100%!important;height:100dvh!important;min-height:100vh!important;max-width:none!important;margin:0!important;padding:0!important;overflow:hidden!important;background:#001428!important}
.finalHome{position:relative;width:100%;height:100%;overflow:hidden;background:#001428}
.finalHomeBg{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:fill;object-position:center center;user-select:none;-webkit-user-drag:none;pointer-events:none}
.finalHot{position:absolute;z-index:30;border:0!important;background:rgba(0,0,0,.001)!important;color:transparent!important;padding:0!important;margin:0!important;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent;border-radius:14px}
.finalHot:active{background:rgba(255,255,255,.06)!important}
.finalRoundInput{position:absolute;z-index:31;left:38.35%;top:52.67%;width:22.2%;height:4.05%;margin:0!important;padding:0 8px!important;border:1px solid #ffd64c!important;border-radius:15px!important;background:linear-gradient(180deg,rgba(126,91,4,.98),rgba(82,56,0,.98))!important;box-shadow:0 0 14px rgba(255,202,38,.35),inset 0 0 10px rgba(255,255,255,.08)!important;color:#fff4b0!important;text-align:center!important;font-weight:950!important;font-size:clamp(21px,4.2vw,42px)!important;line-height:1!important;outline:none!important;-moz-appearance:textfield}
.finalRoundInput::-webkit-outer-spin-button,.finalRoundInput::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.finalHiddenState{display:none!important}
/* hit boxes mapped to approved FINAL artwork */
.finalHot.guide{left:3.05%;top:43.35%;width:45.45%;height:4.65%}
.finalHot.settings{left:50.55%;top:43.35%;width:45.45%;height:4.65%}
.finalHot.prev{left:4.55%;top:52.65%;width:32.45%;height:4.15%}
.finalHot.next{left:61.8%;top:52.65%;width:32.45%;height:4.15%}
.finalHot.analyze{left:4.45%;top:57.45%;width:90.15%;height:4.45%}
.finalHot.notice{left:3.05%;top:63.35%;width:45.45%;height:5.0%}
.finalHot.suggest{left:50.55%;top:63.35%;width:45.45%;height:5.0%}
.finalHot.approval{left:3.05%;top:69.15%;width:45.45%;height:5.0%}
.finalHot.update{left:50.55%;top:69.15%;width:45.45%;height:5.0%}
.finalHot.music{left:3.05%;top:74.90%;width:92.95%;height:4.95%}
.finalHot.exit{left:28.55%;top:80.72%;width:41.45%;height:4.75%}
@media(max-width:520px){.finalRoundInput{font-size:clamp(18px,5vw,28px)!important;border-radius:10px!important}}
</style>
</head><body><div id="wrap">
  <main class="finalHome" aria-label="항해의자유 V3 최종 홈화면">
    <img class="finalHomeBg" src="v3_final_home.png" alt="함께하는 행복한 항해 최종 홈화면">
    <button class="finalHot guide" aria-label="앱 운영원칙" onclick="openM('guide')"></button>
    <button class="finalHot settings" aria-label="설정" onclick="openM('settings')"></button>
    <button class="finalHot prev" aria-label="이전회차" onclick="setRound(Number(cur())-1)"></button>
    <input id="homeRoundDirect" class="finalRoundInput" type="number" min="1" max="9999" inputmode="numeric" value="1242" aria-label="회차 직접 입력" onkeydown="if(event.key==='Enter'){setRound(this.value);this.blur()}" onblur="setRound(this.value)">
    <button class="finalHot next" aria-label="다음회차" onclick="setRound(Number(cur())+1)"></button>
    <button class="finalHot analyze" aria-label="현재 회차 분석 시작" onclick="runAnalysisFromHome()"></button>
    <button class="finalHot notice" aria-label="공지사항" onclick="openM('notice')"></button>
    <button class="finalHot suggest" aria-label="건의사항" onclick="openM('suggest')"></button>
    <button class="finalHot approval" aria-label="승인요청확인" onclick="openM('approve')"></button>
    <button class="finalHot update" aria-label="앱 업데이트" onclick="openM('update')"></button>
    <button class="finalHot music" aria-label="음악" onclick="openM('music')"></button>
    <button class="finalHot exit" aria-label="종료" onclick="exitV3()"></button>
    <div class="finalHiddenState" aria-hidden="true">
      <div id="approvalMessage"></div>
      <button id="approvalBasicQuick" class="approvalQuick"></button>
      <button id="approvalSpecialQuick" class="approvalQuick"></button>
      <button id="approvalWaitQuick" class="approvalQuick"><b id="specialStateHome"></b></button>
      <div id="v2MigrationHomeStatus"></div>
      <button onclick="openM('raw')"></button><button onclick="openM('buy')"></button><button onclick="openM('score')"></button>
    </div>
  </main>
</div>
<iframe id="engineFrame" class="hiddenEngine" src="about:blank" aria-hidden="true"></iframe>
<div id="fanfareOverlay" class="fanfareOverlay" onclick="this.classList.remove('show');stopScoreAudio()"><div class="fanfareCard"><strong id="fanfareTitle">축하합니다!</strong><span id="fanfareText"></span><em id="fanfareBottom">좋은 성적입니다. 수고하셨습니다!</em></div></div><div id="comfortOverlay" class="comfortOverlay" onclick="this.classList.remove('show');stopScoreAudio()"><div class="comfortCard"><strong id="comfortTitle">이번 회차는 아쉽게 지나갔습니다.</strong><span id="comfortText"></span><em id="comfortBottom">다음 회차에서 다시 힘차게 출발하겠습니다.</em></div></div>
<div id="modal" class="modal"><div class="card"><button class="b close" onclick="closeM()">닫기</button><h2 id="mt"></h2><div id="mc"></div></div></div>
<script src="raw_bank.js"></script>
<script>
const APP_BASE_VERSION='SHIPMATE_V3_FREEDOM_INTEGRATED_20260925'; const SHIPMATE_V3_UPDATE=true; const K='shipmate_v3_data';
let D={}; try{D=JSON.parse(localStorage.getItem(K)||'{}')||{}}catch(e){D={}};
// STAGE4.53: 시작 동영상/인트로 화면 삭제. 앱 실행 즉시 홈 화면 표시.
let __voyageFinished=true;
function finishVoyageIntro(){ return; }

if(!D.rounds)D.rounds={}; if(!D.currentRound)D.currentRound=1242; if(!D.notices)D.notices=[]; if(!D.approvalLog)D.approvalLog=[]; if(!D.suggestions)D.suggestions=[]; if(!D.historyNotes)D.historyNotes={}; if(!D.historyRound)D.historyRound=Math.min(Number(D.currentRound||1242),1242);
const SPECIAL_APPROVAL_START_ROUND=1243;
let SPECIAL_APPROVED=false,SPECIAL_APPROVAL_STATE={};
let SPECIAL_APPROVAL_POLL_TIMER=null;
try{SPECIAL_APPROVED=!!(window.AndroidHost&&AndroidHost.isSpecialApproved&&AndroidHost.isSpecialApproved())}catch(e){}
if(D.specialApprovalUnlocked===true)SPECIAL_APPROVED=true;
function stopSpecialApprovalAutoPoll(){if(SPECIAL_APPROVAL_POLL_TIMER){clearInterval(SPECIAL_APPROVAL_POLL_TIMER);SPECIAL_APPROVAL_POLL_TIMER=null}}
function startSpecialApprovalAutoPoll(){
 if(SPECIAL_APPROVED){stopSpecialApprovalAutoPoll();return}
 if(SPECIAL_APPROVAL_POLL_TIMER)return;
 SPECIAL_APPROVAL_POLL_TIMER=setInterval(()=>{
   if(SPECIAL_APPROVED){stopSpecialApprovalAutoPoll();return}
   try{if(window.AndroidHost&&AndroidHost.checkSpecialApproval)AndroidHost.checkSpecialApproval()}catch(e){}
 },5000);
}
function bootSpecialApprovalAutoCheck(){
 try{
   if(!(window.AndroidHost&&AndroidHost.getSpecialApprovalSummary))return;
   let raw=AndroidHost.getSpecialApprovalSummary();
   let q=typeof raw==='string'?JSON.parse(raw):raw||{};
   if(q.approved){SPECIAL_APPROVED=true;D.specialApprovalUnlocked=true;save();stopSpecialApprovalAutoPoll();return}
   if(q.has_request){
     if(q.approval_code)SPECIAL_APPROVAL_STATE.approval_code=q.approval_code;
     SPECIAL_APPROVAL_STATE.status='pending';
     startSpecialApprovalAutoPoll();
     if(AndroidHost.checkSpecialApproval)AndroidHost.checkSpecialApproval();
   }
 }catch(e){}
}
setTimeout(bootSpecialApprovalAutoCheck,1200);
const PINNED_NOTICE={title:'앱의 목적 및 공지사항',body:'분석 결과는 연구·기록·검증을 위한 참고자료입니다.'};
if(!D.notices.length){D.notices.push({time:new Date().toISOString(),title:PINNED_NOTICE.title,body:PINNED_NOTICE.body,pinned:true});try{localStorage.setItem(K,JSON.stringify(D))}catch(e){}}
setTimeout(()=>{let q=document.getElementById('roundQuick');if(q)q.value=D.currentRound||1242;let d=document.getElementById('homeRoundDirect');if(d)d.value=D.currentRound||1242;refreshHomeUI()},0);
// 구버전 단일 메모가 있으면 현재 회차 데이터로 보존
if(D.raw||D.buy||D.merge||D.score||D.compare){let r=String(D.currentRound);D.rounds[r]=D.rounds[r]||{};['raw','buy','merge','score','compare'].forEach(k=>{if(D[k]&&!D.rounds[r][k])D.rounds[r][k]=D[k]})}
function save(){localStorage.setItem(K,JSON.stringify(D));refreshHomeUI()} function closeM(){let m=document.getElementById('modal');m.style.display='none';m.classList.remove('scoreOneScreen','musicOneScreen')}
function approvalCounts(){let a=D.approvalLog||[];return {pending:a.filter(x=>x.status==='승인대기').length,approved:a.filter(x=>x.status==='승인완료').length,history:a.filter(x=>x.status==='승인완료'||x.status==='승인보류'||x.status==='배포완료'||x.status==='거절').length}}
function refreshHomeUI(){try{let h=document.getElementById('homeRoundLabel');if(h)h.innerHTML='<b>제'+esc(cur())+'회</b><span>현재 작업 회차</span>';let st=document.getElementById('specialStateHome');if(st)st.textContent=SPECIAL_APPROVED?'완료':'대기';let am=document.getElementById('approvalMessage');if(am)am.textContent=SPECIAL_APPROVED?'특별승인 완료 · 1243회차 이후 이용 가능':'제1242회차까지 정상 이용 · 이후 특별승인';}catch(e){}}
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function cur(){return String(D.currentRound||1242)} function R(){let r=cur();D.rounds[r]=D.rounds[r]||{};return D.rounds[r]}
function rawBank(n){return (window.V3_RAW_BANK||{})[String(n)]||null}
function embeddedRaw(n){let b=rawBank(n);return b?String(b.text||''):''}
function embeddedGi(n){let b=rawBank(n);return b?String(b.gi||''):''}
function embeddedSource(n){let b=rawBank(n);return b?String(b.source||'내장 원문은행'):''}
function rawBankCount(){return window.V3_RAW_BANK_META?.count||Object.keys(window.V3_RAW_BANK||{}).length}
function rawBankRange(){let m=window.V3_RAW_BANK_META||{};return `${m.first||1}~${m.last||1244}`}
function changeRawRound(delta){let n=(parseInt(cur(),10)||1242)+Number(delta||0);if(n<1)n=1;if(n>1244)n=1244;if(setRound(n))rawPage()}
function restoreEmbeddedRaw(){let b=rawBank(cur());if(!b){alert('이 회차의 내장 원문이 없습니다.');return}rawText.value=b.text||'';giText.value=b.gi||'';rawSource.value=b.source||'내장 원문은행';alert('제'+cur()+'회 내장 원문을 화면에 다시 불러왔습니다.')}
function setRound(v){let n=parseInt(v,10);if(!Number.isFinite(n)||n<1)n=1242;if(n>1244)n=1244;if(n>=SPECIAL_APPROVAL_START_ROUND&&!SPECIAL_APPROVED){D.pendingSpecialRound=n;try{localStorage.setItem(K,JSON.stringify(D))}catch(e){};specialApprovalPage();let q=document.getElementById('roundQuick');if(q)q.value=cur();let h=document.getElementById('homeRoundDirect');if(h)h.value=cur();return false}D.currentRound=n;save();let q=document.getElementById('roundQuick');if(q)q.value=n;let h=document.getElementById('homeRoundDirect');if(h)h.value=n;refreshHomeUI();return true}
function specialApprovalPage(){
 let target=Number(D.pendingSpecialRound||1243);if(target<1243)target=1243;
 let state=SPECIAL_APPROVED?'승인완료':(SPECIAL_APPROVAL_STATE.status==='pending'?'승인대기':'미승인');
 let code=SPECIAL_APPROVAL_STATE.approval_code||'';
 let savedName='',savedRef='';try{savedName=String(AndroidHost.getApprovalApplicantName?AndroidHost.getApprovalApplicantName():'');savedRef=String(AndroidHost.getApprovalReferrerName?AndroidHost.getApprovalReferrerName():'')}catch(e){}
 modal('1243회차 이후 특별승인',`<div class="panel goldline"><h3>⚓ 항해사의 특별한 승인 요청</h3><div>현재 이용은 <b>제1242회차까지</b> 정상 허용됩니다.</div><div class="small" style="margin-top:7px">제1243회차부터는 항해사 확인·승인 후 자동으로 잠금이 해제되어 계속 이용할 수 있습니다.</div></div><div class="panel"><div class="grid2"><div class="stat"><strong>${target}</strong><span>요청 회차</span></div><div class="stat"><strong id="specialApprovalStatus">${esc(state)}</strong><span>승인 상태</span></div></div>${SPECIAL_APPROVED?'':`<div class="label">실명 기입 (필수)</div><input id="specialApplicantName" value="${esc(savedName)}" placeholder="본인 실명을 입력해 주세요"><div class="label">누구의 지인인지 기입 (필수)</div><input id="specialReferrerName" value="${esc(savedRef)}" placeholder="예: 홍길동의 지인">`}<div id="specialApprovalCodeBox" style="display:${code?'block':'none'}"><div class="label">승인번호</div><div class="stat"><strong id="specialApprovalCode">${esc(code)}</strong><span>항해사 확인용</span></div></div><div id="specialApprovalInfo" class="small status" style="margin-top:10px">${SPECIAL_APPROVED?'특별승인이 완료되었습니다.':'실명과 누구의 지인인지 입력한 뒤 승인요청을 눌러 주세요.'}</div><div class="row" style="margin-top:12px">${SPECIAL_APPROVED?`<button class="b gold" onclick="unlockPendingSpecialRound()">승인 회차로 이동</button>`:`<button class="b gold" onclick="requestSpecialApprovalNow()">특별승인 요청</button><button class="b" onclick="checkSpecialApprovalNow()">지금 확인</button>`}<button class="b" onclick="closeM()">제1242회차까지 이용</button></div></div>`);
 renderSpecialApprovalState();
 if(!SPECIAL_APPROVED)try{if(window.AndroidHost&&AndroidHost.checkSpecialApproval)AndroidHost.checkSpecialApproval()}catch(e){}
}
function requestSpecialApprovalNow(){let n=Number(D.pendingSpecialRound||1243),name=String(document.getElementById('specialApplicantName')?.value||'').trim(),ref=String(document.getElementById('specialReferrerName')?.value||'').trim();let x=document.getElementById('specialApprovalInfo');if(!name){if(x)x.textContent='실명을 입력해 주세요.';document.getElementById('specialApplicantName')?.focus();return}if(!ref){if(x)x.textContent='누구의 지인인지 입력해 주세요.';document.getElementById('specialReferrerName')?.focus();return}if(x)x.textContent='특별승인 요청을 보내는 중입니다...';try{AndroidHost.requestSpecialApproval(n,name,ref);startSpecialApprovalAutoPoll()}catch(e){if(x)x.textContent='승인 요청 기능을 실행할 수 없습니다.'}}
function checkSpecialApprovalNow(){let x=document.getElementById('specialApprovalInfo');if(x)x.textContent='승인 상태를 확인하는 중입니다...';try{AndroidHost.checkSpecialApproval()}catch(e){if(x)x.textContent='승인 확인 기능을 실행할 수 없습니다.'}}
function unlockPendingSpecialRound(){let n=Number(D.pendingSpecialRound||1243);D.pendingSpecialRound=null;SPECIAL_APPROVED=true;D.specialApprovalUnlocked=true;save();closeM();setRound(n)}
// FIX6: update the existing approval panel without reopening it or causing
// another immediate server check. The existing five-second poll is retained.
function renderSpecialApprovalState(){
 let p=SPECIAL_APPROVAL_STATE||{},st=String(p.status||'');
 let state=document.getElementById('specialApprovalStatus');
 if(state)state.textContent=SPECIAL_APPROVED?'승인완료':(st==='pending'?'승인대기':(st==='rejected'?'승인거절':'미승인'));
 let code=String(p.approval_code||''),box=document.getElementById('specialApprovalCodeBox'),label=document.getElementById('specialApprovalCode');
 if(label)label.textContent=code;
 if(box)box.style.display=code?'block':'none';
 let x=document.getElementById('specialApprovalInfo');if(!x)return;
 if(p.error||p.ok===false){x.textContent='승인 서버 연결을 확인해 주세요. 연결 후 지금 확인을 눌러 주세요.';return}
 if(SPECIAL_APPROVED)x.textContent='항해사 승인이 확인되었습니다. 특별승인이 완료되었습니다.';
 else if(st==='pending')x.textContent='승인 요청이 접수되었습니다. 항해사 확인을 기다리는 중이며 승인되면 자동으로 열립니다.';
 else if(st==='rejected')x.textContent='승인 요청이 거절되었습니다. 항해사에게 확인해 주세요.';
 else x.textContent='아직 특별승인 요청 전입니다.';
}
function onSpecialApprovalState(p){
 try{
  p=typeof p==='string'?JSON.parse(p):p||{};
  let st=String(p.status||''),wasApproved=SPECIAL_APPROVED;
  SPECIAL_APPROVAL_STATE=Object.assign({},SPECIAL_APPROVAL_STATE,p);
  if(st&&p.ok!==false&&!p.error){delete SPECIAL_APPROVAL_STATE.error;delete SPECIAL_APPROVAL_STATE.ok}
  // A free historical round is not a special approval of future rounds.
  if(st==='approved'&&p.round_policy_free===true){
   SPECIAL_APPROVAL_STATE.status='not_requested';
   stopSpecialApprovalAutoPoll();renderSpecialApprovalState();return;
  }
  if(st==='approved'){
   SPECIAL_APPROVED=true;D.specialApprovalUnlocked=true;stopSpecialApprovalAutoPoll();save();
   renderSpecialApprovalState();
   if(!wasApproved){
    let n=Number(D.pendingSpecialRound||1243);D.pendingSpecialRound=null;save();
    setTimeout(()=>{closeM();setRound(n)},450);
   }
   return;
  }
  if(st==='pending')startSpecialApprovalAutoPoll();
  else if(st==='not_requested'||st==='rejected')stopSpecialApprovalAutoPoll();
  renderSpecialApprovalState();refreshHomeUI();
 }catch(e){
  let x=document.getElementById('specialApprovalInfo');
  if(x)x.textContent='승인 상태 응답을 읽지 못했습니다. 지금 확인을 다시 눌러 주세요.';
 }
}
function modal(title,html){let m=document.getElementById('modal');m.classList.remove('scoreOneScreen','musicOneScreen');document.getElementById('mt').textContent=title;document.getElementById('mc').innerHTML=html;m.style.display='block'}
function roundHead(sub){return `<div class="panel goldline"><div class="grid2"><div><div class="label">작업 회차</div><input id="roundInput" type="number" min="1" value="${esc(cur())}" onchange="setRound(this.value);openM('${sub}')"></div><div><div class="label">현재 저장 상태</div><div class="stat"><strong>${Object.keys(R()).length?'저장됨':'신규'}</strong><span class="small">제${esc(cur())}회</span></div></div></div></div>`}
function openM(k){if(k==='raw')return rawPage();if(k==='buy')return buyPage();if(k==='merge')return mergePage();if(k==='db')return dbPage();if(k==='approve')return specialApprovalPage();if(k==='score')return scorePage();if(k==='compare')return comparePage();if(k==='guide')return guidePage();if(k==='notice')return noticePage();if(k==='settings')return settingsPage();if(k==='total')return totalAnalysisPage();if(k==='history')return historyPage();if(k==='suggest')return suggestPage();if(k==='music')return musicPage();if(k==='update')return updatePage();if(k==='roundctl')return roundControlPage();if(k==='import')return legacyImportPage();}
function isFilled(v){return String(v??'').trim()!==''}
function buyHasData(b){return !!(b&&Array.isArray(b.combos)&&b.combos.some(isFilled))}
function mergeHasData(m){return !!(m&&(isFilled(m.cross)||isFilled(m.final)))}
function scoreHasData(sc){return !!(sc&&(parseNums(sc.result).length===6||isFilled(sc.bonus)||isFilled(sc.memo)))}
function rawHasData(r,n){return !!((r&&isFilled(r.text))||rawBank(n))}
function userRawHasData(r){return !!(r&&(isFilled(r.text)||isFilled(r.gi)||isFilled(r.source)||isFilled(r.memo)))}
function autoStamp(obj){obj.updated=new Date().toISOString();save()}
function rawPage(){
 let saved=R().raw||{}, b=rawBank(cur());
 let txt=(saved.text!==undefined&&saved.text!=='')?saved.text:(b?.text||'');
 let savedGi=String(saved.gi??'').trim();
 if(savedGi===cur()){savedGi='';try{delete R().raw.gi;save()}catch(e){}}
 let gi=savedGi||(b?.gi||'');
 if(gi===cur())gi='';
 let src=(saved.source!==undefined&&saved.source!=='')?saved.source:(b?.source||'');
 let bankStatus=b?`<span class="status">내장 원문 확인</span> · 제${esc(cur())}회 6문장`:`<span class="warn">내장 원문 없음</span>`;
 let giStatus=gi?`<span class="status">氣 문자열 확인</span>`:`<span class="warn">氣 문자열 미보존</span>`;
 modal('원문분석 · RAW 6문장',roundHead('raw')+
 `<div class="panel goldline"><div class="grid2"><div><b>V3 원문은행</b><div class="small">${rawBankRange()} · 총 ${rawBankCount()}회 내장</div></div><div style="text-align:right">${bankStatus}</div></div><div class="row" style="margin-top:10px"><button class="b" onclick="changeRawRound(-1)">◀ 이전회차</button><button class="b gold" onclick="restoreEmbeddedRaw()">내장 원문 다시 불러오기</button><button class="b" onclick="changeRawRound(1)">다음회차 ▶</button></div></div>
 <div class="panel"><h3>① RAW 원문</h3><div class="small">회차를 선택하면 V3에 내장된 원문 6문장이 자동 표시됩니다. 원문과 분석 메모는 분리 보관합니다.</div><textarea id="rawText" rows="11" placeholder="이 회차의 내장 원문이 없습니다." oninput="saveRawAuto()">${esc(txt)}</textarea><div class="label">氣 문자열 · ${giStatus}</div><input id="giText" value="${esc(gi)}" placeholder="${gi?'':'현재 보존자료에 氣 문자열이 없습니다.'}" oninput="saveRawAuto()"><div class="label">원문 출처/확인 메모</div><input id="rawSource" value="${esc(src)}" placeholder="원문 출처" oninput="saveRawAuto()"><h3>② 분석 메모</h3><textarea id="rawMemo" rows="7" placeholder="상징, 숫자 후보, 연결 근거 등을 기록" oninput="saveRawAuto()">${esc(saved.memo||'')}</textarea><div class="small status">입력 내용은 현재 회차에 자동 저장됩니다.</div></div>
 <div class="panel"><b>운영 기준</b><div class="small">내장 원문은 원형 그대로 보존합니다. 결과 확인 후 원문을 소급 수정하지 않습니다.</div></div>`)
}
function saveRawAuto(){if(!document.getElementById('rawText'))return;let old=R().raw||{};R().raw={...old,text:rawText.value,gi:(giText.value.trim()===cur()?'':giText.value),source:rawSource.value,memo:rawMemo.value,updated:new Date().toISOString()};save()}
function saveRaw(){saveRawAuto()}
function restoreEmbeddedRaw(){let b=rawBank(cur());if(!b){alert('이 회차의 내장 원문이 없습니다.');return}rawText.value=b.text||'';giText.value=(b.gi&&b.gi!==cur())?b.gi:'';rawSource.value=b.source||'내장 원문은행';saveRawAuto();alert('제'+cur()+'회 내장 원문을 화면에 다시 불러왔습니다.')}
function buyPage(){
 let x=R().buy||{},c=Array.isArray(x.combos)?x.combos:['','','','',''];while(c.length<5)c.push('');
 let locked=!!x.locked;
 let rows=c.slice(0,5).map((v,i)=>`<div class="combo"><b>${i+1}조합</b><input id="c${i}" value="${esc(v)}" placeholder="${v?'':'저장된 최종 조합 없음'}" ${locked?'readonly':''} oninput="saveBuyAuto()"></div>`).join('');
 modal('실전구매 · 최종 5조합',roundHead('buy')+`<div class="panel"><h3>최종 5조합</h3>${rows}<div class="label">구매/선정 근거</div><textarea id="buyMemo" rows="5" placeholder="최종 5조합 선정 근거와 주의사항" ${locked?'readonly':''} oninput="saveBuyAuto()">${esc(x.memo||'')}</textarea><div class="lockbox"><div>RESULT-BEFORE 상태: <span class="${locked?'locked':'unlocked'}">${locked?'공식 잠금':'미잠금'}</span></div><div class="small">입력은 자동 저장됩니다. 공식잠금 후에는 결과 확인을 이유로 기존 조합을 덮어쓰지 않습니다.</div></div><div class="row" style="margin-top:10px"><button class="b" onclick="copyFinal5()">Final5 복사</button>${locked?'<span class="pill">공식잠금 완료</span><button class="b" onclick="exportResultBeforeLock()">RESULT-BEFORE 잠금파일 저장</button>':'<button class="b gold" onclick="saveBuy(true)">RESULT-BEFORE 공식잠금</button>'}</div></div>`)
}
function saveBuyAuto(){let old=R().buy||{};if(old.locked)return;let combos=[0,1,2,3,4].map(i=>{let e=document.getElementById('c'+i);return e?e.value.trim():''});R().buy={...old,combos,memo:document.getElementById('buyMemo')?.value||'',locked:false,updated:new Date().toISOString()};save()}
function saveBuy(lock){let old=R().buy||{};if(old.locked){alert('이미 공식 잠금된 회차입니다. 기존 RESULT-BEFORE는 유지합니다.');return}saveBuyAuto();if(lock){R().buy.locked=true;R().buy.lockedAt=new Date().toISOString();R().buy.updated=new Date().toISOString();save();alert('RESULT-BEFORE 공식 잠금 완료');openM('buy')}}

function copyFinal5(){let b=R().buy||{},cs=(b.combos||[]).slice(0,5).filter(isFilled);if(!cs.length){alert('복사할 Final5가 없습니다.');return}let t=cs.map((x,i)=>(i+1)+'. '+x).join('\n');try{if(window.AndroidHost&&AndroidHost.copyText){AndroidHost.copyText(t);alert('Final5 복사 완료');return}}catch(e){}try{navigator.clipboard.writeText(t).then(()=>alert('Final5 복사 완료')).catch(()=>prompt('복사하세요',t))}catch(e){prompt('복사하세요',t)}}
function exportResultBeforeLock(){let b=R().buy||{};if(!b.locked){alert('먼저 RESULT-BEFORE 공식잠금을 완료하세요.');return}let cs=(b.combos||[]).slice(0,5),txt='항행의자유앱 V3 · RESULT-BEFORE LOCK\n회차: '+cur()+'\n잠금시각: '+String(b.lockedAt||'')+'\n상태: RESULT-BEFORE / OFFICIAL LOCK\nFinal5:\n'+cs.map((x,i)=>(i+1)+'. '+(x||'-')).join('\n')+'\n선정근거: '+String(b.memo||'')+'\nresult_used=false\nbonus_used=false\n';try{if(window.AndroidHost&&AndroidHost.saveText){AndroidHost.saveText('항행의자유_V3_'+cur()+'회_RESULT-BEFORE_LOCK.txt',txt);return}}catch(e){}prompt('잠금기록을 복사하세요',txt)}
function mergePage(){
 let x=R().merge||{},raw=R().raw||{},buy=R().buy||{};if(!raw.text&&rawBank(cur()))raw={...raw,text:embeddedRaw(cur()),source:embeddedSource(cur())};
 let buyText=buyHasData(buy)?buy.combos.slice(0,5).map((v,i)=>`${i+1}) ${esc(v||'미등록')}`).join('<br>'):'<span class="warn">최종 5조합 미등록</span>';
 modal('중앙통합 · 분석·결과',roundHead('merge')+`<div class="grid2"><div class="panel"><h3>원문분석 요약</h3><div class="small">${esc((raw.memo||raw.text||'아직 저장된 원문분석이 없습니다.').slice(0,700))}</div></div><div class="panel"><h3>실전구매 현황</h3><div class="small">${buyText}</div></div></div><div class="panel"><div class="label">교차검증 요약</div><textarea id="mergeCross" rows="6" placeholder="각 분석의 공통점·충돌·보완점" oninput="saveMergeAuto()">${esc(x.cross||'')}</textarea><div class="label">중앙통합 최종 판단</div><textarea id="mergeFinal" rows="7" placeholder="최종 통합 판단 및 다음 행동" oninput="saveMergeAuto()">${esc(x.final||'')}</textarea><div class="small status">입력 내용은 제${esc(cur())}회에 자동 저장됩니다.</div></div>`)
}
function saveMergeAuto(){R().merge={cross:document.getElementById('mergeCross')?.value||'',final:document.getElementById('mergeFinal')?.value||'',updated:new Date().toISOString()};save()}
function dbPage(){
 let bankKeys=Object.keys(window.V3_RAW_BANK||{}),savedKeys=Object.keys(D.rounds||{});let all=[...new Set([...bankKeys,...savedKeys])].sort((a,b)=>Number(b)-Number(a));
 let rows=all.slice(0,40).map(r=>{let x=D.rounds[r]||{},raw=rawHasData(x.raw,r),buy=buyHasData(x.buy),merge=mergeHasData(x.merge),score=scoreHasData(x.score);let btxt=x.buy?.locked?'잠금':(buy?'있음':'없음');return `<tr><td>${esc(r)}</td><td>${raw?'있음':'없음'}</td><td>${btxt}</td><td>${merge?'있음':'없음'}</td><td>${score?'있음':'없음'}</td></tr>`}).join('');
 let savedCount=savedKeys.filter(r=>{let x=D.rounds[r]||{};return userRawHasData(x.raw)||buyHasData(x.buy)||mergeHasData(x.merge)||scoreHasData(x.score)}).length;
 let lockedCount=savedKeys.filter(r=>!!D.rounds[r]?.buy?.locked).length;let scoreCount=savedKeys.filter(r=>scoreHasData(D.rounds[r]?.score)).length;
 modal('누적 DB · 회차별 데이터',`<div class="grid3"><div class="stat"><strong>${rawBankCount()}</strong><span>내장 원문</span></div><div class="stat"><strong>${savedCount}</strong><span>사용자 저장 회차</span></div><div class="stat"><strong>${lockedCount}</strong><span>공식 잠금</span></div><div class="stat"><strong>${scoreCount}</strong><span>성적 기록</span></div></div><div class="panel"><table class="table"><thead><tr><th>회차</th><th>원문</th><th>5조합</th><th>통합</th><th>성적</th></tr></thead><tbody>${rows}</tbody></table><p class="small">최신 40회를 표시합니다. 전체 데이터는 백업에 포함됩니다.</p></div>`)
}
function approvalPage(){let log=D.approvalLog||[],c=approvalCounts();let rows=log.slice().reverse().slice(0,40).map(x=>`<tr><td>${esc(x.time?.slice(0,16).replace('T',' ')||'')}</td><td>${esc(x.name||'')}</td><td>${esc(x.status||'')}</td><td>${esc(x.note||'')}</td></tr>`).join('');modal('배포 승인관리',`<div class="panel goldline"><h3>✓ 업데이트 확인</h3><div class="small">업데이트 확인은 <b>이름 · 앱 버전 · 업데이트 날짜/시간</b>만 저장합니다. 전화번호·연락처·기기번호·위치는 저장하지 않습니다.</div><button class="b green" style="width:100%;margin-top:10px" onclick="updateCheckPage()">이름별 업데이트 현황 열기</button></div><div class="grid3"><button class="stat" onclick="showApprovalSubset('승인대기')"><strong>${c.pending}</strong><span>승인 대기</span></button><button class="stat" onclick="showApprovalSubset('승인완료')"><strong>${c.approved}</strong><span>승인 완료</span></button><button class="stat" onclick="showApprovalSubset('이력')"><strong>${c.history}</strong><span>배포 이력</span></button></div><div class="panel"><h3>V3 승인 기록</h3><div class="small">승인 기록은 기존 방식대로 유지합니다.</div><div class="grid2"><div><div class="label">신청자/지인 실명</div><input id="apName" placeholder="실명 입력"></div><div><div class="label">상태</div><select id="apStatus"><option>승인대기</option><option>승인완료</option><option>승인보류</option><option>배포완료</option><option>거절</option></select></div></div><div class="label">승인 메모</div><input id="apNote" placeholder="누구의 지인인지, 승인 사유 등"><div class="row"><button class="b gold" onclick="addApproval()">승인 기록 추가</button></div></div><div class="panel"><table class="table"><thead><tr><th>시간</th><th>실명</th><th>상태</th><th>메모</th></tr></thead><tbody>${rows||'<tr><td colspan="4">승인 기록이 없습니다.</td></tr>'}</tbody></table></div>`)}
function loadUpdateStats(){let box=document.getElementById('updateOnlineMeta');if(box)box.textContent='서버 집계를 불러오는 중입니다...';try{if(window.AndroidHost&&AndroidHost.requestUpdateStats){AndroidHost.requestUpdateStats();return}}catch(e){}if(box)box.textContent='업데이트 집계 서버에 연결할 수 없습니다.'}
function onUpdateStats(p){try{p=typeof p==='string'?JSON.parse(p):p||{};let s=document.getElementById('updateOnlineStats'),m=document.getElementById('updateOnlineMeta'),h=document.getElementById('updateOnlineHistory');if(!p.ok){if(m)m.textContent='집계 불러오기 실패 · 인터넷 연결을 확인해 주세요.';return}let total=Number(p.registered_installs||0),up=Number(p.updated_count||0),no=Number(p.not_updated_count||0);if(s)s.innerHTML=`<div class="stat"><strong>${total}</strong><span>등록 설치</span></div><div class="stat"><strong>${up}</strong><span>최신 업데이트</span></div><div class="stat"><strong>${no}</strong><span>미업데이트</span></div>`;if(m)m.innerHTML=`현재 배포 감지 버전: <b>${esc(p.target_version||'아직 없음')}</b> · 승인 서버 기록 ${Number(p.approved_count||0)}건`;let hist=Array.isArray(p.history)?p.history:[];if(h)h.innerHTML=hist.length?('<b>최근 업데이트 완료 수</b><br>'+hist.map(x=>`${esc(String(x.version_name||x.version_code))} → <b>${Number(x.count||0)}명</b>`).join('<br>')):'아직 업데이트 완료 기록이 없습니다.'}catch(e){let m=document.getElementById('updateOnlineMeta');if(m)m.textContent='집계 표시 중 오류가 발생했습니다.'}}
function showApprovalSubset(kind){
  let all=D.approvalLog||[];
  let a=all.filter(x=>kind==='이력'?(x.status!=='승인대기'):x.status===kind).slice().reverse();
  let title=kind==='이력'?'승인·배포 이력':(kind==='승인완료'?'승인 완료':'승인 대기');
  let rows=a.length?a.slice(0,80).map((x,i)=>`<tr><td>${i+1}</td><td>${esc(x.time?.slice(0,16).replace('T',' ')||'')}</td><td>${esc(x.round||'')}</td><td>${esc(x.name||'미입력')}</td><td>${esc(x.status||'')}</td><td>${esc(x.note||'')}</td></tr>`).join(''):'<tr><td colspan="6">해당 기록이 없습니다.</td></tr>';
  modal(title,`<div class="panel goldline"><div class="stat"><strong>${a.length}</strong><span>${title}</span></div></div><div class="panel"><table class="table"><thead><tr><th>#</th><th>시간</th><th>회차</th><th>실명</th><th>상태</th><th>메모</th></tr></thead><tbody>${rows}</tbody></table></div><div class="row"><button class="b" onclick="openM('approve')">승인관리로 돌아가기</button><button class="b gold" onclick="closeM()">홈으로</button></div>`)
}
function addApproval(){D.approvalLog=D.approvalLog||[];D.approvalLog.push({time:new Date().toISOString(),round:Number(cur()),name:apName.value,status:apStatus.value,note:apNote.value});save();alert('승인 기록이 앱 내부에 저장되었습니다.');openM('approve')}
function parseNums(s){return String(s||'').match(/\d+/g)?.map(Number).filter(n=>n>=1&&n<=45).slice(0,6)||[]}
function comboStats(buy,score){let result=parseNums(score?.result),combos=Array.isArray(buy?.combos)?buy.combos.slice(0,5):[];let stats=combos.map((c,i)=>{let nums=parseNums(c),hit=nums.filter(n=>result.includes(n));return {i:i+1,c:c||'',hit}});let best=stats.filter(x=>x.c).sort((a,b)=>b.hit.length-a.hit.length)[0]||null;return {result,stats,best}}
function scoreRowsHtml(buy,score){if(!buyHasData(buy))return '<tr><td colspan="4">최종 5조합 미등록</td></tr>';let st=comboStats(buy,score);return st.stats.map(x=>`<tr><td>${x.i}</td><td>${esc(x.c||'미등록')}</td><td>${st.result.length===6?x.hit.length:'-'}</td><td>${st.result.length===6?esc(x.hit.join(', ')||'-'):'-'}</td></tr>`).join('')}
function autoWinningLookup(){
 let r=Number(cur());
 if(!Number.isFinite(r)||r<1){alert('회차 번호를 확인해 주세요.');return}
 try{
  if(!window.AndroidHost||typeof AndroidHost.fetchWinningNumbers!=='function'){alert('자동조회는 Android 설치본에서 사용할 수 있습니다.');return}
  let b=document.getElementById('autoWinBtn');if(b){b.disabled=true;b.textContent='조회 중…'}
  AndroidHost.fetchWinningNumbers(r)
 }catch(e){alert('당첨번호 자동조회를 시작하지 못했습니다.')}
}
window.__v3WinningResult=function(data){
 try{
  let b=document.getElementById('autoWinBtn');if(b){b.disabled=false;b.textContent='당첨번호 자동조회'}
  if(!data||data.ok!==true){alert((data&&data.error)||'당첨번호를 조회하지 못했습니다.');return}
  if(Number(data.round)!==Number(cur())){alert('조회 회차와 현재 회차가 다릅니다.');return}
  let nums=(data.numbers||[]).map(Number).filter(n=>n>=1&&n<=45)
  if(nums.length!==6){alert('당첨번호 데이터 형식이 올바르지 않습니다.');return}
  let x=R();x.score=x.score||{};x.score.result=nums.join(' ');x.score.bonus=String(Number(data.bonus)||'');x.score.source=data.source||'동행복권';x.score.drawDate=data.date||'';x.score.updated=new Date().toISOString();save();scorePage()
 }catch(e){alert('당첨번호 저장 중 오류가 발생했습니다.')}
}
function scorePage(){let x=R().score||{},buy=R().buy||{};modal('성적 바로보기',roundHead('score')+`<div class="panel"><h3>당첨번호 입력</h3><div class="grid2"><div><div class="label">당첨번호 6개</div><input id="winNums" value="${esc(x.result||'')}" placeholder="예: 2 4 10 16 31 41" oninput="saveScoreAuto()"></div><div><div class="label">보너스</div><input id="bonusNum" value="${esc(x.bonus||'')}" placeholder="예: 9" oninput="saveScoreAuto()"></div></div><div class="label">결과 메모</div><textarea id="scoreMemo" rows="4" oninput="saveScoreAuto()">${esc(x.memo||'')}</textarea><div class="small status">당첨번호·보너스·메모는 자동 저장되며 5조합 성적도 자동 계산됩니다.</div></div><div class="panel"><h3>최종 5조합 일치 현황</h3><table class="table"><thead><tr><th>조합</th><th>번호</th><th>일치수</th><th>일치번호</th></tr></thead><tbody id="scoreRows">${scoreRowsHtml(buy,x)}</tbody></table></div>`)}
function saveScoreAuto(){R().score={result:document.getElementById('winNums')?.value||'',bonus:document.getElementById('bonusNum')?.value||'',memo:document.getElementById('scoreMemo')?.value||'',updated:new Date().toISOString()};save();let body=document.getElementById('scoreRows');if(body)body.innerHTML=scoreRowsHtml(R().buy||{},R().score||{})}
function saveScore(){saveScoreAuto()}
function comparePage(){
 let b=R().buy||{},s=R().score||{},x=R().compare||{},st=comboStats(b,s);let best=st.best;
 let bestHtml=best&&st.result.length===6?`<div class="panel goldline"><b>최고 적중</b><div>제${esc(cur())}회 ${best.i}조합 · <b>${best.hit.length}/6</b></div><div class="small">일치번호: ${esc(best.hit.join(', ')||'-')}</div></div>`:'';
 modal('전·후 비교표',roundHead('compare')+`<div class="grid2"><div class="panel"><h3>RESULT-BEFORE</h3><div class="small">잠금: ${b.locked?'<span class="locked">공식잠금</span>':'<span class="unlocked">미잠금</span>'}</div><div class="hr"></div>${buyHasData(b)?b.combos.slice(0,5).map((v,i)=>`${i+1}) ${esc(v||'미등록')}`).join('<br>'):'저장된 최종 5조합 없음'}<div class="hr"></div><div class="small">${esc(b.memo||'')}</div></div><div class="panel"><h3>RESULT-AFTER</h3><div>당첨번호: <b>${esc(s.result||'미입력')}</b></div><div>보너스: <b>${esc(s.bonus||'-')}</b></div><div class="hr"></div><div class="small">${esc(s.memo||'')}</div></div></div>${bestHtml}<div class="panel"><div class="label">복기 · 차이 분석</div><textarea id="cmpReview" rows="7" placeholder="결과 전 판단과 실제 결과의 차이, 유지할 규칙, 폐기할 가설" oninput="saveCompareAuto()">${esc(x.review||'')}</textarea><div class="label">다음 회차 반영 메모</div><textarea id="cmpNext" rows="5" placeholder="다음 분석에서 점검할 사항" oninput="saveCompareAuto()">${esc(x.next||'')}</textarea><div class="small status">복기와 다음회차 반영 메모는 자동 저장됩니다.</div></div>`)
}
function saveCompareAuto(){R().compare={review:document.getElementById('cmpReview')?.value||'',next:document.getElementById('cmpNext')?.value||'',updated:new Date().toISOString()};save()}
function getLocalUpdateName(){try{return (window.AndroidHost&&AndroidHost.getUpdateDisplayName)?String(AndroidHost.getUpdateDisplayName()||''):''}catch(e){return ''}}

function distributionUpdateCheckPage(){let nm=getLocalUpdateName();modal('업데이트 확인',`<div class="panel goldline"><h3>✓ 업데이트 완료 등록</h3><div class="small">서버에는 <b>이름 · 앱 버전 · 업데이트 날짜/시간</b>만 저장합니다.<br><b>전화번호 · 연락처 · 기기번호 · 위치는 저장하지 않습니다.</b></div></div><div class="panel"><div class="label">실명 등록</div><input id="updateDisplayName" maxlength="40" value="${esc(nm)}" placeholder="실명만 입력"><div class="small status">한 번 등록하면 다음 버전부터 앱 실행 시 같은 이름으로 업데이트 완료가 자동 반영됩니다.</div><button class="b green" style="width:100%;margin-top:8px" onclick="saveUpdateDisplayName()">이름 저장 + 현재 버전 업데이트 완료 등록</button><div id="updateNameSaveMsg" class="small status" style="margin-top:7px"></div></div>`)}
function updateCheckPage(){let nm=getLocalUpdateName();modal('업데이트 확인',`<div class="panel goldline"><h3>✓ 이름별 업데이트 확인</h3><div class="small">서버에는 <b>이름 · 앱 버전 · 업데이트 날짜/시간</b>만 저장합니다.<br><b>전화번호 · 연락처 · 기기번호 · 위치는 저장하지 않습니다.</b></div></div><div class="panel"><div class="label">이 기기 이름 등록</div><input id="updateDisplayName" maxlength="40" value="${esc(nm)}" placeholder="실명만 입력"><div class="small status">한 번 등록하면 다음 버전부터 앱 실행 시 같은 이름으로 업데이트 완료가 자동 반영됩니다.</div><button class="b green" style="width:100%;margin-top:8px" onclick="saveUpdateDisplayName()">이름 저장 + 현재 버전 업데이트 완료 등록</button><div id="updateNameSaveMsg" class="small status" style="margin-top:7px"></div></div><div class="panel"><div class="row"><button class="b gold" onclick="loadNamedUpdateStats()">↻ 최신 현황 새로고침</button></div><div id="namedUpdateSummary" class="grid3" style="margin-top:10px"><div class="stat"><strong>…</strong><span>등록 이름</span></div><div class="stat"><strong>…</strong><span>최신 완료</span></div><div class="stat"><strong>…</strong><span>이전 버전</span></div></div><div id="namedUpdateTarget" class="small status" style="margin-top:9px">불러오는 중입니다...</div></div><div class="panel"><div class="label">이름 찾기</div><input id="updateNameFilter" placeholder="이름 입력" oninput="renderNamedUpdateLast()"><div id="namedUpdatePeople" style="margin-top:10px"></div></div><div class="panel"><h3>날짜별 업데이트 이력</h3><div id="namedUpdateByDate" class="small">불러오는 중입니다...</div></div>`);setTimeout(loadNamedUpdateStats,80)}
let __namedUpdatePayload=null;
function saveUpdateDisplayName(){let n=(document.getElementById('updateDisplayName')?.value||'').trim();let m=document.getElementById('updateNameSaveMsg');if(!n){if(m)m.textContent='실명을 입력해 주세요.';return}if(/[0-9@]/.test(n)){if(m)m.textContent='이름만 입력해 주세요. 전화번호·이메일은 저장하지 않습니다.';return}try{AndroidHost.setUpdateDisplayNameAndReport(n);if(m)m.textContent='저장하고 현재 버전을 등록하는 중입니다...'}catch(e){if(m)m.textContent='등록 기능을 실행할 수 없습니다.'}}
function onUpdateNameSaved(ok,msg){let m=document.getElementById('updateNameSaveMsg');if(m)m.textContent=ok?('이름 저장 완료: '+msg):String(msg||'저장 실패');if(ok)setTimeout(loadNamedUpdateStats,900)}
function loadNamedUpdateStats(){let t=document.getElementById('namedUpdateTarget');if(t)t.textContent='서버에서 이름별 업데이트 현황을 불러오는 중입니다...';try{if(window.AndroidHost&&AndroidHost.requestNamedUpdateStats){AndroidHost.requestNamedUpdateStats();return}}catch(e){}if(t)t.textContent='업데이트 확인 서버에 연결할 수 없습니다.'}
function fmtUpdateDT(v){try{let d=new Date(v);return {date:d.toLocaleDateString('ko-KR',{year:'numeric',month:'2-digit',day:'2-digit'}),time:d.toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'})}}catch(e){return {date:String(v||''),time:''}}}
function onNamedUpdateStats(p){try{p=typeof p==='string'?JSON.parse(p):p||{};__namedUpdatePayload=p;let s=document.getElementById('namedUpdateSummary'),t=document.getElementById('namedUpdateTarget');if(!p.ok){if(t)t.textContent='현황 불러오기 실패 · 인터넷 연결을 확인해 주세요.';return}let total=Number(p.total_names||0),up=Number(p.updated_count||0),old=Number(p.not_updated_count||0);if(s)s.innerHTML=`<div class="stat"><strong>${total}</strong><span>등록 이름</span></div><div class="stat"><strong>${up}</strong><span>최신 완료</span></div><div class="stat"><strong>${old}</strong><span>이전 버전</span></div>`;if(t)t.innerHTML=`현재 최신 감지 버전: <b>${esc(p.target_version||'아직 없음')}</b>`;renderNamedUpdateLast();renderNamedUpdateByDate()}catch(e){let t=document.getElementById('namedUpdateTarget');if(t)t.textContent='표시 중 오류가 발생했습니다.'}}
function renderNamedUpdateLast(){let box=document.getElementById('namedUpdatePeople');if(!box||!__namedUpdatePayload)return;let f=(document.getElementById('updateNameFilter')?.value||'').trim().toLowerCase();let target=Number(__namedUpdatePayload.target_version_code||0);let a=Array.isArray(__namedUpdatePayload.people)?__namedUpdatePayload.people:[];if(f)a=a.filter(x=>String(x.display_name||'').toLowerCase().includes(f));box.innerHTML=a.length?`<table class="table"><thead><tr><th>이름</th><th>상태</th><th>버전</th><th>업데이트</th></tr></thead><tbody>${a.map(x=>{let dt=fmtUpdateDT(x.updated_at),ok=Number(x.version_code||0)===target;return `<tr><td><b>${esc(x.display_name||'')}</b></td><td>${ok?'✅ 최신':'⏳ 이전'}</td><td>${esc(x.version_name||'')}</td><td>${esc(dt.date+' '+dt.time)}</td></tr>`}).join('')}</tbody></table>`:'등록된 이름이 없습니다.'}
function renderNamedUpdateByDate(){let box=document.getElementById('namedUpdateByDate');if(!box||!__namedUpdatePayload)return;let ev=Array.isArray(__namedUpdatePayload.events)?__namedUpdatePayload.events:[];if(!ev.length){box.innerHTML='업데이트 이력이 없습니다.';return}let g={};ev.forEach(x=>{let dt=fmtUpdateDT(x.updated_at);(g[dt.date]||(g[dt.date]=[])).push({x,dt})});box.innerHTML=Object.keys(g).map(d=>`<div style="margin:10px 0 5px;color:#ffe58a;font-weight:900">${esc(d)}</div>${g[d].map(({x,dt})=>`<div style="padding:6px 0;border-bottom:1px solid #23506b"><b>${esc(x.display_name||'')}</b> · ${esc(x.version_name||'')} · ${esc(dt.time)}</div>`).join('')}`).join('')}
function guidePage(){modal('앱 운영원칙 · V3 가이드',`<div class="panel goldline"><div class="rule"><b>1. 원문 우선</b><br><span class="small">RAW 원문은 가능한 한 원형 그대로 보존하고 분석 메모와 분리합니다.</span></div><div class="rule"><b>2. RESULT-BEFORE / AFTER 분리</b><br><span class="small">결과 전 분석과 결과 후 복기를 명확히 나눕니다.</span></div><div class="rule"><b>3. 최종 5조합 공식잠금</b><br><span class="small">실전구매 확정 후 결과 확인을 이유로 과거 조합을 소급 수정하지 않습니다.</span></div><div class="rule"><b>4. HOLD 없이 끝까지 분석</b><br><span class="small">후보가 부족해도 운영 보완 규칙에 따라 최종 5조합까지 완성합니다.</span></div><div class="rule"><b>5. 데이터와 추정 분리</b><br><span class="small">확인된 원문·당첨결과와 해석·가설을 구분하여 기록합니다.</span></div><div class="rule"><b>6. 업데이트 전 전체 백업</b><br><span class="small">중요 업데이트 전 V3 전체 백업 파일을 저장합니다.</span></div></div><div class="panel"><div class="label">항해사 운영 메모</div><textarea id="guideMemo" rows="6" oninput="D.guideMemo=this.value;save()">${esc(D.guideMemo||'')}</textarea><div class="small status">운영 메모는 V3 공통 메모로 자동 저장됩니다.</div></div>`)}
function noticePage(){let rows=(D.notices||[]).filter(n=>!n.pinned).slice().reverse().map((n,i)=>`<div class="panel"><b>${esc(n.title||'공지')}</b><div class="small">${esc(n.time?.slice(0,16).replace('T',' ')||'')}</div><div style="margin-top:6px">${esc(n.body||'').replace(/\n/g,'<br>')}</div></div>`).join('');let purpose=`<div class="panel goldline" style="padding:18px 20px"><div class="centerTitle small" style="letter-spacing:4px;color:#9bb7c9">BAEKHAKDOSA APP</div><div class="centerTitle" style="font-size:30px;color:#ffe58a;margin:8px 0 16px">백학도사앱의 목적</div><div class="noticePinned" style="margin-bottom:14px"><h3 style="margin:0;color:#ffe58a">DB-1 성능 개선 · 백학신서와 로또당첨번호의 연관성 분석 · 철저한 검증</h3></div><div style="line-height:1.8;color:#d5e6f1">본 백학도사앱의 궁극적인 목표는 앱에 탑재된 DB-1의 성능을 개선하고, 백학신서와 로또당첨번호의 연관성을 철저히 분석 및 검증하는 것을 최우선 목표로 두고 있습니다.<br><br>더욱 개선되는 엔진으로 발전하여 이 앱을 사용하는 지인들에게 즐거움을 드리고자 노력하겠습니다.</div><div class="panel" style="margin:16px 0 10px;border-color:#2d8f68;background:#073f39;color:#c8ffe8;text-align:center;font-weight:900;line-height:1.55">비영리 배포 · 무료 · 판매수익 · 유료추천 목적이 아닙니다.<br>연구 · 기록 · 검증 내용을 지인들과 함께 나누는 참고용 앱입니다.</div><div class="screenTitle" style="margin-top:16px">공지사항</div><div class="panel" style="line-height:1.75"><b style="color:#ffe58a">① 본 앱의 분석 결과는 연구·기록·검증을 위한 참고자료입니다.</b><br>② 로또 당첨을 보장하거나 금전적 이익을 약속하지 않습니다.<br><b style="color:#82efc2">③ 앱과 관련하여 별도의 판매대금·유료추천비를 요구하지 않습니다.</b><br>④ 사용 중 불편사항이나 개선 의견은 홈 화면의 건의사항을 이용해 주세요.<br>⑤ 새 버전이 배포되면 홈 화면의 업데이트 버튼을 이용해 최신 버전으로 갱신해 주세요.</div></div>`;modal('공지사항',`${purpose}<div class="panel"><h3>추가 공지 작성</h3><div class="label">제목</div><input id="noticeTitle" placeholder="공지 제목"><div class="label">내용</div><textarea id="noticeBody" rows="5" placeholder="공지 내용을 입력하세요"></textarea><button class="b gold" onclick="addNotice()">공지 저장</button></div>${rows||''}`)}
function addNotice(){let t=noticeTitle.value.trim(),b=noticeBody.value.trim();if(!t&&!b){alert('공지 내용을 입력하세요.');return}D.notices=D.notices||[];D.notices.push({time:new Date().toISOString(),title:t||'공지',body:b});save();openM('notice')}
// FIX5: obsolete settings renderer removed; the current renderer is defined below.

function roundControlPage(){modal('회차 제어 · V2 계승',`<div class="panel goldline"><div class="stat"><strong>제${esc(cur())}회</strong><span>현재 작업 회차</span></div><div class="row" style="margin-top:10px"><button class="b" onclick="setRound(Number(cur())-1);openM('roundctl')">◀ 이전회차</button><button class="b gold" onclick="closeM();openM('raw')">▶ 분석 시작</button><button class="b" onclick="setRound(Number(cur())+1);openM('roundctl')">다음회차 ▶</button></div><div class="small" style="margin-top:10px">현재 회차를 바꾼 뒤 ‘분석 시작’을 누르면 원문분석 화면으로 연결됩니다.</div></div>`)}
function roundBestHit(r){let x=D.rounds?.[String(r)]||{},best=0;if(x.legacy?.total?.bestHits!=null)best=Math.max(best,Number(x.legacy.total.bestHits)||0);if(buyHasData(x.buy)&&parseNums(x.score?.result).length===6){let b=comboStats(x.buy,x.score).best;if(b)best=Math.max(best,b.hit.length)}return best}
function totalRounds(kind){let keys=Object.keys(D.rounds||{}).map(Number).filter(Number.isFinite).sort((a,b)=>b-a);if(kind==='final')return keys.filter(r=>{let x=D.rounds[String(r)]||{};return !!x.buy?.locked||buyHasData(x.buy)||x.legacy?.status==='SCORED'});if(kind==='scored')return keys.filter(r=>scoreHasData(D.rounds[String(r)]?.score)||D.rounds[String(r)]?.legacy?.status==='SCORED');if(kind==='success')return keys.filter(r=>roundBestHit(r)>=3||Number(D.rounds[String(r)]?.legacy?.total?.wins||0)>0);return keys}
function totalAnalysisPage(kind='final'){let labels={final:'최종분석회차',scored:'성적기록회차',success:'성공회차'},arr=totalRounds(kind);let rows=arr.slice(0,100).map(r=>{let x=D.rounds[String(r)]||{},status=x.buy?.locked?'공식잠금':(x.legacy?.status|| (buyHasData(x.buy)?'분석저장':'-'));return `<tr><td>${r}</td><td>${esc(status)}</td><td>${roundBestHit(r)}/6</td><td><button class="b" style="padding:5px 8px" onclick="D.historyRound=${r};save();historyPage(${r})">보기</button></td></tr>`}).join('');modal('총 분석 결과',`<div class="grid3"><div class="stat"><strong>${totalRounds('final').length}</strong><span>최종분석</span></div><div class="stat"><strong>${totalRounds('scored').length}</strong><span>성적기록</span></div><div class="stat"><strong>${totalRounds('success').length}</strong><span>3/6+ 성공</span></div></div><div class="catTabs"><button class="${kind==='final'?'active':''}" onclick="totalAnalysisPage('final')">최종분석회차</button><button class="${kind==='scored'?'active':''}" onclick="totalAnalysisPage('scored')">성적기록회차</button><button class="${kind==='success'?'active':''}" onclick="totalAnalysisPage('success')">성공회차</button></div><div class="panel"><table class="table"><thead><tr><th>회차</th><th>상태</th><th>최고적중</th><th>상세</th></tr></thead><tbody>${rows||'<tr><td colspan="4">해당 기록이 없습니다.</td></tr>'}</tbody></table></div><div class="small">V3 운영원칙에 따라 HOLD 분류는 사용하지 않고, 최종분석·성적기록·성공회차로 정리합니다.</div>`)}
function legacyGroups(round){return D.rounds?.[String(round)]?.legacy?.groups||[]}
function legacyPackHtml(round){let gs=legacyGroups(round);if(!gs.length)return '<div class="panel small">이 회차에 이관된 20조합 자료가 없습니다.</div>';return gs.map(g=>{let rr=(g.rows||[]).map(x=>`<tr><td>${esc(x.slot||'')}</td><td>${esc((x.game||[]).join(', '))}</td><td>${esc(x.hits??'-')}</td><td>${x.bonusHit?'보너스':''}</td><td>${esc(x.rank||'—')}</td></tr>`).join('');return `<div class="legacyPack"><h4>${esc(g.name||'조합')}</h4><table><thead><tr><th>#</th><th>번호</th><th>적중</th><th>보너스</th><th>등수</th></tr></thead><tbody>${rr}</tbody></table></div>`}).join('')}
function historyPage(forced){let n=Number(forced||D.historyRound||Math.min(Number(cur()),1242));if(!Number.isFinite(n)||n<1)n=1;if(n>1244)n=1244;D.historyRound=n;save();let x=D.rounds[String(n)]||{},raw=embeddedRaw(n),score=x.score||{},legacy=x.legacy||{};let win=score.result||(legacy.winning?.numbers||[]).join(' ');let bonus=score.bonus||legacy.winning?.bonus||'';modal('과거회차 독립보기',`<div class="historyWarn">과거회차 화면은 현재 실전 작업회차와 분리됩니다. 여기에서 회차를 이동해도 현재 작업 회차 제${esc(cur())}회는 바뀌지 않습니다.</div><div class="panel goldline"><div class="grid3"><button class="b" onclick="historyPage(${n-1})">◀ 이전</button><div class="stat"><strong>제${n}회</strong><span>과거 독립보기</span></div><button class="b" onclick="historyPage(${n+1})">다음 ▶</button></div></div><div class="panel"><h3>원문</h3><div class="small" style="white-space:pre-wrap">${esc(raw||'내장 원문 없음')}</div></div><div class="panel"><h3>당첨결과</h3><div>당첨번호: <b>${esc(win||'미보존')}</b></div><div>보너스: <b>${esc(bonus||'-')}</b></div><div>최고 적중: <b>${roundBestHit(n)}/6</b></div></div>${legacyPackHtml(n)}<div class="panel"><div class="label">과거회차 개인 메모</div><textarea id="histMemo" rows="5" oninput="D.historyNotes[String(${n})]=this.value;save()">${esc(D.historyNotes[String(n)]||'')}</textarea><div class="small">이 메모는 공식 RESULT-BEFORE에 합치지 않습니다.</div></div>`)}
function suggestPage(){let rows=(D.suggestions||[]).slice().reverse().map(x=>`<div class="panel"><div class="small">${esc(x.time?.slice(0,16).replace('T',' ')||'')}</div><div style="white-space:pre-wrap">${esc(x.body||'')}</div></div>`).join('');modal('건의사항',`<div class="panel"><div class="label">건의 내용</div><textarea id="suggestBody" rows="6" placeholder="V3 개선사항이나 다음 작업 내용을 입력하세요"></textarea><button class="b purple" onclick="addSuggestion()">건의 저장</button></div>${rows||'<div class="panel small">저장된 건의사항이 없습니다.</div>'}`)}
function addSuggestion(){let b=document.getElementById('suggestBody')?.value.trim()||'';if(!b){alert('건의 내용을 입력하세요.');return}D.suggestions.push({time:new Date().toISOString(),body:b});save();suggestPage()}
function legacyImportPage(){let i=D.legacyImport||{};modal('V2 자료이관',`<div class="panel goldline"><h3>V2 / 기존 MASTER 백업 가져오기</h3><div class="small">백업 JSON을 V3 형식으로 안전하게 추가합니다. 현재 V3에서 이미 저장한 내용은 덮어쓰지 않습니다.</div><div class="row" style="margin-top:10px"><button class="b green" onclick="chooseLegacyBackup()">백업 JSON 파일 선택</button></div></div><div class="panel"><h3>백업내용 직접 붙여넣기</h3><div class="small">V2에서 백업내용이 클립보드로만 나온 경우 여기에 그대로 붙여넣어도 됩니다.</div><textarea id="legacyPaste" rows="8" placeholder="{ &quot;format&quot;: &quot;BAEKHAK_DOSA_MASTER_BACKUP_V1&quot;, ... }"></textarea><button class="b green" onclick="importLegacyPaste()">붙여넣은 백업 이관</button></div><div class="grid2"><div class="stat"><strong>${esc(i.rounds||0)}</strong><span>이관 회차</span></div><div class="stat"><strong>${esc(i.packs||0)}</strong><span>이관 조합팩</span></div></div><div class="panel"><div>최근 이관 파일: <b>${esc(i.name||'없음')}</b></div><div class="small">${esc(i.importedAt||'')}</div></div>`)}
function importLegacyPaste(){let t=document.getElementById('legacyPaste')?.value||'';if(!t.trim()){alert('붙여넣은 백업내용이 없습니다.');return}receiveLegacyBackup('직접 붙여넣기',t)}
function chooseLegacyBackup(){try{if(window.AndroidHost&&AndroidHost.chooseLegacyBackup){AndroidHost.chooseLegacyBackup();return}}catch(e){}alert('백업 파일 선택기를 열 수 없습니다.')}
let __legacyName='',__legacyBuf='';function legacyImportStart(name){__legacyName=String(name||'backup.json');__legacyBuf=''}function legacyImportChunk(c){__legacyBuf+=String(c||'')}function legacyImportFinish(){try{receiveLegacyBackup(__legacyName,__legacyBuf)}finally{__legacyBuf=''}}
function parseStorageJson(v){try{return typeof v==='string'?JSON.parse(v):v||{}}catch(e){return {}}}
function receiveLegacyBackup(name,text){let obj;try{obj=JSON.parse(String(text||''))}catch(e){alert('JSON 백업 파일을 읽지 못했습니다.');return}if(obj?.data?.rounds&&String(obj.version||'').includes('V3')){if(!confirm('V3 백업입니다. 현재 데이터와 병합하시겠습니까?'))return;Object.entries(obj.data.rounds||{}).forEach(([r,x])=>{D.rounds[r]=D.rounds[r]||{};D.rounds[r]={...x,...D.rounds[r]}});save();alert('V3 백업을 병합했습니다.');return}let st=obj?.storage||{};let wins=parseStorageJson(st.baekhak_dosa_winning_r8),ledger=parseStorageJson(st.baekhak_dosa_result_ledger_r19);let rc=0,pc=0;Object.entries(wins||{}).forEach(([r,w])=>{if(!w||!w.numbers)return;let x=D.rounds[r]=D.rounds[r]||{};if(!scoreHasData(x.score))x.score={result:(w.numbers||[]).join(' '),bonus:String(w.bonus??''),memo:'기존 MASTER 백업에서 이관',imported:true,updated:new Date().toISOString()};rc++});Object.values(ledger?.records||{}).forEach(rec=>{if(!rec||!rec.round)return;let r=String(rec.round),x=D.rounds[r]=D.rounds[r]||{};x.legacy={status:rec.status||'',appVersion:rec.appVersion||'',engine:rec.engine||{},winning:rec.winning||{},groups:rec.groups||[],total:rec.total||{},importedAt:new Date().toISOString()};pc+=(rec.groups||[]).length;if(!scoreHasData(x.score)&&rec.winning?.numbers)x.score={result:rec.winning.numbers.join(' '),bonus:String(rec.winning.bonus??''),memo:'기존 MASTER 성적장부에서 이관',imported:true,updated:new Date().toISOString()};rc++});let unique=Object.keys(D.rounds||{}).filter(r=>D.rounds[r]?.legacy||D.rounds[r]?.score?.imported).length;D.legacyImport={name:String(name||'backup.json'),format:String(obj?.format||''),appVersion:String(obj?.appVersion||''),importedAt:new Date().toISOString(),rounds:unique,packs:pc};save();alert('자료이관 완료: '+unique+'개 회차 · '+pc+'개 조합팩');legacyImportPage()}
function nativeMusicName(){try{return String(AndroidHost.getMusicName()||'')}catch(e){return ''}}function nativeMusicEnabled(){try{return !!AndroidHost.isMusicEnabled()}catch(e){return false}}function nativeMusicVolume(){try{return Number(AndroidHost.getMusicVolume()||40)}catch(e){return 40}}function nativeMusicPlaylistCount(){try{return Number(AndroidHost.getMusicPlaylistCount())||0}catch(e){return 0}}
function nativeVersion(){try{return String(AndroidHost.getNativeVersion?AndroidHost.getNativeVersion():'확인불가')}catch(e){return '확인불가'}}
function chooseApkUpdate(){try{AndroidHost.chooseApkUpdate()}catch(e){alert('APK 선택기를 열 수 없습니다.')}}
function updatePage(){let an='',ar='';try{an=String(AndroidHost.getApprovalApplicantName?AndroidHost.getApprovalApplicantName():'');ar=String(AndroidHost.getApprovalReferrerName?AndroidHost.getApprovalReferrerName():'')}catch(e){};modal('앱 업데이트',`<div class="panel goldline"><h3>V3 LIVE 업데이트</h3><div>현재 네이티브 버전: <b>${esc(nativeVersion())}</b></div><div class="small">이번 V3 · 1243회차 업데이트에서만 기존 사용자도 승인 확인을 1회 진행합니다. 승인 완료 정보는 이후 업데이트에서도 유지됩니다.</div></div><div class="panel"><div class="label">실명 기입 (필수)</div><input id="updateApplicantName" value="${esc(an)}" placeholder="본인 실명"><div class="label">누구의 지인인지 기입 (필수)</div><input id="updateReferrerName" value="${esc(ar)}" placeholder="예: 홍길동의 지인"><button class="b gold" style="width:100%;margin-top:8px" onclick="requestV3UpdateApproval()">V3 업데이트 승인요청</button><div class="small" id="updateApprovalMsg" style="margin-top:7px">신규 설치자는 계속 승인요청을 진행하며, 기존 사용자의 업데이트 승인은 이번 V3/1243회차에서만 1회 적용합니다.</div></div><div class="panel"><div class="row"><button class="b gold" onclick="chooseApkUpdate()">📂 Samsung 내 파일에서 APK 선택</button></div></div>`) }
function requestV3UpdateApproval(){let name=String(document.getElementById('updateApplicantName')?.value||'').trim(),ref=String(document.getElementById('updateReferrerName')?.value||'').trim(),msg=document.getElementById('updateApprovalMsg');if(!name){msg.textContent='실명을 입력해 주세요.';return}if(!ref){msg.textContent='누구의 지인인지 입력해 주세요.';return}try{D.pendingSpecialRound=1243;AndroidHost.requestSpecialApproval(1243,name,ref);msg.textContent='승인요청을 보냈습니다. 승인 완료 후 이후 업데이트에서는 다시 요청하지 않습니다.';startSpecialApprovalAutoPoll()}catch(e){msg.textContent='승인요청을 보내지 못했습니다.'}}
function musicPage(){return window.MusicV9.open()}
function musicHost(){try{if(window.AndroidHost)return window.AndroidHost}catch(e){}try{if(window.BaekhakNative)return window.BaekhakNative}catch(e){}return null}
function musicDo(action){let st=document.getElementById('musicActionState');if(st)st.textContent='처리 중...';try{let h=musicHost();if(!h)throw new Error('native bridge 없음');if(action==='multi'){if(h.chooseMultipleMusic)h.chooseMultipleMusic();else h.openDeviceMusicLibrary('multi');if(st)st.textContent='Samsung 내 파일의 Music 폴더를 여는 중입니다.';return}let msg='';if(h.musicAction)msg=String(h.musicAction(String(action))||'요청 완료');else{if(action==='prev'&&h.musicPrev)h.musicPrev();else if(action==='next'&&h.musicNext)h.musicNext();else if(action==='toggle'&&h.toggleMusic)h.toggleMusic();else if(action==='stop'&&h.stopMusic)h.stopMusic();else if(action==='reset'&&h.clearMusic)h.clearMusic();else throw new Error('지원되지 않는 명령');msg='요청 완료'}if(st)st.textContent=msg;if(['prev','next','play','pause','toggle','stop','reset'].includes(action))setTimeout(()=>{try{musicPage()}catch(e){}},350)}catch(e){if(st)st.textContent='오류: '+e.message;alert('음악 기능을 실행하지 못했습니다: '+e.message)}}
let __musicLibraryItems=[],__musicFolders=[],__musicViewItems=[],__musicPickMode='multi';
function fmtMusicDuration(ms){let n=Number(ms)||0;if(n<=0)return '';let s=Math.floor(n/1000),m=Math.floor(s/60);return m+':'+String(s%60).padStart(2,'0')}
function onDeviceMusicLibrary(payload){let p=payload||{};if(!p.ok){alert(p.error||'음악 목록을 불러오지 못했습니다.');musicPage();return}__musicLibraryItems=Array.isArray(p.items)?p.items:[];__musicPickMode=String(p.mode||'multi');if(!__musicLibraryItems.length){alert('휴대폰에서 재생 가능한 음악을 찾지 못했습니다.');musicPage();return}if(__musicPickMode==='folder'){let map={};__musicLibraryItems.forEach(x=>{let k=String(x.path||'Music/');(map[k]||(map[k]=[])).push(x)});__musicFolders=Object.keys(map).sort((a,b)=>a.localeCompare(b));let buttons=__musicFolders.map((k,i)=>`<button class="b" style="width:100%;text-align:left;margin:5px 0" onclick="musicOpenFolder(${i})">📁 ${esc(k)} <small>(${map[k].length}곡)</small></button>`).join('');modal('음악 폴더 선택',`<div class="panel goldline"><h3>V3 내부 음악 폴더</h3><div class="small">외부 파일앱을 열지 않습니다. 아래 폴더를 누르면 그 폴더의 모든 곡을 선택할 수 있습니다.</div></div><div class="panel" style="max-height:65vh;overflow:auto">${buttons}</div><div class="row"><button class="b" onclick="musicPage()">음악 화면으로</button></div>`);return}musicRenderTrackPicker(__musicLibraryItems,__musicPickMode,false,'전체 음악')}
function musicOpenFolder(i){let path=__musicFolders[Number(i)]||'';let items=__musicLibraryItems.filter(x=>String(x.path||'Music/')===path);musicRenderTrackPicker(items,'multi',true,path)}
function musicRenderTrackPicker(items,mode,preselect,label){__musicViewItems=Array.isArray(items)?items:[];__musicPickMode=mode==='single'?'single':'multi';let type=__musicPickMode==='single'?'radio':'checkbox',nameAttr=__musicPickMode==='single'?' name="musicPickOne"':'';let rows=__musicViewItems.map((x,i)=>`<label style="display:flex;align-items:center;gap:10px;padding:10px;border-bottom:1px solid #234f6b"><input class="musicPick" type="${type}"${nameAttr} data-id="${Number(x.id)}" ${preselect?'checked':''}><span style="flex:1"><b>${esc(x.name||'음악')}</b><br><small>${esc(x.artist||'')}${x.path?' · '+esc(x.path):''}${x.duration?' · '+fmtMusicDuration(x.duration):''}</small></span></label>`).join('');let tools=__musicPickMode==='multi'?`<button class="b" onclick="musicSelectAll(true)">전체 선택</button><button class="b" onclick="musicSelectAll(false)">전체 해제</button>`:'';modal(__musicPickMode==='single'?'한 곡 선택':'여러 곡 선택',`<div class="panel goldline"><h3>${esc(label||'음악 선택')}</h3><div class="small">선택한 음악은 V3 내부 재생목록으로 저장됩니다. A-IDE나 다른 파일 앱은 열리지 않습니다.</div><div class="row" style="margin-top:8px">${tools}<button class="b gold" onclick="musicSavePicked()">선택 음악 재생</button><button class="b" onclick="musicPage()">취소</button></div></div><div class="panel" style="max-height:62vh;overflow:auto;padding:0">${rows}</div>`)}
function musicSelectAll(on){document.querySelectorAll('.musicPick').forEach(x=>x.checked=!!on)}
function musicSavePicked(){let ids=[...document.querySelectorAll('.musicPick:checked')].map(x=>Number(x.dataset.id)).filter(Number.isFinite);if(!ids.length){alert('음악을 한 곡 이상 선택해 주세요.');return}if(__musicPickMode==='single'&&ids.length>1)ids=ids.slice(0,1);try{let h=musicHost();if(!h||!h.saveDeviceMusicSelection)throw new Error('내부 재생목록 저장 기능 없음');h.saveDeviceMusicSelection(JSON.stringify(ids));let mc=document.getElementById('mc');if(mc)mc.innerHTML='<div class="panel centerTitle"><h3>선택한 음악을 V3 재생목록으로 저장 중입니다...</h3></div>'}catch(e){alert('재생목록 저장 실패: '+e.message)}}
function onDeviceMusicPlaylistSaved(r){let x=r||{};if(!x.ok){alert(x.error||'음악 재생목록 저장에 실패했습니다.');musicPage();return}alert('재생목록 '+String(x.count||0)+'곡을 저장했습니다. 순서대로 연속 재생합니다.');musicPage()}
function setMusicVolume(v){try{let h=musicHost();if(h&&h.setMusicVolume)h.setMusicVolume(Number(v)||0)}catch(e){}}
function onMusicSelected(name){alert('배경음악으로 설정했습니다: '+String(name||'선택한 음악'));try{musicPage()}catch(e){}}
function onMusicFolderSelected(count){alert('재생목록 '+String(count||0)+'곡을 저장했습니다. 순서대로 연속 재생합니다.');try{musicPage()}catch(e){}}

function openRawLoader(){try{if(window.AndroidHost&&AndroidHost.chooseText){AndroidHost.chooseText();return}}catch(e){}alert('TXT 선택기를 열 수 없습니다.')}
function receiveText(name,text){R().raw=R().raw||{};R().raw.text=String(text||'');R().raw.source='TXT 불러오기: '+String(name||'원문.txt');R().raw.updated=new Date().toISOString();save();alert('제'+cur()+'회 원문 TXT 불러오기 완료: '+String(name||'원문.txt'));openM('raw')}
function backup(){
 let json=JSON.stringify({version:APP_BASE_VERSION,exported:new Date().toISOString(),data:D},null,2);
 try{
  if(window.AndroidHost&&typeof AndroidHost.backupJsonV37==='function'){
   let res=String(AndroidHost.backupJsonV37(json)||'');
   if(res.startsWith('OK|')){
    let fn=res.slice(3);
    modal('전체 백업 완료',`<div class="panel goldline"><h3>백업 파일 저장 완료</h3><div class="small">내 파일 &gt; 다운로드 &gt; 항행의자유</div><div style="margin-top:10px;word-break:break-all"><b>${esc(fn)}</b></div></div><div class="row"><button class="b gold" onclick="closeM()">확인</button></div>`);
    return;
   }
   if(res.startsWith('ERR|')){
    modal('전체 백업 실패',`<div class="panel"><div class="warn">${esc(res.slice(4)||'저장 오류')}</div><div class="small">저장 위치 선택 방식으로 다시 시도할 수 있습니다.</div></div><div class="row"><button class="b gold" onclick="legacyBackupPicker()">저장창으로 백업</button><button class="b" onclick="closeM()">닫기</button></div>`);
    return;
   }
  }
 }catch(e){
  modal('전체 백업',`<div class="panel"><div class="warn">자동 백업 본체 연결 오류</div><div class="small">${esc(e&&e.message?e.message:String(e))}</div></div>`);return;
 }
 let native='';try{if(window.AndroidHost&&typeof AndroidHost.getNativeVersion==='function')native=String(AndroidHost.getNativeVersion()||'')}catch(e){}
 modal('전체 백업',`<div class="panel"><div class="warn">APK 본체가 이전 버전입니다.</div><div class="small">V3.0.70 · STAGE4.58 TOP CLEAN APK를 AndroidIDE에서 다시 빌드하여 설치해야 자동 백업이 작동합니다.</div><div class="small" style="margin-top:8px">현재 본체: ${esc(native||'확인 불가')}</div></div>`);
}
function legacyBackupPicker(){closeM();let json=JSON.stringify({version:APP_BASE_VERSION,exported:new Date().toISOString(),data:D},null,2);try{if(window.AndroidHost&&typeof AndroidHost.backupJson==='function'){AndroidHost.backupJson(json);return}}catch(e){}modal('백업 오류','<div class="panel warn">백업 기능을 사용할 수 없습니다.</div>')}
function exitV3(){try{if(window.AndroidHost&&typeof AndroidHost.exitApp==='function'){AndroidHost.exitApp();return}}catch(e){} try{if(window.BaekhakNative&&typeof BaekhakNative.exitApp==='function'){BaekhakNative.exitApp();return}}catch(e){} if(confirm('항해의자유를 종료하시겠습니까?')){try{window.close()}catch(e){}}}
function chooseUpdate(){try{if(window.AndroidHost&&AndroidHost.chooseUpdate){AndroidHost.chooseUpdate();return}}catch(e){}alert('업데이트 파일 선택기를 열 수 없습니다.')}
function saveApprovalRecord(){D.approvalLog=D.approvalLog||[];D.approvalLog.push({time:new Date().toISOString(),round:Number(cur()),name:'승인관리 기록',status:'기록저장',note:'홈 승인 허락 기록 버튼에서 내부 저장'});save();alert('승인 기록이 앱 내부에 저장되었습니다. 전체 백업에 함께 포함됩니다.')}


/* ================= STAGE4 FUNCTIONAL ANALYSIS + SCORE UI ================= */
let V3_ENGINE_READY=false, V3_ANALYSIS_PENDING=null;
window.addEventListener('message',function(ev){
  const m=ev.data||{};
  if(m.type==='V3_ENGINE_READY'){
    V3_ENGINE_READY=true;
    if(V3_ANALYSIS_PENDING){const q=V3_ANALYSIS_PENDING;V3_ANALYSIS_PENDING=null;sendAnalysisToEngine(q.round,q.raw)}
    return;
  }
  if(m.type==='V3_ANALYSIS_RESULT')handleEngineResult(m);
});
function sendAnalysisToEngine(round,raw){
  const f=document.getElementById('engineFrame');
  if(!f||!f.contentWindow){alert('분석 엔진을 준비하지 못했습니다.');return;}
  if(!V3_ENGINE_READY){
    V3_ANALYSIS_PENDING={round,raw};
    try{if(f.getAttribute('src')!=='engine_v2.html')f.setAttribute('src','engine_v2.html')}catch(e){}
    modal('분석 준비 중','<div class="panel centerTitle">분석 엔진을 준비하고 있습니다.<br><span class="small">첫 실행은 엔진을 불러오는 데 잠시 시간이 걸릴 수 있습니다.</span></div>');
    return;
  }
  modal('분석 진행 중',`<div class="panel centerTitle"><h3>제${esc(round)}회 RAW 6문장 분석</h3><div class="small">V2 MASTER 계승 엔진으로 후보를 생성하고 V3 운영 보완 규칙까지 적용합니다.</div><div style="font-size:32px;margin:18px">⚓</div><b>분석 중...</b></div>`);
  f.contentWindow.postMessage({type:'V3_ANALYZE',round:Number(round),raw:String(raw||'')},'*');
}
function hashSeed(str){let h=2166136261>>>0;str=String(str||'');for(let i=0;i<str.length;i++){h^=str.charCodeAt(i);h=Math.imul(h,16777619)>>>0}return h>>>0}
function ensurePool(nums,seed,size=10){let out=[];for(const n of nums||[]){let x=Number(n);if(x>=1&&x<=45&&!out.includes(x))out.push(x);if(out.length>=size)return out.slice(0,size)}let h=hashSeed(seed);let i=0;while(out.length<size&&i<300){h=(Math.imul(h^((i+1)*2654435761),2246822519)+3266489917)>>>0;let n=(h%45)+1;if(!out.includes(n))out.push(n);i++}return out.slice(0,size)}
const V3_OMIT10=[[0,1,8,9],[2,3,4,8],[2,3,5,9],[4,6,7,9],[5,6,7,8]];
function rotate(a,k){if(!a.length)return [];k=((k%a.length)+a.length)%a.length;return a.slice(k).concat(a.slice(0,k))}
function packFromPool(pool,variant=0){let p=pool.slice(0,10);if(variant===1)p=rotate(p,1);if(variant===2)p=rotate(p,3);if(variant===3)p=rotate(p.reverse(),2);return V3_OMIT10.map(omit=>p.filter((_,i)=>!omit.includes(i)).slice(0,6).sort((a,b)=>a-b))}
function cleanGames(games){return (games||[]).slice(0,5).map(g=>(g||[]).map(Number).filter(n=>n>=1&&n<=45).slice(0,6).sort((a,b)=>a-b)).filter(g=>g.length===6)}
function gamesToRows(games){return cleanGames(games).map((g,i)=>({slot:i+1,game:g}))}
function analysisGroups(pool,original){let g0=cleanGames(original);if(g0.length!==5)g0=packFromPool(pool,0);return [
 {name:'원문분석 5조합',rows:gamesToRows(g0)},
 {name:'자동 A 5조합',rows:gamesToRows(packFromPool(pool,1))},
 {name:'자동 B 5조합',rows:gamesToRows(packFromPool(pool,2))},
 {name:'자동 C 5조합',rows:gamesToRows(packFromPool(pool,3))}
]}
function runAnalysisFromHome(){let r=cur(),saved=R().raw||{},raw=(saved.text||embeddedRaw(r)||'').trim();if(!raw){openM('raw');setTimeout(()=>alert('먼저 RAW 6문장을 입력하거나 불러와 주세요.'),120);return}
  let before=String((R().analysis||{}).analyzedAt||'');
  sendAnalysisToEngine(r,raw);
  // 일부 Samsung WebView에서 hidden iframe의 READY/RESULT 메시지가 늦거나 누락되는 경우 자동 보완.
  setTimeout(()=>{try{let now=String((R().analysis||{}).analyzedAt||'');if(now===before&&Number(cur())===Number(r)){V3_ANALYSIS_PENDING=null;let pool=ensurePool([],raw+'|'+r,10);storeAnalysisResult({round:Number(r),engine:'V3_BUTTON_SAFE_FALLBACK',rank:[]},pool,[],true,'엔진 응답 지연 자동 보완')}}catch(e){}},4200)
}
function runAnalysisFromRaw(){saveRawAuto();runAnalysisFromHome()}
// STAGE4.48: 홈 핵심버튼 터치 안전장치. Android WebView에서 inline onclick 누락 시에도 동작합니다.
document.addEventListener('DOMContentLoaded',()=>{
  try{
    const a=document.querySelector('.analyzeStart');
    if(a&&!a.dataset.v3SafeBound){a.dataset.v3SafeBound='1';a.addEventListener('touchend',e=>{if(Date.now()-Number(a.dataset.lastSafeTap||0)<700)return;a.dataset.lastSafeTap=Date.now();e.preventDefault();runAnalysisFromHome()},{passive:false});}
    document.querySelectorAll('.approvalQuick').forEach(b=>{b.style.pointerEvents='auto';});
  }catch(e){}
});
function handleEngineResult(m){if(Number(m.round)!==Number(cur()))return;let raw=(R().raw?.text||embeddedRaw(cur())||'');if(!m.ok){let pool=ensurePool([],raw+'|'+cur(),10);storeAnalysisResult(m,pool,[],true,m.error||'엔진 응답 없음');return}let rank=(m.rank||[]).map(x=>Number(x.n)).filter(n=>n>=1&&n<=45);let pool=ensurePool(rank,raw+'|'+cur(),10);let original=cleanGames(m.games||[]);let fallback=original.length!==5;storeAnalysisResult(m,pool,original,fallback,'')}
function storeAnalysisResult(m,pool,original,fallback,error){let groups=analysisGroups(pool,original);let a={round:Number(cur()),engine:String(m.engine||'V2_MASTER_ENGINE'),candidates:pool,rank:m.rank||[],groups,engineGames:cleanGames(original),fallback:!!fallback,error:String(error||''),analyzedAt:new Date().toISOString()};R().analysis=a;let b=R().buy||{};if(!b.locked){b.combos=groups[0].rows.map(x=>x.game.join(', '));b.memo=`${a.engine}${fallback?' · V3 운영 보완 PACK':''} · 후보 ${pool.join(', ')}`;b.updated=new Date().toISOString();R().buy=b}save();analysisResultPage()}
function candidateBalls(nums){return `<div class="scoreBalls" style="justify-content:center">${(nums||[]).map(n=>`<span class="scoreBall">${n}</span>`).join('')}</div>`}
function analysisResultPage(){let a=R().analysis||{};let gs=a.groups||[];let packs=gs.map(g=>`<div class="scorePack"><h4>${esc(g.name)}</h4>${(g.rows||[]).map(x=>`<div class="scoreGame"><b>${x.slot}</b><div class="scoreBalls">${(x.game||[]).map(n=>`<span class="scoreBall">${n}</span>`).join('')}</div></div>`).join('')}</div>`).join('');modal(`분석 결과 · 제${cur()}회`,`<div class="analysisCompact"><div class="scoreHero ${a.fallback?'fail':'success'}"><strong>${a.fallback?'V3 보완 PACK 완료':'분석 완료'}</strong><span>${esc(a.engine||'분석엔진')} · ${a.fallback?'엔진 후보 기반 운영 보완 규칙으로 5조합 완성':'엔진 Final5 정상 생성'}</span></div><div class="panel candidatePanel"><h3>후보 10수</h3>${candidateBalls(a.candidates||[])}</div><div class="packGrid">${packs}</div><div class="panel centerTitle analysisBottom"><button class="b gold" onclick="buyPage()">실전구매 최종 5조합 확인</button> <button class="b" onclick="rawPage()">원문분석으로 돌아가기</button></div></div>`)}
function scoreData(round){let x=D.rounds?.[String(round)]||{},s=x.score||{},legacy=x.legacy||{};let result=parseNums(s.result);if(result.length!==6&&Array.isArray(legacy.winning?.numbers))result=legacy.winning.numbers.map(Number);let bonus=Number(s.bonus||legacy.winning?.bonus||0)||0;return {x,s,legacy,result,bonus}}
function groupsForRound(round){let x=D.rounds?.[String(round)]||{};if(Array.isArray(x.analysis?.groups)&&x.analysis.groups.length)return x.analysis.groups;if(Array.isArray(x.legacy?.groups)&&x.legacy.groups.length)return x.legacy.groups;if(buyHasData(x.buy))return [{name:'최종 5조합',rows:(x.buy.combos||[]).slice(0,5).map((c,i)=>({slot:i+1,game:parseNums(c)}))}];return []}
function calcRank(hit,bonusHit){if(hit===6)return {no:1,label:'1등'};if(hit===5&&bonusHit)return {no:2,label:'2등'};if(hit===5)return {no:3,label:'3등'};if(hit===4)return {no:4,label:'4등'};if(hit===3)return {no:5,label:'5등'};return {no:0,label:'-'}}
function scoredRows(round){let d=scoreData(round),groups=groupsForRound(round);return groups.map(g=>({name:g.name,rows:(g.rows||[]).map((r,i)=>{let game=(r.game||parseNums(r.c||'')).map(Number);let hits=game.filter(n=>d.result.includes(n));let bh=d.bonus>0&&game.includes(d.bonus)&&!d.result.includes(d.bonus);let rk=calcRank(hits.length,bh);return {slot:r.slot||i+1,game,hits,bonusHit:bh,rankNo:rk.no,rank:rk.label}})}))}
function packScoreHtml(g){return `<div class="scorePack"><h4>${esc(g.name)}</h4>${(g.rows||[]).map(r=>`<div class="scoreGame"><b>${esc(r.slot)}</b><div class="scoreGameBody"><div class="scoreBalls">${r.game.map(n=>`<span class="scoreBall ${r.hits.includes(n)?'hit':''}">${n}</span>`).join('')}</div><div class="scoreMeta"><span class="hitCount ${r.hits.length>=3?'warn':''}">${r.hits.length}/6</span><span class="rankBadge ${r.rankNo?'win':''}">${esc(r.rank)}</span></div></div></div>`).join('')}</div>`}
function roundScoreSummary(round){let gs=scoredRows(round),rows=gs.flatMap(g=>g.rows);let best=rows.reduce((m,r)=>Math.max(m,r.hits.length),0),wins=rows.filter(r=>r.hits.length>=3).length;return {best,wins,rows,groups:gs}}
function cumulativeScore(){let complete=0,incomplete=0,c3=0,c4=0,c5=0,c6=0;for(const r of Object.keys(D.rounds||{})){let x=D.rounds[r]||{},status=String(x.legacy?.status||'');let gs=groupsForRound(r),d=scoreData(r);if(status){if(status==='SCORED')complete++;else incomplete++;}else{if(!gs.length)continue;if(d.result.length===6)complete++;else incomplete++;}if(d.result.length===6&&gs.length){let sum=roundScoreSummary(r);for(const z of sum.rows){if(z.hits.length>=3)c3++;if(z.hits.length>=4)c4++;if(z.hits.length>=5)c5++;if(z.hits.length===6)c6++}}}return {complete,incomplete,total:complete+incomplete,c3,c4,c5,c6}}
function recentScoreRows(){let rs=Object.keys(D.rounds||{}).map(Number).filter(Number.isFinite).filter(r=>groupsForRound(r).length||scoreData(r).result.length===6).sort((a,b)=>b-a).slice(0,8);return rs.map(r=>{let d=scoreData(r),sum=roundScoreSummary(r);return `<div class="scoreRoundRow" onclick="setRound(${r});scorePage()"><b>제${r}회</b><span>${d.result.length===6?'완료 · 3/6 '+sum.rows.filter(x=>x.hits.length>=3).length+' · 4/6 '+sum.rows.filter(x=>x.hits.length>=4).length+' · 5/6 '+sum.rows.filter(x=>x.hits.length>=5).length:'당첨번호 미입력'}</span><strong>${d.result.length===6?sum.best+'/6':'-'}</strong></div>`}).join('')}
function toggleResultInput(){let e=document.getElementById('resultInputBox');if(e)e.classList.toggle('open')}
function saveScoreInputOnly(){let old=R().score||{};R().score={...old,result:document.getElementById('winNums')?.value||'',bonus:document.getElementById('bonusNum')?.value||'',memo:document.getElementById('scoreMemo')?.value||'',updated:new Date().toISOString()};save()}
function scorePage(){let d=scoreData(cur()),sum=roundScoreSummary(cur()),cum=cumulativeScore(),has=d.result.length===6;let bestRank=calcRank(sum.best,false).label;let banner=has?(sum.best>=3?`<div class="scoreHero success"><strong>🎉 축하합니다! 제${cur()}회 ${bestRank} 성적!</strong><span>${sum.best}/6 최고 적중 · ${sum.wins}조합 3/6 이상<br>좋은 성적입니다. 이번 회차도 수고하셨습니다!</span></div>`:`<div class="scoreHero fail"><strong>이번 회차는 아쉽게 지나갔습니다.</strong><span>괜찮습니다. 이번 기록도 다음 분석의 소중한 항해일지입니다.<br>다음 회차에서 다시 힘차게 출발하겠습니다.</span></div>`):`<div class="scoreHero fail"><strong>아직 당첨번호가 입력되지 않았습니다.</strong><span>당첨번호를 입력하면 조합별 적중 현황과 누적 성적을 자동 계산합니다.</span></div>`;let packs=sum.groups.length?sum.groups.map(packScoreHtml).join(''):'<div class="panel centerTitle">이 회차에 분석 조합이 없습니다. 먼저 원문분석을 실행해 주세요.</div>';modal('성적 바로보기',`<div class="scoreCompact">${banner}<div class="screenTitle">누적 결과표 · 회차별 성적</div><div class="scoreSummary"><div class="stat"><strong>${cum.complete}</strong><span>완료 회차</span></div><div class="stat"><strong>${cum.incomplete}</strong><span>미성적/미완료</span></div><div class="stat"><strong>${cum.total}</strong><span>전체 기록</span></div><div class="stat"><strong>${cum.c3}</strong><span>3/6 누계</span></div><div class="stat"><strong>${cum.c5} / ${cum.c6}</strong><span>5/6 · 6/6</span></div></div><div class="scoreRoundList">${recentScoreRows()||'<div class="scoreRoundRow"><span>아직 누적 성적이 없습니다.</span></div>'}</div><div class="resultInputToggle"><button id="autoWinBtn" class="b gold" onclick="autoWinningLookup()">당첨번호 자동조회</button><button class="b" onclick="toggleResultInput()">당첨번호 입력/수정</button></div><div id="resultInputBox" class="panel resultInputBox ${has?'':'open'}"><div class="grid2"><div><div class="label">당첨번호 6개</div><input id="winNums" value="${esc(d.s.result||d.result.join(' '))}" placeholder="예: 2 4 10 16 31 41" oninput="saveScoreInputOnly()" onchange="scorePage()"></div><div><div class="label">보너스</div><input id="bonusNum" value="${esc(d.s.bonus||d.bonus||'')}" placeholder="예: 9" oninput="saveScoreInputOnly()" onchange="scorePage()"></div></div><div class="label">결과 메모</div><textarea id="scoreMemo" rows="3" oninput="saveScoreInputOnly()">${esc(d.s.memo||'')}</textarea><div class="small status">입력 내용은 자동 저장됩니다.</div></div><div class="packGrid">${packs}</div></div>`);document.getElementById('modal')?.classList.add('scoreOneScreen');if(has&&sum.best>=3){setTimeout(()=>showFanfare(cur(),sum.best,sum.wins),180)}else if(has){setTimeout(()=>showComfort(cur(),sum.best),180)}}
function scoreVoiceHost(){try{if(window.BaekhakNative)return window.BaekhakNative}catch(e){}try{if(window.AndroidHost)return window.AndroidHost}catch(e){}return null}
function stopScoreAudio(){try{let h=scoreVoiceHost();if(h&&h.stopScoreVoice)h.stopScoreVoice()}catch(e){}try{if('speechSynthesis' in window)window.speechSynthesis.cancel()}catch(e){}}
function successVoiceText(round,best,wins){let rank=calcRank(best,false).label||'성적';return '축하합니다! 축하합니다! 제'+round+'회 '+rank+' 성적입니다. 최고 적중은 '+best+'개이며, 3개 이상 적중한 조합은 '+wins+'개입니다. 좋은 성적입니다. 이번 회차도 수고하셨습니다!'}
function comfortVoiceText(round,best){if(best===2)return '아쉽습니다. 제'+round+'회 최고 성적은 2개 적중입니다. 당첨에는 조금 모자랐습니다. 그래도 수고하셨습니다. 다음 회차에는 더 좋은 결과를 기대해 보겠습니다. 힘내세요!';if(best===1)return '아쉽습니다. 제'+round+'회 최고 성적은 1개 적중입니다. 오늘의 결과는 여기까지지만 다음 회차가 있습니다. 수고하셨습니다. 힘내세요!';return '아쉽습니다. 제'+round+'회에는 당첨 조합이 없었습니다. 그래도 결과를 확인하고 기록하는 과정이 중요합니다. 수고하셨습니다. 다음 회차에는 더 좋은 결과를 기대해 보겠습니다!'}
function speakScoreFallback(text,rank){try{if(!('speechSynthesis' in window))return;let u=new SpeechSynthesisUtterance(text);u.lang='ko-KR';u.rate=rank>0&&rank<=2?.9:.96;u.pitch=rank>0?1.03:1.0;window.speechSynthesis.cancel();window.speechSynthesis.speak(u)}catch(e){}}
function showFanfare(round,best,wins){let o=document.getElementById('fanfareOverlay');if(!o)return;let rank=calcRank(best,false).label;document.getElementById('fanfareTitle').textContent='🎉 축하합니다! 제'+round+'회 '+rank+' 성적!';document.getElementById('fanfareText').textContent=best+'/6 최고 적중 · '+wins+'조합 3/6 이상';document.getElementById('fanfareBottom').textContent='좋은 성적입니다. 이번 회차도 수고하셨습니다!';o.querySelectorAll('.confetti,.fireworkBurst,.fanfareSpark').forEach(x=>x.remove());let icons=['🎉','✨','🎊','⭐','💫','🏆','🥳'];for(let i=0;i<72;i++){let e=document.createElement('span');e.className='confetti';e.textContent=icons[i%icons.length];e.style.left=(1+(i*29)%98)+'%';e.style.animationDelay=(i%12)*0.055+'s';e.style.animationDuration=(2.6+(i%7)*0.2)+'s';o.appendChild(e)}let burstPos=[[14,25],[30,58],[50,20],[68,55],[85,28],[52,72],[22,78],[80,78]];burstPos.forEach((p,i)=>{let b=document.createElement('i');b.className='fireworkBurst';b.style.left=p[0]+'%';b.style.top=p[1]+'%';b.style.animationDelay=(i*.16)+'s';o.appendChild(b)});[['🎆',8,55],['🎇',88,55],['✨',12,15],['✨',86,16]].forEach((p,i)=>{let e=document.createElement('span');e.className='fanfareSpark';e.textContent=p[0];e.style.left=p[1]+'%';e.style.top=p[2]+'%';e.style.animationDelay=(i*.2)+'s';o.appendChild(e)});o.classList.add('show');let msg=successVoiceText(round,best,wins),rankNo=calcRank(best,false).no||5;let h=scoreVoiceHost();let nativeOk=false;try{if(h&&h.playCelebrationWithVoice){h.playCelebrationWithVoice(msg,rankNo);nativeOk=true}}catch(e){}if(!nativeOk){playFanfareTone();setTimeout(()=>playFanfareTone(),650);setTimeout(()=>speakScoreFallback(msg,rankNo),700)}setTimeout(()=>o.classList.remove('show'),5600)}
function showComfort(round,best){let o=document.getElementById('comfortOverlay');if(!o)return;document.getElementById('comfortTitle').textContent='이번 회차는 아쉽게 지나갔습니다.';document.getElementById('comfortText').textContent='제'+round+'회 최고 적중 '+best+'/6 · 이번 기록도 다음 분석의 소중한 항해일지입니다.';document.getElementById('comfortBottom').textContent='괜찮습니다. 다음 회차에서 다시 힘차게 출발하겠습니다.';o.classList.add('show');let msg=comfortVoiceText(round,best),h=scoreVoiceHost(),nativeOk=false;try{if(h&&h.speakConsolation){h.speakConsolation(msg);nativeOk=true}else if(h&&h.speakCelebration){h.speakCelebration(msg,0);nativeOk=true}}catch(e){}if(!nativeOk)setTimeout(()=>speakScoreFallback(msg,0),250);setTimeout(()=>o.classList.remove('show'),6200)}
function playFanfareTone(){try{let A=window.AudioContext||window.webkitAudioContext;if(!A)return;let ctx=new A(),t=ctx.currentTime;let notes=[[523.25,0],[659.25,.13],[783.99,.26],[1046.5,.41],[783.99,.59],[1046.5,.75],[1318.5,.92]];notes.forEach((q,i)=>{let osc=ctx.createOscillator(),g=ctx.createGain();osc.frequency.value=q[0];osc.type=i%2?'triangle':'sawtooth';g.gain.setValueAtTime(.001,t+q[1]);g.gain.exponentialRampToValueAtTime(.11,t+q[1]+.02);g.gain.exponentialRampToValueAtTime(.001,t+q[1]+.28);osc.connect(g).connect(ctx.destination);osc.start(t+q[1]);osc.stop(t+q[1]+.3)});setTimeout(()=>ctx.close(),1800)}catch(e){}}


// STAGE4.51: V2와 V3가 동일한 승인 서버를 함께 보도록 항해사 승인관리 연동
const APPROVAL_ADMIN_ENDPOINT='https://jyqkohpeowkhuaohlezc.supabase.co/functions/v1/approval-admin';
const APPROVAL_ADMIN_TOKEN='';
let __captainApprovalItems=[];
async function captainApprovalApi(body){
 const r=await fetch(APPROVAL_ADMIN_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json','x-admin-token':APPROVAL_ADMIN_TOKEN},body:JSON.stringify(body||{})});
 if(!r.ok)throw new Error('HTTP '+r.status);return await r.json();
}
function approvalWhen(v){try{return new Date(v).toLocaleString('ko-KR',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'})}catch(e){return String(v||'')}}
async function refreshCaptainApprovalBadge(){
 try{
  let j=await captainApprovalApi({action:'list'});let a=Array.isArray(j.items)?j.items:[];__captainApprovalItems=a;
  let p=a.filter(x=>x.status==='pending').length,b=document.getElementById('captainPendingBadge');if(b)b.textContent=p+'건';
  let btn=document.getElementById('captainApprovalBtn');if(btn)btn.style.borderColor=p?'#e0b840':'#2c87bd';
 }catch(e){let b=document.getElementById('captainPendingBadge');if(b)b.textContent='서버';}
}
function serverApprovalItemHtml(x){
 let pending=x.status==='pending',round=Number(x.requested_round||0),who=String(x.referrer_name||'승인 요청'),label=String(x.device_label||''),code=String(x.approval_code||'');
 return `<div class="serverApprovalItem ${pending?'pending':''}"><div class="serverApprovalTop"><b>${esc(who)}</b><span class="pill">${pending?'승인대기':esc(x.status||'')}</span></div><div class="serverApprovalMeta">${round?`요청 회차: 제${round}회 · `:''}${code?`승인번호: ${esc(code)} · `:''}${esc(approvalWhen(x.requested_at))}${label?`<br>${esc(label)}`:''}</div>${pending?`<div class="serverApprovalActions"><button class="b green" onclick="captainApprovalDecide('${esc(x.id)}','approved')">승인</button><button class="b danger" onclick="captainApprovalDecide('${esc(x.id)}','rejected')">거절</button></div>`:''}</div>`
}
async function captainApprovalPage(){
 modal('V2·V3 배포 승인관리','<div class="panel goldline centerTitle"><h3>V2와 V3 공용 승인 서버</h3><div class="small">V2에서 들어온 요청과 V3 특별승인 요청을 한 화면에서 함께 확인합니다.<br>항해사 확인 전에는 자동 승인되지 않습니다.</div></div><div id="captainApprovalBody" class="panel centerTitle">승인 요청을 불러오는 중입니다...</div>');
 await loadCaptainApprovalList();
}
async function loadCaptainApprovalList(){
 let box=document.getElementById('captainApprovalBody');if(box)box.innerHTML='승인 요청을 불러오는 중입니다...';
 try{
  let j=await captainApprovalApi({action:'list'});let a=Array.isArray(j.items)?j.items:[];__captainApprovalItems=a;let pending=a.filter(x=>x.status==='pending'),approved=a.filter(x=>x.status==='approved'),other=a.filter(x=>x.status!=='pending'&&x.status!=='approved');
  if(box)box.innerHTML=`<div class="grid3"><div class="stat"><strong>${pending.length}</strong><span>승인 대기</span></div><div class="stat"><strong>${approved.length}</strong><span>승인 완료</span></div><div class="stat"><strong>${other.length}</strong><span>기타 이력</span></div></div><div class="row" style="margin-top:10px"><button class="b gold" onclick="loadCaptainApprovalList()">↻ 새로고침</button></div><h3>승인 대기</h3>${pending.length?pending.map(serverApprovalItemHtml).join(''):'<div class="small status">현재 승인 대기 요청이 없습니다.</div>'}<h3>최근 승인 완료</h3>${approved.slice(0,20).map(serverApprovalItemHtml).join('')||'<div class="small">승인 완료 기록이 없습니다.</div>'}`;
  refreshCaptainApprovalBadge();
 }catch(e){if(box)box.innerHTML='<div class="warn">승인 서버 연결 실패</div><div class="small">인터넷 연결을 확인하고 새로고침해 주세요.</div>'}
}
async function captainApprovalDecide(id,decision){
 if(!id)return;let ok=confirm(decision==='approved'?'이 요청을 승인하시겠습니까?':'이 요청을 거절하시겠습니까?');if(!ok)return;
 try{await captainApprovalApi({action:'decide',id:String(id),decision:String(decision)});await loadCaptainApprovalList()}catch(e){alert('승인 처리에 실패했습니다. 서버 연결을 확인해 주세요.')}
}
// 홈 표시: 현재 회차가 1242 이하면 기본 이용 강조, 1243 이상은 특별승인 강조
const __refreshHomeUI_stage451=refreshHomeUI;
refreshHomeUI=function(){
 try{__refreshHomeUI_stage451()}catch(e){}
 try{
  let n=Number(cur()),a=document.getElementById('approvalBasicQuick'),b=document.getElementById('approvalSpecialQuick');
  if(a)a.classList.toggle('active',n<=1242);if(b)b.classList.toggle('active',n>=1243);
  let msg=document.getElementById('approvalMessage');if(msg){if(n<=1242)msg.textContent='제1242회차까지 정상 이용';else if(SPECIAL_APPROVED)msg.textContent='특별승인 완료 · 제'+n+'회 이용 가능';else msg.textContent='제1243회차부터 특별승인 필요';}
 }catch(e){}
};
// Integrated distribution: do not poll the administrator endpoint without owner credentials.
setTimeout(()=>{refreshHomeUI()},1400);

// 성적창 아래의 불필요한 짙은 빈 화면을 줄이기 위해 배경을 반투명 처리
const __modal_stage451=modal;
modal=function(title,html){__modal_stage451(title,html);let m=document.getElementById('modal');if(m)m.classList.toggle('scoreModalCompact',String(title)==='성적 바로보기')};

// V2 MASTER 백업 전체 이관: 당첨번호 + 성적장부 + emergency RAW 원문까지 보존
function legacyImportPage(){let i=D.legacyImport||{};modal('V2 자료이관',`<div class="panel goldline"><h3>V2 / 기존 MASTER 백업 가져오기</h3><div class="small">백업 JSON을 V3 형식으로 안전하게 추가합니다. 현재 V3에서 이미 저장한 내용은 덮어쓰지 않습니다.<br><b>당첨번호 · 상세 성적장부 · emergency RAW 원문</b>까지 함께 이관합니다.</div><div class="row" style="margin-top:10px"><button class="b green" onclick="chooseLegacyBackup()">백업 JSON 파일 선택</button></div></div><div class="panel"><h3>백업내용 직접 붙여넣기</h3><div class="small">V2에서 백업내용이 클립보드로만 나온 경우 여기에 그대로 붙여넣어도 됩니다.</div><textarea id="legacyPaste" rows="8" placeholder="{ &quot;format&quot;: &quot;BAEKHAK_DOSA_MASTER_BACKUP_V1&quot;, ... }"></textarea><button class="b green" onclick="importLegacyPaste()">붙여넣은 백업 이관</button></div><div class="legacyImportSummary"><div class="stat"><strong>${esc(i.rounds||0)}</strong><span>이관 회차</span></div><div class="stat"><strong>${esc(i.packs||0)}</strong><span>이관 조합팩</span></div><div class="stat"><strong>${esc(i.raws||0)}</strong><span>이관 원문</span></div></div><div class="panel"><div>최근 이관 파일: <b>${esc(i.name||'없음')}</b></div><div class="small">${esc(i.importedAt||'')}</div></div>`)}
function receiveLegacyBackup(name,text){
 let obj;try{obj=JSON.parse(String(text||''))}catch(e){alert('JSON 백업 파일을 읽지 못했습니다.');return}
 if(obj?.data?.rounds&&String(obj.version||'').includes('V3')){if(!confirm('V3 백업입니다. 현재 데이터와 병합하시겠습니까?'))return;Object.entries(obj.data.rounds||{}).forEach(([r,x])=>{D.rounds[r]=D.rounds[r]||{};D.rounds[r]={...x,...D.rounds[r]}});save();alert('V3 백업을 병합했습니다.');return}
 let st=obj?.storage||{},wins=parseStorageJson(st.baekhak_dosa_winning_r8),ledger=parseStorageJson(st.baekhak_dosa_result_ledger_r19);let rc=0,pc=0,rawc=0;
 // emergency 버전 번호에 관계없이 모두 찾아서 회차별 원문을 보존
 Object.entries(st).filter(([k])=>/^baekhak_dosa_emergency_v\d+$/.test(k)).sort((a,b)=>a[0].localeCompare(b[0])).forEach(([k,v])=>{let e=parseStorageJson(v);if(!e||!e.round||!e.raw)return;let r=String(e.round),x=D.rounds[r]=D.rounds[r]||{};if(!(x.raw&&String(x.raw.text||'').trim())){x.raw={text:String(e.raw||''),source:'V2 MASTER 백업 '+k,updated:String(e.savedAt||new Date().toISOString()),imported:true};rawc++;}});
 Object.entries(wins||{}).forEach(([r,w])=>{if(!w||!w.numbers)return;let x=D.rounds[r]=D.rounds[r]||{};if(!scoreHasData(x.score))x.score={result:(w.numbers||[]).join(' '),bonus:String(w.bonus??''),memo:'기존 MASTER 백업에서 이관',source:w.source||'',drawDate:w.date||'',imported:true,updated:new Date(Number(w.savedAt)||Date.now()).toISOString()};rc++});
 Object.values(ledger?.records||{}).forEach(rec=>{if(!rec||!rec.round)return;let r=String(rec.round),x=D.rounds[r]=D.rounds[r]||{};x.legacy={status:rec.status||'',savedAt:rec.savedAt||'',appVersion:rec.appVersion||'',engine:rec.engine||{},winning:rec.winning||{},groups:rec.groups||[],total:rec.total||{},importedAt:new Date().toISOString()};pc+=(rec.groups||[]).length;if(!scoreHasData(x.score)&&rec.winning?.numbers)x.score={result:rec.winning.numbers.join(' '),bonus:String(rec.winning.bonus??''),memo:'기존 MASTER 성적장부에서 이관',source:rec.winning.source||'',drawDate:rec.winning.date||'',imported:true,updated:String(rec.savedAt||new Date().toISOString())};rc++});
 let unique=Object.keys(D.rounds||{}).filter(r=>D.rounds[r]?.legacy||D.rounds[r]?.score?.imported||D.rounds[r]?.raw?.imported).length;D.legacyImport={name:String(name||'backup.json'),format:String(obj?.format||''),appVersion:String(obj?.appVersion||''),importedAt:new Date().toISOString(),rounds:unique,packs:pc,raws:rawc};save();alert('자료이관 완료: '+unique+'개 회차 · '+pc+'개 조합팩 · '+rawc+'개 원문');legacyImportPage();
}

// FIX5: one settings implementation; navigation remains on the approved home screen.
function settingsPage(){
  const keys=Object.keys(D.rounds||{});
  modal('설정',`
    <div class="grid2">
      <div class="stat"><strong>${esc(cur())}</strong><span>현재 작업 회차</span></div>
      <div class="stat"><strong>${keys.length}</strong><span>저장 회차</span></div>
    </div>
    <div class="panel">
      <h3>앱 정보</h3>
      <div>앱: <b>항해의자유</b></div>
      <div>버전: <b>V3.0.84 · V3 PERPECT FINAL · 2026-09-25</b></div>
      <div>원문은행: <b>1~1244</b> (이후 회차는 TXT/직접입력 가능)</div>
      <div class="small">기존 분석 데이터와 기능은 그대로 유지합니다.</div>
    </div>
    <div class="panel">
      <div class="label">기본 작업 회차</div>
      <input id="settingsRoundInput" type="number" min="1" max="9999" inputmode="numeric" value="${esc(cur())}">
      <div class="row">
        <button class="b" onclick="if(setRound(document.getElementById('settingsRoundInput').value)){alert('기본 회차 저장 완료');settingsPage()}">저장</button>
        <button class="b gold" onclick="backup()">전체 백업</button>
      </div>
    </div>`);
}


function roundControlPage(){modal('회차 제어 · 분석 시작',`<div class="panel goldline"><div class="stat"><strong>제${esc(cur())}회</strong><span>현재 작업 회차</span></div><div class="row" style="margin-top:10px;justify-content:center"><button class="b" onclick="setRound(Number(cur())-1);openM('roundctl')">◀ 이전회차</button><button class="b gold" onclick="closeM();runAnalysisFromHome()">▶ 분석 시작</button><button class="b" onclick="setRound(Number(cur())+1);openM('roundctl')">다음회차 ▶</button></div><div class="small centerTitle" style="margin-top:10px">RAW가 있으면 바로 분석을 실행하고, RAW가 없으면 원문분석 화면으로 안내합니다.</div></div>`)}
function roundBestHit(r){let sum=roundScoreSummary(r);let legacy=Number(D.rounds?.[String(r)]?.legacy?.total?.bestHits||0);return Math.max(sum.best||0,legacy)}


/* ================= STAGE4.52 V2 SAME-DEVICE AUTO MIGRATION ================= */
const V2_STAGE452_BUILTIN_WINNING={"1214":{"numbers":[10,15,19,27,30,33],"bonus":14,"date":"20260307","source":"동행복권"},"1215":{"numbers":[13,15,19,21,44,45],"bonus":39,"date":"20260314","source":"동행복권"},"1216":{"numbers":[3,10,14,15,23,24],"bonus":25,"date":"20260321","source":"동행복권"},"1217":{"numbers":[8,10,15,20,29,31],"bonus":41,"date":"20260328","source":"동행복권"},"1218":{"numbers":[3,28,31,32,42,45],"bonus":25,"date":"20260404","source":"동행복권"},"1219":{"numbers":[1,2,15,28,39,45],"bonus":31,"date":"20260411","source":"동행복권"},"1220":{"numbers":[2,22,25,28,34,43],"bonus":16,"date":"20260418","source":"동행복권"},"1221":{"numbers":[6,13,18,28,30,36],"bonus":9,"date":"20260425","source":"동행복권"},"1222":{"numbers":[4,11,17,22,32,41],"bonus":34,"date":"20260502","source":"동행복권"},"1223":{"numbers":[16,18,20,32,33,39],"bonus":26,"date":"20260509","source":"동행복권"},"1224":{"numbers":[9,18,21,27,44,45],"bonus":28,"date":"20260516","source":"동행복권"},"1225":{"numbers":[8,9,19,25,41,42],"bonus":33,"date":"20260523","source":"동행복권"},"1226":{"numbers":[4,6,13,17,26,28],"bonus":41,"date":"20260530","source":"동행복권"},"1227":{"numbers":[1,14,16,34,41,44],"bonus":13,"date":"20260606","source":"동행복권"},"1228":{"numbers":[24,29,30,31,35,44],"bonus":1,"date":"20260613","source":"동행복권"},"1229":{"numbers":[12,13,29,34,37,42],"bonus":16,"date":"20260620","source":"동행복권"},"1230":{"numbers":[3,8,9,22,28,42],"bonus":45,"date":"20260627","source":"동행복권"},"1231":{"numbers":[4,13,14,18,31,38],"bonus":15,"date":"20260704","source":"동행복권"},"1232":{"numbers":[12,15,19,22,24,36],"bonus":3,"date":"20260711","source":"동행복권"},"1233":{"numbers":[2,7,20,25,37,40],"bonus":29,"date":"20260718","source":"동행복권"},"1234":{"numbers":[1,15,19,31,35,43],"bonus":27,"date":"20260725","source":"동행복권"},"1235":{"numbers":[6,7,11,15,39,43],"bonus":20,"date":"20260801","source":"동행복권"},"1236":{"numbers":[12,18,21,29,34,38],"bonus":10,"date":"20260808","source":"동행복권"},"1237":{"numbers":[10,20,23,34,37,40],"bonus":36,"date":"20260815","source":"동행복권"},"1238":{"numbers":[2,13,18,32,38,42],"bonus":22,"date":"20260822","source":"동행복권"},"1239":{"numbers":[11,13,22,32,33,36],"bonus":8,"date":"20260829","source":"동행복권"},"1240":{"numbers":[11,13,19,20,31,44],"bonus":27,"date":"20260905","source":"동행복권"},"1241":{"numbers":[7,13,16,23,24,43],"bonus":9,"date":"20260912","source":"동행복권"},"1242":{"numbers":[2,4,10,16,31,41],"bonus":9,"date":"20260919","source":"동행복권"}};
const V2_STAGE452_BUILTIN_RAW={"1241":"첫번째. 눈위에 봄을 기다리는 두루미의 발자국이 보이는구나.\n두번째. 대추나무에 걸린 연은 바람을 만나리니 주인을 찾을지로다.\n세번째. 세개의 주사위는 던져지고 가장 작은 눈은 큰 상을 받을지로다.\n네번째. 소금장수는 소나기를 피해 처마밑에서 잠이 드는구나.\n다섯째. 거북은 토끼의 낮잠을 깨우지 않고 홀로 산을 넘을지로다.\n여섯째. 열리지 않은 자물쇠와 부러진 열쇠가 함께 하리로다.","1242":"첫번째. 시골집 화로에 놓인 마지막 숯이 붉게 살아나는구나.\n두번째. 강건너 대나무숲에서 코끼리소리가 들리는구나.\n세번째. 황금이 가득한 창고에는 사람이 가장 많이 지키는구나.\n네번째. 玉 의 구슬주머니는 사자가 지키는구나.\n다섯째. 샘물속의 달을 마시는 사슴을 찾을지로다.\n여섯째. 가장 어린 뱃사공은 노를 저어 은하수를 건너리로다."};

function stage452SeedBackupBase(){
  let addedWins=0,addedRaw=0;
  try{
    Object.entries(V2_STAGE452_BUILTIN_WINNING).forEach(([r,w])=>{
      let x=D.rounds[r]=D.rounds[r]||{};
      if(!scoreHasData(x.score)){
        x.score={result:(w.numbers||[]).join(' '),bonus:String(w.bonus??''),memo:'V2 MASTER 백업 내장복구',source:w.source||'',drawDate:w.date||'',imported:true,updated:new Date().toISOString()};
        addedWins++;
      }
    });
    Object.entries(V2_STAGE452_BUILTIN_RAW).forEach(([r,raw])=>{
      let x=D.rounds[r]=D.rounds[r]||{};
      if(!(x.raw&&String(x.raw.text||'').trim())){x.raw={text:String(raw),source:'V2 MASTER 백업 내장복구',updated:new Date().toISOString(),imported:true};addedRaw++;}
    });
    if(addedWins||addedRaw){D.v2BuiltinSeed={at:new Date().toISOString(),winning:addedWins,raws:addedRaw};save();}
  }catch(e){}
  return {winning:addedWins,raws:addedRaw};
}

function stage452ReadV2LocalStorage(){
  let st={};
  try{
    for(let i=0;i<localStorage.length;i++){let k=localStorage.key(i);if(!k)continue;if(k==='baekhak_dosa_winning_r8'||k==='baekhak_dosa_result_ledger_r19'||/^baekhak_dosa_emergency_v\d+$/.test(k)){let v=localStorage.getItem(k);if(v!=null)st[k]=v;}}
  }catch(e){}
  return st;
}

function stage452MigrateV2LocalStorage(force=false){
  let st=stage452ReadV2LocalStorage(), keys=Object.keys(st);
  if(!keys.length){return {found:false,rounds:0,packs:0,raws:0};}
  if(!force&&D.v2AutoMigration&&D.v2AutoMigration.sourceHash===keys.sort().join('|')&&D.v2AutoMigration.done){return {found:true,rounds:Number(D.v2AutoMigration.rounds||0),packs:Number(D.v2AutoMigration.packs||0),raws:Number(D.v2AutoMigration.raws||0),cached:true};}
  let wins=parseStorageJson(st.baekhak_dosa_winning_r8),ledger=parseStorageJson(st.baekhak_dosa_result_ledger_r19),pc=0,rawc=0;
  try{
    Object.entries(st).filter(([k])=>/^baekhak_dosa_emergency_v\d+$/.test(k)).sort((a,b)=>a[0].localeCompare(b[0])).forEach(([k,v])=>{let e=parseStorageJson(v);if(!e||!e.round||!e.raw)return;let r=String(e.round),x=D.rounds[r]=D.rounds[r]||{};if(!(x.raw&&String(x.raw.text||'').trim())){x.raw={text:String(e.raw||''),source:'V2 기기 자동복구 '+k,updated:String(e.savedAt||new Date().toISOString()),imported:true};rawc++;}});
    Object.entries(wins||{}).forEach(([r,w])=>{if(!w||!Array.isArray(w.numbers)||w.numbers.length!==6)return;let x=D.rounds[r]=D.rounds[r]||{};if(!scoreHasData(x.score))x.score={result:w.numbers.join(' '),bonus:String(w.bonus??''),memo:'V2 기기 자동복구',source:w.source||'',drawDate:w.date||'',imported:true,updated:new Date(Number(w.savedAt)||Date.now()).toISOString()};});
    Object.values((ledger&&ledger.records)||{}).forEach(rec=>{if(!rec||!rec.round)return;let r=String(rec.round),x=D.rounds[r]=D.rounds[r]||{};if(force||!x.legacy||!Array.isArray(x.legacy.groups)||!x.legacy.groups.length){x.legacy={status:rec.status||'',savedAt:rec.savedAt||'',appVersion:rec.appVersion||'',engine:rec.engine||{},winning:rec.winning||{},groups:rec.groups||[],total:rec.total||{},importedAt:new Date().toISOString()};}pc+=(rec.groups||[]).length;if(!scoreHasData(x.score)&&rec.winning?.numbers)x.score={result:rec.winning.numbers.join(' '),bonus:String(rec.winning.bonus??''),memo:'V2 기기 성적장부 자동복구',source:rec.winning.source||'',drawDate:rec.winning.date||'',imported:true,updated:String(rec.savedAt||new Date().toISOString())};});
    let rounds=Object.keys(D.rounds||{}).filter(r=>D.rounds[r]?.legacy||D.rounds[r]?.score?.imported||D.rounds[r]?.raw?.imported).length;
    D.v2AutoMigration={done:true,at:new Date().toISOString(),rounds,packs:pc,raws:rawc,sourceHash:keys.sort().join('|')};
    D.legacyImport={name:'V2 기기 자동복구',format:'BAEKHAK_DOSA_MASTER_BACKUP_V1 / LOCALSTORAGE',appVersion:'V2',importedAt:D.v2AutoMigration.at,rounds,packs:pc,raws:rawc};
    save();return {found:true,rounds,packs:pc,raws:rawc};
  }catch(e){return {found:true,error:String(e&&e.message?e.message:e),rounds:0,packs:0,raws:0};}
}

function stage452MigrationStatusText(r){
  if(r&&r.found)return 'V2 기록 자동연결 완료 · '+Number(r.rounds||0)+'회차 · '+Number(r.packs||0)+'개 조합팩';
  let b=D.v2BuiltinSeed||{};return 'V2 백업 기본기록 내장 · 당첨결과 '+Number(b.winning||0)+'회차';
}

function stage452ManualMigration(){
  let r=stage452MigrateV2LocalStorage(true);let t=document.getElementById('v2MigrationHomeStatus');if(t)t.textContent=stage452MigrationStatusText(r);
  alert(r.found?('V2 기기 기록 자동복구 완료: '+r.rounds+'개 회차 · '+r.packs+'개 조합팩'):('V2 기기 저장기록은 찾지 못했습니다. 내장된 당첨결과/RAW 기록은 유지됩니다.'));
  try{legacyImportPage()}catch(e){}
}

const __legacyImportPage_stage452=legacyImportPage;
legacyImportPage=function(){
  let i=D.legacyImport||{},m=D.v2AutoMigration||{},b=D.v2BuiltinSeed||{};
  modal('V2 자료이관',`<div class="panel goldline"><h3>V2 기록 자동연결</h3><div class="small">같은 기기에 남아 있는 V2 MASTER 저장기록을 자동으로 찾아 V3에 병합합니다. V3에서 이미 저장된 기록은 덮어쓰지 않습니다.</div><button class="b green" style="width:100%;margin-top:10px" onclick="stage452ManualMigration()">V2 기기 자동복구 실행</button><div class="small status" style="margin-top:8px">자동복구: ${m.done?('완료 · '+Number(m.rounds||0)+'회차 · '+Number(m.packs||0)+'개 조합팩'):'확인 전'}<br>내장 기본기록: 당첨결과 1214~1242 · RAW 1241~1242</div></div><div class="panel"><h3>백업 JSON 직접 이관</h3><div class="small">다른 기기의 V2 백업은 파일선택 또는 붙여넣기로 가져올 수 있습니다.</div><div class="row" style="margin-top:10px"><button class="b green" onclick="chooseLegacyBackup()">백업 JSON 파일 선택</button></div><textarea id="legacyPaste" rows="7" placeholder="{ &quot;format&quot;: &quot;BAEKHAK_DOSA_MASTER_BACKUP_V1&quot;, ... }"></textarea><button class="b green" onclick="importLegacyPaste()">붙여넣은 백업 이관</button></div><div class="legacyImportSummary"><div class="stat"><strong>${esc(i.rounds||0)}</strong><span>이관 회차</span></div><div class="stat"><strong>${esc(i.packs||0)}</strong><span>이관 조합팩</span></div><div class="stat"><strong>${esc(i.raws||0)}</strong><span>이관 원문</span></div></div><div class="panel"><div>최근 이관: <b>${esc(i.name||'없음')}</b></div><div class="small">${esc(i.importedAt||'')}</div></div>`);
};

setTimeout(()=>{
  let base=stage452SeedBackupBase();let mig=stage452MigrateV2LocalStorage(false);let t=document.getElementById('v2MigrationHomeStatus');if(t)t.textContent=stage452MigrationStatusText(mig);refreshHomeUI();refreshCaptainApprovalBadge();
},650);

</script>
