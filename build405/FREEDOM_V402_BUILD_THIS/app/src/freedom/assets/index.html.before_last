<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>항해의자유</title><style>
*{box-sizing:border-box}html,body{margin:0;background:#00152a;color:#fff;font-family:system-ui,-apple-system,'Noto Sans KR',sans-serif}#wrap{max-width:1024px;margin:auto;position:relative}.home{width:100%;display:block}.hot{position:absolute;border:0;background:rgba(0,0,0,0.001);padding:0;margin:0;pointer-events:auto!important;touch-action:manipulation;-webkit-tap-highlight-color:transparent}.toolbar{position:fixed;right:10px;bottom:18px;display:flex;gap:7px;z-index:20}.b{border:1px solid #d9b95b;background:linear-gradient(#0c4f7b,#062b4a);color:#fff;border-radius:18px;padding:10px 13px;font-weight:800}.b.gold{background:linear-gradient(#7a5b16,#3a2a08);color:#fff0a5}.b.green{border-color:#5bd1a3;background:linear-gradient(#087259,#064838)}.b.purple{border-color:#d781ff;background:linear-gradient(#6e278f,#35144d)}.b.danger{border-color:#ff7b7b;background:linear-gradient(#a81423,#5d0711)}.exit{background:#8b0012}.homeBankLabel{position:absolute;left:10.4%;top:58.0%;width:24%;height:2.5%;z-index:12;background:#062a4b;color:#c8d8e5;font-size:clamp(10px,1.55vw,16px);display:flex;align-items:center;white-space:nowrap;padding-left:2px;pointer-events:none}.homeApprovalLabel{position:absolute;left:52.8%;top:73.7%;width:42.5%;height:3.8%;z-index:47;background:#074066;color:#fff;font-weight:800;font-size:clamp(10px,1.7vw,17px);display:flex;align-items:center;justify-content:center;border-radius:12px;pointer-events:none}.modal{display:none;position:fixed;inset:0;background:#001326fa;z-index:200;padding:18px;overflow:auto}.card{max-width:820px;margin:2vh auto;background:linear-gradient(180deg,#082f50,#041b30);border:1px solid #d2b355;border-radius:22px;padding:18px;box-shadow:0 0 35px #0009}.card h2{margin:0 0 6px;color:#ffe58a}.card h3{color:#ffe58a;margin:14px 0 8px}.close{float:right}.row{display:flex;gap:8px;flex-wrap:wrap}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.panel{background:#031d33;border:1px solid #2b6e98;border-radius:15px;padding:12px;margin:10px 0}.panel.goldline{border-color:#b99642}.label{font-size:13px;color:#a9c7db;margin:7px 0 3px}textarea,input,select{width:100%;background:#00182b;color:#fff;border:1px solid #54728a;border-radius:10px;padding:10px;margin:4px 0;font:inherit}textarea{resize:vertical;min-height:88px}.combo{display:grid;grid-template-columns:58px 1fr;gap:8px;align-items:center;margin:7px 0}.combo b{color:#ffe58a}.status{color:#8ff0c5}.warn{color:#ffd27e}.small{opacity:.8;font-size:13px}.muted{color:#9db4c4}.pill{display:inline-block;padding:5px 10px;border:1px solid #b8953e;border-radius:999px;color:#ffe58a;font-size:12px}.stat{padding:10px;background:#061c2d;border:1px solid #234f6b;border-radius:12px;text-align:center}.stat strong{display:block;color:#ffe58a;font-size:20px}.rule{padding:9px 10px;border-bottom:1px solid #204b66}.rule:last-child{border-bottom:0}.table{width:100%;border-collapse:collapse;font-size:13px}.table th,.table td{padding:8px;border-bottom:1px solid #234f6b;text-align:left}.table th{color:#ffe58a}.lockbox{border:1px solid #d3b253;border-radius:14px;padding:12px;background:#2b2208aa}.locked{color:#7ff2be;font-weight:900}.unlocked{color:#ffd27e;font-weight:900}.hr{height:1px;background:#2a5975;margin:12px 0}@media(max-width:640px){.grid2,.grid3{grid-template-columns:1fr}.combo{grid-template-columns:48px 1fr}.modal{padding:9px}.card{padding:14px}}
.homeRoundLabel{position:absolute;left:15.4%;top:48.3%;width:20.2%;height:5.0%;z-index:70;background:#062a4bee;border-radius:10px;padding:5px 8px;display:flex;flex-direction:column;justify-content:center;pointer-events:none;box-shadow:0 0 0 1px #1f6389 inset}.homeRoundLabel b{color:#ffe58a;font-size:clamp(13px,2.0vw,22px)}.homeRoundLabel span{color:#c4d7e4;font-size:clamp(9px,1.2vw,13px)}
.roundCtlBtn{position:absolute;left:15.4%;top:53.45%;width:20.2%;height:2.45%;z-index:82;border:1px solid #d7b64f;border-radius:999px;background:linear-gradient(#174d71,#092b47);color:#ffe79a;font-size:clamp(9px,1.25vw,13px);font-weight:900;box-shadow:0 4px 12px #0007}
.extraDock{position:absolute;left:3%;top:86.15%;width:68.5%;height:6.05%;z-index:85;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,1fr);gap:5px}.extraDock button{border:1px solid #4d86ad;border-radius:12px;background:linear-gradient(180deg,#0e4a73,#082b48);color:#f7fbff;font-size:clamp(8px,1.2vw,13px);font-weight:900;line-height:1.05;padding:2px 4px;box-shadow:0 4px 12px #0007}.extraDock button.goldx{border-color:#d5b351;color:#ffe68d;background:linear-gradient(#684f17,#32260d)}.extraDock button.greenx{border-color:#55b88a;background:linear-gradient(#145d46,#0a392b)}.extraDock button.purplex{border-color:#b574db;background:linear-gradient(#572272,#2d103e)}
.legacyPack{margin:10px 0;border:1px solid #345d78;border-radius:13px;overflow:hidden}.legacyPack h4{margin:0;padding:8px 10px;background:#0b3654;color:#ffe58a}.legacyPack table{width:100%;border-collapse:collapse;font-size:12px}.legacyPack td,.legacyPack th{padding:7px;border-bottom:1px solid #234f6b;text-align:left}.legacyPack th{color:#bcd4e3}.catTabs{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:10px 0}.catTabs button{border:1px solid #477aa0;background:#0b3555;color:#fff;border-radius:12px;padding:10px 6px;font-weight:900}.catTabs button.active{border-color:#d7b852;color:#ffe58a;background:#5a4616}.historyWarn{border:1px solid #b37a3a;background:#3a2b12;border-radius:12px;padding:9px;color:#ffe0a1}.musicRange{width:100%;accent-color:#d5b351}
@media(max-width:640px){.homeRoundLabel{left:15%;width:21%;padding:3px 5px}.roundCtlBtn{left:15%;width:21%}.extraDock{gap:3px}.extraDock button{border-radius:9px;font-size:9px}.catTabs{grid-template-columns:1fr}.legacyPack table{font-size:10px}}


/* ===== STAGE4.58 TOP CLEAN ===== */
/* 최상단 우측 구형 공지사항/설정 바로가기는 홈에서 완전 제거. 하단 기능은 유지. */
.heroHot.notice,.heroHot.settings{display:none!important;pointer-events:none!important}

/* ===== STAGE4 CLEAN HOME ===== */
body{background:#001425;overflow-x:hidden}
#wrap{max-width:1024px;margin:0 auto;background:linear-gradient(180deg,#04182d 0%,#031629 48%,#001323 100%);min-height:100vh;padding-bottom:20px}
.hero{position:relative;width:100%;overflow:hidden;background:#05203a}.hero img{display:block;width:100%;height:auto}.heroHot{position:absolute;border:0;background:transparent;cursor:pointer}.heroHot.notice{right:10.5%;top:2.0%;width:16%;height:11%}.heroHot.settings{right:1.8%;top:2.0%;width:9%;height:11%}
.homeBody{padding:14px 18px 18px}
.homeMenu{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:2px}.homeMenuBtn{height:72px;min-height:72px;border-radius:18px;border:1px solid #1b83c4;background:linear-gradient(180deg,#0c456d 0%,#062944 100%);box-shadow:inset 0 0 0 1px #0b3856,0 8px 18px #0008;color:#fff;display:flex;align-items:center;justify-content:center;gap:8px;padding:9px 7px;text-align:center;font-weight:900;font-size:17px}.homeMenuBtn .ico{font-size:25px;color:#ffe58a;line-height:1}.homeMenuBtn small{display:block;font-size:11px;font-weight:650;color:#c9d9e5;margin-top:3px}.homeMenuBtn:hover,.homeMenuBtn:active{filter:brightness(1.08)}
.homePanel{margin-top:12px;border:1px solid #17699a;border-radius:18px;background:linear-gradient(180deg,#062b49e8,#031d34f5);box-shadow:0 10px 24px #0008;padding:13px}.homePanelTitle{text-align:center;color:#ffe58a;font-weight:950;font-size:18px;margin-bottom:9px}.roundProgress{display:grid;grid-template-columns:210px 1fr;gap:14px;align-items:center}.roundBox{border:1px solid #b99a43;border-radius:15px;background:#092b46;padding:11px;text-align:center}.roundBox strong{display:block;color:#ffe58a;font-size:22px}.roundBox span{display:block;color:#c8d8e4;font-size:12px;margin-top:2px}.roundControls{display:grid;grid-template-columns:1fr 1.35fr 1fr;gap:6px;margin-top:8px}.miniBtn{height:34px;border-radius:999px;border:1px solid #4c7c9c;background:#0a3757;color:#fff;font-weight:850;font-size:12px}.miniBtn.gold{border-color:#d1ad48;color:#ffe58a;background:#58420f}.roundDirectInput{height:34px!important;margin:0!important;padding:4px 8px!important;border-radius:999px!important;border:1px solid #d1ad48!important;background:linear-gradient(#795914,#4a3509)!important;color:#fff3ad!important;text-align:center!important;font-weight:950!important;font-size:14px!important;box-shadow:inset 0 0 0 1px #ffffff12}.noticePinned{border:1px solid #d5b351;border-radius:16px;background:linear-gradient(180deg,#173b58,#0a263d);padding:14px;margin-bottom:12px;box-shadow:0 0 18px #d6ae3d26}.noticePinned h3{margin:0 0 8px!important;color:#ffe58a!important;text-align:center}.noticePinned .noticeBody{line-height:1.7;color:#e5f2fb}.progressSteps{display:grid;grid-template-columns:repeat(5,1fr);gap:5px}.step{text-align:center;color:#b6c9d6;font-size:11px}.step i{width:38px;height:38px;border-radius:50%;border:2px solid #58768e;background:#183145;display:grid;place-items:center;margin:0 auto 5px;font-style:normal;font-size:16px}.step.on{color:#fff}.step.on i{border-color:#20c8ff;background:#0665a3;box-shadow:0 0 15px #16bfff}.step.done i{border-color:#65cfa2;background:#145b47}.analyzeStart{margin-top:9px;width:100%;height:42px;border-radius:14px;border:1px solid #e0b74d;background:linear-gradient(#8b6818,#483407);color:#fff3ad;font-size:15px;font-weight:950;box-shadow:0 0 15px #d6a42355}
.workGrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.workCard{border:1px solid #1b6d9b;border-radius:16px;background:#041e35;padding:12px}.workCard h3{text-align:center;margin:0 0 9px;color:#ffe58a;font-size:17px}.rawQuick{display:grid;grid-template-columns:1fr 120px;gap:7px}.rawQuick input{height:40px;margin:0}.wideRow{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:7px}.homeAction{height:42px;border:1px solid #2c87bd;border-radius:12px;background:linear-gradient(#12517b,#082e4b);color:#fff;font-weight:850}.approvalStat{height:40px;border:1px dashed #2d6f97;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#cfe1ee;margin:6px 0}.approvalCounts{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:7px}.approvalCounts button{border:0;border-radius:10px;background:#0a3555;padding:7px;text-align:center;font-size:11px;color:#c5d8e6;font-family:inherit;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent}.approvalCounts b{display:block;color:#ffe58a;font-size:17px}.approvalQuick{cursor:pointer;user-select:none;transition:filter .12s,transform .12s}.approvalQuick:active{filter:brightness(1.18);transform:scale(.985)}
.primaryActions{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}.primaryAction{height:72px;border-radius:18px;color:#fff;font-weight:950;font-size:18px;border:1px solid;box-shadow:0 7px 18px #0008}.primaryAction small{display:block;font-size:11px;font-weight:650;margin-top:4px}.primaryAction.green{border-color:#26e56d;background:linear-gradient(#078839,#024c25);box-shadow:0 0 15px #00ff5550}.primaryAction.purple{border-color:#e161ff;background:linear-gradient(#8016a7,#41075c);box-shadow:0 0 15px #c900ff55}.primaryAction.gold{border-color:#ffd45d;background:linear-gradient(#9d6e04,#503300);box-shadow:0 0 15px #ffbf2055}
.auxActions{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:9px}.auxAction{height:40px;border-radius:12px;border:1px solid #3b78a1;background:#0a3556;color:#fff;font-weight:850;font-size:12px}.auxAction.gold{border-color:#c9a64b;background:#5a4211;color:#ffe894}.auxAction.green{border-color:#5bb88f;background:#13543f}.auxAction.purple{border-color:#c15be0;background:#5a1b73}
.homeFooter{display:grid;grid-template-columns:1fr 220px;gap:12px;align-items:center;margin-top:12px;padding:12px;border-top:1px solid #275674}.homeFooterQuote{text-align:center;color:#c9dae6;font-size:13px;line-height:1.6}.exitHome{height:56px;border-radius:28px;border:1px solid #ff4b57;background:linear-gradient(#e2142b,#81020e);color:#fff;font-weight:950;font-size:20px;box-shadow:0 0 16px #ff243c55}
.hiddenEngine{position:fixed;left:-9999px;top:-9999px;width:2px;height:2px;opacity:0;pointer-events:none;border:0}
/* Modal / result polish */
.card{position:relative;max-width:920px}.card h2{text-align:center!important;padding:0 70px;margin-bottom:12px}.card h3{text-align:center}.close{position:absolute;right:14px;top:14px;float:none}.screenTitle{text-align:center;color:#ffe58a;font-size:20px;font-weight:950;margin:4px 0 12px}.centerTitle{text-align:center!important}.scoreHero{border:1px solid #d5af4c;border-radius:18px;background:linear-gradient(#57101f,#2a0610);padding:14px;text-align:center;color:#ffe98b;margin-bottom:12px;box-shadow:0 0 18px #b71c4066}.scoreHero.success{background:linear-gradient(#5d0b24,#2b0612)}.scoreHero.fail{background:linear-gradient(#173954,#0c253b);border-color:#4a89ae;color:#dceef9}.scoreHero strong{display:block;font-size:24px}.scoreHero span{display:block;margin-top:5px;font-size:14px}.scoreSummary{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.scoreRoundList{margin-top:9px;border:1px solid #315b76;border-radius:12px;overflow:hidden}.scoreRoundRow{display:grid;grid-template-columns:100px 1fr 60px;padding:7px 10px;border-bottom:1px solid #23455d;font-size:12px;align-items:center}.scoreRoundRow:last-child{border-bottom:0}.scoreRoundRow b{color:#ffe58a}.packGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.scorePack{border:1px solid #2f6e95;border-radius:15px;overflow:hidden;background:#032038}.scorePack h4{text-align:center;margin:0;padding:9px;background:#0b4667;color:#ffe58a}.scoreGame{display:grid;grid-template-columns:24px 1fr 42px 46px;align-items:center;gap:6px;padding:7px 8px;border-bottom:1px solid #234b64}.scoreGame:last-child{border-bottom:0}.scoreBalls{display:flex;gap:5px;flex-wrap:wrap}.scoreBall{width:30px;height:30px;border-radius:50%;display:inline-grid;place-items:center;border:1px solid #5085a5;background:#0b3855;color:#fff;font-weight:900;font-size:12px}.scoreBall.hit{background:radial-gradient(circle at 35% 30%,#ff7380,#e4142c 58%,#7d0512);border-color:#ff8690;box-shadow:0 0 8px #ff314a}.hitCount{text-align:center;font-weight:950}.rankBadge{text-align:center;border-radius:9px;padding:4px 2px;background:#0c4869;font-size:11px;font-weight:900}.rankBadge.win{background:#9b1a1a;color:#ffe889;border:1px solid #dd8d38}.resultInputToggle{margin-top:10px;text-align:center}.resultInputBox{display:none}.resultInputBox.open{display:block}.fanfareOverlay{display:none;position:fixed;inset:0;z-index:500;background:radial-gradient(circle at center,rgba(80,0,35,.42),rgba(0,0,0,.72));align-items:center;justify-content:center;overflow:hidden}.fanfareOverlay.show{display:flex}.fanfareCard{position:relative;z-index:3;min-width:330px;max-width:84vw;border:2px solid #ffd768;border-radius:24px;background:linear-gradient(180deg,#7c0e31,#360713);padding:24px 28px;text-align:center;color:#ffec8f;box-shadow:0 0 24px #ffcf4f99,0 0 70px #ff6b2f66;animation:fanfarePop .55s ease-out}.fanfareCard strong{display:block;font-size:30px;text-shadow:0 2px 8px #000}.fanfareCard span{display:block;margin-top:9px;color:#fff3c5;font-size:16px;line-height:1.5}.fanfareCard em{display:block;margin-top:10px;color:#fff;font-style:normal;font-weight:900}.comfortOverlay{display:none;position:fixed;inset:0;z-index:501;background:rgba(0,16,30,.72);align-items:center;justify-content:center}.comfortOverlay.show{display:flex}.comfortCard{min-width:330px;max-width:84vw;border:2px solid #77bde8;border-radius:24px;background:linear-gradient(180deg,#16466a,#0b263e);padding:24px 28px;text-align:center;color:#e5f5ff;box-shadow:0 0 26px #5bb9ee66}.comfortCard strong{display:block;font-size:27px;color:#ffe58a}.comfortCard span{display:block;margin-top:10px;line-height:1.55;font-size:16px}.comfortCard em{display:block;margin-top:12px;color:#9fe3ff;font-style:normal;font-weight:900}.confetti{position:absolute;top:-12vh;font-size:28px;animation:fall 3.5s linear forwards;filter:drop-shadow(0 0 5px rgba(255,255,255,.55))}.fireworkBurst{position:absolute;z-index:1;width:12px;height:12px;border-radius:50%;background:#fff4a0;box-shadow:0 -52px 0 #ffdf4a,37px -37px 0 #ff5c7a,52px 0 0 #72d8ff,37px 37px 0 #c483ff,0 52px 0 #6dffae,-37px 37px 0 #ff9f43,-52px 0 0 #ffef71,-37px -37px 0 #60f5ff;opacity:0;animation:burst 1.25s ease-out forwards}.fanfareSpark{position:absolute;z-index:1;font-size:36px;animation:sparkPulse 1s ease-in-out infinite alternate}@keyframes fanfarePop{0%{transform:scale(.65);opacity:0}75%{transform:scale(1.06)}100%{transform:scale(1);opacity:1}}@keyframes burst{0%{transform:scale(.1);opacity:0}20%{opacity:1}100%{transform:scale(1.45);opacity:0}}@keyframes sparkPulse{from{transform:scale(.8) rotate(-8deg);opacity:.65}to{transform:scale(1.2) rotate(8deg);opacity:1}}@keyframes fall{to{transform:translateY(125vh) rotate(900deg);opacity:.12}}
@media(max-width:760px){.homeBody{padding:10px}.homeMenu{grid-template-columns:repeat(3,1fr)}.homeMenuBtn{height:64px;min-height:64px;font-size:14px}.roundProgress{grid-template-columns:1fr}.workGrid{grid-template-columns:1fr}.primaryAction{height:62px;font-size:15px}.auxActions{grid-template-columns:repeat(2,1fr)}.homeFooter{grid-template-columns:1fr}.scoreSummary{grid-template-columns:repeat(2,1fr)}.packGrid{grid-template-columns:1fr}.scoreRoundRow{grid-template-columns:80px 1fr 50px}}


/* ===== STAGE4.10 CLEAN BUILD ID / HOME POLISH ===== */
.homeBuildBadge{position:absolute;right:16px;bottom:10px;z-index:9;padding:6px 12px;border:1px solid #d7b64f;border-radius:999px;background:#062b46e8;color:#ffe58a;font-size:11px;font-weight:900;letter-spacing:.3px;box-shadow:0 0 12px #0008}
.homePanel{border-color:#2a7eb0;box-shadow:0 8px 22px #0008,inset 0 0 0 1px #ffffff08}.homePanelTitle{letter-spacing:.2px}
.roundBox{box-shadow:inset 0 0 0 1px #ffffff08}.roundDirectInput{cursor:text}
.workCard{box-shadow:inset 0 0 0 1px #ffffff06}.auxAction,.homeAction,.primaryAction,.homeMenuBtn{transition:transform .08s ease,filter .08s ease}.auxAction:active,.homeAction:active,.primaryAction:active,.homeMenuBtn:active{transform:scale(.985)}
@media(max-width:760px){
  .homeBody{padding:10px 12px 16px}
  .homeMenu{grid-template-columns:repeat(6,1fr);gap:8px}
  .homeMenuBtn{height:58px;min-height:58px;border-radius:15px;font-size:13px;padding:6px 5px}
  .homeMenuBtn .ico{font-size:20px}.homeMenuBtn small{font-size:10px;margin-top:2px}
  .homeMenuBtn:nth-child(1),.homeMenuBtn:nth-child(2),.homeMenuBtn:nth-child(3){grid-column:span 2}
  .homeMenuBtn:nth-child(4){grid-column:2/span 2}.homeMenuBtn:nth-child(5){grid-column:4/span 2}
  .homePanel{margin-top:10px;padding:11px}.homePanelTitle{font-size:17px;margin-bottom:8px}
  .roundBox{padding:10px}.roundBox strong{font-size:21px}.roundControls{gap:7px}.miniBtn,.roundDirectInput{height:38px!important}
  .analyzeStart{height:44px}.primaryAction{height:58px;font-size:15px;border-radius:15px}.primaryAction small{font-size:10px}
  .auxAction{height:42px}.exitHome{height:54px}.homeBuildBadge{right:10px;bottom:8px;font-size:9px;padding:5px 9px}
}


/* ===== STAGE4.8 HOME ONE-SCREEN FIT ===== */
/* 홈 기능은 그대로 두고 태블릿 세로화면에서 스크롤 없이 핵심 기능이 한눈에 보이도록 압축 */
.homeBody{padding:8px 12px 10px}
.homeMenu{gap:7px;margin-top:0}
.homeMenuBtn{height:56px;min-height:56px;border-radius:14px;padding:5px 4px;font-size:14px;gap:5px}
.homeMenuBtn .ico{font-size:20px}.homeMenuBtn small{font-size:9px;margin-top:1px}
.homePanel{margin-top:8px;padding:8px 10px;border-radius:15px}
.homePanelTitle{font-size:16px;margin-bottom:6px}
.roundProgress{grid-template-columns:175px 1fr;gap:10px}
.roundBox{padding:7px 8px;border-radius:12px}.roundBox strong{font-size:19px}.roundBox span{font-size:10px;margin-top:0}
.roundControls{gap:5px;margin-top:5px}.miniBtn,.roundDirectInput{height:30px!important;font-size:11px!important}.roundDirectInput{padding:2px 6px!important}
.progressSteps{gap:3px}.step{font-size:9px}.step i{width:30px;height:30px;margin-bottom:2px;font-size:13px;border-width:1.5px}.step b{font-size:9px}
.analyzeStart{height:34px;margin-top:5px;border-radius:11px;font-size:12px}
.workGrid{grid-template-columns:1fr 1fr;gap:8px}.workCard{padding:8px 9px;border-radius:13px}.workCard h3{font-size:14px;margin:0 0 4px}.workCard .small{font-size:10px!important;margin-bottom:4px!important}
.rawQuick{grid-template-columns:1fr 96px;gap:5px}.rawQuick input{height:32px!important;padding:5px 8px!important}.wideRow{gap:5px;margin-top:5px}.homeAction{height:32px;border-radius:9px;font-size:11px}
.approvalStat{height:30px;margin:3px 0;font-size:11px}.approvalCounts{gap:4px;margin-top:4px}.approvalCounts button{padding:4px;font-size:9px}.approvalCounts b{font-size:13px}
.primaryActions{gap:7px;margin-top:8px}.primaryAction{height:52px;border-radius:14px;font-size:14px}.primaryAction small{font-size:9px;margin-top:1px}
.auxActions{gap:5px;margin-top:6px}.auxAction{height:32px;border-radius:9px;font-size:10px}
.homeFooter{grid-template-columns:1fr 165px;gap:8px;margin-top:7px;padding:7px 8px}.homeFooterQuote{font-size:10px;line-height:1.35}.exitHome{height:42px;border-radius:22px;font-size:15px}
.homeBuildBadge{right:12px;bottom:8px;font-size:9px;padding:4px 8px}

/* Galaxy Tab 계열의 세로 WebView 폭에서도 5개 메뉴/2열 작업카드를 유지 */
@media (min-width:600px) and (max-width:900px){
  .homeBody{padding:8px 10px 10px}
  .homeMenu{grid-template-columns:repeat(5,1fr);gap:6px}
  .homeMenuBtn:nth-child(n){grid-column:auto}
  .homeMenuBtn{height:54px;min-height:54px;font-size:12px;border-radius:13px}
  .homeMenuBtn .ico{font-size:18px}.homeMenuBtn small{font-size:8px}
  .roundProgress{grid-template-columns:165px 1fr;gap:8px}
  .workGrid{grid-template-columns:1fr 1fr;gap:7px}
  .homeFooter{grid-template-columns:1fr 150px}
  .primaryAction{height:48px;font-size:13px}.auxAction{height:30px;font-size:9.5px}
}

/* 작은 휴대폰만 세로 스택 허용 */
@media (max-width:599px){
  .homeMenu{grid-template-columns:repeat(2,1fr)}
  .homeMenuBtn:nth-child(n){grid-column:auto}
  .roundProgress,.workGrid{grid-template-columns:1fr}
  .homeFooter{grid-template-columns:1fr}
}



/* ===== STAGE4.11 HOME FINAL ===== */
/* 승인된 홈 배치: 이전회차 · 현재회차 · 다음회차 / RAW 회차 중앙 / 불러오기 제거 */
.roundProgress{display:block!important}
.roundBox{display:none!important}
.progressSteps{margin-bottom:6px}
.roundControls{display:grid!important;grid-template-columns:1fr 160px 1fr!important;gap:8px!important;margin:0!important}
.miniBtn{height:38px!important;border-radius:12px!important;font-size:13px!important;font-weight:900!important}
.roundDirectInput{height:38px!important;border-radius:12px!important;font-size:20px!important;line-height:1!important;padding:3px 8px!important}
.analyzeStart{height:40px!important;margin-top:7px!important}
.rawQuick{display:block!important}
.rawQuick input{display:block!important;width:72%!important;max-width:330px!important;height:38px!important;margin:0 auto!important;text-align:center!important;font-size:18px!important;font-weight:900!important}
/* 하단 기능 버튼은 같은 높이와 간격으로 정리 */
.primaryActions{gap:7px!important;margin-top:8px!important}
.primaryAction,.auxAction{height:50px!important;min-height:50px!important;border-radius:12px!important;font-size:13px!important;line-height:1.1!important}
.primaryAction small{font-size:9px!important;margin-top:2px!important}
.auxActions{grid-template-columns:repeat(2,1fr)!important;grid-template-rows:repeat(3,50px)!important;gap:6px!important;margin-top:6px!important}
.auxAction{font-size:12px!important}
/* 종료버튼 최하단, 문구는 종료 아래 */
.homeFooter{display:flex!important;flex-direction:column!important;align-items:center!important;gap:8px!important;margin-top:7px!important;padding:7px 8px 12px!important;border-top:1px solid #275674!important}
.exitHome{width:52%!important;max-width:520px!important;height:50px!important;border-radius:14px!important;font-size:18px!important;order:1}
.homeFooterQuote{order:2!important;text-align:center!important;line-height:1.35!important;margin-top:2px!important}
.homeFooterQuote span{font-family:'Nanum Pen Script','Gaegu','Noto Serif KR',cursive!important;color:#f8d766!important;font-size:18px!important;font-weight:700!important;letter-spacing:.2px!important}
.homeFooterQuote small{font-family:'Noto Serif KR',serif!important;color:#d8e5ee!important;font-size:11px!important}
@media (min-width:600px) and (max-width:900px){
  .roundControls{grid-template-columns:1fr 145px 1fr!important}
  .miniBtn{height:34px!important;font-size:12px!important}.roundDirectInput{height:34px!important;font-size:18px!important}
  .analyzeStart{height:36px!important}.rawQuick input{height:34px!important;font-size:17px!important}
  .primaryAction,.auxAction{height:44px!important;min-height:44px!important}.auxActions{grid-template-rows:repeat(3,44px)!important}
  .exitHome{height:46px!important}.homeFooterQuote span{font-size:16px!important}.homeFooterQuote small{font-size:10px!important}
}
@media (max-width:599px){
  .roundControls{grid-template-columns:1fr 110px 1fr!important}
  .rawQuick input{width:100%!important}
  .primaryActions{grid-template-columns:1fr!important}
  .auxActions{grid-template-columns:1fr!important;grid-template-rows:none!important}
  .exitHome{width:88%!important}
}

/* STAGE4.24 HOME FINAL: 우측 목표 화면 하단 고정 */
.homeFooter{position:relative!important;display:flex!important;flex-direction:column!important;align-items:center!important;gap:7px!important;margin-top:7px!important;padding:7px 140px 10px!important;border-top:1px solid #275674!important;min-height:112px!important}
.exitHome{order:1!important;width:52%!important;max-width:520px!important;height:50px!important;border-radius:14px!important;font-size:18px!important}
.homeFooterQuote{order:2!important;position:relative!important;text-align:center!important;line-height:1.30!important;margin-top:2px!important;min-width:360px!important}
.homeFooterQuote:before{content:'☙';display:inline-block;margin-right:12px;color:#d9b64b;font-size:25px;vertical-align:middle}
.homeFooterQuote:after{content:'❧';display:inline-block;margin-left:12px;color:#d9b64b;font-size:25px;vertical-align:middle}
.homeFooterQuote span{font-family:'Nanum Pen Script','Gaegu','Noto Serif KR',cursive!important;color:#f8d766!important;font-size:20px!important;font-weight:700!important;letter-spacing:.25px!important}
.homeFooterQuote small{font-family:'Noto Serif KR','Batang',serif!important;color:#d8e5ee!important;font-size:11px!important}
.homeBuildBadge{position:absolute!important;right:10px!important;bottom:12px!important;top:auto!important;left:auto!important;z-index:3!important;padding:6px 11px!important;border:1px solid #d7b64f!important;border-radius:999px!important;background:#062b46e8!important;color:#ffe58a!important;font-size:11px!important;font-weight:900!important;letter-spacing:.35px!important;box-shadow:0 0 12px #0008!important}
@media (min-width:600px) and (max-width:900px){.homeFooter{padding:7px 122px 9px!important;min-height:100px!important}.exitHome{height:46px!important}.homeFooterQuote{min-width:310px!important}.homeFooterQuote span{font-size:17px!important}.homeFooterQuote small{font-size:10px!important}.homeBuildBadge{font-size:10px!important;right:8px!important;bottom:9px!important}}
@media (max-width:599px){.homeFooter{padding:7px 8px 44px!important}.exitHome{width:88%!important}.homeFooterQuote{min-width:0!important}.homeFooterQuote span{font-size:16px!important}.homeBuildBadge{right:8px!important;bottom:6px!important;font-size:9px!important}}



/* ===== STAGE4.26 TWO SCREEN COMPACT =====
   HOME FINAL은 잠금. 원문분석/성적보기 두 화면만 태블릿 한눈보기로 압축. */
.rawCompact .panel{margin:6px 0!important;padding:8px 10px!important;border-radius:13px!important}
.rawCompact .panel.goldline{padding:8px 10px!important}
.rawCompact .grid2{gap:6px!important}
.rawCompact h3{margin:6px 0 5px!important;font-size:17px!important}
.rawCompact .label{margin:4px 0 2px!important;font-size:12px!important}
.rawCompact .small{font-size:11px!important}
.rawCompact input{padding:7px 9px!important;margin:2px 0!important;height:34px!important}
.rawCompact textarea{padding:8px 10px!important;margin:2px 0!important;resize:none!important;min-height:0!important}
.rawCompact #rawText{height:170px!important}
.rawCompact #rawMemo{height:92px!important}
.rawCompact .row{gap:6px!important}
.rawCompact .b{padding:7px 10px!important;border-radius:14px!important;font-size:12px!important}
.rawCompact .panel.centerTitle{padding:7px 8px!important;margin-bottom:0!important}
.rawCompact .panel.centerTitle .b{min-width:170px!important;font-size:14px!important}
.rawCompact + *{margin-top:0!important}

.scoreCompact .scoreHero{padding:8px 10px!important;margin-bottom:6px!important;border-radius:14px!important}
.scoreCompact .scoreHero strong{font-size:20px!important}
.scoreCompact .scoreHero span{font-size:12px!important;margin-top:3px!important}
.scoreCompact .screenTitle{font-size:17px!important;margin:3px 0 6px!important}
.scoreCompact .scoreSummary{grid-template-columns:repeat(5,1fr)!important;gap:4px!important}
.scoreCompact .scoreSummary .stat{padding:6px 4px!important;border-radius:9px!important}
.scoreCompact .scoreSummary .stat strong{font-size:17px!important}
.scoreCompact .scoreSummary .stat span{font-size:10px!important}
.scoreCompact .scoreRoundList{margin-top:5px!important;max-height:210px!important;overflow:auto!important}
.scoreCompact .scoreRoundRow{grid-template-columns:82px 1fr 44px!important;padding:4px 7px!important;font-size:10px!important}
.scoreCompact .resultInputToggle{margin-top:6px!important}
.scoreCompact .resultInputToggle .b{padding:7px 10px!important;font-size:11px!important}
.scoreCompact .resultInputBox{padding:7px!important;margin:6px 0!important}
.scoreCompact .resultInputBox textarea{min-height:52px!important;height:52px!important}
.scoreCompact .packGrid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px!important;margin-top:6px!important}
/* STAGE4.54: 성적 바로보기는 팝업이 아니라 한 화면 전체 카드로 표시 */
.modal.scoreOneScreen{padding:4px!important;overflow:hidden!important;background:#001326!important}
.modal.scoreOneScreen>.card{width:min(960px,calc(100vw - 8px))!important;max-width:960px!important;height:calc(100dvh - 8px)!important;min-height:calc(100vh - 8px)!important;margin:0 auto!important;padding:10px 14px 12px!important;border-radius:18px!important;display:flex!important;flex-direction:column!important;overflow:hidden!important}
.modal.scoreOneScreen>.card>h2{flex:0 0 auto!important;margin:0 0 5px!important;font-size:23px!important;line-height:1.2!important}
.modal.scoreOneScreen>.card>.close{top:9px!important;right:11px!important;padding:7px 12px!important}
.modal.scoreOneScreen #mc{flex:1 1 auto!important;min-height:0!important;overflow:hidden!important}
.modal.scoreOneScreen .scoreCompact{height:100%!important;min-height:0!important;display:flex!important;flex-direction:column!important;overflow:hidden!important}
.modal.scoreOneScreen .scoreCompact .scoreHero{flex:0 0 auto!important}
.modal.scoreOneScreen .scoreCompact .screenTitle{flex:0 0 auto!important}
.modal.scoreOneScreen .scoreCompact .scoreSummary{flex:0 0 auto!important}
.modal.scoreOneScreen .scoreCompact .scoreRoundList{flex:0 0 auto!important;max-height:104px!important;overflow:auto!important}
.modal.scoreOneScreen .scoreCompact .resultInputToggle{flex:0 0 auto!important}
.modal.scoreOneScreen .scoreCompact .resultInputBox{flex:0 0 auto!important}
.modal.scoreOneScreen .scoreCompact .packGrid{flex:1 1 auto!important;min-height:0!important;align-content:start!important;overflow:hidden!important}
.modal.scoreOneScreen .scorePack{border-radius:10px!important}
.modal.scoreOneScreen .scorePack h4{padding:5px 6px!important;font-size:13px!important;line-height:1.15!important}
.modal.scoreOneScreen .scoreGame{grid-template-columns:18px minmax(0,1fr) 31px 38px!important;gap:3px!important;padding:3px 5px!important;min-height:29px!important}
.modal.scoreOneScreen .scoreBalls{gap:3px!important;flex-wrap:nowrap!important}
.modal.scoreOneScreen .scoreBall{width:23px!important;height:23px!important;flex:0 0 23px!important;font-size:10px!important}
.modal.scoreOneScreen .hitCount{font-size:10px!important}
.modal.scoreOneScreen .rankBadge{font-size:9px!important;padding:3px 1px!important;border-radius:7px!important}
@media(max-width:760px){
 .modal.scoreOneScreen>.card{padding:8px 8px 9px!important}
 .modal.scoreOneScreen>.card>h2{font-size:19px!important;padding:0 58px!important}
 .modal.scoreOneScreen .scoreCompact .scoreHero{padding:5px 7px!important;margin-bottom:4px!important}
 .modal.scoreOneScreen .scoreCompact .scoreHero strong{font-size:16px!important}
 .modal.scoreOneScreen .scoreCompact .scoreHero span{font-size:10px!important;line-height:1.25!important}
 .modal.scoreOneScreen .scoreCompact .screenTitle{font-size:14px!important;margin:2px 0 4px!important}
 .modal.scoreOneScreen .scoreCompact .scoreSummary{grid-template-columns:repeat(5,1fr)!important;gap:3px!important}
 .modal.scoreOneScreen .scoreCompact .scoreSummary .stat{padding:4px 2px!important}
 .modal.scoreOneScreen .scoreCompact .scoreSummary .stat strong{font-size:14px!important}
 .modal.scoreOneScreen .scoreCompact .scoreSummary .stat span{font-size:8px!important}
 .modal.scoreOneScreen .scoreCompact .scoreRoundList{max-height:90px!important}
 .modal.scoreOneScreen .scoreCompact .scoreRoundRow{grid-template-columns:68px 1fr 34px!important;padding:3px 5px!important;font-size:8.5px!important}
 .modal.scoreOneScreen .scoreCompact .resultInputToggle{margin-top:4px!important}
 .modal.scoreOneScreen .scoreCompact .resultInputToggle .b{padding:5px 7px!important;font-size:9px!important}
 .modal.scoreOneScreen .scoreCompact .packGrid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:4px!important;margin-top:4px!important}
 .modal.scoreOneScreen .scorePack h4{font-size:11px!important;padding:4px!important}
 .modal.scoreOneScreen .scoreGame{grid-template-columns:13px minmax(0,1fr) 25px 31px!important;padding:2px 3px!important;gap:2px!important;min-height:25px!important}
 .modal.scoreOneScreen .scoreBall{width:19px!important;height:19px!important;flex-basis:19px!important;font-size:8px!important}
 .modal.scoreOneScreen .hitCount{font-size:8px!important}
 .modal.scoreOneScreen .rankBadge{font-size:7.5px!important;padding:2px 0!important}
}
.analysisCompact .scoreHero{padding:8px 10px!important;margin-bottom:6px!important;border-radius:13px!important}
.analysisCompact .scoreHero strong{font-size:19px!important}
.analysisCompact .scoreHero span{font-size:11px!important;margin-top:2px!important}
.analysisCompact .candidatePanel{padding:7px 10px!important;margin-bottom:6px!important}
.analysisCompact .candidatePanel h3{font-size:15px!important;margin:0 0 5px!important}
.analysisCompact .candidatePanel .scoreBall{width:25px!important;height:25px!important;flex-basis:25px!important;font-size:10px!important}
.analysisCompact .packGrid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px!important}
.analysisCompact .scorePack{border-radius:11px!important}
.analysisCompact .scorePack h4{padding:5px 6px!important;font-size:13px!important}
.analysisCompact .scoreGame{grid-template-columns:16px minmax(0,1fr)!important;gap:3px!important;padding:3px 5px!important;min-height:30px!important}
.analysisCompact .scoreGame>b{font-size:11px!important}
.analysisCompact .scoreBalls{gap:3px!important;flex-wrap:nowrap!important}
.analysisCompact .scoreBall{width:23px!important;height:23px!important;flex:0 0 23px!important;font-size:10px!important}
.analysisCompact .analysisBottom{padding:7px!important;margin-top:6px!important}
.analysisCompact .analysisBottom .b{padding:8px 10px!important;font-size:12px!important}
@media(max-width:760px){
 .analysisCompact .packGrid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
 .analysisCompact .scoreBall{width:21px!important;height:21px!important;flex-basis:21px!important;font-size:9px!important}
 .analysisCompact .scoreGame{grid-template-columns:14px minmax(0,1fr)!important;padding:2px 3px!important;gap:2px!important}
 .analysisCompact .scorePack h4{font-size:12px!important;padding:4px!important}
}

.scoreCompact .scorePack{border-radius:11px!important}
.scoreCompact .scorePack h4{padding:5px 6px!important;font-size:13px!important}
.scoreCompact .scoreGame{grid-template-columns:18px minmax(0,1fr) 31px 36px!important;gap:3px!important;padding:3px 5px!important;min-height:31px!important}
.scoreCompact .scoreGame>b{font-size:11px!important}
.scoreCompact .scoreBalls{gap:3px!important;flex-wrap:nowrap!important}
.scoreCompact .scoreBall{width:23px!important;height:23px!important;font-size:10px!important;flex:0 0 23px!important}
.scoreCompact .hitCount{font-size:10px!important}
.scoreCompact .rankBadge{font-size:9px!important;padding:2px 1px!important;border-radius:7px!important}
@media(max-width:760px){
 .scoreCompact .scoreSummary{grid-template-columns:repeat(5,1fr)!important}
 .scoreCompact .packGrid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
 .scoreCompact .scoreBall{width:21px!important;height:21px!important;flex-basis:21px!important;font-size:9px!important}
 .scoreCompact .scoreGame{grid-template-columns:15px minmax(0,1fr) 28px 32px!important;padding:2px 3px!important;gap:2px!important}
 .scoreCompact .scorePack h4{font-size:12px!important;padding:4px!important}
 .rawCompact #rawText{height:155px!important}
 .rawCompact #rawMemo{height:82px!important}
}


/* ===== STAGE4.47 REAL 20-SECOND VOYAGE ANIMATION · NO ON-SCREEN TEXT ===== */
.launchVoyage{position:fixed;inset:0;z-index:9999;overflow:hidden;background:#001427;opacity:1;transition:opacity .8s ease;touch-action:manipulation}
.launchVoyage.hide{opacity:0;pointer-events:none}
.launchShipScene{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center center;background:#001427}
.launchVignette{position:absolute;inset:0;box-shadow:inset 0 0 110px #000b;pointer-events:none}


.approvalQuick.active{background:linear-gradient(180deg,#8a6b16,#4b3508)!important;border:1px solid #e0c15d!important;box-shadow:0 0 12px rgba(255,216,90,.34);color:#fff7c4!important}.approvalQuick.active b{color:#fff3a7}.captainApprovalBtn{width:100%;margin-top:7px;height:36px!important;font-size:12px}.captainApprovalBtn span{display:inline-block;margin-left:6px;color:#ffe58a;font-weight:950}.serverApprovalItem{border:1px solid #2b6e98;border-radius:13px;background:#031d33;padding:10px;margin:8px 0}.serverApprovalItem.pending{border-color:#d1a844;background:#302609}.serverApprovalTop{display:flex;justify-content:space-between;gap:8px;align-items:center}.serverApprovalTop b{color:#ffe58a}.serverApprovalMeta{font-size:12px;color:#b8cede;line-height:1.55;margin-top:5px}.serverApprovalActions{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px}.modal.scoreModalCompact{background:rgba(0,19,38,.70);backdrop-filter:blur(1px)}.modal.scoreModalCompact .card{margin:0 auto;min-height:calc(100vh - 18px);box-shadow:0 0 30px #000b}.legacyImportSummary{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}@media(max-width:640px){.legacyImportSummary{grid-template-columns:repeat(3,1fr)}.serverApprovalTop{align-items:flex-start;flex-direction:column}}


/* ===== STAGE4.55 FINAL TWO FIXES =====
   1) Galaxy Tab 세로 홈: 상단부터 종료까지 스크롤 없이 한 화면 우선
   2) 성적 바로보기: 4개 조합표가 남은 높이를 끝까지 채움 */
@media (min-width:600px) and (min-height:1100px){
  html,body{height:100%;overflow:hidden!important}
  #wrap{height:100dvh!important;min-height:100dvh!important;overflow:hidden!important;padding-bottom:0!important}
  .hero{height:420px!important;min-height:0!important}
  .hero img{width:100%!important;height:100%!important;object-fit:cover!important;object-position:center 53%!important}
  .homeBody{height:calc(100dvh - 420px)!important;min-height:0!important;overflow:hidden!important;padding:5px 10px 6px!important;display:flex!important;flex-direction:column!important}
  .homeMenu{flex:0 0 auto!important;gap:5px!important;margin:0!important}
  .homeMenuBtn{height:47px!important;min-height:47px!important;padding:3px 4px!important;border-radius:11px!important;font-size:11px!important;gap:3px!important}
  .homeMenuBtn .ico{font-size:16px!important}.homeMenuBtn small{font-size:7.5px!important;margin-top:0!important}
  .homePanel{flex:0 0 auto!important;margin-top:5px!important;padding:6px 8px!important;border-radius:12px!important}
  .homePanelTitle{font-size:14px!important;margin-bottom:4px!important}
  .progressSteps{margin-bottom:3px!important;gap:2px!important}.step{font-size:8px!important}.step i{width:25px!important;height:25px!important;margin-bottom:1px!important;font-size:11px!important}.step b{font-size:8px!important}
  .roundControls{grid-template-columns:1fr 145px 1fr!important;gap:5px!important}.miniBtn,.roundDirectInput{height:30px!important;min-height:30px!important;font-size:11px!important}.roundDirectInput{font-size:17px!important}
  .analyzeStart{height:31px!important;margin-top:4px!important;font-size:11px!important;border-radius:9px!important}
  .workGrid{gap:6px!important}.workCard{padding:6px 7px!important;border-radius:11px!important}.workCard h3{font-size:13px!important;margin:0 0 3px!important}.workCard .small{font-size:8.5px!important;margin-bottom:2px!important}
  .rawQuick input{height:29px!important;font-size:15px!important}.wideRow{gap:4px!important;margin-top:4px!important}.homeAction{height:29px!important;min-height:29px!important;font-size:9.5px!important;border-radius:8px!important}
  .approvalStat{height:27px!important;margin:2px 0!important;font-size:9px!important}.approvalCounts{gap:3px!important;margin-top:3px!important}.approvalCounts button{min-height:40px!important;padding:2px!important;font-size:8px!important}.approvalCounts b{font-size:11px!important}
  #v2MigrationHomeStatus{font-size:8px!important;margin-top:2px!important;line-height:1.15!important}
  .primaryActions{flex:0 0 auto!important;gap:5px!important;margin-top:5px!important}.primaryAction{height:40px!important;min-height:40px!important;border-radius:10px!important;font-size:11px!important}.primaryAction small{font-size:7.5px!important;margin-top:0!important}
  .auxActions{flex:0 0 auto!important;grid-template-rows:repeat(3,34px)!important;gap:4px!important;margin-top:4px!important}.auxAction{height:34px!important;min-height:34px!important;border-radius:8px!important;font-size:9px!important}
  .homeFooter{flex:1 1 auto!important;min-height:55px!important;max-height:76px!important;margin-top:4px!important;padding:4px 108px 4px!important;gap:3px!important;justify-content:center!important}
  .exitHome{height:36px!important;min-height:36px!important;width:48%!important;font-size:14px!important;border-radius:11px!important}
  .homeFooterQuote{min-width:260px!important;margin:0!important;line-height:1.12!important}.homeFooterQuote:before,.homeFooterQuote:after{font-size:16px!important;margin:0 6px!important}.homeFooterQuote span{font-size:13px!important}.homeFooterQuote small{font-size:8px!important}
  .homeBuildBadge{font-size:7.5px!important;padding:3px 7px!important;right:6px!important;bottom:5px!important}
}

/* 성적 화면: 4개 조합표가 카드 최하단까지 균등하게 확장 */
.modal.scoreOneScreen .scoreCompact .packGrid{grid-template-rows:repeat(2,minmax(0,1fr))!important;align-items:stretch!important;align-content:stretch!important;height:auto!important}
.modal.scoreOneScreen .scoreCompact .scorePack{height:100%!important;min-height:0!important;display:flex!important;flex-direction:column!important}
.modal.scoreOneScreen .scoreCompact .scorePack h4{flex:0 0 auto!important}
.modal.scoreOneScreen .scoreCompact .scoreGame{flex:1 1 0!important;min-height:0!important;align-content:center!important}
@media (min-width:600px) and (min-height:1100px){
  .modal.scoreOneScreen .scoreCompact .packGrid{gap:6px!important;margin-top:5px!important}
  .modal.scoreOneScreen .scoreCompact .scorePack h4{font-size:13px!important;padding:5px 6px!important}
  .modal.scoreOneScreen .scoreCompact .scoreGame{padding:4px 6px!important;grid-template-columns:18px minmax(0,1fr) 31px 38px!important}
  .modal.scoreOneScreen .scoreCompact .scoreBall{width:25px!important;height:25px!important;flex-basis:25px!important;font-size:10px!important}
}


/* STAGE4.56 배포용: 관리 기능 제거 + 단순 한눈 화면 */
.distributionHome{padding:8px 10px 12px!important}
.distributionMenu{grid-template-columns:repeat(4,1fr)!important;gap:7px!important;margin-bottom:8px!important}
.distributionMenu .homeMenuBtn{min-height:62px!important;padding:7px!important;font-size:14px!important}
.distributionMenu .homeMenuBtn .ico{font-size:20px!important}
.distributionRoundPanel,.distributionApproval{margin-top:8px!important;padding:10px 12px!important}
.distributionRoundPanel .roundProgress{padding:4px 0!important}
.distributionRoundPanel .roundControls{margin-top:3px!important}
.distributionRoundPanel .analyzeStart{margin-top:7px!important;height:42px!important}
.distributionApproval .approvalStat{padding:7px!important;margin:5px 0!important}
.distributionApproval .homeAction{height:39px!important}
.distributionApproval .approvalCounts{margin-top:6px!important}
.distributionAux{grid-template-columns:repeat(2,1fr)!important;gap:7px!important;margin-top:8px!important}
.distributionAux .auxAction{height:50px!important;min-height:50px!important;font-size:14px!important}
.distributionHome .homeFooter{margin-top:8px!important;padding-top:8px!important}
.distributionHome .exitHome{height:50px!important}
@media(max-width:620px){
 .hero{height:31vh!important;min-height:220px!important;max-height:310px!important}
 .distributionMenu{grid-template-columns:repeat(2,1fr)!important}
 .distributionMenu .homeMenuBtn{min-height:56px!important}
 .distributionHome .homeFooterQuote{font-size:12px!important}
}

/* FINAL V3 score one-glance fix: metrics never overlap number balls. */
.modal.scoreOneScreen .scoreGame{grid-template-columns:18px minmax(0,1fr)!important;gap:5px!important;overflow:hidden!important}
.modal.scoreOneScreen .scoreGameBody{display:grid!important;grid-template-columns:minmax(0,1fr) 72px!important;gap:6px!important;align-items:center!important;min-width:0!important}
.modal.scoreOneScreen .scoreBalls{display:flex!important;gap:4px!important;flex-wrap:nowrap!important;min-width:0!important;overflow:hidden!important}
.modal.scoreOneScreen .scoreMeta{display:grid!important;grid-template-columns:1fr!important;gap:2px!important;min-width:0!important}
.modal.scoreOneScreen .hitCount,.modal.scoreOneScreen .rankBadge{width:100%!important;min-width:0!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;line-height:1.05!important}
@media(max-width:760px){.modal.scoreOneScreen .scoreGameBody{grid-template-columns:minmax(0,1fr) 54px!important;gap:3px!important}.modal.scoreOneScreen .scoreBalls{gap:2px!important}.modal.scoreOneScreen .scoreBall{width:18px!important;height:18px!important;flex:0 0 18px!important;font-size:7.5px!important}.modal.scoreOneScreen .scoreMeta{font-size:7px!important}}
</style><style id="distributionHomeFinalLayout">
.distributionHome{padding:10px 13px 14px!important}
.distributionMenu{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;grid-template-rows:92px!important;gap:12px!important;width:100%!important;margin:10px 0 12px!important}
.distributionMenu .homeMenuBtn{height:92px!important;min-height:92px!important;padding:12px 10px!important;border-radius:16px!important;font-size:20px!important;gap:9px!important;width:100%!important}
