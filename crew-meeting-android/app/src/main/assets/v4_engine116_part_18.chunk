 </div>
</div>

<script id="baekhakV20IndependentHomeJS">
(function(){
  const $=id=>document.getElementById(id);
  const home=$('bhv2Home'), homeBtn=$('bhv2EngineHomeBtn');
  function cleanupLegacyHomeState(){
    document.documentElement.classList.remove('master-r2617-home-open');
    document.body.classList.remove('master-r2617-home-open');
    const old=$('masterR2617Home'); if(old) old.style.setProperty('display','none','important');
  }
  function syncFromEngine(){
    const r=$('round'), v=$('bhv2Round');
    if(r&&v&&String(r.value).trim()) v.value=r.value;
  }
  function syncToEngine(){
    const r=$('round'), v=$('bhv2Round'); if(!r||!v)return;
    let n=parseInt(v.value,10); if(!Number.isFinite(n)) n=parseInt(r.value,10)||1242;
    r.value=String(n); v.value=String(n);
    try{r.dispatchEvent(new Event('input',{bubbles:true}));r.dispatchEvent(new Event('change',{bubbles:true}));}catch(e){}
  }
  function openHome(){
    cleanupLegacyHomeState(); syncFromEngine();
    home.style.display='flex'; homeBtn.style.display='none';
    document.documentElement.classList.add('bhv2-home-open'); document.body.classList.add('bhv2-home-open');
    try{window.scrollTo(0,0)}catch(e){}
  }
  function openEngine(){
    syncToEngine(); cleanupLegacyHomeState();
    home.style.display='none'; homeBtn.style.display='block';
    document.documentElement.classList.remove('bhv2-home-open'); document.body.classList.remove('bhv2-home-open');
    try{window.scrollTo(0,0)}catch(e){}
  }
  function modal(title,text){$('bhv2ModalTitle').textContent=title;$('bhv2ModalText').textContent=text;$('bhv2Modal').classList.add('open');}
  function closeModal(){$('bhv2Modal').classList.remove('open')}
  $('bhv2Prev').onclick=function(){syncToEngine();const b=$('prevRound');if(b)b.click();setTimeout(syncFromEngine,80)};
  $('bhv2Next').onclick=function(){syncToEngine();const b=$('nextRound');if(b)b.click();setTimeout(syncFromEngine,80)};
  $('bhv2Round').addEventListener('change',syncToEngine);
  $('bhv2Start').onclick=openEngine;
  homeBtn.onclick=openHome;
  $('bhv2Exit').onclick=function(){try{if(window.BaekhakNative&&typeof window.BaekhakNative.exitApp==='function'){window.BaekhakNative.exitApp();return;}}catch(e){} modal('종료',`Android 설치본에서는 앱 종료로 연결됩니다.\n브라우저 미리보기에서는 창을 직접 닫아주세요.`);};
  $('bhv2Update').onclick=function(){const b=$('masterR2617UpdateBtn');if(b){try{b.click();return;}catch(e){}}modal('업데이트','V2.0은 기존 MASTER 업데이트 연결을 보존합니다. 설치본에서 업데이트 기능이 연결됩니다.');};
  $('bhv2Notice').onclick=function(){modal('공지사항',`백학도사 MASTER V2.0\n\nR26.x 홈 수정 누적 구조를 종료하고, 신규 독립 홈으로 전환했습니다.\n기존 분석 엔진·RAW·U10·Final5·성적·승인·백업 로직은 R26.34 기준으로 보존합니다.`);};
  $('bhv2Suggest').onclick=function(){modal('건의사항',`V2부터 홈 화면은 분석 엔진과 분리해 관리합니다.\n향후 홈 수정은 V2 전용 CSS/JS만 변경하며 기존 엔진 화면은 건드리지 않습니다.`);};
  $('bhv2Total').onclick=function(){const b=$('masterR2634TotalAnalysisBtn');if(b){b.click();}else{modal('총 분석 결과','최종분석회차 · HOLD회차 · 성공회차 3분류 메뉴 연결을 준비 중입니다.');}};
  $('bhv2ModalClose').onclick=closeModal;
  $('bhv2Modal').addEventListener('click',e=>{if(e.target===$('bhv2Modal'))closeModal();});
  function boot(){cleanupLegacyHomeState();syncFromEngine();openHome();setTimeout(cleanupLegacyHomeState,800);}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
  window.__BAEKHAK_DOSA_MASTER_V2__=Object.freeze({version:'V2.0',date:'2026-09-16',homeArchitecture:'INDEPENDENT',baseEngine:'R26.34',engineChanged:false,rawChanged:false,u10Changed:false,final5Changed:false,scoreChanged:false,approvalChanged:false,backupChanged:false});
})();
</script>


<!-- V2 FINAL.1 · 분석화면 종료 버튼 국소 복구: 다른 기능/화면 변경 없음 -->
<script id="baekhakV2Final1ExitRepair">
(function(){
  function repair(){
    var b=document.getElementById('masterR264ExitBtn');
    if(!b) return false;
    b.textContent='⏻ 종료';
    b.title='종료';
    b.onclick=function(e){
      if(e){e.preventDefault();e.stopPropagation();}
      try{
        if(window.BaekhakNative && typeof window.BaekhakNative.exitApp==='function'){
          window.BaekhakNative.exitApp();
          return;
        }
      }catch(err){}
      var homeBtn=document.getElementById('bhv2EngineHomeBtn');
      if(homeBtn){ homeBtn.click(); return; }
      var home=document.getElementById('bhv2Home');
      if(home){
        home.style.display='flex';
        document.documentElement.classList.add('bhv2-home-open');
        document.body.classList.add('bhv2-home-open');
        try{window.scrollTo(0,0);}catch(err){}
        return;
      }
    };
    return true;
  }
  function boot(){
    var n=0,t=setInterval(function(){n++; if(repair()||n>80)clearInterval(t);},120);
    setTimeout(repair,1800);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot,{once:true}); else boot();
  window.__BAEKHAK_V2_FINAL1_EXIT_REPAIR__=Object.freeze({version:'V2 FINAL.1',scope:'analysis-exit-only',engineChanged:false});
})();
</script>

