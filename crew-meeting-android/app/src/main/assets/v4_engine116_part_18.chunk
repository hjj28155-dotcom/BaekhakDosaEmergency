");background-size:cover;background-position:center top;background-repeat:no-repeat;}
#bhv2Version{position:absolute;left:12px;top:max(10px,env(safe-area-inset-top));z-index:3;min-width:112px;padding:8px 11px;border:1.5px solid #f0c85f;border-radius:14px;background:rgba(3,22,50,.92);box-shadow:0 4px 16px rgba(0,0,0,.35);text-align:center;line-height:1.05;}
#bhv2Version strong{display:block;color:#ffe17f;font-size:20px;letter-spacing:.02em;}
#bhv2Version span{display:block;margin-top:4px;color:#dcecff;font-size:10px;font-weight:800;}
#bhv2NewTag{position:absolute;right:12px;top:max(12px,env(safe-area-inset-top));padding:7px 10px;border-radius:999px;background:rgba(0,87,184,.88);border:1px solid #75b6ff;color:#fff;font-size:10px;font-weight:900;}
#bhv2Panel{flex:1 1 auto;min-height:0;margin-top:-7px;padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:linear-gradient(180deg,#061a31 0%,#020916 100%);border-top:1px solid rgba(102,177,236,.45);display:flex;flex-direction:column;gap:8px;}
.bhv2-btn{appearance:none;border:1.5px solid #5ba5dd;border-radius:16px;background:linear-gradient(180deg,#0d4c78,#082f52);color:#fff;box-shadow:0 4px 14px rgba(0,0,0,.28),inset 0 0 0 1px rgba(255,255,255,.04);font-weight:950;letter-spacing:-.02em;cursor:pointer;min-height:48px;-webkit-tap-highlight-color:transparent;}
.bhv2-btn:active{transform:scale(.985);}
#bhv2Update{width:62%;align-self:center;font-size:20px;min-height:52px;}
#bhv2RoundBox{border:1px solid #4c80a8;border-radius:16px;background:rgba(2,19,37,.92);padding:8px;}
#bhv2RoundTitle{font-size:12px;font-weight:900;color:#eef7ff;margin:0 0 5px 3px;}
#bhv2RoundRow{display:grid;grid-template-columns:1fr 92px 1fr;gap:7px;}
#bhv2RoundRow button{font-size:12px;min-height:42px;border-radius:11px;}
#bhv2Round{width:100%;height:42px;border:1.5px solid #bd943c;border-radius:10px;background:#071827;color:#fff7d3;font-size:20px;font-weight:950;text-align:center;outline:none;}
#bhv2RoundHint{margin:5px 2px 0;color:#a7bac9;font-size:8.5px;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
#bhv2ActionRow{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
#bhv2ActionRow .bhv2-btn{font-size:15px;min-height:46px;}
#bhv2Start{background:linear-gradient(180deg,#0b5488,#07385f);}
#bhv2Exit{background:linear-gradient(180deg,#26384c,#15263a);}
#bhv2MenuRow{display:grid;grid-template-columns:1fr 1.08fr 1fr;gap:7px;margin-top:auto;}
#bhv2MenuRow .bhv2-btn{min-height:48px;font-size:13px;padding:5px 4px;}
#bhv2Total{border-color:#e2ba51;color:#ffe38b;background:linear-gradient(180deg,#1c4468,#0a2946);}
#bhv2Footer{text-align:center;color:#91a8ba;font-size:8px;line-height:1.2;padding-top:1px;}
#bhv2EngineHomeBtn{display:none;position:fixed;z-index:2147481000;right:12px;top:max(10px,env(safe-area-inset-top));border:1px solid #78b8e8;border-radius:999px;background:#073860;color:#fff;font-weight:900;padding:9px 13px;box-shadow:0 5px 16px #0007;}
#bhv2Modal{display:none;position:fixed;inset:0;z-index:2147483400;background:rgba(0,6,16,.86);padding:max(14px,env(safe-area-inset-top)) 12px 14px;align-items:flex-start;justify-content:center;}
#bhv2Modal.open{display:flex;}
#bhv2ModalBox{width:min(94vw,520px);background:linear-gradient(180deg,#0b2c49,#061827);border:1px solid #5d97bf;border-radius:18px;padding:17px;box-shadow:0 12px 34px #0009;}
#bhv2ModalTitle{color:#f0cf72;font-size:22px;font-weight:950;margin-bottom:10px;}
#bhv2ModalText{white-space:pre-line;color:#eaf3f8;font-size:13px;line-height:1.6;}
#bhv2ModalClose{width:100%;margin-top:14px;min-height:44px;}
@media(max-height:760px){#bhv2Hero{flex-basis:38%;min-height:220px}#bhv2Panel{gap:6px;padding-top:7px}#bhv2Update{min-height:44px;font-size:18px}#bhv2RoundRow button,#bhv2Round{height:38px;min-height:38px}#bhv2ActionRow .bhv2-btn,#bhv2MenuRow .bhv2-btn{min-height:40px}}
@media(max-width:390px){#bhv2Version{left:8px;min-width:102px;padding:7px 9px}#bhv2Version strong{font-size:18px}#bhv2Panel{padding-left:8px;padding-right:8px}#bhv2Update{width:68%;font-size:18px}#bhv2RoundRow{grid-template-columns:1fr 84px 1fr;gap:5px}#bhv2MenuRow{gap:5px}#bhv2MenuRow .bhv2-btn{font-size:11.5px}}
</style>

