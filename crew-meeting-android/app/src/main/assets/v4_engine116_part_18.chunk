  </div>
  <div id="bhv2Panel">
    <button type="button" class="bhv2-btn" id="bhv2Update">↻ 업데이트</button>
    <section id="bhv2RoundBox" aria-label="이번 회차">
      <div id="bhv2RoundTitle">이번 회차</div>
      <div id="bhv2RoundRow">
        <button type="button" class="bhv2-btn" id="bhv2Prev">이전회차</button>
        <input id="bhv2Round" inputmode="numeric" value="1242" aria-label="회차 번호">
        <button type="button" class="bhv2-btn" id="bhv2Next">다음회차</button>
      </div>
      <div id="bhv2RoundHint">RESULT-BEFORE 전용 · 당첨번호/결과후 자료 미입력</div>
    </section>
    <div id="bhv2ActionRow">
      <button type="button" class="bhv2-btn" id="bhv2Start">▶ 시작</button>
      <button type="button" class="bhv2-btn" id="bhv2Exit">■ 종료</button>
    </div>
    <div id="bhv2MenuRow">
      <button type="button" class="bhv2-btn" id="bhv2Notice">공지사항</button>
      <button type="button" class="bhv2-btn" id="bhv2Total">총 분석 결과</button>
      <button type="button" class="bhv2-btn" id="bhv2Suggest">건의사항</button>
    </div>
    <div id="bhv2Footer">백학도사 MASTER V2 · 기존 분석 엔진 보존 · 신규 홈 독립 구조</div>
  </div>
</div>
