  color:#8fa9ba;
  font-size:10px;
  line-height:1.5;
}
#masterR2634TotalBottomClose{
  width:100%;
  margin-top:12px;
  border:1px solid #4a718a;
  border-radius:13px;
  background:#143750;
  color:#fff;
  padding:12px;
  font-size:15px;
  font-weight:900;
}
body.master-r2634-total-open{overflow:hidden!important;}

@media(max-width:430px){
  #masterR2617UpdateBtn{top:58.2%!important;left:27%!important;width:46%!important;}
  #masterR2618ControlPanel{top:64.5%!important;left:20.5%!important;width:60%!important;}
  #masterR2634TotalAnalysisBtn{
    right:2.8%;
    top:58.2%;
    width:16.5%;
    height:18.7%;
    min-width:50px;
    min-height:88px;
    border-radius:15px;
    font-size:12px;
  }
  #masterR2634TotalCard{width:calc(100vw - 12px);padding:16px 10px 13px;border-radius:18px;}
  #masterR2634TotalClose{width:38px;height:38px;font-size:25px;right:8px;top:8px;}
  #masterR2634TotalTitle{font-size:23px;margin:5px 43px 18px;}
  #masterR2634CategoryRow{gap:6px;}
  .masterR2634CategoryBtn{min-height:66px;font-size:11px;padding:8px 3px;border-radius:13px;}
  #masterR2634CategoryDetail{min-height:160px;padding:13px 10px;}
  #masterR2634CategoryDetail h3{font-size:17px;}
  #masterR2634CategoryDetail p{font-size:11.5px;}
}
</style>

<script id="masterR2634TotalAnalysisJS">
(function(){
  function byId(id){return document.getElementById(id);}

  const categoryText={
    final:{title:'최종분석회차',body:'최종 분석이 완료되어 공식 결과로 보존된 회차를 확인하는 영역입니다.'},
    hold:{title:'HOLD회차',body:'후보우주 부족·보류 판정 등으로 HOLD 처리된 회차를 확인하는 영역입니다.'},
    success:{title:'성공회차',body:'공식 기준에 따라 성공으로 분류된 회차를 확인하는 영역입니다.'}
  };

  function showCategory(key){
    const data=categoryText[key]||categoryText.final;
    document.querySelectorAll('.masterR2634CategoryBtn').forEach(function(b){
      b.classList.toggle('active',b.dataset.key===key);
    });
    const detail=byId('masterR2634CategoryDetail');
    if(detail){
      detail.innerHTML='<h3>'+data.title+'</h3><p>'+data.body+'</p><p class="r2634-note">회차 목록·세부 결과는 기존 MASTER 기록을 보존한 상태에서 이 분류 화면에 연결합니다.</p>';
    }
  }

  function openTotal(){
    const o=byId('masterR2634TotalOverlay');
    if(!o) return;
    o.classList.add('open');
    document.body.classList.add('master-r2634-total-open');
    showCategory('final');
    try{o.scrollTop=0;}catch(e){}
  }
  function closeTotal(){
    const o=byId('masterR2634TotalOverlay');
    if(!o) return;
    o.classList.remove('open');
    document.body.classList.remove('master-r2634-total-open');
  }

  function install(){
    const home=byId('masterR2617Home');
    if(!home) return false;

    if(!byId('masterR2634TotalAnalysisBtn')){
      const btn=document.createElement('button');
      btn.type='button';
      btn.id='masterR2634TotalAnalysisBtn';
      btn.setAttribute('aria-label','총 분석 결과');
      btn.innerHTML='총<br>분석<br>결과';
      btn.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();openTotal();});
      home.appendChild(btn);
    }

    if(!byId('masterR2634TotalOverlay')){
      const overlay=document.createElement('div');
      overlay.id='masterR2634TotalOverlay';
      overlay.setAttribute('role','dialog');
      overlay.setAttribute('aria-modal','true');
      overlay.setAttribute('aria-label','총 분석 결과');
      overlay.innerHTML=`
        <div id="masterR2634TotalCard">
          <button type="button" id="masterR2634TotalClose" aria-label="닫기">×</button>
          <div id="masterR2634TotalTitle">총 분석 결과</div>
          <div id="masterR2634CategoryRow">
            <button type="button" class="masterR2634CategoryBtn" data-key="final">최종분석<br>회차</button>
            <button type="button" class="masterR2634CategoryBtn" data-key="hold">HOLD<br>회차</button>
            <button type="button" class="masterR2634CategoryBtn" data-key="success">성공<br>회차</button>
          </div>
          <div id="masterR2634CategoryDetail"></div>
          <button type="button" id="masterR2634TotalBottomClose">닫기</button>
        </div>`;
      document.body.appendChild(overlay);

      overlay.addEventListener('click',function(e){if(e.target===overlay) closeTotal();});
      byId('masterR2634TotalClose').addEventListener('click',closeTotal);
      byId('masterR2634TotalBottomClose').addEventListener('click',closeTotal);
      overlay.querySelectorAll('.masterR2634CategoryBtn').forEach(function(b){
        b.addEventListener('click',function(){showCategory(b.dataset.key);});
      });
      showCategory('final');
    }

    window.__BAEKHAK_MASTER_R2634_TOTAL_ANALYSIS__=Object.freeze({
      version:'R26.34',
      homeControlsMovedDown:true,
      totalAnalysisButton:true,
      categories:Object.freeze(['최종분석회차','HOLD회차','성공회차']),
      engineChanged:false,
      rawChanged:false,
      u10Changed:false,
      final5Changed:false,
      scoreLogicChanged:false,
      approvalChanged:false,
      backupChanged:false
    });
    return true;
  }

  function boot(){
    let n=0;
    const t=setInterval(function(){n++;if(install()||n>80) clearInterval(t);},120);
    setTimeout(install,30);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot,{once:true});
  else boot();
})();
</script>


<!-- ============================================================
 BAEKHAK DOSA MASTER V2.1 · 2026-09-16
 홈 전용 업그레이드
 - 좌측 상단 버전 V2.1 고정 / 기존 R26.38 표식 완전 가림
 - 중앙 배포 승인 관리 패널 추가
 - 승인대기 / 승인완료 / 배포이력 바로가기
 - 기존 R26.34 분석 엔진/RAW/U10/Final5/성적/승인/백업 로직 무변경
============================================================= -->
<style id="baekhakV21HomeUpgradeCSS">
/* V2.1 버전 표식: 이전 이미지 속 R26.38 배지를 완전히 덮고 V2.1만 보이게 함 */
#bhv2Hero::after{
  content:"";
  position:absolute;
  z-index:7;
  left:0;
  top:0;
  width:166px;
  height:102px;
  background:linear-gradient(145deg,#071f46 0%,#062453 52%,#05204a 100%);
  border-bottom-right-radius:28px;
  box-shadow:8px 8px 22px rgba(0,0,0,.18);
  pointer-events:none;
}
#bhv2Version{
  z-index:12!important;
  left:12px!important;
  top:12px!important;
  min-width:138px!important;
  padding:10px 14px 9px!important;
  border:1.8px solid #f1ca65!important;
  border-radius:18px!important;
  background:linear-gradient(180deg,#092e60 0%,#061b39 100%)!important;
  box-shadow:0 7px 20px rgba(0,0,0,.38),inset 0 0 0 1px rgba(255,255,255,.06)!important;
}
#bhv2Version strong{font-size:24px!important;color:#ffd972!important;line-height:1!important;letter-spacing:.02em!important;}
#bhv2Version span{font-size:10px!important;color:#f2f6ff!important;line-height:1.25!important;margin-top:4px!important;}
#bhv2NewTag{z-index:12!important;right:11px!important;top:14px!important;background:linear-gradient(180deg,#126ab0,#084a80)!important;border-color:#7ac0ff!important;box-shadow:0 5px 16px #0005!important;}

/* 중앙 배포 승인 관리 */
#bhv21Approval{
  position:relative;
  overflow:hidden;
  border:1.5px solid #5b9ed0;
  border-radius:20px;
  padding:14px 14px 12px;
  min-height:172px;
  background:
    radial-gradient(circle at 50% -20%,rgba(54,151,228,.23),transparent 52%),
    linear-gradient(180deg,rgba(8,42,70,.97),rgba(4,23,42,.98));
  box-shadow:0 8px 24px rgba(0,0,0,.28),inset 0 0 0 1px rgba(255,255,255,.04);
}
#bhv21Approval::before{
  content:"";
  position:absolute;left:18px;right:18px;top:0;height:2px;
  background:linear-gradient(90deg,transparent,#f0cb68 25%,#fff0a6 50%,#f0cb68 75%,transparent);
  opacity:.88;
}
#bhv21ApprovalHead{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:5px;}
#bhv21ApprovalTitle{display:flex;align-items:center;gap:7px;color:#ffe08a;font-size:18px;font-weight:950;letter-spacing:-.02em;}
#bhv21ApprovalTitle .lock{font-size:18px;filter:drop-shadow(0 0 6px rgba(255,212,92,.35));}
#bhv21ApprovalState{flex:0 0 auto;border:1px solid #5e8caf;border-radius:999px;background:#092c4a;color:#dceeff;padding:6px 9px;font-size:9.5px;font-weight:900;white-space:nowrap;}
#bhv21ApprovalDesc{color:#a9c1d2;font-size:9.4px;line-height:1.35;margin:0 0 10px;}
#bhv21ApprovalButtons{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;}
.bhv21-approval-btn{
  appearance:none;
  min-width:0;
  min-height:68px;
  border-radius:14px;
  border:1px solid #3e7399;
  background:linear-gradient(180deg,#104b75,#082f50);
  color:#f5f9fc;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:5px;
  font-weight:950;
  cursor:pointer;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.035),0 4px 12px #0003;
}
.bhv21-approval-btn:active{transform:scale(.985);}
.bhv21-approval-btn .label{font-size:12px;line-height:1.05;}
.bhv21-approval-btn .count{font-size:17px;color:#ffe187;line-height:1;font-variant-numeric:tabular-nums;}
#bhv21Pending{border-color:#d4a846;background:linear-gradient(180deg,#5a4518,#31280f);}
#bhv21Pending .count{color:#fff0a6;}
#bhv21Approved{border-color:#48a779;background:linear-gradient(180deg,#145b45,#0b382b);}
#bhv21Approved .count{color:#9ce5bd;}
#bhv21History{border-color:#5689bb;background:linear-gradient(180deg,#16466d,#0a2c4b);}
#bhv21History .count{color:#b7d8ff;}
#bhv21ApprovalFoot{margin-top:8px;text-align:center;color:#7997ad;font-size:8.2px;line-height:1.2;}

/* V2.1에서는 중앙 관리판이 있으므로 하단 버튼은 항상 일정 간격 */
#bhv2MenuRow{margin-top:0!important;}
#bhv2Panel{gap:8px!important;}
#bhv2Footer{font-size:8px!important;color:#8ea9bd!important;}

@media(max-height:820px){
  #bhv21Approval{min-height:148px;padding:10px 11px 9px;}
  #bhv21ApprovalTitle{font-size:15px;}
  #bhv21ApprovalDesc{margin-bottom:7px;font-size:8.6px;}
  .bhv21-approval-btn{min-height:55px;gap:3px;}
  .bhv21-approval-btn .label{font-size:10.5px;}
  .bhv21-approval-btn .count{font-size:14px;}
  #bhv21ApprovalFoot{margin-top:5px;font-size:7.5px;}
}
@media(max-width:390px){
  #bhv2Hero::after{width:154px;height:96px;}
  #bhv2Version{left:9px!important;top:9px!important;min-width:128px!important;padding:9px 12px 8px!important;}
  #bhv2Version strong{font-size:21px!important;}
  #bhv21Approval{padding:11px 9px 9px;min-height:158px;}
  #bhv21ApprovalTitle{font-size:15px;}
  #bhv21ApprovalState{font-size:8.5px;padding:5px 7px;}
  #bhv21ApprovalButtons{gap:5px;}
  .bhv21-approval-btn{min-height:59px;border-radius:12px;}
  .bhv21-approval-btn .label{font-size:10px;}
  .bhv21-approval-btn .count{font-size:14px;}
}
</style>

<script id="baekhakV21HomeUpgradeJS">
(function(){
  const $=id=>document.getElementById(id);
  const ENDPOINT='https://jyqkohpeowkhuaohlezc.supabase.co/functions/v1/approval-admin';
  const ADMIN='';
  let lastApprovalItems=[];
  function escText(v){return String(v==null?'':v)}
  function fmt(t){try{return new Date(t).toLocaleString('ko-KR',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'})}catch(e){return ''}}
  function v2modal(title,text){
    const t=$('bhv2ModalTitle'), m=$('bhv2ModalText'), o=$('bhv2Modal');
    if(t)t.textContent=title;if(m)m.textContent=text;if(o)o.classList.add('open');
  }
  async function api(body){
    const r=await fetch(ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json','x-admin-token':ADMIN},body:JSON.stringify(body)});
    if(!r.ok)throw new Error('HTTP '+r.status);return await r.json();
  }
  function buildApproval(){
    if($('bhv21Approval'))return;
    const action=$('bhv2ActionRow'); if(!action)return;
    const card=document.createElement('section');
    card.id='bhv21Approval';
    card.setAttribute('aria-label','배포 승인 관리');
    card.innerHTML=''
      +'<div id="bhv21ApprovalHead">'
      +'<div id="bhv21ApprovalTitle"><span class="lock">🔐</span><span>배포 승인 관리</span></div>'
      +'<div id="bhv21ApprovalState">서버 확인 중</div>'
      +'</div>'
      +'<div id="bhv21ApprovalDesc">배포 승인 요청과 승인 완료 기록을 한곳에서 확인합니다.</div>'
      +'<div id="bhv21ApprovalButtons">'
      +'<button type="button" class="bhv21-approval-btn" id="bhv21Pending"><span class="label">승인 대기</span><span class="count" id="bhv21PendingCount">···</span></button>'
      +'<button type="button" class="bhv21-approval-btn" id="bhv21Approved"><span class="label">승인 완료</span><span class="count" id="bhv21ApprovedCount">···</span></button>'
      +'<button type="button" class="bhv21-approval-btn" id="bhv21History"><span class="label">배포 이력</span><span class="count" id="bhv21HistoryCount">···</span></button>'
      +'</div>'
      +'<div id="bhv21ApprovalFoot">승인 요청은 기존 MASTER 승인 엔진과 동일하게 처리됩니다.</div>';
    action.insertAdjacentElement('afterend',card);
    $('bhv21Pending').addEventListener('click',openPending);
    $('bhv21Approved').addEventListener('click',showApproved);
    $('bhv21History').addEventListener('click',showHistory);
  }
  function updateCounts(items){
    lastApprovalItems=Array.isArray(items)?items:[];
    const pending=lastApprovalItems.filter(x=>x.status==='pending');
    const approved=lastApprovalItems.filter(x=>x.status==='approved');
    const decided=lastApprovalItems.filter(x=>x.status==='approved'||x.status==='rejected');
    if($('bhv21PendingCount'))$('bhv21PendingCount').textContent=pending.length+'건';
    if($('bhv21ApprovedCount'))$('bhv21ApprovedCount').textContent=approved.length+'건';
    if($('bhv21HistoryCount'))$('bhv21HistoryCount').textContent=decided.length+'건';
    if($('bhv21ApprovalState'))$('bhv21ApprovalState').textContent='정상 연결 · 대기 '+pending.length+'건';
  }
  async function refreshApproval(){
    if(!$('bhv21ApprovalState'))return;
    $('bhv21ApprovalState').textContent='승인 서버 확인 중';
    try{const j=await api({action:'list'});updateCounts(Array.isArray(j.items)?j.items:[]);}
    catch(e){$('bhv21ApprovalState').textContent='서버 연결 확인';
      ['bhv21PendingCount','bhv21ApprovedCount','bhv21HistoryCount'].forEach(id=>{if($(id))$(id).textContent='—';});}
  }
  function openPending(){
    const start=$('bhv2Start'); if(start)start.click();
    setTimeout(function(){
      const refresh=$('r2616Refresh'); if(refresh)try{refresh.click()}catch(e){}
      const card=$('r2616ApprovalCard'); if(card)try{card.scrollIntoView({behavior:'smooth',block:'start'})}catch(e){card.scrollIntoView()}
    },220);
  }
  async function ensureData(){
    if(lastApprovalItems.length)return lastApprovalItems;
    try{const j=await api({action:'list'});updateCounts(Array.isArray(j.items)?j.items:[]);}catch(e){}
    return lastApprovalItems;
  }
  async function showApproved(){
    const all=await ensureData(); const a=all.filter(x=>x.status==='approved');
    if(!a.length){v2modal('승인 완료','현재 승인 완료 기록이 없습니다.');return;}
    const lines=a.slice(0,20).map((x,i)=>
      (i+1)+'. '+escText(x.referrer_name||'소개자 미입력')+'님의 지인\n'+
      '기기 '+escText(x.device_label||'미확인')+' · 승인번호 '+escText(x.approval_code||'-')+'\n'+
      '승인 '+fmt(x.decided_at||x.requested_at)
    );
    v2modal('승인 완료 · '+a.length+'건',lines.join('\n\n'));
  }
  async function showHistory(){
    const all=await ensureData(); const a=all.filter(x=>x.status==='approved'||x.status==='rejected');
    if(!a.length){v2modal('배포 이력','아직 처리된 배포 승인 이력이 없습니다.');return;}
    a.sort((x,y)=>new Date(y.decided_at||y.requested_at||0)-new Date(x.decided_at||x.requested_at||0));
    const lines=a.slice(0,25).map((x,i)=>{
      const state=x.status==='approved'?'승인':'거절';
      return (i+1)+'. ['+state+'] '+escText(x.referrer_name||'소개자 미입력')+'님의 지인 · '+fmt(x.decided_at||x.requested_at);
    });
    v2modal('배포 이력 · '+a.length+'건',lines.join('\n'));
  }
  function upgradeLabels(){
    const v=$('bhv2Version');
    if(v)v.innerHTML='<strong>V2.1</strong><span>백학도사 MASTER<br>2026.09.16</span>';
    const tag=$('bhv2NewTag');if(tag)tag.textContent='V2 독립 MASTER';
    const foot=$('bhv2Footer');if(foot)foot.textContent='백학도사 MASTER V2.1 · 기존 분석 엔진 보존 · 홈/승인 관리 독립 구조';
    const notice=$('bhv2Notice');
    if(notice)notice.onclick=function(){v2modal('공지사항','백학도사 MASTER V2.1\n\nV2.0 독립 홈을 기준으로 중앙 배포 승인 관리 패널을 추가했습니다.\n기존 분석 엔진·RAW·U10·Final5·성적·승인·백업 로직은 R26.34 기준으로 그대로 보존합니다.');};
  }
  function bootV21(){
    buildApproval();
    upgradeLabels();
    refreshApproval();
    setTimeout(refreshApproval,700);
    setInterval(function(){if(!document.hidden)refreshApproval();},15000);
    window.__BAEKHAK_DOSA_MASTER_V2_1__=Object.freeze({version:'V2.1',date:'2026-09-16',homeArchitecture:'INDEPENDENT',approvalHomePanel:true,baseEngine:'R26.34',engineChanged:false,rawChanged:false,u10Changed:false,final5Changed:false,scoreChanged:false,approvalCoreChanged:false,backupChanged:false});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bootV21,{once:true});else bootV21();
})();
</script>


<!-- =============================================================
백학도사 MASTER V2.2 · 홈 기준 잠금 + 현재 항해사 분석화면 연결 고정
- V2.1 홈/배포승인관리 화면 그대로 보존
- 시작 버튼은 기존 R26.34 분석 엔진 화면(현재 항해사 사용 화면)으로 연결
- 총 분석 결과/공지/건의/승인 관리 기능 유지
- 엔진/RAW/U10/Final5/성적/승인 핵심/백업 로직 변경 없음
============================================================= -->
<style id="baekhakV22LockCSS">
/* V2.2는 홈 디자인을 더 이상 흔들지 않는 잠금 버전입니다. */
#bhv2Version{outline:1px solid rgba(255,220,118,.12);outline-offset:2px;}
#bhv2NewTag{white-space:nowrap;}
#bhv2EngineHomeBtn{font-size:12px!important;letter-spacing:-.02em;}
</style>
<script id="baekhakV22LockJS">
(function(){
  const $=id=>document.getElementById(id);
  function modal(title,text){
    const t=$('bhv2ModalTitle'),m=$('bhv2ModalText'),o=$('bhv2Modal');
    if(t)t.textContent=title;if(m)m.textContent=text;if(o)o.classList.add('open');
  }
  function lockLabels(){
    const v=$('bhv2Version');
    if(v)v.innerHTML='<strong>V2.2</strong><span>백학도사 MASTER<br>2026.09.16</span>';
    const tag=$('bhv2NewTag');if(tag)tag.textContent='V2 MASTER · 홈 잠금';
    const foot=$('bhv2Footer');if(foot)foot.textContent='백학도사 MASTER V2.2 · 홈 기준 잠금 · 현재 항해사 분석화면 연결';
    const homeBtn=$('bhv2EngineHomeBtn');if(homeBtn)homeBtn.textContent='⌂ V2.2 홈';
    const notice=$('bhv2Notice');
    if(notice)notice.onclick=function(){modal('공지사항','백학도사 MASTER V2.2\n\nV2.1 홈 화면과 배포 승인 관리 구성을 기준 MASTER로 잠갔습니다.\n시작 버튼은 현재 항해사가 사용 중인 기존 분석 화면으로 연결됩니다.\n분석 엔진·RAW·U10·Final5·성적·승인 핵심·백업 로직은 변경하지 않았습니다.');};
  }
  function hardenStartLink(){
    const start=$('bhv2Start');
    if(!start || start.dataset.v22Locked==='1')return;
    start.dataset.v22Locked='1';
    start.title='현재 항해사 분석 화면 열기';
    start.addEventListener('click',function(){
      setTimeout(function(){
        const home=$('bhv2Home'); if(home)home.style.display='none';
        document.documentElement.classList.remove('bhv2-home-open');
        document.body.classList.remove('bhv2-home-open');
        const old=$('masterR2617Home'); if(old)old.style.setProperty('display','none','important');
        const homeBtn=$('bhv2EngineHomeBtn'); if(homeBtn)homeBtn.style.display='block';
        try{window.scrollTo(0,0)}catch(e){}
      },0);
    },false);
  }
  function verifyCoreButtons(){
    const required=['bhv2Start','bhv2Exit','bhv2Notice','bhv2Total','bhv2Suggest','bhv21Approval'];
    return required.every(id=>!!$(id));
  }
  function bootV22(){
    lockLabels();
    hardenStartLink();
    window.__BAEKHAK_DOSA_MASTER_V2_2__=Object.freeze({
      version:'V2.2',date:'2026-09-16',homeLocked:true,currentNavigatorEngineLinked:true,
      totalAnalysisButtonPreserved:true,approvalHomePanelPreserved:true,baseEngine:'R26.34',
      engineChanged:false,rawChanged:false,u10Changed:false,final5Changed:false,
      scoreChanged:false,approvalCoreChanged:false,backupChanged:false,coreButtonsVerified:verifyCoreButtons()
    });
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bootV22,{once:true});else bootV22();
})();
</script>

<!-- 백학도사 MASTER V2 FINAL : 항해사 승인 홈 기준 -->
<script id="baekhakV2FinalSeal">
(function(){
 const $=id=>document.getElementById(id);
 function seal(){
   const v=$('bhv2Version'); if(v)v.innerHTML='<strong>V2 FINAL.1</strong><span>백학도사 MASTER<br>2026.09.16</span>';
   const tag=$('bhv2NewTag'); if(tag)tag.textContent='V2 MASTER · FINAL.1';
   const foot=$('bhv2Footer'); if(foot)foot.textContent='백학도사 MASTER V2 FINAL.1 · 항해사 승인 홈 · 분석/승인/총분석 연결';
   const hb=$('bhv2EngineHomeBtn'); if(hb)hb.textContent='⌂ V2 FINAL 홈';
   window.__BAEKHAK_DOSA_MASTER_V2_FINAL__=Object.freeze({
     version:'V2 FINAL',date:'2026-09-16',approvedHome:'V2.2',baseEngine:'R26.34',
     homeLocked:true,currentNavigatorEngineLinked:true,totalAnalysisButtonPreserved:true,
     approvalHomePanelPreserved:true,engineChanged:false,rawChanged:false,u10Changed:false,
     final5Changed:false,scoreChanged:false,approvalCoreChanged:false,backupChanged:false
   });
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',seal,{once:true});else seal();
})();
</script>

<!-- V2 FINAL.2 · 공지사항 읽기시간 보장: 자동닫힘 없음 / X로만 닫기 -->
<script id="baekhakV2Final2NoticeHold">
(function(){
  function $(id){return document.getElementById(id)}
  function openFullNotice(){
    var o=$('masterR2631StartupOverlay');
    if(!o)return;
    o.classList.remove('r2631-closed');
    document.body.classList.add('r2631-startup-open');
    try{o.scrollTop=0}catch(e){}
  }
  function closeFullNotice(){
    var o=$('masterR2631StartupOverlay');
    if(!o)return;
    o.classList.add('r2631-closed');
    document.body.classList.remove('r2631-startup-open');
  }
  function bind(){
    var o=$('masterR2631StartupOverlay'), x=$('masterR2631StartupX'), n=$('bhv2Notice');
    if(x){ x.onclick=function(e){e.preventDefault();e.stopPropagation();closeFullNotice();}; }
    /* 배경 터치로 닫히지 않게 하여 읽는 중 실수로 종료되는 문제 방지 */
    if(o){ o.onclick=function(e){ if(e.target===o){e.preventDefault();e.stopPropagation();} }; }
    /* V2 홈 공지사항은 짧은 텍스트 모달 대신 목적+공지 전체 화면을 연다 */
    if(n){ n.onclick=function(e){e.preventDefault();e.stopPropagation();openFullNotice();}; }
    var v=$('bhv2Version'); if(v)v.innerHTML='<strong>V2 FINAL.2</strong><span>백학도사 MASTER<br>2026.09.16</span>';
    var top=$('bhv2TopBadge'); if(top)top.textContent='V2 MASTER · FINAL.2';
    var foot=$('bhv2Footer'); if(foot)foot.textContent='백학도사 MASTER V2 FINAL.2 · 공지 수동닫기 · 종료버튼 복구';
  }
  function boot(){bind();setTimeout(bind,100);setTimeout(bind,700);}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
  window.__BAEKHAK_V2_FINAL2__=Object.freeze({version:'V2 FINAL.2',noticeAutoClose:false,noticeClose:'X_ONLY',exitRepair:true,engineChanged:false});
})();
</script>
<script id="v3Bridge">
(function(){
  function serialRank(rank){return (rank||[]).map(function(x){return {n:Number(x.n),score:Number(x.score||0),support:Number(x.support||x.supportCount||0),grade:String(x.grade||''),basis:String(x.basis||''),source:String(x.source||'')};});}
  window.addEventListener('message',function(ev){
    var d=ev.data||{}; if(d.type!=='V3_ANALYZE')return;
    try{
      var re=document.getElementById('round'),ra=document.getElementById('raw');
      if(re)re.value=String(d.round||1242); if(ra)ra.value=String(d.raw||'');
      if(typeof v13Run==='function')v13Run(); else {var run=document.getElementById('run'); if(run)run.click();}
      var L=window.LAST||LAST||null;
      var payload={type:'V3_ANALYSIS_RESULT',ok:!!L,round:Number(d.round||0),engine:L&&L.engine||'V2_MASTER_ENGINE',rank:serialRank(L&&L.rank||[]),games:(L&&L.pack&&L.pack.games||[]).map(function(g){return (g||[]).map(Number);}),decoded:L&&L.dec||[],regression:!!(L&&L.regression),rankPass:!!(L&&L.rankPass),packPass:!!(L&&L.packPass)};
      parent.postMessage(payload,'*');
    }catch(e){parent.postMessage({type:'V3_ANALYSIS_RESULT',ok:false,error:String(e&&e.message||e),round:Number(d.round||0)},'*');}
  });
  parent.postMessage({type:'V3_ENGINE_READY'},'*');
})();
</script>

</body>
</html>