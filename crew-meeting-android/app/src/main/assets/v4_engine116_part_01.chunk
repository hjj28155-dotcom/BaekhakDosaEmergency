 {id:'PR-025',src:7,n:25,op:'CONDITION_SPLIT',a:['행운','나누'],must:[['행운'],['나누'],['큰']],cue:[['세','3'],['더','차이']] ,basis:'행운7 분할쌍 중 큰쪽 차이3 조건'},
