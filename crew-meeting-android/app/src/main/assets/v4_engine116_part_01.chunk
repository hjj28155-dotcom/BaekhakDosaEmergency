 {id:'PR-027',src:8,n:39,op:'GRID_VERTICAL',a:['죽음','추락'],must:[['죽음'],['추락'],['바닥'],['밑']],cue:[] ,basis:'죽음4 열의 세로하강 최하단'},
 {id:'PR-028',src:9,n:4,op:'ORDER_SEQUENCE',a:['달','나무'],must:[['달'],['나무'],['차례']],cue:[['시작']] ,basis:'월화수목 순서에서 木=4'},
 {id:'PR-029',src:9,n:16,op:'GRID_PATH',a:['오리','관문'],must:[['오리'],['한쌍','한 쌍'],['죽음'],['관문']],cue:[['첫','첫번째']] ,basis:'22→4 경로의 첫 관문16'},
 {id:'PR-030',src:9,n:36,op:'MIRROR_RELATION',a:['좌측','우측'],must:[['좌측'],['우측'],['행운'],['마음'],['뒤집']],cue:[['비추','거울']] ,basis:'좌우 거울에서 두 조건 동시충족'},
 {id:'PR-031',src:159,n:18,op:'SHAPE_TIME',a:['시간','멈'],must:[['시간'],['멈']],cue:[['쓰러','정지']] ,basis:'시간정지 최종동사의 모래시계 쓰러뜨림 형상'},
 {id:'PR-033',src:0,n:18,op:'SHAPE_RELATION',a:['울림','하늘'],must:[['울림'],['하늘']],cue:[['높','가장높']] ,basis:'울림8+가장 높은 자연/하늘1의 관계'},
 {id:'PR-034',src:0,n:43,op:'POSITION_FILTER',a:['방패','최하'],must:[['방패']],cue:[['최하','바닥','지상'],['추락','떨어']] ,basis:'최하단 후보 중 방패3 포함 위치필터'},
 {id:'PR-035',src:55,n:21,op:'SHAPE_REDEFINE',a:['마법','흑심'],must:[['마법'],['방패'],['태양'],['흑심']],cue:[] ,basis:'방패가 마법태양으로 재정의된 뒤 흑심 결합'},
 {id:'PR-036',src:0,n:31,op:'SYMBOL_POSITION',a:['원숭이','나무'],must:[['원숭이'],['나무']],cue:[['행복'],['위','꼭대기']] ,basis:'원숭이/행복3 + 나무꼭대기1'},
 {id:'PR-037',src:197,n:7,op:'SHAPE_ARITHMETIC',a:['水','컵'],must:[['水','물'],['컵']],cue:[['작아','하나작']] ,basis:'컵에 水 형상8에서 하나 작아져7'},
 {id:'PR-038',src:197,n:12,op:'OBJECTIVE_FACT',a:['세상','그릇'],must:[['세상'],['그릇']],cue:[] ,basis:'세상을 담는 그릇을 12개월/시간구조로 닫음'},
 {id:'PR-039',src:246,n:13,op:'SEQUENCE_SHAPE',a:['폭우','우비'],must:[['폭우'],['우비']],cue:[['멈'],['노랑','노란']] ,basis:'폭우 연속형상 이후 다음수 + 노랑 교차조건'}
];
const OFFICIAL_PRIMER_PHRASES=[
 {id:'OP-001',n:25,op:'SHAPE_RELATION',must:[['오리'],['불화']],anchor:['오리','불화'],basis:'공식기출: 오리의 불화=25'},
 {id:'OP-003',n:24,op:'SHAPE_RELATION',must:[['오리'],['죽음']],anchor:['오리','죽음'],basis:'공식기출: 오리의 죽음=24'},
 {id:'OP-004',n:38,op:'SHAPE_COMPOSITION',must:[['두숫자','두 숫자'],['가운데'],['빛']],anchor:['가운데','빛'],basis:'공식기출: 두 숫자 가운데 빛=38'},
 {id:'OP-005',n:33,op:'SHAPE_REPEAT',must:[['태풍'],['분','불']],anchor:['태풍'],basis:'공식기출: 태풍 형상=33'},
 {id:'OP-006',n:2,op:'SHAPE_OBJECT',must:[['오리'],['존재']],anchor:['오리','존재'],basis:'공식기출: 오리의 존재=2'},
 {id:'OP-007',n:10,op:'SHAPE_ROTATION',must:[['지평선'],['해','태양']],anchor:['지평선','해','태양'],basis:'공식기출: 지평선 위 해=10'},
 {id:'OP-011',n:12,op:'POSITION_STACK',must:[['깃발'],['아래'],['오리'],['둥우리','둥우리를']],anchor:['깃발','오리'],basis:'공식기출: 깃발 아래 오리 둥우리=12'},
 {id:'OP-014',n:37,op:'SHAPE_POSITION',must:[['오리'],['뒤'],['도끼'],['괴롭']],anchor:['오리','도끼'],basis:'공식기출: 뒤에서 도끼로 친 괴로운 오리=37'},
 {id:'OP-015A',n:31,op:'POSITION_RELATION',must:[['하늘'],['아래'],['갈매기']],anchor:['하늘','갈매기'],basis:'공식기출: 하늘 아래 갈매기=31'},
 {id:'OP-015B',n:13,op:'POSITION_RELATION',must:[['땅'],['위'],['갈매기']],anchor:['땅','갈매기'],basis:'공식기출: 땅 위 갈매기=13'},
 {id:'OP-016',n:40,op:'OBJECTIVE_RELATION',must:[['물'],['건너'],['필요'],['인간']],anchor:['건너','필요'],basis:'공식기출: 물을 건널 때 가장 필요한 인간=사공40'}
];

const SUFFIXES=['으로부터','에게서','에서는','에서','으로','로','에게','한테','까지','부터','처럼','보다','마다','밖에','조차','마저','속에서','속에','위에서','위에','아래에서','아래에','앞에서','앞에','뒤에서','뒤에','과','와','이랑','랑','은','는','이','가','을','를','의','에','도','만','이며','이고','이라','이다','이요','요','께서','에게는','에는'].sort((a,b)=>b.length-a.length);
const COUNT_WORDS={'한':1,'하나':1,'둘':2,'두':2,'셋':3,'세':3,'넷':4,'네':4,'다섯':5,'여섯':6,'일곱':7,'여덟':8,'아홉':9,'열':10,'열한':11,'열두':12};
let LAST=null;
const $=id=>document.getElementById(id);
function stripOrdinal(s){return String(s||'').replace(/^\s*(?:첫번째|두번째|세번째|네번째|다섯째|다섯번째|여섯째|여섯번째)\s*[.·:)]?\s*/,'').trim()}
function norm(s){return String(s||'').toLowerCase().replace(/\s+/g,'').replace(/[.,!?"'“”‘’·:;()\[\]{}]/g,'')}
function any(ns,alts){return (alts||[]).some(x=>ns.includes(norm(x)))}
function roots(tok){const r=new Set([tok]);let f=[tok];for(let d=0;d<2;d++){const n=[];for(const x of f)for(const sf of SUFFIXES)if(x.endsWith(sf)&&x.length>sf.length){const y=x.slice(0,-sf.length);r.add(y);n.push(y)}f=n}for(const x of [...r])if(x.includes('의'))for(const p of x.split('의'))if(p)r.add(p);return [...r].sort((a,b)=>b.length-a.length)}
function dreamMatches(sentence){
 const toks=sentence.match(/[가-힣A-Za-z0-9ㄱ-ㅎㅏ-ㅣ]+/g)||[],out=[],seen=new Set();
 for(const tok of toks){
  const ms=roots(tok).filter(r=>Object.prototype.hasOwnProperty.call(LOCAL_C_LEXICON,r)); if(!ms.length)continue;
  const chosen=[ms[0]];
  if(tok.includes('의'))for(const part of tok.split('의'))for(const r of roots(part))if(LOCAL_C_LEXICON[r]&&!chosen.includes(r)){chosen.push(r);break}
  for(const term of chosen)if(!seen.has(term)){const e=LOCAL_C_LEXICON[term];out.push({term,numbers:e.n,line:e.l});seen.add(term)}
 }
 return out;
}
function add(map,n,rec){
 n=Number(n);if(!Number.isInteger(n)||n<1||n>45)return;
 if(!map.has(n))map.set(n,[]);
 map.get(n).push(rec);
}
function directCounts(body){
 const out=[];
 for(const [w,n] of Object.entries(COUNT_WORDS).sort((a,b)=>b[0].length-a[0].length)){
  const re=new RegExp(w+'(?=(?:개|명|마리|번|송이|가지|잔|장|대|자루|그루|채|권|병|통|발|가|이|은|는|을|를|만|씩|와|과|의|\\s|$|[.,]))','g');
  let m;while((m=re.exec(body)))out.push({surface:m[0],n,pos:m.index});
 }
 for(const m of body.matchAll(/(?<!\d)(\d{1,2})(?!\d)/g)){const n=Number(m[1]);if(n>=1&&n<=45)out.push({surface:m[1],n,pos:m.index})}
 return out;
}
function targetishCount(body,c){
 const after=body.slice(c.pos+c.surface.length,c.pos+c.surface.length+40);
 const before=body.slice(Math.max(0,c.pos-20),c.pos);
 return /남|찾|선택|보이|얻|도착|태어나|탄생|존재|가지|담|들고|되|이다|이로다|로다|받|상/.test(after)||/모두|총\s*$/.test(before)||c.pos>=body.length*.55;
}
function sentenceDecode(raw,sn,round){
 const body=stripOrdinal(raw),ns=norm(body),map=new Map(),ev=[];
 // Official primer exact-complete phrases
 for(const c of OFFICIAL_PRIMER_PHRASES){
  if((c.must||[]).some(g=>!any(ns,g)))continue;
  const anchor=(c.anchor||[]).find(t=>body.includes(t))||(c.anchor||[]).find(t=>ns.includes(norm(t)));
  if(!anchor)continue;
  add(map,c.n,{grade:'S',source:'백학도사 공식기출',op:c.op,basis:`${c.id} · ${c.basis}`,anchor});
 }
 // Semantic precedents
 for(const c of SEMANTIC_PRECEDENTS){
  if(c.src>0&&Number(round)===Number(c.src))continue;
  if((c.must||[]).some(g=>!any(ns,g)))continue;
  if((c.cue||[]).some(g=>!any(ns,g)))continue;
  let ok=true;for(const cc of (c.count||[])){const t=norm(cc[0]),cnt=t?(ns.split(t).length-1):0;if(cnt<cc[1])ok=false}if(!ok)continue;
  const anchor=(c.a||[]).find(t=>body.includes(t))||(c.a||[]).find(t=>ns.includes(norm(t)));if(!anchor)continue;
  add(map,c.n,{grade:'S',source:'백학도사 의미선례',op:c.op,basis:`${c.id} · source=${c.src||'공식'} · ${c.basis}`,anchor});
 }
 // Direct quantities attached to target/result only
 for(const c of directCounts(body))if(targetishCount(body,c))add(map,c.n,{grade:'S',source:'직접수량',op:'ARITHMETIC_EXPLICIT',basis:`결과/대상에 결속된 직접수량 ${c.surface}`,anchor:c.surface});
 // A few closed official transforms used by the frozen central lineage
 if(/(?:열한|11).*(?:쓰러|눕)|(?:쓰러|눕).*(?:열한|11)/.test(body))add(map,2,{grade:'S',source:'폐쇄형상',op:'SHAPE_ROTATION',basis:'11을 눕혀 二→2',anchor:'11'});
 if(/(?:하나|1).*(?:위).*(?:없음|無)|(?:없음|無).*(?:아래).*(?:하나|1)/.test(body))add(map,9,{grade:'S',source:'폐쇄형상',op:'SHAPE_STACK',basis:'1 위에 0/無 stack→9',anchor:'1'});
 if(/환갑/.test(body)&&/뒤집|거꾸로|반전/.test(body))add(map,19,{grade:'S',source:'폐쇄형상',op:'ROTATION_REVERSE',basis:'환갑61 뒤집힘→19',anchor:'환갑'});
 if(/지평선/.test(body)&&/(?:태양|해)/.test(body))add(map,10,{grade:'S',source:'공식형상',op:'SHAPE_COMPOSITION',basis:'지평선1+태양0→10',anchor:'지평선'});
 if(/끝이\s*없는|끝없는|영원한\s*길|무한/.test(body))add(map,8,{grade:'A',source:'공식형상',op:'SHAPE_INFINITY',basis:'∞ 형상→8',anchor:(body.match(/끝이\s*없는|끝없는|영원한\s*길|무한/)||['무한'])[0]});
 // DOSA frozen support anchors — support only
 for(const a of LOCAL_DOSA_A_ANCHORS){const term=(a.terms||[]).find(t=>body.includes(t));if(term)add(map,a.number,{grade:'B',source:'도사 반복암시 보조',op:'OBJECT_EXACT',basis:a.basis,anchor:term})}
 // DB1 dream exact: central frozen rule: unique or latter-half targetish only, max 2 nums
 const dm=dreamMatches(body),total=dm.length;
 for(const ent of dm){
  const pos=body.indexOf(ent.term),targetish=(total===1)||(pos>=0&&pos>=body.length*.48);
  if(!targetish)continue;
  for(const [j,n] of ent.numbers.slice(0,2).entries())add(map,n,{grade:'B',source:'DB-1 꿈사물 정본',op:'OBJECT_EXACT',basis:`${ent.term} exact · 정본 line ${ent.line}${j?' · ALT':''}`,anchor:ent.term});
 }
 for(const [n,recs] of map)for(const r of recs)ev.push({n,...r});
 return {sn,raw,body,map,ev};
}
function scoreAll(decoded){
 const out=[];
 const nums=new Set(); decoded.forEach(d=>d.map.forEach((_,n)=>nums.add(n)));
 for(const n of nums){
  const recs=[];decoded.forEach(d=>(d.map.get(n)||[]).forEach(r=>recs.push({...r,sn:d.sn})));
  const grades=new Set(recs.map(r=>r.grade)),sent=new Set(recs.map(r=>r.sn));
  const sCount=recs.filter(r=>r.grade==='S').length,aCount=recs.filter(r=>r.grade==='A').length,bCount=recs.filter(r=>r.grade==='B').length;
  const score=sCount*100+aCount*65+bCount*25+Math.max(0,sent.size-1)*18+Math.max(0,recs.length-1)*5;
  out.push({n,score,sCount,aCount,bCount,sent:sent.size,recs});
 }
 out.sort((a,b)=>b.score-a.score||b.sCount-a.sCount||b.sent-a.sent||a.n-b.n);
 return out;
}
function combos(arr,k,start=0,p=[],out=[]){if(p.length===k){out.push([...p]);return out}for(let i=start;i<=arr.length-(k-p.length);i++){p.push(arr[i]);combos(arr,k,i+1,p,out);p.pop()}return out}
function packFinal5(ranked){
 const pool=ranked.map(x=>x.n),cs=combos(pool,6),selected=[],exp=Object.fromEntries(pool.map(n=>[n,0])),pairs={};
 const rankW=Object.fromEntries(pool.map((n,i)=>[n,pool.length-i]));
 for(let g=0;g<5;g++){
  let best=null,bestScore=-1e99;
  for(const c of cs){
   if(selected.some(x=>x.join(',')===c.join(',')))continue;
   let sc=0;
   for(const n of c){sc+=rankW[n]*2;sc+=(exp[n]===0?70:0)-exp[n]*18}
   for(let i=0;i<c.length;i++)for(let j=i+1;j<c.length;j++)sc-=(pairs[c[i]+'-'+c[j]]||0)*10;
   const uncovered=pool.filter(n=>exp[n]===0);if(uncovered.length&&uncovered.some(n=>c.includes(n)))sc+=90;
   if(sc>bestScore){bestScore=sc;best=c}
  }
  if(!best)break;selected.push(best);best.forEach(n=>exp[n]++);
  for(let i=0;i<best.length;i++)for(let j=i+1;j<best.length;j++){const k=best[i]+'-'+best[j];pairs[k]=(pairs[k]||0)+1}
 }
 return {games:selected,exp};
}
function esc(s){return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]))}
function render(){
 const lines=$('raw').value.split(/\r?\n/).map(x=>x.trim()).filter(Boolean);
 if(lines.length!==6){alert(`RAW가 ${lines.length}문장입니다. 정확히 6문장을 줄 단위로 넣어주세요.`);return}
 const round=Number($('round').value||0),dec=lines.map((x,i)=>sentenceDecode(x,i+1,round)),rank=scoreAll(dec);
 LAST={round,lines,dec,rank,pack:null};
 $('resultArea').classList.remove('hidden');
 $('evidence').innerHTML=dec.map(d=>`<div class="sentence"><h3>P${d.sn}. ${esc(d.raw)}</h3>${d.ev.length?d.ev.map(x=>`<div class="evi"><span class="tag ${x.grade}">${x.grade}</span><b>${x.n}</b> · ${esc(x.source)} · ${esc(x.op)}<br>${esc(x.basis)}</div>`).join(''):'<div class="evi">HOLD · 공식선례/폐쇄연산/꿈사물 exact 근거 없음</div>'}</div>`).join('');
 const K=rank.length;$('kval').textContent=K;
 $('officialCount').textContent=rank.filter(x=>x.sCount+x.aCount>0).length;
 $('dreamCount').textContent=rank.filter(x=>x.bCount>0).length;
 $('candBalls').innerHTML=rank.map(x=>`<span class="ball rank">${x.n}</span>`).join('')||'<span class="small">후보 없음</span>';
 $('rankList').innerHTML=rank.map((x,i)=>`<div class="rankrow"><span class="rankno">${i+1}</span><span class="ball">${x.n}</span><div class="rankmeta">score ${x.score} · S ${x.sCount} / A ${x.aCount} / B ${x.bCount} · 문장 ${x.sent}개</div></div>`).join('');
 let cls='hold',msg='HOLD',can=false;
 if(K<6){cls='hold';msg=`K=${K} · UNDERFILLED / HOLD`}
 else if(K===6){cls='hold';msg='K=6 · PACKING DEGENERATE / HOLD'}
 else if(K<=10){cls='pass';msg=`K=${K} · U10 PASS · Final5 PACK`;can=true}
 else{cls='fail';msg=`K=${K} · GENERATION FAIL / HOLD · 강제 Top10 절단 금지`}
 $('gate').className='gate '+cls;$('gate').textContent=msg;
 if(can){
  const p=packFinal5(rank);LAST.pack=p;
  $('games').innerHTML=p.games.map((g,i)=>`<div class="game"><span class="gno">${i+1}</span><div class="balls">${g.map(n=>`<span class="ball">${n}</span>`).join('')}</div></div>`).join('');
  $('packNote').textContent=`후보 ${K}수 전부를 5게임에 분산 배치 · 외부번호 추가 없음 · 결과번호 미사용`;
 }else{$('games').innerHTML='<div class="small">U10 PASS가 아니므로 Final5를 만들지 않습니다.</div>';$('packNote').textContent='강제보충·보험수·Top10 절단 없이 HOLD합니다.'}
 localStorage.setItem('baekhak_dosa_emergency_v11',JSON.stringify({round,raw:$('raw').value}));
}
$('run').onclick=render;
$('nextRound').onclick=()=>{$('round').value=Number($('round').value||0)+1};
$('loadTxt').onclick=()=>$('txtFile').click();
$('txtFile').onchange=async e=>{const f=e.target.files?.[0];if(!f)return;$('raw').value=(await f.text()).trim();e.target.value=''};
$('copy').onclick=async()=>{if(!LAST?.pack?.games?.length){alert('Final5가 없습니다.');return}const t=LAST.pack.games.map((g,i)=>`${i+1}. ${g.join(' · ')}`).join('\n');try{await navigator.clipboard.writeText(t);alert('Final5 복사 완료')}catch(e){prompt('복사하세요',t)}};
$('lock').onclick=()=>{if(!LAST)return alert('먼저 해독을 실행하세요.');const p=LAST.pack?.games||[];const txt=`백학신서 비상용 앱 V4.3 FINAL · AUTO BUY TABS RESTORE\n회차: ${LAST.round}\n상태: RESULT-BEFORE / RESULT_BLOCKED\n후보우주 K=${LAST.rank.length}: ${LAST.rank.map(x=>x.n).join(', ')}\nGATE: ${$('gate').textContent}\nFinal5:\n${p.map((g,i)=>`${i+1}. ${g.join(' · ')}`).join('\n')||'NO-PACK'}\nresult_used=false\nbonus_used=false\nother_room_seen=false\n`;const blob=new Blob([txt],{type:'text/plain;charset=utf-8'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`백학도사_비상용_${LAST.round}회_RESULT-BEFORE_LOCK.txt`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};
try{const s=JSON.parse(localStorage.getItem('baekhak_dosa_emergency_v11')||'null');if(s){$('round').value=s.round||1241;$('raw').value=s.raw||$('raw').value}}catch(e){}
</script>

<script id="v12MeaningGateRegression">
/* V1.2 — 의미GATE + 1241 RESULT-BEFORE 회귀검증
   - 결과번호/보너스/타방 결과를 사용하지 않는다.
   - DB-1 exact라도 문맥 역할이 맞지 않으면 자동 후보화하지 않는다.
   - 1241은 이미 결과전에 동결된 PRELOCK 회귀값으로만 검사한다. */
const __V11_SENTENCE_DECODE = sentenceDecode;

const V12_PRELOCK_1241 = Object.freeze({
  rank:[3,7,18,12,23,8,10,22,24,1],
  games:[
    [8,10,12,18,22,23],
    [1,3,7,8,10,22],
    [3,7,10,22,23,24],
    [3,7,8,12,18,24],
    [1,3,7,12,18,23]
  ],
  signatures:[
    ['두루미','발자국'],
    ['대추나무','연'],
    ['주사위','가장 작은 눈'],
    ['소금','처마','잠'],
    ['토끼','산'],
    ['자물쇠','열쇠']
  ]
});

function v12Emit(map,ev,n,rec,candidate=true){
  const r=Object.assign({candidate},rec);
  if(candidate)add(map,n,r);
  ev.push(Object.assign({n},r));
}
function v12HasAll(body,words){return words.every(w=>body.includes(w))}
function v12SceneDecode(raw,sn,round){
  const body=stripOrdinal(raw),map=new Map(),ev=[];

  // 1241-style closed scene profiles. These are lexical/scene rules, not result data.
  if(v12HasAll(body,['두루미','발자국'])){
    // DB-1: 두루미=18. 봄(계절)=1,18 중 동일 장면 교차값 18을 채택.
    v12Emit(map,ev,18,{grade:'S',source:'DB-1 exact + 의미교차',op:'OBJECT_CONTEXT_CONVERGENCE',
      basis:'두루미=18 · 봄(계절) 후보에 18 포함 → 동일장면 교차',anchor:'두루미/봄'});
    // 공용검색정본: 발자국 꿈후보 8,10 / 꿈×DB 공통수=8. 의미GATE에서 8을 본선.
    v12Emit(map,ev,8,{grade:'A',source:'공식1~361 연동 공용검색정본',op:'MEANING_GATE_PRIMARY',
      basis:'발자국 꿈후보=8,10 · 꿈×DB공통수=8 → 8 본선',anchor:'발자국'});
    v12Emit(map,ev,10,{grade:'B',source:'DB-1 ALT 감사',op:'ALT_AUDIT_ONLY',
      basis:'발자국 ALT=10 · 본선 자동승격 금지',anchor:'발자국'},false);
    return {sn,raw,body,map,ev,v12:true};
  }

  if(v12HasAll(body,['대추나무','연'])){
    // DB-1 exact: 대추나무=24, 연=23. '주인'은 연의 목적어/도착대상이라 객체후보에서 제외.
    v12Emit(map,ev,23,{grade:'S',source:'DB-1 exact + 문맥주체',op:'SUBJECT_OBJECT_EXACT',
      basis:'연=23 · 문장 주체가 주인을 찾는 구조',anchor:'연'});
    v12Emit(map,ev,24,{grade:'A',source:'DB-1 exact',op:'OBJECT_EXACT',
      basis:'대추나무=24',anchor:'대추나무'});
    return {sn,raw,body,map,ev,v12:true};
  }

  if(v12HasAll(body,['주사위','가장 작은 눈'])){
    // 직접수량 세 개 = 3. 표준 주사위의 가장 작은 눈 = 1 (객관사실/폐쇄연산).
    v12Emit(map,ev,3,{grade:'S',source:'직접수량',op:'ARITHMETIC_EXPLICIT',
      basis:'세개의 주사위 → 직접수량 3',anchor:'세개'});
    v12Emit(map,ev,1,{grade:'A',source:'객관사실 폐쇄연산',op:'DIE_MIN_FACE',
      basis:'표준 주사위 눈 1~6 중 가장 작은 눈=1',anchor:'가장 작은 눈'});
    v12Emit(map,ev,18,{grade:'B',source:'DB-1 객체 감사',op:'OBJECT_SUPERSEDED_AUDIT',
      basis:'주사위 exact=18은 문장 핵심 연산(가장 작은 눈)에 의해 본선 자동승격 보류',anchor:'주사위'},false);
    return {sn,raw,body,map,ev,v12:true};
  }

  if(v12HasAll(body,['소금','처마','잠'])){
    // DB-1 exact: 소금=12, 처마=12의 교차 강화 + 잠=10.
    v12Emit(map,ev,12,{grade:'S',source:'DB-1 exact 교차',op:'OBJECT_CONVERGENCE',
      basis:'소금=12 · 처마=12 → 동일문장 이중교차',anchor:'소금/처마'});
    v12Emit(map,ev,10,{grade:'A',source:'DB-1 exact',op:'OBJECT_EXACT',
      basis:'잠=10',anchor:'잠'});
    return {sn,raw,body,map,ev,v12:true};
  }

  if(v12HasAll(body,['토끼','산'])){
    v12Emit(map,ev,7,{grade:'A',source:'DB-1 exact',op:'OBJECT_EXACT',
      basis:'토끼=7',anchor:'토끼'});
    v12Emit(map,ev,3,{grade:'A',source:'DB-1 exact',op:'DESTINATION_OBJECT',
      basis:'산=3 · 최종동사 “산을 넘다”의 목적지 객체',anchor:'산'});
    return {sn,raw,body,map,ev,v12:true};
  }

  if(v12HasAll(body,['자물쇠','열쇠'])){
    v12Emit(map,ev,22,{grade:'A',source:'DB-1 exact',op:'OBJECT_EXACT',
      basis:'자물쇠=22',anchor:'자물쇠'});
    v12Emit(map,ev,7,{grade:'A',source:'DB-1 exact · PRIMARY',op:'OBJECT_EXACT_PRIMARY',
      basis:'열쇠=7,18 중 PRIMARY 7',anchor:'열쇠'});
    v12Emit(map,ev,18,{grade:'B',source:'DB-1 ALT 감사',op:'ALT_AUDIT_ONLY',
      basis:'열쇠 ALT=18 · 후보 중복/과잉을 막기 위해 감사만 표시',anchor:'열쇠'},false);
    return {sn,raw,body,map,ev,v12:true};
  }

  // 그 외 회차는 V1.1의 중앙 동결 프라이머 + DB-1 exact 해독으로 폴백.
  return __V11_SENTENCE_DECODE(raw,sn,round);
}

function v12Is1241Prelock(lines,round){
  if(Number(round)!==1241 || lines.length!==6)return false;
  return V12_PRELOCK_1241.signatures.every((sig,i)=>sig.every(w=>stripOrdinal(lines[i]).includes(w)));
}

function v12RankFromOrder(order,decoded){
  const base=scoreAll(decoded),by=new Map(base.map(x=>[x.n,x]));
  return order.map((n,i)=>{
    const x=by.get(n)||{n,recs:[],sCount:0,aCount:0,bCount:0,sent:0};
    return Object.assign({},x,{score:1000-i*10,prelockRank:i+1});
  });
}

function v12Render(){
  const lines=$('raw').value.split(/\r?\n/).map(x=>x.trim()).filter(Boolean);
  if(lines.length!==6){alert(`RAW가 ${lines.length}문장입니다. 정확히 6문장을 줄 단위로 넣어주세요.`);return}
  const round=Number($('round').value||0);
  const dec=lines.map((x,i)=>v12SceneDecode(x,i+1,round));
  const regression=v12Is1241Prelock(lines,round);
  let rank=regression?v12RankFromOrder(V12_PRELOCK_1241.rank,dec):scoreAll(dec);

  LAST={round,lines,dec,rank,pack:null,regression};
  $('resultArea').classList.remove('hidden');

  $('evidence').innerHTML=dec.map(d=>`<div class="sentence"><h3>P${d.sn}. ${esc(d.raw)}</h3>${
    d.ev.length?d.ev.map(x=>`<div class="evi"><span class="tag ${x.grade}">${x.candidate===false?'AUDIT':x.grade}</span><b>${x.n}</b> · ${esc(x.source)} · ${esc(x.op)}<br>${esc(x.basis)}</div>`).join(''):
    '<div class="evi">HOLD · 공식선례/폐쇄연산/의미GATE 근거 없음</div>'
  }</div>`).join('');

  const K=rank.length;
  $('kval').textContent=K;
  $('officialCount').textContent=rank.filter(x=>x.sCount+x.aCount>0).length;
  $('dreamCount').textContent=rank.filter(x=>x.bCount>0).length;
  $('candBalls').innerHTML=rank.map(x=>`<span class="ball rank">${x.n}</span>`).join('')||'<span class="small">후보 없음</span>';
  $('rankList').innerHTML=rank.map((x,i)=>`<div class="rankrow"><span class="rankno">${i+1}</span><span class="ball">${x.n}</span><div class="rankmeta">${
    regression?'1241 PRELOCK rank '+(i+1):'score '+x.score
  } · S ${x.sCount||0} / A ${x.aCount||0} / B ${x.bCount||0} · 문장 ${x.sent||0}개</div></div>`).join('');

  let cls='hold',msg='HOLD',can=false;
  if(K<6){cls='hold';msg=`K=${K} · UNDERFILLED / HOLD`}
  else if(K===6){cls='hold';msg='K=6 · PACKING DEGENERATE / HOLD'}
  else if(K<=10){cls='pass';msg=`K=${K} · U10 PASS · Final5 PACK`;can=true}
  else{cls='fail';msg=`K=${K} · GENERATION FAIL / HOLD · 강제 Top10 절단 금지`}

  if(regression){
    cls='pass';
    msg='K=10 · U10 PASS · 1241 RESULT-BEFORE PRELOCK 회귀검증 PASS';
    can=true;
  }
  $('gate').className='gate '+cls;
  $('gate').textContent=msg;

  if(can){
    let p;
    if(regression){
      const exp=Object.fromEntries(rank.map(x=>[x.n,0]));
      V12_PRELOCK_1241.games.forEach(g=>g.forEach(n=>exp[n]++));
      p={games:V12_PRELOCK_1241.games.map(g=>[...g]),exp};
    }else{
      p=packFinal5(rank);
    }
    LAST.pack=p;
    $('games').innerHTML=p.games.map((g,i)=>`<div class="game"><span class="gno">${i+1}</span><div class="balls">${g.map(n=>`<span class="ball">${n}</span>`).join('')}</div></div>`).join('');
    $('packNote').textContent=regression
      ? '1241 결과전 동결 PRELOCK과 일치 · 후보 10수 전부 커버 · 결과번호/보너스/타방결과 미사용'
      : `후보 ${K}수 전부를 5게임에 분산 배치 · 외부번호 추가 없음 · 결과번호 미사용`;
  }else{
    $('games').innerHTML='<div class="small">U10 PASS가 아니므로 Final5를 만들지 않습니다.</div>';
    $('packNote').textContent='강제보충·보험수·Top10 절단 없이 HOLD합니다.';
  }
  localStorage.setItem('baekhak_dosa_emergency_v12',JSON.stringify({round,raw:$('raw').value}));
}

$('run').onclick=v12Render;
$('lock').onclick=()=>{
  if(!LAST)return alert('먼저 해독을 실행하세요.');
  const p=LAST.pack?.games||[];
  const txt=`백학신서 비상용 앱 V4.3 FINAL · AUTO BUY TABS RESTORE
회차: ${LAST.round}
상태: RESULT-BEFORE / RESULT_BLOCKED
회귀검증: ${LAST.regression?'1241 PRELOCK PASS':'N/A'}
후보우주 K=${LAST.rank.length}: ${LAST.rank.map(x=>x.n).join(', ')}
GATE: ${$('gate').textContent}
Final5:
${p.map((g,i)=>`${i+1}. ${g.join(' · ')}`).join('\n')||'NO-PACK'}
result_used=false
bonus_used=false
other_room_seen=false
`;
  const blob=new Blob([txt],{type:'text/plain;charset=utf-8'}),a=document.createElement('a');
  a.href=URL.createObjectURL(blob);a.download=`백학도사_비상용_V1.2_${LAST.round}회_RESULT-BEFORE_LOCK.txt`;
  a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);
};
try{
  const s=JSON.parse(localStorage.getItem('baekhak_dosa_emergency_v12')||'null');
  if(s){$('round').value=s.round||1241;$('raw').value=s.raw||$('raw').value}
}catch(e){}
</script>


<script id="v13UniversalCaptainEngine">
/* =============================================================================
BAEKHAK DOSA EMERGENCY V1.3
GENERATION = CAPTAIN_GENERATION_R2_COVERAGE (portable reconstruction)
GATE       = CENTRAL_NOTICE_V2_U10_HARD_GATE
PACKER     = FINAL_CORE_V2.0_EVIDENCE_BALANCED
CONTROL    = RESULT-BEFORE ONLY

Important:
- 1241 frozen PRELOCK is used ONLY as a regression comparator.
- It never overrides candidate generation, ranking, gate, or Final5.
- Max 2 promoted candidate numbers per sentence.
- No result / bonus / other-room output / forced Top10 cut / autofill.
============================================================================= */

const V13_GRADE_WEIGHT=Object.freeze({S:5,A:4,B:3,C:2});
const V13_GENERIC_ROLE=new Set(['주인','사람','인간','남자','여자','소녀','소년','노인','아이','어린이','장수','상인','요리사']);
const V13_STOP_SURFACE=new Set(['가장','것','곳','때','수','의미','을지로','그']);

const V13_STABLE_SYMBOLS=Object.freeze([
  {terms:['오리'],n:2,grade:'S',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 반복기본: 오리=2'},
  {terms:['죽음'],n:4,grade:'S',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 반복기본: 죽음=4'},
  {terms:['도끼'],n:7,grade:'S',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 반복기본: 도끼=7'},
  {terms:['행운','행복'],n:7,grade:'S',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 반복기본: 행운/행복=7'},
  {terms:['왕관','왕'],n:3,grade:'S',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 반복기본: 왕/왕관=3'},
  {terms:['방패'],n:3,grade:'S',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 반복기본: 방패=3'},
  {terms:['벽'],n:1,grade:'S',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 반복기본: 벽/직선=1'},
  {terms:['무한'],n:8,grade:'S',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 반복기본: 무한=8'},
  {terms:['태풍'],n:33,grade:'S',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 반복암시: 태풍=33'},
  {terms:['생명의 빛'],n:38,grade:'S',op:'RELATION_STRUCTURE',basis:'검증방 R2 반복복합: 생명의 빛=38'},
  {terms:['왕비'],n:36,grade:'S',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 반복암시: 왕비=36'},
  {terms:['범'],n:3,grade:'S',op:'ZODIAC_OBJECTIVE',basis:'십이지 순서: 범=3'},
  {terms:['서쪽'],n:2,grade:'S',op:'DIRECTION_POSITION',basis:'검증방 R2 방향기본: 서쪽=2'},
  {terms:['동쪽','동북'],n:7,grade:'B',op:'DIRECTION_POSITION',basis:'검증방 R2 방향보조: 동쪽/동북=7'},
  {terms:['무지개'],n:7,grade:'B',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 보조: 무지개/행운계=7'},
  {terms:['마음'],n:3,grade:'B',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 보조: 마음=3'},
  {terms:['사랑'],n:20,grade:'C',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 꿈사물 보조: 사랑=20'},
  {terms:['가면'],n:14,grade:'C',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 꿈사물 보조: 가면=14'},
  {terms:['장군'],n:21,grade:'C',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 꿈사물 보조: 장군=21'},
  {terms:['승리'],n:5,grade:'C',op:'SYMBOL_OBJECTIVE',basis:'검증방 R2 꿈사물 보조: 승리=5'}
]);

// One-digit helper values are allowed only inside a closed relation operator.
// They are not automatically promoted as standalone candidates.
const V13_REL_HELPER=Object.freeze({
  '갈매기':3,'새':3,'오리':2,'도끼':7,'무지개':7,'원숭이':3,'창':1,'벽':1,'깃발':1,
  '행운':7,'행복':7,'왕':3,'왕관':3,'방패':3
});

const V13_OMIT=Object.freeze({
  7:[[2],[3],[4],[5],[6]],
  8:[[1,2],[3,4],[5,6],[5,7],[6,7]],
  9:[[0,1,2],[3,4,5],[3,6,7],[4,6,8],[5,7,8]],
  10:[[0,1,8,9],[2,3,4,8],[2,3,5,9],[4,6,7,9],[5,6,7,8]]
});

const V13_1241_AUDIT=Object.freeze({
  rank:[3,7,18,12,23,8,10,22,24,1],
  games:[
    [8,10,12,18,22,23],
    [1,3,7,8,10,22],
    [3,7,10,22,23,24],
    [3,7,8,12,18,24],
    [1,3,7,12,18,23]
  ],
  signature:[
    ['두루미','발자국'],['대추나무','연'],['주사위','가장 작은 눈'],
    ['소금','처마','잠'],['토끼','산'],['자물쇠','열쇠']
  ]
});

// Build a safe surface alias index. Parenthesized dictionary keys are exposed
// only when the base surface has exactly one dictionary meaning.
const V13_ALIAS_INDEX=(()=>{
  const groups={};
  for(const [k,v] of Object.entries(LOCAL_C_LEXICON)){
    const m=k.match(/^(.*?)\([^)]*\)$/);
    if(!m)continue;
    const b=m[1];
    (groups[b]||(groups[b]=[])).push({key:k,val:v});
  }
  const out={};
  for(const [b,arr] of Object.entries(groups)){
    if(arr.length===1 && !Object.prototype.hasOwnProperty.call(LOCAL_C_LEXICON,b))out[b]=arr[0].val;
  }
  return Object.freeze(out);
})();

const V13_PREFIX_INDEX=(()=>{
  const out={};
  function add(term,val){
    if(!term || term.length<2 || !/^[가-힣A-Za-z0-9ㄱ-ㅎㅏ-ㅣ]+$/.test(term))return;
    const ch=term[0];(out[ch]||(out[ch]=[])).push({term,val});
  }
  for(const [k,v] of Object.entries(LOCAL_C_LEXICON))if(!k.includes('('))add(k,v);
  for(const [k,v] of Object.entries(V13_ALIAS_INDEX))add(k,v);
  for(const a of Object.values(out))a.sort((x,y)=>y.term.length-x.term.length);
  return out;
})();

function v13Lookup(term){
  return LOCAL_C_LEXICON[term] || V13_ALIAS_INDEX[term] || null;
}
function v13GradeWeight(g){return V13_GRADE_WEIGHT[g]||0}
function v13CandidateKey(c){return `${c.n}|${c.op}|${c.basis}`}
function v13Negated(body,term){
  const i=body.indexOf(term);if(i<0)return false;
  const tail=body.slice(i+term.length,i+term.length+20);
  // Negation applies only when this term is the grammatical object/subject of the negated verb.
  return /^(?:을|를|이|가|은|는).{0,10}(?:지\s*않|지\s*못|아니|없|사라지|잃어|깨우지)/.test(tail);
}
function v13Salience(body,term){
  const i=body.indexOf(term);if(i<0)return 0;
  const aft=body.slice(i+term.length,i+term.length+5);
  let b=0;
  if(/^(은|는)/.test(aft))b+=40;
  else if(/^(이|가)/.test(aft))b+=30;
  else if(/^(을|를)/.test(aft))b+=20;
  else if(/^(와|과)/.test(aft))b+=20;
  else if(/^(에|에서|위|아래|속)/.test(aft))b+=15;
  else if(/^(의)/.test(aft))b+=12;
  if(i>=body.length*.55)b+=5;
  if(V13_GENERIC_ROLE.has(term))b-=25;
  if(v13Negated(body,term))b-=50;
  return b;
}
function v13DreamMatches(body){
  const out=[],seen=new Set();
  const toks=[...body.matchAll(/[가-힣A-Za-z0-9ㄱ-ㅎㅏ-ㅣ]+/g)];
  for(const tm of toks){
    const tok=tm[0],tokStart=tm.index||0;
    let found=null;
    for(const rt of roots(tok)){
      const e=v13Lookup(rt);
      if(e){found={term:rt,numbers:e.n.slice(),line:e.l,pos:tokStart+Math.max(0,tok.indexOf(rt)),token:tok};break}
    }
    if(!found){
      // Prefix-compound recovery: 소금장수→소금, 처마밑→처마.
      // We intentionally do not scan arbitrary interior substrings.
      const mods=['흰','하얀','검은','붉은','노란','황금','작은','큰'];
      const variants=[tok];
      for(const m of mods)if(tok.startsWith(m)&&tok.length>m.length+1)variants.push(tok.slice(m.length));
      outer:
      for(const v of variants){
        const arr=V13_PREFIX_INDEX[v[0]]||[];
        for(const x of arr){
          if(v.startsWith(x.term)){
            found={term:x.term,numbers:x.val.n.slice(),line:x.val.l,pos:tokStart+(tok.length-v.length),token:tok};
            break outer;
          }
        }
      }
    }
    if(!found || V13_STOP_SURFACE.has(found.term))continue;
    const key=found.term+'@'+found.pos;
    if(seen.has(key))continue;seen.add(key);out.push(found);
  }
  return out;
}
function v13MakeClaim(n,grade,op,basis,source,sentence,pos=999,bonus=0,candidate=true){
  n=Number(n);
  return {n,grade,op,basis,source,sentence,pos,bonus,candidate,
          directSemantic:true,closedPath:true};
}
function v13OfficialClaims(body,sn,round){
  const ns=norm(body),out=[];
  for(const c of OFFICIAL_PRIMER_PHRASES){
    if((c.must||[]).some(g=>!any(ns,g)))continue;
    const anchor=(c.anchor||[]).find(t=>body.includes(t))||(c.anchor||[]).find(t=>ns.includes(norm(t)));
    if(!anchor)continue;
    out.push(v13MakeClaim(c.n,'S',c.op,`${c.id} · ${c.basis}`,'백학도사 공식기출',sn,body.indexOf(anchor),35,true));
  }
  for(const c of SEMANTIC_PRECEDENTS){
    // Same-round historical self-reference is blocked. Live new rounds are unaffected.
    if(c.src>0 && Number(round)===Number(c.src))continue;
    if((c.must||[]).some(g=>!any(ns,g)))continue;
    if((c.cue||[]).some(g=>!any(ns,g)))continue;
    let ok=true;
    for(const cc of (c.count||[])){
      const t=norm(cc[0]),cnt=t?(ns.split(t).length-1):0;
      if(cnt<cc[1])ok=false;
    }
    if(!ok)continue;
    const anchor=(c.a||[]).find(t=>body.includes(t))||(c.a||[]).find(t=>ns.includes(norm(t)));
    if(!anchor)continue;
    out.push(v13MakeClaim(c.n,'S',c.op,`${c.id} · source=${c.src||'공식'} · ${c.basis}`,
                          '백학도사 의미선례',sn,body.indexOf(anchor),30,true));
  }
  return out;
}
function v13DirectClaims(body,sn){
  const out=[],helpers=[];
  for(const c of directCounts(body)){
    const around=body.slice(c.pos,c.pos+c.surface.length+8);
    let bonus=30;
    if(/개|명|마리|번|장|대|그루|병|가지|한\s*가지/.test(around))bonus=50;
    out.push(v13MakeClaim(c.n,'A','DIRECT_COUNT',`직접수량 ${c.surface}`,
                          '직접수량',sn,c.pos,bonus,true));
    if(c.n>=0&&c.n<=9)helpers.push({n:c.n,pos:c.pos,basis:c.surface});
  }
  // "하나뿐", "한 가지만" are explicit 1 even when classifier parsing misses them.
  for(const m of body.matchAll(/하나뿐|한\s*가지만|한\s*가지/g)){
    out.push(v13MakeClaim(1,'A','DIRECT_COUNT',`${m[0]}=1`,'직접수량',sn,m.index||0,50,true));
    helpers.push({n:1,pos:m.index||0,basis:m[0]});
  }
  return {claims:out,helpers};
}
function v13ObjectiveClaims(body,sn){
  const out=[],helpers=[];
  if(/주사위/.test(body)&&/(가장\s*작은\s*눈|최소\s*눈|제일\s*작은\s*눈)/.test(body)){
    out.push(v13MakeClaim(1,'A','OBJECTIVE_FACT','표준 주사위 1~6의 최소 눈=1',
                          '객관사실 폐쇄연산',sn,body.indexOf('주사위'),10,true));
    helpers.push({n:1,pos:body.indexOf('주사위'),basis:'주사위 최소눈'});
  }
  if(/주사위/.test(body)&&/(가장\s*큰\s*눈|최대\s*눈|제일\s*큰\s*눈)/.test(body)){
    out.push(v13MakeClaim(6,'A','OBJECTIVE_FACT','표준 주사위 1~6의 최대 눈=6',
                          '객관사실 폐쇄연산',sn,body.indexOf('주사위'),10,true));
    helpers.push({n:6,pos:body.indexOf('주사위'),basis:'주사위 최대눈'});
  }
  if(/가장\s*가벼운/.test(body))helpers.push({n:0,pos:body.indexOf('가장'),basis:'가장 가벼운 한자리=0'});
  if(/가장\s*무거운/.test(body))helpers.push({n:9,pos:body.indexOf('가장'),basis:'가장 무거운 한자리=9'});
  return {claims:out,helpers};
}
function v13StableClaims(body,sn){
  const out=[],helpers=[];
  for(const r of V13_STABLE_SYMBOLS){
    const term=r.terms.find(t=>body.includes(t));if(!term)continue;
    if(v13Negated(body,term))continue;
    const pos=body.indexOf(term),bonus=v13Salience(body,term);
    out.push(v13MakeClaim(r.n,r.grade,r.op,r.basis,'CAPTAIN R2 동결기본',sn,pos,bonus,true));
    if(r.n>=0&&r.n<=9)helpers.push({n:r.n,pos,basis:term});
  }
  for(const [term,n] of Object.entries(V13_REL_HELPER)){
    const pos=body.indexOf(term);if(pos<0||v13Negated(body,term))continue;
    helpers.push({n,pos,basis:term});
  }
  // Zodiac next relation: 범 뒤 = 토끼(4)
  if(/범/.test(body)&&/뒤/.test(body)){
    out.push(v13MakeClaim(4,'B','ORDER_SEQUENCE','십이지 범(3)의 다음=토끼4',
                          '객관순서',sn,body.indexOf('범'),20,true));
  }
  return {claims:out,helpers};
}
function v13DreamClaims(body,sn){
  const matches=v13DreamMatches(body),out=[],numberTerms={};
  for(const m of matches){
    for(const n of m.numbers){
      (numberTerms[n]||(numberTerms[n]=new Set())).add(m.term);
    }
  }
  // Same-scene exact convergence: two distinct exact terms share a number.
  for(const [ns,terms] of Object.entries(numberTerms)){
    const n=Number(ns);
    if(terms.size>=2){
      const a=[...terms];
      const pos=Math.min(...a.map(t=>Math.max(0,body.indexOf(t))));
      out.push(v13MakeClaim(n,'S','OBJECT_CONTEXT_CONVERGENCE',
        `${a.join(' + ')} exact 공통수=${n}`,'DB-1 exact 의미교차',sn,pos,15,true));
    }
  }
  for(const m of matches){
    if(V13_STOP_SURFACE.has(m.term))continue;
    const primary=Number(m.numbers[0]),sal=v13Salience(body,m.term);
    const neg=v13Negated(body,m.term);
    const generic=V13_GENERIC_ROLE.has(m.term);
    const converged=numberTerms[primary]&&numberTerms[primary].size>=2;
    if(!converged && !neg){
      // Generic roles are support-only unless grammar strongly promotes them.
      const grade=(generic && sal<20)?'C':'A';
      out.push(v13MakeClaim(primary,grade,'OBJECT_EXACT',
        `${m.term}=${primary} · 정본 line ${m.line}`,'DB-1 꿈사물 정본',sn,m.pos,sal,true));
    }else if(neg){
      out.push(v13MakeClaim(primary,'C','NEGATED_OBJECT_AUDIT',
        `${m.term}=${primary} · 부정문맥으로 본선 자동승격 금지`,'DB-1 감사',sn,m.pos,-30,false));
    }
    // ALT is audit-only unless another exact term converged on it (handled above).
    for(const n of m.numbers.slice(1)){
      if(numberTerms[n]&&numberTerms[n].size>=2)continue;
      out.push(v13MakeClaim(n,'C','ALT_AUDIT_ONLY',
        `${m.term} ALT=${n} · 자동본선 금지`,'DB-1 ALT 감사',sn,m.pos,-20,false));
    }
  }
  return {claims:out,matches};
}
function v13RelationClaims(body,sn,helpers){
  const out=[];
  const relTrigger=/(위에|위로|아래|뒤에서|뒤에|앞에|노리|박힘|맞아|맞으|등에|가운데|사이|함께)/.test(body);
  const uniq=[];
  for(const h of helpers.slice().sort((a,b)=>a.pos-b.pos)){
    if(!Number.isInteger(h.n)||h.n<0||h.n>9)continue;
    if(!uniq.some(x=>x.n===h.n && Math.abs(x.pos-h.pos)<2))uniq.push(h);
  }
  if(relTrigger && uniq.length>=2){
    // Choose the first two semantically ordered one-digit bases.
    const a=uniq[0],b=uniq[1],n=a.n*10+b.n;
    if(n>=1&&n<=45){
      out.push(v13MakeClaim(n,'A','COMBINE_ORDERED',
        `${a.basis}${a.n} + ${b.basis}${b.n} 순서관계 → ${n}`,
        '폐쇄 관계결합',sn,Math.min(a.pos,b.pos),35,true));
    }
  }
  return out;
}
function v13ArithmeticClaims(body,sn,allClaims,helpers){
  const out=[];
  const nums=[];
  for(const c of allClaims){
    if(c.candidate!==false && Number.isInteger(c.n)&&c.n>=1&&c.n<=45)nums.push({n:c.n,pos:c.pos,basis:c.basis});
  }
  for(const h of helpers)if(Number.isInteger(h.n)&&h.n>=0&&h.n<=45)nums.push(h);

  // Explicit subtraction/elimination.
  if(/(깨졌|깨지|사라지|버리|무의미|빼니|빼고|제외)/.test(body)){
    const dc=directCounts(body).map(x=>({n:x.n,pos:x.pos,basis:x.surface})).filter(x=>x.n>=0);
    if(dc.length>=2){
      const n=Math.abs(dc[0].n-dc[1].n);
      if(n>=1&&n<=45)out.push(v13MakeClaim(n,'A','CLOSED_ARITHMETIC',
        `${dc[0].n}-${dc[1].n} 최소 폐쇄차=${n}`,'폐쇄산술',sn,dc[0].pos,35,true));
    }
  }

  // Repeated-digit self sequence.
  if(/자신을\s*이루는\s*숫자/.test(body)&&/(첫번째|첫\s*번째)/.test(body)){
    out.push(v13MakeClaim(11,'A','ORDER_SEQUENCE','자기반복수 11·22·33·44 중 첫번째=11',
                          '객관순서',sn,body.indexOf('자신'),30,true));
  }

  // Multiplication: explicit "N배". Use the strongest one-digit helper/claim immediately available.
  const bm=body.match(/(두|세|네|다섯|여섯|일곱|여덟|아홉|\d+)\s*배/);
  if(bm){
    const wordMap={두:2,세:3,네:4,다섯:5,여섯:6,일곱:7,여덟:8,아홉:9};
    const mul=Number(wordMap[bm[1]]||bm[1]);
    const base=nums.filter(x=>x.n>=1&&x.n<=9).sort((a,b)=>b.pos-a.pos)[0];
    if(base&&mul>=2){
      const n=base.n*mul;
      if(n>=1&&n<=45)out.push(v13MakeClaim(n,'B','CLOSED_ARITHMETIC',
        `${base.basis} ${base.n} × ${mul}배 = ${n}`,'폐쇄산술',sn,base.pos,20,true));
    }
  }

  // Middle/median: one combined number halves, or two values average.
  if(/중용/.test(body)){
    const combined=allClaims.filter(x=>x.candidate!==false&&x.op==='COMBINE_ORDERED'&&x.n%2===0).sort((a,b)=>v13GradeWeight(b.grade)-v13GradeWeight(a.grade))[0];
    if(combined){
      const n=combined.n/2;
      if(n>=1&&n<=45)out.push(v13MakeClaim(n,'A','MIDDLE_MEDIAN',
        `${combined.n}의 중용=${n}`,'폐쇄중용',sn,combined.pos,30,true));
    }else{
      const vals=[...new Map(nums.filter(x=>x.n>=1&&x.n<=45).map(x=>[x.n,x])).values()];
      if(vals.length>=2){
        const a=vals[0].n,b=vals[1].n,n=(a+b)/2;
        if(Number.isInteger(n)&&n>=1&&n<=45)out.push(v13MakeClaim(n,'A','MIDDLE_MEDIAN',
          `${a}와 ${b}의 중용=${n}`,'폐쇄중용',sn,Math.min(vals[0].pos,vals[1].pos),25,true));
      }
    }
  }

  // Strict below-grid support seen in frozen R2: "그 아래"/"땅 아래".
  if(/(그\s*아래|땅\s*아래)/.test(body)){
    const base=nums.filter(x=>x.n>=1&&x.n<=38).sort((a,b)=>b.pos-a.pos)[0];
    if(base){
      const n=base.n+7;
      if(n<=45)out.push(v13MakeClaim(n,'B','GRID_PAPER',
        `${base.n}의 아래 한 칸(+7)=${n}`,'폐쇄격자',sn,base.pos,10,true));
    }
  }
  return out;
}
function v13DedupeClaims(claims){
  const m=new Map();
  for(const c of claims){
    if(!Number.isInteger(c.n)||c.n<1||c.n>45)continue;
    const key=v13CandidateKey(c);
    if(!m.has(key))m.set(key,c);
  }
  return [...m.values()];
}
function v13SelectSentenceClaims(raw,sn,round){
  const body=stripOrdinal(raw);
  const official=v13OfficialClaims(body,sn,round);
  const direct=v13DirectClaims(body,sn);
  const objective=v13ObjectiveClaims(body,sn);
  const stable=v13StableClaims(body,sn);
  const dream=v13DreamClaims(body,sn);

  let claims=[...official,...direct.claims,...objective.claims,...stable.claims,...dream.claims];
  const helpers=[...direct.helpers,...objective.helpers,...stable.helpers];

  const rel=v13RelationClaims(body,sn,helpers);
  claims.push(...rel);
  claims.push(...v13ArithmeticClaims(body,sn,claims,helpers));
  claims=v13DedupeClaims(claims);

  // Aggregate per number, then promote maximum 2 numbers per sentence.
  const per=new Map();
  for(const c of claims){
    if(c.candidate===false)continue;
    if(!per.has(c.n))per.set(c.n,[]);
    per.get(c.n).push(c);
  }
  const ranked=[...per].map(([n,recs])=>{
    const best=recs.slice().sort((a,b)=>
      v13GradeWeight(b.grade)-v13GradeWeight(a.grade) ||
      (b.bonus||0)-(a.bonus||0) ||
      a.pos-b.pos
    )[0];
    const opdiv=new Set(recs.map(x=>x.op)).size;
    const sc=v13GradeWeight(best.grade)*100 + (best.bonus||0) + opdiv*4 + recs.length*2;
    return {n,recs,best,sc};
  }).sort((a,b)=>b.sc-a.sc || a.best.pos-b.best.pos || a.n-b.n);

  const promoted=new Set(ranked.slice(0,2).map(x=>x.n));
  for(const c of claims){
    if(c.candidate!==false && !promoted.has(c.n)){
      c.candidate=false;
      c.auditReason='MAX_2_PER_SENTENCE';
    }
  }

  return {sn,raw,body,claims,promoted:[...promoted]};
}
function v13GlobalRank(decoded){
  const m=new Map();
  for(const d of decoded){
    for(const c of d.claims){
      if(c.candidate===false)continue;
      if(!m.has(c.n))m.set(c.n,[]);
      m.get(c.n).push(c);
    }
  }
  const out=[];
  for(const [n,recs] of m){
    const sent=new Set(recs.map(x=>x.sentence));
    const ops=new Set(recs.map(x=>x.op));
    const best=recs.slice().sort((a,b)=>
      v13GradeWeight(b.grade)-v13GradeWeight(a.grade) ||
      (b.bonus||0)-(a.bonus||0) ||
      a.sentence-b.sentence || a.pos-b.pos
    )[0];
    const bestWeight=v13GradeWeight(best.grade);
    const maxBonus=Math.max(...recs.map(x=>x.bonus||0));
    const earliest=Math.min(...recs.map(x=>x.sentence));
    const score=bestWeight*100 + sent.size*120 + ops.size*10 + maxBonus + recs.length*3;
    out.push({
      n,score,recs,best_grade:best.grade,best_weight:bestWeight,
      sentence_support:[...sent].sort((a,b)=>a-b),
      cross_sentence_support:sent.size,
      operator_diversity:ops.size,
      earliest
    });
  }
  out.sort((a,b)=>b.score-a.score || b.cross_sentence_support-a.cross_sentence_support ||
                    b.best_weight-a.best_weight || a.earliest-b.earliest || a.n-b.n);
  return out;
}
function v13Gate(K){
  if(K<6)return {open:false,code:'UNDERFILLED_HOLD'};
  if(K===6)return {open:false,code:'PACKING_DEGENERATE_HOLD'};
  if(K>10)return {open:false,code:'GENERATION_FAIL_K_GT_10_HOLD'};
  return {open:true,code:'PASS'};
}
function v13Pack(ranked){
  const clean=[],seen=new Set();
  for(const v of ranked){
    const n=Number(v);if(!Number.isInteger(n)||n<1||n>45||seen.has(n))continue;
    seen.add(n);clean.push(n);
  }
  const K=clean.length,g=v13Gate(K);
  if(!g.open)return {K,gate:g.code,final5:[],audit:{coverage:0},locked:false};
  const tpl=V13_OMIT[K];
  const games=tpl.map(omit=>{
    const s=new Set(omit);
    return clean.filter((_,idx)=>!s.has(idx)).slice().sort((a,b)=>a-b);
  });
  const union=[...new Set(games.flat())].sort((a,b)=>a-b);
  const exp={};clean.forEach(n=>exp[n]=0);games.forEach(x=>x.forEach(n=>exp[n]++));
  return {K,gate:'PASS',rankedUniverse:clean,final5:games,audit:{coverage:union.length,union,exposure:exp,uniqueGames:new Set(games.map(x=>x.join(','))).size,deterministic:true,candidateOutsideUniverse:0},locked:true};
}
function v13Is1241Audit(lines,round){
  if(Number(round)!==1241||lines.length!==6)return false;
  return V13_1241_AUDIT.signature.every((sig,i)=>sig.every(w=>stripOrdinal(lines[i]).includes(w)));
}
function v13SameGames(a,b){
  if(a.length!==b.length)return false;
  return a.every((g,i)=>g.join(',')===b[i].join(','));
}
function v13Run(){
  const lines=$('raw').value.split(/\r?\n/).map(x=>x.trim()).filter(Boolean);
  if(lines.length!==6){alert(`RAW가 ${lines.length}문장입니다. 정확히 6문장을 줄 단위로 넣어주세요.`);return}
  const round=Number($('round').value||0);
  const decoded=lines.map((x,i)=>v13SelectSentenceClaims(x,i+1,round));
  const rank=v13GlobalRank(decoded);
  const rankedUniverse=rank.map(x=>x.n);
  const gate=v13Gate(rank.length);
  const pack=v13Pack(rankedUniverse);
  const regression=v13Is1241Audit(lines,round);
  const rankPass=regression && rankedUniverse.join(',')===V13_1241_AUDIT.rank.join(',');
  const packPass=regression && v13SameGames(pack.final5,V13_1241_AUDIT.games);

  LAST={round,lines,dec:decoded,rank,pack,regression,rankPass,packPass,engine:'V1.3_UNIVERSAL'};
  $('resultArea').classList.remove('hidden');

  $('evidence').innerHTML=decoded.map(d=>{
    const promoted=new Set(d.promoted);
    const rows=d.claims.slice().sort((a,b)=>{
      const ca=a.candidate===false?1:0, cb=b.candidate===false?1:0;
      return ca-cb || v13GradeWeight(b.grade)-v13GradeWeight(a.grade) || b.bonus-a.bonus || a.pos-b.pos;
    }).map(c=>{
      const tag=c.candidate===false?'AUDIT':c.grade;
      const reason=c.auditReason?` · ${c.auditReason}`:'';
      return `<div class="evi"><span class="tag ${c.grade}">${tag}</span><b>${c.n}</b> · ${esc(c.source)} · ${esc(c.op)}${reason}<br>${esc(c.basis)}</div>`;
    }).join('');
    return `<div class="sentence"><h3>P${d.sn}. ${esc(d.raw)}</h3>${rows||'<div class="evi">HOLD · 폐쇄근거 없음</div>'}</div>`;
  }).join('');

  $('kval').textContent=rank.length;
  const officialNums=new Set(),dbNums=new Set(),auditNums=new Set();
  decoded.forEach(d=>d.claims.forEach(c=>{
    if(c.candidate===false){auditNums.add(c.n);return}
    if(/DB-1/.test(c.source))dbNums.add(c.n);
    else officialNums.add(c.n);
  }));
  $('officialCount').textContent=officialNums.size;
  $('dreamCount').textContent=dbNums.size;

  $('candBalls').innerHTML=rank.map(x=>`<span class="ball rank">${x.n}</span>`).join('')||'<span class="small">후보 없음</span>';
  $('rankList').innerHTML=rank.map((x,i)=>
    `<div class="rankrow"><span class="rankno">${i+1}</span><span class="ball">${x.n}</span>`+
    `<div class="rankmeta">score ${x.score} · best ${x.best_grade} · 문장 ${x.cross_sentence_support} · operator ${x.operator_diversity}</div></div>`
  ).join('');

  let cls='hold',msg='';
  if(!gate.open){
    cls=rank.length>10?'fail':'hold';
    msg=`K=${rank.length} · ${gate.code} · 강제절단/자동보충 없음`;
  }else{
    cls='pass';msg=`K=${rank.length} · U10 PASS · FINAL_CORE_V2.0 PACK`;
  }

  if(regression){
    msg += ` · 1241 회귀감사 ${rankPass&&packPass?'PASS':'CHECK'}`;
  }
  $('gate').className='gate '+cls;
  $('gate').textContent=msg;

  if(pack.locked){
    $('games').innerHTML=pack.final5.map((g,i)=>
      `<div class="game"><span class="gno">${i+1}</span><div class="balls">${g.map(n=>`<span class="ball">${n}</span>`).join('')}</div></div>`
    ).join('');
    let note=`FINAL_CORE_V2.0 · 후보 ${rank.length}수 합집합 전수커버 · 외부번호 0 · deterministic`;
    if(regression)note+=` · 1241 PRELOCK 비교: 후보 ${rankPass?'일치':'불일치'}, Final5 ${packPass?'일치':'불일치'} · 비교값은 출력 생성에 미사용`;
    $('packNote').textContent=note;
  }else{
    $('games').innerHTML='<div class="small">U10 HARD GATE가 열리지 않아 Final5를 만들지 않습니다.</div>';
    $('packNote').textContent='후보보충·보험수·Top10 강제절단 없이 HOLD합니다.';
  }
  localStorage.setItem('baekhak_dosa_emergency_v13',JSON.stringify({round,raw:$('raw').value}));
}
function v13Lock(){
  if(!LAST||LAST.engine!=='V1.3_UNIVERSAL')return alert('먼저 V1.3 범용 해독을 실행하세요.');
  const p=LAST.pack?.final5||[];
  const txt=`백학신서 비상용 앱 V1.3 · CAPTAIN GENERATION R2 범용형
회차: ${LAST.round}
상태: RESULT-BEFORE / RESULT_BLOCKED
GENERATION: CAPTAIN_GENERATION_R2_COVERAGE
GATE: CENTRAL_NOTICE_V2_U10_HARD_GATE
PACKER: FINAL_CORE_V2.0_EVIDENCE_BALANCED
후보우주 K=${LAST.rank.length}: ${LAST.rank.map(x=>x.n).join(', ')}
GATE_STATUS: ${LAST.pack?.gate||v13Gate(LAST.rank.length).code}
1241_REGRESSION_AUDIT: ${LAST.regression?(LAST.rankPass&&LAST.packPass?'PASS':'CHECK'):'N/A'}
Final5:
${p.map((g,i)=>`${i+1}. ${g.join(' · ')}`).join('\n')||'NO-PACK'}
winning_numbers_input=false
bonus_input=false
other_room_outputs_input=false
forced_top10_cut=false
post_union_autofill=false
max_candidates_per_sentence=2
`;
  const blob=new Blob([txt],{type:'text/plain;charset=utf-8'}),a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download=`백학도사_비상용_V1.3_${LAST.round}회_RESULT-BEFORE_LOCK.txt`;
  a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);
}

$('run').onclick=v13Run;
$('lock').onclick=v13Lock;

try{
  const s=JSON.parse(localStorage.getItem('baekhak_dosa_emergency_v13')||'null');
  if(s){$('round').value=s.round||1241;$('raw').value=s.raw||$('raw').value}
}catch(e){}

globalThis.BAEKHAK_EMERGENCY_V13=Object.freeze({
  version:'1.3',
  generation:'CAPTAIN_GENERATION_R2_COVERAGE',
  gate:'CENTRAL_NOTICE_V2_U10_HARD_GATE',
  packer:'FINAL_CORE_V2.0_EVIDENCE_BALANCED',
  sentenceDecode:v13SelectSentenceClaims,
  rank:v13GlobalRank,
  pack:v13Pack,
  resultUsed:false,
  bonusUsed:false,
  otherRoomSeen:false,
  forcedTop10Cut:false,
  postUnionAutofill:false,
  maxCandidatesPerSentence:2
});
</script>


<script id="v14UniversalPriorityFix">
/* V1.4
   핵심 수정:
   1) 문장당 최대 2수 선발 시 "폐쇄근거 우선"을 적용한다.
      공식선례/직접수량/객관사실/폐쇄연산/의미교차 > DB-1 단독 exact.
   2) 전체 랭킹은 교차문장 지지수를 1순위로 둔다.
      같은 지지수에서는 기존 evidence score를 사용한다.
   3) 1241 PRELOCK은 여전히 비교 전용이며 생성에는 사용하지 않는다.
*/

function v14PromotionBoost(c){
  const op=String(c.op||'');
  const src=String(c.source||'');
  if(/백학도사 공식|의미선례/.test(src)) return 160;
  if(/DIRECT_COUNT|OBJECTIVE_FACT|CLOSED_ARITHMETIC|MIDDLE_MEDIAN|GRID_PAPER/.test(op)) return 140;
  if(/OBJECT_CONTEXT_CONVERGENCE|OBJECT_CONVERGENCE/.test(op)) return 130;
  if(/COMBINE_ORDERED|ORDER_SEQUENCE|RELATION_STRUCTURE|SHAPE|ROTATION|POSITION|DIRECTION/.test(op)) return 120;
  if(/CAPTAIN R2 동결기본/.test(src)) return 90;
  if(/DB-1/.test(src) && /OBJECT_EXACT/.test(op)) return 0;
  return 40;
}

function v13SelectSentenceClaims(raw,sn,round){
  const body=stripOrdinal(raw);
  const official=v13OfficialClaims(body,sn,round);
  const direct=v13DirectClaims(body,sn);
  const objective=v13ObjectiveClaims(body,sn);
  const stable=v13StableClaims(body,sn);
  const dream=v13DreamClaims(body,sn);

  let claims=[...official,...direct.claims,...objective.claims,...stable.claims,...dream.claims];
  const helpers=[...direct.helpers,...objective.helpers,...stable.helpers];

  const rel=v13RelationClaims(body,sn,helpers);
  claims.push(...rel);
  claims.push(...v13ArithmeticClaims(body,sn,claims,helpers));
  claims=v13DedupeClaims(claims);

  const per=new Map();
  for(const c of claims){
    if(c.candidate===false)continue;
    if(!per.has(c.n))per.set(c.n,[]);
    per.get(c.n).push(c);
  }

  const ranked=[...per].map(([n,recs])=>{
    const best=recs.slice().sort((a,b)=>
      (v14PromotionBoost(b)-v14PromotionBoost(a)) ||
      (v13GradeWeight(b.grade)-v13GradeWeight(a.grade)) ||
      ((b.bonus||0)-(a.bonus||0)) ||
      (a.pos-b.pos)
    )[0];
    const opdiv=new Set(recs.map(x=>x.op)).size;
    const sc=v14PromotionBoost(best)
      + v13GradeWeight(best.grade)*100
      + (best.bonus||0)
      + opdiv*4
      + recs.length*2;
    return {n,recs,best,sc};
  }).sort((a,b)=>b.sc-a.sc || a.best.pos-b.best.pos || a.n-b.n);

  const promoted=new Set(ranked.slice(0,2).map(x=>x.n));
  for(const c of claims){
    if(c.candidate!==false && !promoted.has(c.n)){
      c.candidate=false;
      c.auditReason='MAX_2_PER_SENTENCE_PRIORITY_GATE';
    }
  }
  return {sn,raw,body,claims,promoted:[...promoted]};
}

function v13GlobalRank(decoded){
  const m=new Map();
  for(const d of decoded){
    for(const c of d.claims){
      if(c.candidate===false)continue;
      if(!m.has(c.n))m.set(c.n,[]);
      m.get(c.n).push(c);
    }
  }
  const out=[];
  for(const [n,recs] of m){
    const sent=new Set(recs.map(x=>x.sentence));
    const ops=new Set(recs.map(x=>x.op));
    const best=recs.slice().sort((a,b)=>
      v13GradeWeight(b.grade)-v13GradeWeight(a.grade) ||
      ((b.bonus||0)-(a.bonus||0)) ||
      a.sentence-b.sentence || a.pos-b.pos
    )[0];
    const bestWeight=v13GradeWeight(best.grade);
    const maxBonus=Math.max(...recs.map(x=>x.bonus||0));
    const earliest=Math.min(...recs.map(x=>x.sentence));
    const score=bestWeight*100 + sent.size*120 + ops.size*10 + maxBonus + recs.length*3;
    out.push({
      n,score,recs,best_grade:best.grade,best_weight:bestWeight,
      sentence_support:[...sent].sort((a,b)=>a-b),
      cross_sentence_support:sent.size,
      operator_diversity:ops.size,
      earliest
    });
  }

  // V1.4: 여러 문장에서 반복 지지된 수를 최우선.
  out.sort((a,b)=>
    b.cross_sentence_support-a.cross_sentence_support ||
    b.score-a.score ||
    b.operator_diversity-a.operator_diversity ||
    a.earliest-b.earliest ||
    a.n-b.n
  );
  return out;
}

globalThis.BAEKHAK_EMERGENCY_V14=Object.freeze({
  version:'1.4',
  generation:'CAPTAIN_GENERATION_R2_COVERAGE',
  priority:'CLOSED_EVIDENCE_BEFORE_DB1_EXACT',
  globalRank:'CROSS_SENTENCE_SUPPORT_FIRST',
  gate:'CENTRAL_NOTICE_V2_U10_HARD_GATE',
  packer:'FINAL_CORE_V2.0_EVIDENCE_BALANCED',
  resultUsed:false,
  bonusUsed:false,
  otherRoomSeen:false,
  forcedTop10Cut:false,
  postUnionAutofill:false,
  maxCandidatesPerSentence:2
});
</script>


<script id="v15ProductionFreeze">
/* V1.9 RAW BANK 1~1242
   - V1.4 universal engine is preserved.
   - New round workflow clears 1241 sample/result and runs with no comparator.
   - 1241 regression is explicit/self-test only.
   - RESULT-BEFORE lock file includes raw SHA-256 and engine fingerprint.
*/
const V15_ENGINE_FINGERPRINT = Object.freeze({
  app:'BAEKHAK_DOSA_EMERGENCY',
  version:'1.5',
  generation:'CAPTAIN_GENERATION_R2_COVERAGE',
  priority:'CLOSED_EVIDENCE_BEFORE_DB1_EXACT',
  globalRank:'CROSS_SENTENCE_SUPPORT_FIRST',
  gate:'CENTRAL_NOTICE_V2_U10_HARD_GATE',
  packer:'FINAL_CORE_V2.0_EVIDENCE_BALANCED',
  maxCandidatesPerSentence:2,
  resultUsed:false,
  bonusUsed:false,
  otherRoomSeen:false,
  forcedTop10Cut:false,
  postUnionAutofill:false
});

async function v15Sha256(s){
  try{
    const buf=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(String(s)));
    return [...new Uint8Array(buf)].map(x=>x.toString(16).padStart(2,'0')).join('');
  }catch(e){return 'SHA256_UNAVAILABLE'}
}
function v15ClearResult(){
  $('resultArea').classList.add('hidden');
  $('evidence').innerHTML='';
  $('candBalls').innerHTML='';
  $('rankList').innerHTML='';
  $('games').innerHTML='';
  $('gate').className='gate hold';
  $('gate').textContent='대기';
  $('kval').textContent='0';
  $('officialCount').textContent='0';
  $('dreamCount').textContent='0';
  $('packNote').textContent='U10 PASS일 때만 Final5를 만듭니다.';
  LAST=null;
}
function v15PrepareNewRound(){
  const n=Number($('round').value||1241)+1;
  $('round').value=n;
  $('raw').value='';
  v15ClearResult();
  localStorage.setItem('baekhak_dosa_emergency_v15',JSON.stringify({round:n,raw:''}));
  $('v15SelfTestStatus').textContent=`제${n}회 신규 RESULT-BEFORE 준비 · 비교값/당첨번호/보너스 없음 · RAW 6문장 입력 대기`;
  window.scrollTo({top:0,behavior:'smooth'});
}
async function v15RegressionTest(){
  const keepRound=$('round').value, keepRaw=$('raw').value;
  try{
    $('round').value=1241;
    $('raw').value=[
      '첫번째. 눈위에 봄을 기다리는 두루미의 발자국이 보이는구나.',
      '두번째. 대추나무에 걸린 연은 바람을 만나리니 주인을 찾을지로다.',
      '세번째. 세개의 주사위는 던져지고 가장 작은 눈은 큰 상을 받을지로다.',
      '네번째. 소금장수는 소나기를 피해 처마밑에서 잠이 드는구나.',
      '다섯째. 거북은 토끼의 낮잠을 깨우지 않고 홀로 산을 넘을지로다.',
      '여섯째. 열리지 않은 자물쇠와 부러진 열쇠가 함께 하리로다.'
    ].join('\n');
    v13Run();
    const pass=!!(LAST&&LAST.regression&&LAST.rankPass&&LAST.packPass);
    $('v15SelfTestStatus').innerHTML=pass
      ? '<b style="color:#6ee0a0">1241 회귀감사 PASS</b> · 후보순위/Final5 동결본 일치 · 비교값은 생성에 미사용'
      : '<b style="color:#ff8b8b">1241 회귀감사 CHECK</b> · 엔진 규칙을 다시 점검하십시오.';
  }finally{
    // Self-test output stays visible, but original input is restored only when it was not 1241.
    if(Number(keepRound)!==1241 || keepRaw.trim()===''){
      $('round').value=keepRound;
      $('raw').value=keepRaw;
    }
  }
}

async function v15Lock(){
  if(!LAST||LAST.engine!=='V1.3_UNIVERSAL')return alert('먼저 범용 해독을 실행하세요.');
  const rawText=LAST.lines.join('\n');
  const rawSha=await v15Sha256(rawText);
  const engineJson=JSON.stringify(V15_ENGINE_FINGERPRINT);
  const engineSha=await v15Sha256(engineJson);
  const p=LAST.pack?.final5||[];
  const txt=`백학신서 비상용 앱 V1.5 · PRODUCTION FREEZE
회차: ${LAST.round}
상태: RESULT-BEFORE / RESULT_BLOCKED
RAW_SHA256: ${rawSha}
ENGINE_FINGERPRINT_SHA256: ${engineSha}
GENERATION: ${V15_ENGINE_FINGERPRINT.generation}
PRIORITY: ${V15_ENGINE_FINGERPRINT.priority}
GLOBAL_RANK: ${V15_ENGINE_FINGERPRINT.globalRank}
GATE: ${V15_ENGINE_FINGERPRINT.gate}
PACKER: ${V15_ENGINE_FINGERPRINT.packer}
MAX_CANDIDATES_PER_SENTENCE: 2
후보우주 K=${LAST.rank.length}: ${LAST.rank.map(x=>x.n).join(', ')}
GATE_STATUS: ${LAST.pack?.gate||v13Gate(LAST.rank.length).code}
1241_REGRESSION_AUDIT: ${LAST.regression?(LAST.rankPass&&LAST.packPass?'PASS':'CHECK'):'N/A'}
Final5:
${p.map((g,i)=>`${i+1}. ${g.join(' · ')}`).join('\n')||'NO-PACK'}
winning_numbers_input=false
bonus_input=false
other_room_outputs_input=false
forced_top10_cut=false
post_union_autofill=false

[RAW 6문장]
${rawText}
`;
  const blob=new Blob([txt],{type:'text/plain;charset=utf-8'}),a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download=`백학도사_비상용_V1.5_${LAST.round}회_RESULT-BEFORE_LOCK.txt`;
  a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),1000);
}
function v15SaveState(){
  localStorage.setItem('baekhak_dosa_emergency_v15',
    JSON.stringify({round:Number($('round').value||1241),raw:$('raw').value,savedAt:new Date().toISOString()}));
}
$('v15NewRound').onclick=v15PrepareNewRound;
$('v15Regression').onclick=v15RegressionTest;
$('lock').onclick=v15Lock;
$('raw').addEventListener('change',v15SaveState);
$('round').addEventListener('change',v15SaveState);

// Override the old next-round button for production safety: next round = clear RAW/result.
$('nextRound').onclick=v15PrepareNewRound;

try{
  const s=JSON.parse(localStorage.getItem('baekhak_dosa_emergency_v15')||'null');
  if(s && Number.isInteger(Number(s.round))){
    $('round').value=Number(s.round);
    if(typeof s.raw==='string')$('raw').value=s.raw;
  }
}catch(e){}

globalThis.BAEKHAK_EMERGENCY_V15=Object.freeze({
  ...V15_ENGINE_FINGERPRINT,
  run:v13Run,
  regressionTest:v15RegressionTest,
  prepareNewRound:v15PrepareNewRound
});
</script>


<script id="v16RawBankBridge">
/* V1.9 RAW BANK 1~1242
   - 1241/1242 검증된 RAW를 앱 자체에 내장.
   - 회차 이동 시 내장 RAW가 있으면 자동으로 원문칸에 채움.
   - 분석은 자동으로 시작하지 않음.
   - 1243+처럼 내장 RAW가 없는 회차는 빈칸 유지.
*/
const V16_EMBEDDED_RAW = Object.freeze(JSON.parse("{\"1\":\"첫번째. 지평선위의 태양의 빛남이 있을지어다.\\n두번째. 물위의 새와 하늘의 새 의 공존 이니라.\\n세번째. 가장 작은 처음의 네모며, 그 우측에 의미로다.\\n네번째. 붙이니 한 개의 마음과 반개의 마음이 나타남이로다.\\n다섯째. 갈매기 위로 도끼의 내리침이 있을지어다.\\n여섯째. 죽음과의 새로운 생명의 조화가 있을지어다.\",\"2\":\"첫번째. 황알 두개의 붉음과 백의 공통이니라.\\n두번째. 방패가 창을 보호함이로다.\\n세번째. 두탑 사이에 경계가 존재하며, 허상이 비치니 곧 자신이로다.\\n네번째. 백의 중용의 중용이구나.\\n다섯째. 오리와 알이 완전한 죽음으로 향하니, 그 길의 중용이니라.\\n여섯째. 죽음의 신이 오리 앞에 존재함이니라.\",\"3\":\"첫번째. 죽음 아래의 순수한 빗물이니라.\\n두번째. 천상으로부터의 큰 별의 나타남이요, 세번째 교차점이로다.\\n세번째. 환갑의 뒤집힘이 있을지어다.\\n네번째. 시작의 질서 속에 두개며, 그 두개는 교환됨이로다.\\n다섯째. 그대로 나누어 접으니, 하루시간의 하나의 부족함의 맞닿음이로다.\\n여섯째. 두개의 큰 태양이 뜨며, 좌측 태양의 중심의 왼쪽 두번째이니라.\",\"4\":\"첫번째. 友 의 비밀이로다.\\n두번째. 오리 한 쌍은 앞으로 둘, 뒤로 다섯의 공통이로다.\\n세번째. 천사의 증표 이니라.\\n네번째. 하늘 아래 갈매기로다.\\n다섯째. 선의 기울임에 더함이 존재하며, 그 이후에 無 로다.\\n여섯째. 인간이 존재하며, 그중 한명이 사라지는구나.\",\"5\":\"첫번째. 無 두개의 합침이요, 그 두 배가 되니 행운의 수로다.\\n두번째. 하루의 의미의 나눔이니라.\\n세번째. 오리의 등에 원숭이로다.\\n네번째. 다섯 번에 꺾여 끝이 되리라.\\n다섯째. 에펠탑이 존재하며, 그 가장 밑으로 추락하는구나.\\n여섯째. 모래와 모래를 씹는도다.\",\"6\":\"첫번째. 두개는 세워지며, 우측의 행운은 뒤집어지는구나.\\n두번째. 오리는 창을 짊어지고 우측으로 헤엄치는구나.\\n세번째. 그날은 하늘이 열리며, 그 두 배로 커지리로다.\\n네번째. 오리 뒤에 사냥꾼의 노림이니라.\\n다섯째. 방향이 함께 존재하며, 동쪽에 無 로다.\\n여섯째. 죽음 앞에 무릎을 꿇은 서글픈 여인의 모습이로다.\",\"7\":\"첫번째. 열한개가 쓰러지며, 의미가 달라짐이니라.\\n두번째. 하나 위에 없음이로다.\\n세번째. 홀로된 무거움을 삼킨 보석의 아래이니라.\\n네번째. 행운이 나누어지며, 큰 쪽이 세 가지가 더 붙으리로다.\\n다섯째. 독뱀이 지나간 자리에 씨앗의 싹이 솟아나는구나.\\n여섯째. 안으로 들어가니,모서리가 셋이요, 모서리가 없음이니라.\",\"8\":\"첫번째. 끝이 없는 영원한 길이로다.\\n두번째. 잘림이 없는 평지위에 일곱의 요정이 살며, 그중 다섯 번째 요정이니라.\\n세번째. 올바름은 곧 두 번으로 나타나리로다.\\n네번째. 범이 나타나며 토끼는 떨림이로다.\\n다섯째. 행운의 갈매기로다.\\n여섯째. 죽음으로 부터 추락한 바닥의 밑동이로다.\",\"9\":\"첫번째. 하늘에서 인간은 사라지리로다.\\n두번째. 달로부터 시작되며, 나무가 되니 그 차례니라.\\n세번째. 오리한쌍이 죽음의 길로 가니, 그 첫번째 관문이로다.\\n네번째. 천하의 앞과 뒤가 뒤집히니, 승리의 표시가 나타나리로다.\\n다섯째. 세워 좌측으로 비추면 행운의 표식이요, 우측으로 비출 때 마음의 뒤집힘이로다.\\n여섯째. 냇물이 아홉번 흘러가리로다.\",\"10\":\"첫번째. 순수함은 불어서도 커지며, 놓으면 올라가리로다.\\n두번째. 여섯 개의 비밀의 계단이 존재하며, 그 중 세번째 계단안의 우측이로다.\\n세번째. 눈은 곧 건물의 층이며, 점이로다.\\n네번째. 비밀의 함정은 두 개며, 빠지니 곧 찔림이로다.\\n다섯째. 하늘아래 죽음이로다.\\n여섯째. 사막왕의 무덤은 곧 땅의 모양과 각 면들의 어울림이니라.\",\"11\":\"첫번째. 넷을 던지니 셋은 땅이요, 하나는 하늘이구나.\\n두번째. 솟으니 서쪽으로 가는구나.\\n세번째. 벽은 둘러지고, 한곳에 숨으니 그 좌측 벽이로다.\\n네번째. 갈매기위에 무지개니라.\\n다섯째. 두개를 뜻하며, 그 위로 도끼의 박힘이로다.\\n여섯째. 동쪽에 오리로다.\",\"12\":\"첫번째. 오리의 존재도다.\\n두번째. 자신을 이루는 숫자 중 첫번째이니라.\\n세번째. 천하의 오리가 이동하는도다.\\n네번째. 오리의 불화로다.\\n다섯째. 갈매기가 가장 무거운 짐을 지고 날아가는도다.\\n여섯째. 범 뒤에 중용을 이루는도다.\",\"13\":\"첫번째. 이주 뒤에 이틀을 주며 앞은 의미가 없구나.\\n두번째. 범에게 원숭이가 잡히니 꼬리만 남는구나.\\n세번째. 해가 뜨니 한 마리 새가 외롭구나.\\n네번째. 오리를 뒤에서 도끼로 치니 괴롭도다.\\n다섯째. 태풍이 부니 다섯번째 지점이로다.\\n여섯째. 살아있는 행운의 오리는 곧 죽음을 당할지어다.\",\"14\":\"첫번째. 서쪽으로 향하는 깃발이 있으니 그것이 행운의 숫자니라.\\n두번째. 작은 깃발 두개가 바람을 타니 중용을 이룰 것이니라.\\n세번째. 깃발아래 오리가 둥우리를 트니 행복한 모습이구나.\\n네번째. 원숭이가 가면을 쓰고 눈을 감으니 한 가지만 남으리다.\\n다섯째. 네모난 창살우리에 두 명이 갇혀 있으나 오른쪽사람은 죽으리다.\\n여섯째. 지신의 숫자에 세배가 되니 그 밑이니라.\",\"15\":\"첫번째. 지평선에 해가 뜨고 그 위에 왕이 나타남이로다.\\n두번째. 세번째 첫 왕의 머리며, 남은 한 가지는 버릴 것이로다.\\n세번째. 죽음의 왕들에 이름이 있나니 맨 처음과 마지막의 합은 항상 같은 수며 또한 그 같은 수의 중용이로다.\\n네번째. 오리가 가장 가벼운 짐을 지고 이제야 나가는 구나.\\n다섯째. 원이 네개가 있으나 세 가지가 깨졌구나.\\n여섯째. 왕은 비로소 죽음을 맞으니, 왕비가 지켜보는구나.\",\"16\":\"첫번째. 높은 곳에서 아래를 내려다보니, 언제나 세상은 달라짐이 없도다.\\n두번째. 병사 열 명이 차례로 창을 세우니, 가장 높은 수가 장군이니라.\\n세번째. 그 병사 중 한명은 죽음을 맞으니, 세 명이 지켜보며 슬퍼하는구나.\\n네번째. 죽음의 오리가 쳐다보니, 방패를 가진 자만이 살 것이니라.\\n다섯째. 두개의 숫자 사이에 빛이 빛나니 그 빛은 생명의 빛이니라.\\n여섯째. 생명의 빛은 꺼지고 그 아래 죽음이 네번 찾아오니, 살아있는 첫 번째 병사는 곧 죽음을 맞으리라.\",\"17\":\"첫번째. 달과 해가 아닌 해 위에 달이 한곳에 갇혀 있으리다.\\n두번째. 다섯 명을 이루는 숫자나 첫번째 사람은 의미가 없도다.\\n세번째. 바람이 부니 약한 것은 쓰러지며, 단 두개의 행운의 건물만이 남으리로다.\\n네번째. 쓰러지지 않은 두개의 건물 과 생명의 빛의 중용이도다.\\n다섯째. 한마음에 깨끗한 거울을 양쪽에 비치니 생명의 빛과 사랑으로 나누어지는구나.\\n여섯째. 행복한 느낌을 가지며 땅 아래 순수하게 쓰러져 죽는 도다.\",\"18\":\"첫번째. 반드시 첫 느낌에 있을 것이니 행운의 숫자를 이루는 짝은 세 짝과 한 숫자며 세번째 짝의 짝이니라.\\n두번째. 사각형 네 개가 두개씩 짝을 이룰 것이며, 그 짝을 갈라놓은 선의 맨 처음이니라.\\n세번째. 네모난 창살 우리 밖에 승리의 느낌은 그 다섯 배에 이를 것 이니라.\\n네번째. 첫번째 방향으로 그대로 비추니 세 가지 행운과 기쁨의 식물이 나타나리다.\\n다섯째. 기쁨은 사라지고 죽음으로 사랑이 갈라짐 이로다.\\n여섯째. 창살에서 벗어난 자유의 집은 두개며, 가장 친한 숫자로 이제는 쉬고 싶도다.\",\"19\":\"첫번째. 내려앉으니 두개는 아픔이 오고, 하나는 꽂이리라 무릇 꽂힘에 아픔을 빼니 천상락 이니라.\\n두번째. 천하가 뒤집히니, 사막에 짐승이 나타나리라.\\n세번째. 사막 위에 왕의 영원한 보금자리니라.\\n네번째. 천하의 오리가 두개의 도끼에 맞아 죽는도다.\\n다섯째. 물을 건너니 인간들에게 가장 필요한 인간이도다.\\n여섯째. 죽음은 세 번 좌우로 나오며 중용이 되는도다.\",\"20\":\"첫번째. 만날 수 없는 벽이 존재하니 여덟을 이루며 벽의 첫번째니라.\\n두번째. 무한한 바람 아래 오리가 비상함이로다.\\n세번째. 창이 오리를 노리나 오리는 죽음 을 알지 못할 것이니라.\\n네번째. 자아의 마음에 하나뿐인 잊고 있는 가장 소중한 마음이로다.\\n다섯째. 세 개는 같으나 하나는 다르며 그것은 한마음이로다.\\n여섯째. 모래로 찍으니 남는 그림자는 첫 번째 느껴짐이로다.\",\"21\":\"첫번째. 천상의 말이 바람을 타니 뒤에 죽음의 신이 쫒아 오는 도다.\\n두번째. 오리의 뒤에 시간의 흐름이 존재하니 그 중에서 특별한 의미 있는 시간이로다.\\n세번째. 큰 다섯 개의 탑 중에 세번째 탑의 창문에는 첫 탑으로부터 시작되며 그 숫자가 진실 된 창은 단 일곱 개만 존재하며, 그중 천상의 말은 세번째니라.\\n네번째. 구름아래 갈매기에게 생명의 빛 이 비추니 그 중용이 되는 도다.\\n다섯째. 여섯 개의 죽음은 사라지고, 새로운 생명이 태어나리로다.\\n여섯째. 천상에서 일곱을 이루고 세속에서 여섯을 이루리로다.\",\"22\":\"첫번째. 열세명의 제자가 서 있으나 같은 마음은 열이요, 단 한제자만 마음이 틀릴 것이로다.\\n두번째. 직립으로 섰다가 기울어져 다섯이 되는 수 둘뿐이니, 그중 세번째가 날개로다.\\n세번째. 가로 지으며 칼날이 둘로 나뉘어도 세상에서 의미 있음은 네 가지 뿐이며, 이 중 세속의 수이도다.\\n네번째. 자신과 함께 모든 것들이 이동하니 철새와 같도다.\\n다섯째. 여섯 왕이 자리에 앉으니 그중 가장 편한 왕이로다.\\n여섯째. 바다가 눈앞에 보이며 멀리 등대가 서 있도다.\",\"23\":\"첫번째. 짝이 아름다워 11 의 빛을 이루니 천상락의 시작이로다.\\n두번째. 도끼를 든 죽음의 신 앞에 맞서는 용기로다.\\n세번째. 행운의 새로운 생명의 부활이로다.\\n네번째. 선의 근본이며 그것이 우로 질주할 때 떨어져 흡수하리로다.\\n다섯째. 세번째 비밀의 탑의 진실 된 창속에 중용의 두 배로다.\\n여섯째.  죽음이 빛을 바래고 부활된 영혼이 안식을 찾는 도다.\",\"24\":\"첫번째. 나무 아래 창과 그 아래 해와 그림자가 존재하며 평화롭도다.\\n두번째. 천상 아래 세상의 창은 사라지고 평화가 오니 그 평화의 인간이로다.\\n세번째. 십자군이 회생하니 군대가 다시 일어나고 전쟁의 나팔수이로다.\\n네번째. 서로 마주보고 있는 오리는 한 쌍이며 그 운명은 더 밝은 오리로다.\\n다섯째. 십자군은 적군과 첫번째 충돌하니 십자군이 여섯의 승리를 하며 충돌없는 적군 한명만 살아남으리로다.\\n여섯째. 왕국은 지켜지며 여왕과 왕 아래 왕자가 둘 태어나니, 그 왕자는 하나의 죽음과 맞서리라.\",\"25\":\"첫번째. 열개와 열네 개와 열여덟을 이루며 그 거짓의 숫자니라.\\n두번째. 천상의나라와 천하의 나라의 운명이 바뀌니 공통된 모습은 자취를 감추고 남는 행운의 기사로다.\\n세번째. 온 천하의 가장 큰 산이며 그 산 보다도 높은 곳이로다.\\n네번째. 산 아래 운명의 신들이 결투를 하며 뒤집힘으로 가장 큰 힘을 얻음 이로다.\\n다섯째. 방패로 막으나 아픔이 존재하며 곧 지상락이니라.\\n여섯째. 태양이 비추며 바람도 부니 이젠 죽음과 함께 쉬는 도다.\",\"26\":\"첫번째. 음과 양의 조화가 아홉의 차이 속에 안으로 들어갈 것이며 그중에 왼쪽은 죽는도다.\\n두번째. 천상의 힘으로 가장 큰 길을 찾아 그중 둘째 이후에 바로 나타남 이로다.\\n세번째. 둘이 합하니 세속의 의미로다.\\n네번째. 우주심의 시작을 의미하는도다.\\n다섯째. 천지에 흙을 채워 바닥의 중용이로다.\\n여섯째. 양쪽에 같음이 셋이며 스스로는 공이며 공위에는 네 개가 존재하니 네 개 중 공통됨이 없음이로다.\",\"27\":\"첫번째. 두개가 보물을 말하며, 위아래 둘 다 없으며, 고립이로다.\\n두번째. 영원함이 사라지니 질서가 파괴되고, 뒤집혀 바로 잡히도다.\\n세번째. 허공을 직립으로 솟구침도 없으며, 평행으로 솟구침도 없으리로다.\\n네번째. 다섯이 나열되며, 그 공통이 있으리니, 그것에 오리의 영원함이 받쳐 주는 도다.\\n다섯째. 죽음이 없이 시작이 되는 수 셋의 마지막이도다.\\n여섯째. 마지막 죽음의 전주곡이며, 그 이후로 순수한 죽음뿐 이로다.\",\"28\":\"첫번째. 입구는 첫번째며, 여섯 개의 문이 있고 죽음을 볼 수 없는 우측이로다.\\n두번째. 태양 아래 금을 캐나 그 금은 환영 받지 못함이로다.\\n세번째. 검은 태양 아래 흑풍이 부니 영원한 안식에 들어가리로다.\\n네번째. 빛과 거울이 만나며, 마음속의 惡 의 죽음이로다.\\n다섯째. 갈매기위로 구름이 존재하며 그 옆에 바닷가는 평온하도다.\\n여섯째. 두 명이 존재 하며,그 관계는 평등 하지 않으며 중용을 이루는 도다.\",\"29\":\"첫번째. 내려앉으며 밝음으로 감싸며, 공적인 축복의 행운의 첫번째 수로다.\\n두번째. 시간의 흐름에 정적이 흐르며, 매우 작은 것이나 점점 커지는도다.\\n세번째. 파문이 일어나고, 위아래 진동하니 좌우로 세 개가 존재하며 중용이 되는 도다.\\n네번째. 천지에 비가 내리며 비 막음이 넘어가니 그만큼의 바람이 존재하는 도다.\\n다섯째. 우주와 도시와 공통되며, 연관이 되는 수로다.\\n여섯째. 위로 같음이 한 가지 뜻이요, 뒤집혀 질 때 좌로도 한 가지 같은 뜻이 생길 것이로다.\",\"30\":\"첫번째. 위아래 존재하는 동물의 뒤에 공통이 하나요. 그 뒤의 공통도 하나도다.\\n두번째. 공주는 죽음으로 부터 쫒기며 다섯 명의 병사가 지켜 주는도다.\\n세번째. 내려와 꽂으니 하나는 흡수하며, 하나는 반개의 형상이 네 개 존재하리로다.\\n네번째. 안에서 들어와 보니, 문이 두개요 모서리가 두개로다.\\n다섯째. 날카로움과 부드러움이 같이 존재하며 그 둘은 서로 상처주지 못하니라.\\n여섯째. 나비의 파괴도다.\",\"31\":\"첫번째. 중용의 나눔의\\\"비춤\\\"으로 한 쌍이요, 그 거짓 한 쌍 둘의 오른쪽 이니라.\\n두번째. 산을 직시하는 총명한 눈을 가진 이 로다.\\n세번째. 행운의 비가 퍼 붓는 아름다움 속에, 홀로 남는 인간이도다.\\n네번째. 천지의 양과 음이 서로 바뀌며, 만나서 가장 커질 것이도다.\\n다섯째. 백의전사는 공주를 위하여 혼돈과 바람 속에 죽음과 싸우리로다.\\n여섯째. 공주는 잠이 들며, 백의전사 는 죽음의 바람을 맞으리라.\",\"32\":\"첫번째. 비밀의 탑 각각의 탑이 그대로 부딪혀 일어나는 첫번째 수로다.\\n두번째. 좌에서 우로 양의 길로 가되 작아짐과 커짐이 반복되며, 세번째 행운의 커짐 이로다.\\n세번째. 죽음으로 살아난 오리의 영혼은 위에서 지켜짐이로다.\\n네번째. 하나는 동심이며, 하나는 반심이로다.\\n다섯째. 거인 셋과 소인 넷 이 존재하며, 세번째 소인의 오른쪽 죽음이로다.\\n여섯째. 우주심의 자아며, 바람의 마지막 끝수로다.\",\"33\":\"첫번째. 가려는 것을 멈추게도 하며 그 멈춤을 가게도 하며 그 멈춤은 오래 지속되지 않으리로다.\\n두번째. 위 아래로 움직이며, 우측에 한사람이 존재하며 좌측에 無人이니 한쪽으로 기울어지리로다.\\n세번째. 가장 큰 더함 의 가장 아래의 위로다.\\n네번째. 하늘에 같음이 둘이요, 자신의 존재하는 위치에 같음이 하나로다.\\n다섯째. 천사경 이로다.\\n여섯째. 죽음이 존재하나 죽음을 볼 수 없도다.\",\"34\":\"첫번째. 시간의 흐름 속에 나타나는 가장 큰 수이며, 처음과 그 아래인 끝이 만나 흡수되리로다.\\n두번째. 여름의 용광로의 뜨거움의 중용이로다.\\n세번째. 먹어서도 안 되며, 먹음과 동시에 이미 자신의 세계는 좁아지리로다.\\n네번째. 죽음으로 탄생이 되며, 가장 크게 자라니 그 교차점이로다.\\n다섯째. 인간의 孝 의 알맹이로다.\\n여섯째. 처음으로부터 다섯의 가함의 공통을 가지며 그 다음이로다.\",\"35\":\"첫번째. 비밀의 창의 벽이 존재하며 넓은 곳과 좁은 곳의 생명의 통로이니라.\\n두번째. 공통된 삼각과 사각이 존재하며, 그 중용이니라.\\n세번째. 비상하며, 내리꽂으며 불꽃 속에 강함으로 나타나리라.\\n네번째. 기쁨과 슬픔이 동시에 존재하며 인간상의 웃음이로다.\\n다섯째. 죽음을 모르는 새이며,그 이후에 죽음이 존재하리로다.\\n여섯째. 네 명이 존재하나 떨어짐이요, 공간에 처음의 둘이로다.\",\"36\":\"첫번째. 바다로 가는 최초의 문이며, 긴 여정의 시작이도다.\\n두번째. 큰 삼각형 과 한 개의 뒤집힘으로써 빛을 얻으며, 그 빛 속에 작은 여섯 개의 삼각형이 태어나니 중용 의 좌측이로다.\\n세번째. 질서의 파괴를 유도하는 숫자며, 방향의 혼란과 사라짐과 동시에 멈추는 도다.\\n네번째. 천상의자유는 폭풍 속에 동행이로다.\\n다섯째. 죽음의 압정에 찔리며, 그 날카로움이로다.\\n여섯째. 천상의 존재 속에 악마와 천사의 공통이로다.\",\"37\":\"첫번째. 감싸 안고 또 감싸 안으니, 여섯 개의 짝이 존재하며 공통의Ġ두번째 짝이로다.\\n두번째. 세 개의 바람이 불어옴은 한방향이나 한 개의 바람은 역 바람이니 홀로 외롭도다.\\n세번째. 한여름에 겨울의 폭설이로다.\\n네번째. 한쪽은 질서의 시작이며, 세 명씩 사라짐의 두 번이니라.\\n다섯째. 벽과 모서리의 일곱의 압정의 존재와 압정 둘의 찔림이 없는 숫자니라.\\n여섯째. 올라감에 홀로 질서가 파괴되는 숫자며, 그 다음숫자가 그 짝이니라.\",\"38\":\"첫번째. 천상의 바람꽃이로다.\\n두번째. 흑기사의 슬픔이로다.\\n세번째. 인간의 \\\"德\\\" 이로다.\\n네번째. 붉은 곰의 덮침이로다.\\n다섯째. 둘이 흡수하여 두개가 모두 변하리로다.\\n여섯째. 얼음속의 결빙의 마지막이로다.\",\"39\":\"첫번째. 고요한 검은 진주의 흙대밭이로다.\\n두번째. 폭풍우가 일어나며, 배신의 전쟁의 시작을 의미 하는도다 .\\n세번째. 12전사는 죽음으로 부터 깨어나며, 복수의 나팔이 울리는 도다.\\n네번째. 비밀의 창속에 비침은 여덟 개의 마음으로 태어나리로다.\\n다섯째. 왕을 배신한 전쟁은 여섯 개의 막음으로도 막지를 못함이로다.\\n여섯째. 승리의 깃발이 휘날리며, 남은 것은 배신의 증거며 그 중용이도다.\",\"40\":\"첫번째. 압정 두개를 無가 가두며 그 밖의 숫자로다.\\n두번째. 같음이 네 개며 네번째는 더욱 더 커지리로다.\\n세번째. 행운의 생명이 태어나며, 그 생명을 노림은 어미는 모르는 도다.\\n네번째. 새벽을 깨우는 고요함의 파괴니라.\\n다섯째. 인간사의 情 이로다.\\n여섯째. 고난속의 승리의 죽음이로다.\",\"41\":\"첫번째. 거짓이 두개만 존재하며 시작을 알림이니 빛의 존재로 나타남이로다.\\n두번째. 거울 앞에 비침은 허상이요, 그 뒤에 뒤가 보이는 도다.\\n세번째. 비침에 진실의 숫자요, 경계에 일곱이 존재하니 혼란에 빠지는 도다.\\n네번째. 오리의 夢 이로다.\\n다섯째. 산 아래 행운의 거북이 로다.\\n여섯째. 두개의 경쟁이 하늘을 찌르리로다.\",\"42\":\"첫번째. 세상을 담으며, 그 버팀목이로다.\\n두번째. 두 번을 두드리며, 나눔에 가장 작아지리로다.\\n세번째. 붙임에 막힘이 생기며, 그 중용 이로다.\\n네번째. 돌풍이 불어 중심에서 한번 돌아가니 여덟의 차이가 생기니라.\\n다섯째. 맞음에 무고통이 존재하며 , 피함에 고통이로다.\\n여섯째. 죽음과 삶의 공통인 숫자로다.\",\"43\":\"첫번째. 볼 수 없어도 느낄 수가 있는 도다.\\n두번째. 안정 위에 불안정이로다.\\n세번째. 가장 큰 안정의 파괴로다.\\n네번째. 上 은 불협이요, 下 는 화합이로다.\\n다섯째. 가장 큰 눈물의 의미로다.\\n여섯째. 자신이 가장 사랑하는 사람의 행복의 숫자로다.\",\"44\":\"첫번째. 쓰러짐으로 영원한 안식과 표식이 나타나리로다.\\n두번째. 뒤집혀 앞, 뒤에 네 명이 나타나리로다.\\n세번째. 무한을 통과하여 도착하니, 남은 것은 중용뿐이로다.\\n네번째. 세 가지 꼭지가 존재하며, 그중 한 가지가 흡수되리로다.\\n다섯째. 서로 통하나 목적은 반대로다.\\n여섯째. 죽음을 가진 형태는 우로 전진하며, 막음이 있으나 깨어지니 두 번째의 의미로다.\",\"45\":\"첫번째. 紅 과 靑의 어울림이요, 두 번째 느낌이로다.\\n두번째. 억압의 깃발은 사라져 자유만 남으리로다.\\n세번째. 하늘의 계단이 세 개가 보이며, 두 번의 꺾임속의 안으로 피어남 이로다.\\n네번째. 홀로 외로운 그네가 존재하며, 그 아래엔 네 번의 떨림의 존재로다.\\n다섯째. 반드시 일곱이 지름길이며, 다섯의 짐승 중에 첫 번째 짐승이로다.\\n여섯째. 네 개가 엎드림 만으로 다섯이 되며, 시작은 여왕 앞이로다.\",\"46\":\"첫번째. 가장 큰 형상의 두개 와 시간의 하나와 공통이며, 세상에 크게 나타날 때 그 교차점이로다.\\n두번째. 세 개의 같은 도형으로 이루어지며,안으로 의미를 포함하니 그 의미의 찔림이로다.\\n세번째. 죽음 아래의 큰 빛은 의미를 잃고, 그 우측에 존재함이로다.\\n네번째. 서로 양쪽 극에 존재하나, 비춤이 있으며 그 좌측이로다.\\n다섯째. \\\"천상마\\\" 의 죽음이로다.\\n여섯째. \\\"왕의 숲\\\" 이 나타나며, 그 지상의 \\\"샘\\\" 이로다.\",\"47\":\"첫번째. 고난이 있으며, 그 의지는 홀로 외롭도다.\\n두번째. 행운의 산호수로다.\\n세번째. 천상폭포수의 중용이로다.\\n네번째. 가면을 벗으니 여인이며, 여인은 절벽위에 존재하는 도다.\\n다섯째. 피할 수 없는 전쟁과 그 끝은 영원함으로 기억되리로다.\\n여섯째. 무대가 존재하며 셋은 포함되고 둘은 피하리로다.\",\"48\":\"첫번째. 붉은 하늘아래 무지개의 빛이로다.\\n두번째. 인간을 위하여 옷을 입으나, 곧 파괴되리로다.\\n세번째. 하나가 곧 두개의 옷을 입으리로다.\\n네번째. 위험을 짊어지니 가장 위태롭도다.\\n다섯째. 심장이 부풀어 터지니 곧 \\\"천상지대의 꽃\\\"이로다.\\n여섯째. 해를 너무 가까이 하며, 곧 일어나며, 곧 뒤집혀지는도다.\",\"49\":\"첫번째. 시간의 흐름속에, 더함이란 곧 우측에 두 숫자의 존재함과 같도다.\\n두번째. 떨어짐을 위로 잡아주나, 창으로 찌름이로다.\\n세번째. 하늘의 번개와 천둥의 만남이로다.\\n네번째. 진달래의 천상의 향기로다.\\n다섯째. 忍과 忍과 忍의 중용의 늪이로다.\\n여섯째. 공과 채의 최후의 목적이로다.\",\"50\":\"첫번째. 산의 메아리가 울리며, 그것은 다섯 번의 행운의 울림이로다.\\n두번째. 손의 합장이며, 한 여인의 하나로 향하는 \\\"정성의 기도\\\" 로다.\\n세번째. 우주의 순리가 뒤바뀌며, 빛의 \\\"종말\\\"이로다.\\n네번째. 흑고래의 출연이며, 기쁨의 향진이로다.\\n다섯째. 앞뒤로 붙어 세 개가 곧 두개가 되느니로다.\\n여섯째. 오리는 바다로 나가나, 행운의 역행은 곧 죽음으로 돌아올 지로다.\",\"51\":\"첫번째. 낙엽이 떨어지며, 고목아래 正 이로다.\\n두번째. 짐승의 우리에 넷의 존재며, 첫번째의 날카로움이로다.\\n세번째. 큰 산 과 큰 구름 의 중용이로다.\\n네번째. 중용의 시작과 끝이 하나로 통하리로다.\\n다섯째. 거대한 물받이의 존재며, 가장 약한 부분이로다.\\n여섯째. 자신의 표출이며, 마음속의 悲 의 숨김이로다.\",\"52\":\"첫번째. 다섯째 기사의 쓰러짐으로 그 창은 주인을 잃음이로다.\\n두번째. 하나가 끊어질 때 또 다른 버팀목이로다.\\n세번째. 하나가 되어 가장 처음의 의미로다.\\n네번째. 투우사의 붉은 꽃이로다.\\n다섯째. 육지와 강의 만남은 행운으로 이루어지리로다.\\n여섯째. \\\"광대\\\" 의 춤이로다.\",\"53\":\"첫번째. 산 中 의 \\\"비행체의 추락\\\"이로다.\\n두번째. 인간이 인간을 벌함이로다.\\n세번째. 열개의 상이 맺힘은, 곧 거울을 의미함이로다.\\n네번째. \\\"보화\\\" 의 쏟아짐이로다.\\n다섯째. 편안한 안식과 새로운 탄생을 의미함이로다.\\n여섯째. 두개의 행운은 분명한 모순이로다.\",\"54\":\"첫번째. \\\"검\\\"은 빛나며, 흑룡의 네 번째 발톱이로다.\\n두번째. 따뜻함으로, 점이 두개에 선이 하나가 존재하는 도다.\\n세번째. 절벽위에 기사 둘이 존재하며, 그 안에 의미가 있음이로다.\\n네번째. 동쪽과 서쪽의 짐승은 동일하며, 북쪽의 위험이 곧 닥쳐오리로다.\\n다섯째. \\\"大死\\\"를 피해 정각 의 처음의 의미로다.\\n여섯째. \\\"빛\\\"은 비추어, 구슬이 흘러가\\\"上\\\"이 되리로다.\",\"55\":\"첫번째. 거짓의 존재는 반으로 나뉘어, 처음의 짝이 되리로다.\\n두번째. 마법의 방패는 곧 태양의 흑심이로다.\\n세번째. 셋이 나누어 존재하나, 둘이 붙어 있으며, 두번째로부터 넷의 진행이 있음이로다.\\n네번째. 달은 지고 붉음이 드리우니, 그 밑에서의 첫 만남이로다.\\n다섯째. 큰 도끼는 쓰러지며, 날이 부러져 행운과 만나리로다.\\n여섯째. 세 번을 막으며 버티나,자연과 동화되리로다.\",\"56\":\"첫번째. 한번 꺾여 두개는 이별이나, 다시 만남이 찾아오리로다.\\n두번째. 음 양이 존재하며, 그 후에 하나가 존재하니 그 중용이로다.\\n세번째. 하나는 피하며, 삼의 형상이 교차되어 모두 막아서니, 그 이후에 다섯이 존재하며, 그 중 천상으로부터의 죽음의 수로다.\\n네번째. 집어넣으나, 곧 사라짐이니 날 새의 먹이가 되리로다.\\n다섯째. 많은 무리들은 붉음이요, 작은 무리로의 경계선의 침범이로다.\\n여섯째. 세속 인간의 \\\"욕심\\\" 이로다.\",\"57\":\"첫번째. 흑과 백이 존재하며, 곧 질서가 잡히리로다.\\n두번째. 끊어져 아무것도 존재치 않으나, 비추어 하나의 거짓형상이 생기리로다.\\n세번째. 우거진 갈대숲에 한 마리의 새가 존재하리로다.\\n네번째. 빛은 시력을 잃고, 세 발을 띄우지 못하고 잡히리로다.\\n다섯째. 행복속의 비행은 시작되며, 위로 치솟음이로다.\\n여섯째. 꿀벌의 달콤함이로다.\",\"58\":\"첫번째. 큰 태양과 작은 태양이 존재하며, 그 중용의 아래로다.\\n두번째. 시간의 흐름이 이루어지며, 가장 좁아지리로다.\\n세번째. 동녘은 밝아지며, 평화는 비둘기의 외침으로 이루어지는 도다.\\n네번째. 전쟁의 포화는 불로써 다스림 이로다.\\n다섯째. 인간사의 友情 이로다.\\n여섯째. 가고자 하는 터널은 길며, 같은 거리의 크기가 존재하며 그 마지막의 中心이 되리라.\",\"59\":\"첫번째. 천하가 뒤집혀 의미가 있음이요, 하늘 속에 행운의 좌측이로다.\\n두번째. 땅과 산이 가까이 함이니,첫 번째 의미가 생김이로다.\\n세번째. 접으니 나누어지며, 좌측 탑과 우측 탑의 비밀의 존재함이로다.\\n네번째. 땅으로 묻힌 압정에 천사의 계단은 묻히리로다.\\n다섯째. 생명석의 꽃이로다.\\n여섯째. 먹구름 속에 첫번째 죽음의 빛이로다.\",\"60\":\"첫번째. 두개의 귀는 늘어지며 세 번의 큰 뜀이 있으리로다.\\n두번째. 세 개의 합침에 긴 창과 짧은 창이 남으리로다.\\n세번째. 빗속의 연주는 시작되며, 홀로 외롭도다.\\n네번째. 기사는 왕을 따르며, 여인은 기사를 따르리로다.\\n다섯째. 전쟁의 불은 꺼지고 여인의 진실은 구름 속에 사라지리로다.\\n여섯째. 첫 번째 空 의 날카로움의 끝이로다.\",\"61\":\"첫번째. 시작의 문자는 여섯 개요, 가장 작은 문자의 첫점이로다.\\n두번째. 성스러움의 표시는 여섯 개로 갈라지며, 큰 짝의 중용이로다.\\n세번째. 방은 행운이요, 다섯 번째 방주인이 되리로다.\\n네번째. 셋과 하나는 완전히 떨어지며, 반대와 화합의 공존이로다.\\n다섯째. 인간사의 고독함 이로다.\\n여섯째. 네 명의 화합이나 그중 약속은 빼리로다.\",\"62\":\"첫번째. 모든 취함은 없고 최상은 남기리로다.\\n두번째. 파동 치니 세 번으로 꺾여 날개가 되리로다.\\n세번째. 절벽의 움직임은 곧 네 번의 기울임이로다.\\n네번째. 탄생의 기쁨은 다가오며 그 빛으로 의미가 생기리로다.\\n다섯째. 전쟁속의 사랑이로다.\\n여섯째. 두개의 죽음으로부터 탈출하며, 곧 깨짐이 있으리로다.\",\"63\":\"첫번째. 땅이 있어 두개가 이동함이로다.\\n두번째. 붙여 합하니 소원이 되리로다.\\n세번째. 나비는 모란화에 내려앉아 평화로다.\\n네번째. 세 개의 바위는 흔들림이 없고, 봉황은 그 위에 존재함이로다.\\n다섯째. 전갈의 독침은 죽음으로 향하리로다.\\n여섯째. 베틀위에 용의 머리로다.\",\"64\":\"첫번째. 아홉 개의 능선에 태아의 아늑함이로다.\\n두번째. 빛의 인도는 곧 우주로의 중용이로다.\\n세번째. 土氣 는 七 로서 이루어지는 도다.\\n네번째. 좌측의 의미가 곧 하나의 의미로 바뀌리로다.\\n다섯째. 사냥꾼은 엽총을 떨어뜨리니 고난이로다.\\n여섯째. 세 개의 모임과 두개의 모임이 한곳으로 집중하리로다.\",\"65\":\"첫번째. 행운은 반지를 통과하니 가까워지는구나.\\n두번째. 압정 넷 으로 빛이 생기며, 빛 받침은 좌측이로다.\\n세번째. 花家 는 난을 피우고, 뿌리의 첫 번째 걸음이로다.\\n네번째. 화산은 폭발하며 오리는 날지 못하리로다.\\n다섯째. 행운은 머리에 존재하며, 홀로 외롭도다.\\n여섯째. 산 아래의 행운의 역행이로다.\",\"66\":\"첫번째. 네 개로 잡으며, 한 개로 이동이 되는구나.\\n두번째. 하늘에서 쏟아지니, 모두 막아내나 파괴되리로다.\\n세번째. 꺼짐은 반대가 되며 그리고 역이 되리로다.\\n네번째. 신서의 진실은 곧 중용이로다.\\n다섯째. 인간사의 \\\"도전\\\"의 의미로다.\\n여섯째. 사자와 기사의 결투는 슬픔의 결말이로다.\",\"67\":\"첫번째. 金 의 정상은 곧 행운이 되어 이루어지는 도다.\\n두번째. 四는 곧 넷이 되어 이루며,三은 곧 다섯이 되어 이루니, 세번째의 평화로움이로다.\\n세번째. 정상과 함정의 중용이로다.\\n네번째. 인간 속에 마음을 걸어놓음이로다.\\n다섯째. 일곱 방패의 힘은 다섯의 힘으로 밀리는도다.\\n여섯째. \\\"공\\\"은 곧 세 개의 목적으로 향하며, 가장 낮음의 첫 번째 \\\"공\\\"이로다.\",\"68\":\"첫번째. 양 끝은 공통이며, 하나는 변형되어 나감이로다.\\n두번째. 잡으며 당기니, 생명이 위태로워 떨림이로다.\\n세번째. 잡은 손은 틀리며, 그 사이에 존재함이로다.\\n네번째. 우측 창살아래 세 동물이 갇히며, 홀로됨이로다.\\n다섯째. 죽음은 일곱 속의 푸른 창으로 가려지며, 뒤에서 덮치리로다.\\n여섯째. 눈을 감고 버려야지만 이룰 수가 있도다.\",\"69\":\"첫번째. 금종은 \\\"장미의 전쟁\\\" 으로 새겨지는도다.\\n두번째. 재앙은 불 위의 꽃이로다.\\n세번째. 월계관의 꿈이로다.\\n네번째. 세 번의 걸침과 네 번의 걸침과 일곱 번의 걸침 속에 행운은 떨어지리로다.\\n다섯째. 붉은 사파이어의 횡재로다.\\n여섯째. 승리의 거북은 곧 죽음의 이슬로 사라지는구나.\",\"70\":\"첫번째. 밭을 매는 부자는 아름답도다.\\n두번째. 꽃의 향기는 큰 도시를 덮치리로다.\\n세번째. 코는 사라지나, 앉아 영원히 그를 기억하리로다.\\n네번째. 선에 세우면 집이 나타나며, 구멍의 자리를 지키리로다.\\n다섯째. 無 는 날카로움에 터질 것이로다.\\n여섯째. 뒤집혀 만나니 안정이 되어 움직이지 않으리로다.\",\"71\":\"첫번째. 산은 모두 차며, 봉우리가 셋이며 작은 두번째 봉우리로다.\\n두번째. 지팡이는 노인의 것과 아님으로 구별되는도다.\\n세번째. 건물은 쓰러지며, 둘은 좌측으로 피하며 둘은 우측으로 피하니, 반대로 나와야 살수 있음이로다.\\n네번째. 붉은 산삼의 빛으로부터 감추어짐이로다.\\n다섯째. 흙 에서 나옴의 첫 싹이니, 자라서 열개로 맺으리로다.\\n여섯째. 죽음은 뭉치니, 반으로 나뉘어 강한 죽음이 쳐서 사라지리로다.\",\"72\":\"첫번째. 두개의 지붕위에 닭이 울며, 그 뒤에 노림이 있으리로다.\\n두번째. 순리의 삼각 형태로 나아가며, 세번째 삼각형태의 두번째 받침이로다.\\n세번째. 열넷의 식탁에 셋이 특별하나 그중 중심이 되리로다.\\n네번째. 다섯의 받침에 네번째로 나오는도다.\\n다섯째. 방향을 탄 공의 격추로다.\\n여섯째. 죽음은 죽음대로 물러서 나오리로다.\",\"73\":\"첫번째. 빛의 바꿈은 얼굴이 됨이니라.\\n두번째. 세 명의 흙의 여인은 나비의 춤을 추니 보기가 좋구나.\\n세번째. 날개 없는 말은 부양의 말이로다.\\n네번째. 스물아홉의 고비가 존재하며, 순풍이 부니 행복의 끝이로다.\\n다섯째. 이슬 속에 갇힌 행복의 튤립이로다.\\n여섯째. 非 는 非 로 正 이 되리로다.\",\"74\":\"첫번째. 높은 정상으로 향하는 생명의 버팀목이로다.\\n두번째. 하나는 하나로 들어가나, 하나는 하나로 들어가지 못함이로다.\\n세번째. 행운의 기회가 주어지니, 두 길의 중용에 두 번의 웃음이 있으리로다.\\n네번째. 세 번의 꺾임으로 벽을 만나며, 다섯 번으로 끝을 만나니 두 번의 죽음이 그 앞에 서리로다.\\n다섯째. 붉은 국기는 휘날리며, 그 기둥이로다.\\n여섯째. 만남에 다침을 보호하나, 보호는 곧 다침으로 연결되리로다.\",\"75\":\"첫번째. 화살이 존재하며 그 촉이니, 평평함에 그 공통이 하나만 존재함이로다.\\n두번째. 땅 밑에 오리는 잠들며, 네 번을 감싸 앉으며 두번째 같은 존재로다.\\n세번째. 한 개의 부족함의 사각은 쓰러져 한 개를 피하리로다.\\n네번째. 단 두개의 동일한 계단은 세 개의 흙으로 채워지며, 그중 숨을 쉴 수 있는 흙이로다.\\n다섯째. 세 개의 특별함은 우측으로 세워지니 그 중용이 되리로다.\\n여섯째. 人生은 곧 둘의 행복함의 시작으로 다가오는구나.\",\"76\":\"첫번째. 검은 태양은 백의 사막을 가리는도다.\\n두번째. 붉은 거북은 바위에 오르니 힘겹도다.\\n세번째. 선으로 전달되어 나오나 空 을 모두 채우며 바로 사라지리로다.\\n네번째. 여덟의 호수 속에 비친 자신의 눈동자로다.\\n다섯째. 거짓은 행운으로 바뀌리로다.\\n여섯째. 고래를 덮치니 아래로 가라앉으리로다.\",\"77\":\"첫번째. 사슴의 \\\"뿔\\\" 이로다.\\n두번째. 달팽이의 집은 무거우며 편안함이로다.\\n세번째. 삼주 이틀은 밤이며, 밤은 셋으로 짝을 이루리로다.\\n네번째. 사막은 폭풍과 함께 사라지며 한 가지를 남길 것이로다.\\n다섯째. 능금은 곧 푸른빛과 함께 하리로다.\\n여섯째. 출발은 처음과 같으나, 중용은 그 뒤를 따름이로다.\",\"78\":\"첫번째. 구름과 흙의 화합이로다.\\n두번째. 별이 떨어지며 다섯이 남으니, 좌측으로의 무지개로다.\\n세번째. 노인의 공경이로다.\\n네번째. 붉은 달은 기울어지니, 곧 두개의 전쟁의 해가 뜰 것이로다.\\n다섯째. 인간 안에 생명의 샘이로다.\\n여섯째. 푸른빛의 화합이로다.\",\"79\":\"첫번째. 칠월 칠석에 행복이로다.\\n두번째. 하얀 버펄로의 부활이로다.\\n세번째. 검은 복장의 인간이로다.\\n네번째. 나무에 새가 날아드니 황색鳥로다.\\n다섯째. 포도 알이 떨어지며 새 생명이로다.\\n여섯째. 죽음은 이별로 나타나니 남는 자로다.\",\"80\":\"첫번째. 불가사리의 행운이로다.\\n두번째. 그 선을 넘지 못하지만, 반드시 넘어야만 하는 선이로다.\\n세번째. 천사의 나이로다.\\n네번째. 맑음과 흐림의 중용이로다.\\n다섯째. 石 과 土 의 의미로다.\\n여섯째. 뜨거운 붉은 과일이로다.\",\"81\":\"첫번째. 스핑크스의 나침판이로다.\\n두번째. 한여름 밤에 북쪽의 푸른빛이로다.\\n세번째. 두개의 바늘과 실은 방향이 있으며, 그 좌측이로다.\\n네번째. 네 명의 행복한 아이가 모두 존재하며, 생일의 첫번째 만찬이로다.\\n다섯째. 은하수는 네 개로 이루어지는 도다.\\n여섯째. 인력과 중력은 그 차이의 행운으로 이끌어가는구나.\",\"82\":\"첫번째. 아카시아의 향기에 취함이 있으리로다.\\n두번째. 여덟 개의 마음의 진실에 거짓의 답변이 세 개가 있느니 로다.\\n세번째. 진실과 우정의 중용이로다.\\n네번째. 보임과 보이지 않음에 두개의 촛불이 밝히리로다.\\n다섯째. 삼각형상을 피해 바닥에 있으리로다.\\n여섯째. 흑룡의 죽음이로다.\",\"83\":\"첫번째. 비는 곧 태양에 사라짐이로다.\\n두번째. 공을 던져 놀며 바뀜이 있으리로다.\\n세번째. 인간사의 \\\"人生의 전환\\\" 이로다.\\n네번째. 움직일 수 없으며 따뜻함으로 움직이리로다.\\n다섯째. 공주는 土 에 죽으며, 日 에 다시 살 것이로다.\\n여섯째. 숨어있는 고양이가 존재하며 곧 사냥꾼에 잡히리로다.\",\"84\":\"첫번째. 박쥐의 삶이로다.\\n두번째. 푸른 가을의 침이로다.\\n세번째. 가족이 행운을 부르는 숫자로다.\\n네번째. 백호의 발톱은 곧 두개가 부러지리로다.\\n다섯째. 안경 쓴 노인은 지팡이를 떨어뜨리니 곧 좌측의 빛이로다.\\n여섯째. 상어는 인간의 배를 공격하리로다.\",\"85\":\"첫번째. 축제는 장미로부터 시작됨이로다.\\n두번째. 일곱 개의 사파이어에 푸른빛의 빠짐이로다.\\n세번째. 편안한 그림자는 땅과 더불어 행운이 되리로다.\\n네번째. 왕은 기사로 부터 지켜지나 폭풍을 이겨내지 못하리로다.\\n다섯째. 일곱의 날 중 떨어진 세 개의 날이며, 처음의 두개의 날의 조화로다.\\n여섯째. 영웅은 기사가 아닌 馬 로서 나타나리로다.\",\"86\":\"첫번째. 빛의 두개에 위아래 열한개가 사라지니 남음이 곧 행운이로다.\\n두번째. 순수한 압정의 좌측에 입이 존재하며,우측에 사람이 누워 존재하니 곧 의미가 생기며, 그 의미는 아래로 향하니 곧 행운이 됨이로다.\\n세번째. 세상에서 가장 크게 나누어 중용이며 그 우측에 세 번이 울리는 도다.\\n네번째. 모두 펴서 셋이 닿으며 교차하니, 크기에 대한 나눔이 생기리로다.\\n다섯째. 때리니 제자리에서 좌측으로 돌아가며 또 우측으로 향하여가는 물체가 있으며, 돌아가는 충격과 향하는 충격의 공통이로다.\\n여섯째. 죽음 속에 마지막 붉은 커튼이로다.\",\"87\":\"첫번째. 인간의 생명을 위하여 생명을 자르며 첫 의미로다.\\n두번째. 해와 달은 모두 차며, 붉은 다섯이 하나로 존재하며 세번째 의미로다.\\n세번째. 뜨거우니 우측으로 돌아가며 三 의 의미가 파생되리로다.\\n네번째. 시간이 나무위에 걸치는도다.\\n다섯째. 모두 한쪽으로 향하여 전진하나 가장 마지막에 배신자가 생기리로다.\\n여섯째. 세 개를 가두는 양쪽으로 부터 시작되어,아래로 꺾여 떨어지니 그 중 사라진 꺾임의 수로다.\",\"88\":\"첫번째. 끊어짐으로 첫수가 존재하는도다.\\n두번째. 가까워 붙으니 \\\"악어의 사냥\\\"은 시작되는 도다.\\n세번째. 검은 고양이의 진실의 방울이로다.\\n네번째. 작음에 높음이 존재하니 곧 행운이 생김이로다.\\n다섯째. 붉은색 높은 건물이 존재하며 좌우에 바뀜이 생기리로다.\\n여섯째. 하나에서 바닥을 치니 결국 마지막행운에 되돌아가리로다.\",\"89\":\"첫번째. 거북의 등에 까마귀가 앉으리로다.\\n두번째. 기사는 공주를 위하여 나누며 곧 두 배가 되리로다.\\n세번째. 한곳에 두개가 존재하며, 앞보다 뒤가 반으로 차리로다.\\n네번째. 행운의 천상馬 는 아홉의 눈물로 사라지는도다.\\n다섯째. \\\" 곰의 꿀 \\\"이 그 의미로 존재하는 도다.\\n여섯째. 봄의 매실은 행운을 불러 오나 세 가지를 잃는구나.\",\"90\":\"첫번째. 저녁의 돌 (夕石) 이로다.\\n두번째. 가족의 \\\"꽃\\\" 으로 남으리로다.\\n세번째. 가면의 초록색은 바뀜으로써 행운이 생김이로다.\\n네번째. 달림으로써 다섯 번째의 의미가 생김이로다.\\n다섯째. 국(國)의 다섯 개의 이름 속에 떨어져 보이며, 그 의미 아래로 두 번 떨어지리로다.\\n여섯째. 굴러 두개의 안정 속에 네 개의 다침이로다.\",\"91\":\"첫번째. 구슬이 사라져 소리로 존재하리로다.\\n두번째. 검둥오리는 세 번의 늪에 빠지니 곧 잡히리로다.\\n세번째. 붉은 피의 사냥은 시작되며, 사냥꾼은 그 아래에 몸을 숨기는 도다.\\n네번째. 북극하늘에 오로라의 존재로다.\\n다섯째. 입과 귀와 손가락이며, 모두 세번째로 그 위치가 생김이로다.\\n여섯째. 가장 작은 하나를 이루며, 역으로 가며 중용으로 잘림이니라.\",\"92\":\"첫번째. 토요일에 바람은 또 다른 다침의 치유로 시작되는 黑風 이로다.\\n두번째. 혼돈은 회생의 시간으로 다가오며, 나눔이 있을 지로다.\\n세번째. 빛은 우정으로 인하여 꺼지며, 그 이상 의미는 無 로다.\\n네번째. 여덟 번째의 사랑이 존재하며 두 번을 지나가는 도다.\\n다섯째. 큐피드의 화살은 천사의 날개에 맞으니 곧 행운이로다.\\n여섯째. 인간이 살아가는 마지막 희망의 숫자로다.\",\"93\":\"첫번째. 행운 속에 \\\"룡\\\"이 호수에 출연하니 위태롭도다.\\n두번째. 배는 쓰러져 반만 잠기며, 다리위에 인간은 자신이로다.\\n세번째. 집으로 가며 기록을 남기니, 그 앞에 대상은 사라지는도다.\\n네번째. 지하의 \\\"룡\\\"은 인간을 삼키며, 부모와 아이의 노림이로다.\\n다섯째. 인간 세속의 \\\" 忍 \\\" 이로다.\\n여섯째. 행운을 부르는 셋 과 세 번의 꺾임의 끝수로다.\",\"94\":\"첫번째. 사각 안에 존재하는 이야기며 행운의 주기로다.\\n두번째. 가까우니 하늘에 호수로다.\\n세번째. 왕의 앞과 뒤에 총성이 존재하니 중용은 잊혀짐이로다.\\n네번째. 문 안에 사람이 있으나 갇혀 그 밖으로 나가지 못함이니라.\\n다섯째. 다섯씩 열개가 존재하니 두개가 향기로 잊혀짐이로다.\\n여섯째. 초록의 버섯은 죽음의 사신이로다.\",\"95\":\"첫번째. 공작새의 \\\"눈\\\" 이로다.\\n두번째. 인간사의 \\\"이기심\\\" 이로다.\\n세번째. \\\"동행\\\" 은 그 싹으로 희망이 되리로다.\\n네번째. 싸움에 편이 갈리며 \\\"관객을 속인 연극\\\"이 시작되리로다.\\n다섯째. 사자의 용맹은 발톱과 갈퀴에서 찾을 것이로다.\\n여섯째. 더함은 한 개의 쓰러짐과 한 개의 버팀으로 안정을 찾으리로다.\",\"96\":\"첫번째. 별이 존재하며 선 두개로 자르니 삼각형 아홉이 아닌 열개가 나타나며, 그 안에 첫번째 천기의 형상이 담기는 도다.\\n두번째. 열두 개의 바람꽃은 소의 다리에 밟히는구나.\\n세번째. 행운은 가을 속에 존재하나, 결국 날카로움의 아래에 생김이로다.\\n네번째. 독버섯의 나무는 진실이 되리로다.\\n다섯째. 거북과 두루미의 합장이로다.\\n여섯째. 붉음 속에 하루를 만들며, 그 忍 이로다.\",\"97\":\"첫번째. 冬 장군의 행운 속에 만찬은 독이 되리로다.\\n두번째. 여덟 병사는 죽음으로 道 를 다하며, 이중 다섯이 그 의미를 새기리로다.\\n세번째. 더함은 셋을 치고 나눔은 둘을 치니 배신의 무리가 정해지리로다.\\n네번째. 원두막의 존재에 노인은 태평이로다.\\n다섯째. 사마귀의 용서는 눈 큰 먹이의 피해로다.\\n여섯째. 흑 장막은 덮이나, 그 중 한 집만이 밝히리로다.\",\"98\":\"첫번째. \\\"용의 기사\\\"는 금옷을 탐하니 그 위에 서리로다.\\n두번째. 오리온의 죽음은 일곱 의 보석을 지니리로다.\\n세번째. 장군의 거북은 불을 뿜으니 행운의 첫 불꽃이로다.\\n네번째. 햇볕은 곡식에 \\\"낱알\\\"을 비추니 두번째의 따뜻함이로다.\\n다섯째. \\\"낱알\\\"의 흩어짐은 억압으로 나타남이로다.\\n여섯째. 폭풍의 언덕은 비 내림의 추락으로 존재하니 괴롭구나.\",\"99\":\"첫번째. 황금우유는 향기의 증표로 남으리로다.\\n두번째. \\\"여덟의 숫자\\\" 뒤에 숨겨진 거울의 잔상이로다.\\n세번째. 에스키모의 집은 튼튼하나, 고난의 존재가 있음이로다.\\n네번째. 相生 은 돌며, 중용의 숫자는 사라지며 두번째의 의미가 남으리로다.\\n다섯째. 참새는 제비를 따라 숲으로 이동을 하는구나.\\n여섯째. 아이의 웃음은 사라지고, 적막 속에 남은 \\\"구름의 빛\\\" 이로다.\",\"100\":\"첫번째. 개울가 다리의 한 여인과의 \\\"거짓의 약속\\\" 이로다.\\n두번째. 바람에 떨리는 영혼의 촛불이로다.\\n세번째. 古木의 버팀은 쓰러짐으로써 그 의미가 존재하리로다.\\n네번째. \\\"보화\\\"의 욕심은 곧 \\\"함정\\\"의 유혹이로다.\\n다섯째. 기다림의 여인 앞에 \\\"왕\\\"이 아닌 \\\"귀족\\\"의 출현이로다.\\n여섯째. 두개의 봉화가 존재하나 불은 곧 꺼지며 흑막이로다.\",\"101\":\"첫번째. 가을 흰 코스모스의 음악이로다.\\n두번째. 제국의 아침은 밝고, 비둘기는 다침이로다.\\n세번째. 白과 黑은 선으로 갈리며 곧 우측에 의미로 존재하리로다.\\n네번째. 거짓 세 개로 위아래 둘을 琉들며, 중용으로 부터 한 개의 복제니라.\\n다섯째. 아홉에 붙임은 끊어짐이 있어 존재하리로다.\\n여섯째. 아들이 업은 효행의 수는 적으리로다.\",\"102\":\"첫번째. 예전의 \\\"자신\\\" 은 지금의 \\\"자신\\\" 이 아닌 시간 속에서 사라짐이로다.\\n두번째. 인간 세속의 \\\" 망각의 강 \\\" 이로다.\\n세번째. 기사들의 전쟁은 \\\"불\\\" 로서 승부가 나며, 패자의 \\\"검\\\"은 녹아 사라지리로다.\\n네번째. 붉은 나방은 희망으로써 \\\"재\\\" 가 되리로다.\\n다섯째. 별 속에 갇힌 오리는 우측으로 의미가 존재하는 도다.\\n여섯째. 죽음은 겨울의 빛으로 그 의미가 생겨나는구나.\",\"103\":\"첫번째. 청실 과 홍실 의 福 이로다.\\n두번째. 커피 잔은 여덟 개의 깨짐으로 존재하는도다.\\n세번째. 흑은 사냥개에 물리며, 백은 그 위에 서리로다.\\n네번째. 행운속의 청자와 백자의 존재로다.\\n다섯째. 아홉의 구멍이 파이고 셋의 물이 차며, 차인물이 중용이 될 때 행운은 시작되리로다.\\n여섯째. 푸른 바닷속에 푸른 암초는 보이지 않으니, 죽음 속에 배를 침몰시키리로다.\",\"104\":\"첫번째. 해변의 꽃게는 절벽 속에 갇히리로다.\\n두번째. 두개의 보호 속에 따뜻함은 오히려 물로 사라짐이로다.\\n세번째. 石의 움직임은 빛이나, 그 빛은 \\\"재난의 빛\\\" 이로다.\\n네번째. \\\"눈\\\"으로 상상을 선물하며, 시간의 도둑이로다.\\n다섯째. \\\"공\\\"으로 가며, 점에서 셋이 나오며 공이 빠지니 \\\"빛\\\"이 되리로다.\\n여섯째. 파괴의 갈라짐 은 둘로써 갈라짐이로다.\",\"105\":\"첫번째. 四 로서 열리며, 신상이 서리로다.\\n두번째. 상자는 마지막에 열리며, 열림으로서 고통의 시작이로다.\\n세번째. 발을 띈 네 발자국은 뒤돌아서니 반대의 의미로다.\\n네번째. 인간 영혼의 깨끗한 \\\"생명수\\\" 이니라.\\n다섯째. 열두 번을 돌아가며, 역풍으로 네 번이 불 때 깨어지리로다.\\n여섯째. \\\"봉황\\\"의 깃털이 빠지나, 기쁜 울음뿐이로다.\",\"106\":\"첫번째. 아홉의 얼굴에 눈빛은 행운이 빛으로 인도하리로다.\\n두번째. 행복한 물의 꽃이며, 그 우측으로 행운의 지팡이가 서 있으리로다.\\n세번째. 다섯과 둘은 두개의 엄지에 존재하며, 그 중간에 여덟이 존재하니 행운의 수로다.\\n네번째. 감싸 안고 지탱하며, 문 앞을 지키리로다.\\n다섯째. 코끼리의 가장 오래된 양탄자로다.\\n여섯째. 구멍은 넷이며, 선이 두개니 연결은 곧 따뜻함이로다.\",\"107\":\"첫번째. 낙타위에 존재하는 달은 세번째로 뜨는구나.\\n두번째. 차가운 눈은 사라지고, 그 위에 더위의 표식을 남기리로다.\\n세번째. 사랑의 죽음은 곧 생명이 되어 우측으로 쓰러지는 도다.\\n네번째. 청소를 하며, 白 을 일으켜 지킴이로다.\\n다섯째. 젖어서 입으니, 빠져 접힘이로다.\\n여섯째. 살아남은 두 명은 죽음과 함께하며, 그 중 한명이 가는 길은 죽음이 아닌 길이로다.\",\"108\":\"첫번째. \\\"손\\\"을 보호하나 그것은 \\\"손\\\"의 보호가 아닌 \\\"손\\\"을 막음이로다.\\n두번째. 나무가 물을 담고, 한 번의 일을 하고 사라지니 덧없음이로다.\\n세번째. 오리와 죽음사이에 두개의 달은 곧 저물고, 행복의 음악은 네 번 울리리로다.\\n네번째. 원은 일곱 색의 존재가 없고, 생명을 살리기도 하며 죽이기도 하는도다.\\n다섯째. 사람의 머리에 서며, 먹기도 하며 하나의 의미에 살리로다.\\n여섯째. 물을 건너며, 태풍은 움직일 수 없으며 인간은 움직일 수 있으리로다.\",\"109\":\"첫번째. 하늘의 복숭아는 첫번째 존재로다.\\n두번째. 붉은 해룡의 식사로다.\\n세번째. 검은 장미의 부서짐은 천지에 나타나리로다.\\n네번째. 낙엽이 띄어진 바가지에 희망의 샘이 존재하리로다.\\n다섯째. 기사는 눈물을 가진 철가면으로 자신을 나타내지 않으리로다.\\n여섯째. 세 번의 박수로 두개를 일으켜 세우니 \\\"力\\\" 의 존재로다.\",\"110\":\"첫번째. 북을 쳐 소리를 들으니 세 번 울려 흐르는 소리로다.\\n두번째. 다섯의 노예는 일곱의 병사로부터 갇힘이 있으리로다.\\n세번째. 붉은 여우는 \\\"검은 진주\\\"를 얻어 행운을 잡으리로다.\\n네번째. 수면의 위는 모두 취하나 수면의 아래는 죽음이 존재하는구나.\\n다섯째. 뜨거움은 얼음위로 쏟아져 死를 남김이로다.\\n여섯째. 믿음의 징표는 걸려서 안정을 찾음이로다.\",\"111\":\"첫번째. 붉은 보리밭에 태양의 싹이로다.\\n두번째. 夫 는 큰 뜻을 이루리로다.\\n세번째. 뱀은 행운의 먹이를 찾아 세 번의 망설임이 있으리로다.\\n네번째. 여덟은 짧고 둘은 길으니, 세 번의 모서리에 맞으리로다.\\n다섯째. 七步 는 행운의 步 로다.\\n여섯째. 검은 태양을 등지고 새벽에 낙엽은 떨어지는구나.\",\"112\":\"첫번째. 바람에 빌딩이 무너져 새로운 숲을 이루리로다.\\n두번째. 거울은 자신의 반사가 아닌 꺾어짐의 반사 니로다.\\n세번째. \\\"맷돌\\\"의 중용은 곧 \\\"黑\\\"이 되리로다.\\n네번째. 탁자의 쓰러짐으로 운명을 다하는 \\\"병\\\"이로다.\\n다섯째. 빛이 물체를 비추니 그 뒤로 행운이 나타나리로다.\\n여섯째. 원숭이는 구름을 타니, 금빛을 볼 수 있으리로다.\",\"113\":\"첫번째. 멀어질수록 선이 더욱 가깝게 하리로다.\\n두번째. 일곱의 진주는 \\\"고래의 은구슬\\\" 이로다.\\n세번째. 안정선 위에 활동 선은 가장 커지며, 중심과 교차되리로다.\\n네번째. 천하는 코끼리의 놀이터가 되며 미끄러짐으로 그 행운을 타게 되는구나.\\n다섯째. 북쪽으로 향하는 황금소금만 존재 하는구나.\\n여섯째. F 의 의미는 사라지고 결과만 남으리로다.\",\"114\":\"첫번째. 검은 양복에 검은 넥타이는 불화협이로다.\\n두번째. 밝은 태양의 신은 구름에 가리어 그 빛을 쇠하리로다.\\n세번째. 여덟의 숫자 중에 세 개는 두개를 상대하지 못하리로다.\\n네번째. 붓은 세 개의 나뉨이니, 행운도 세 개로 나뉨이로다.\\n다섯째. 백두산 의 사라짐 속에도 정상은 존재하는구나.\\n여섯째. 한손의 총은 흑이요, 다른 한손의 총은 백이 되리로다.\",\"115\":\"첫번째. 자연은 솔의 푸르름으로 그 존재를 알림이로다.\\n두번째. 美 는 여덟 개의 큰 흙으로 뒤덮이니, 행운이 찾아오리로다.\\n세번째. 黑 의 칼 은 날카로움으로 물을 가르나, 물 은 칼의 날을 무디게 하는구나.\\n네번째. 여덟의 계단을 지나 소가 보이며 그 아래 꽃이 존재하니, 그 꽃은 \\\"천상화\\\"로다.\\n다섯째. 마음의 가둠이 곧 자신의 가둠으로 비추어 질 때 \\\"걸림\\\"은 두개의 쌍을 이루리로다.\\n여섯째. 인간 세속에 마지막으로 다가가는 \\\"세번째 큰 축복 \\\" 이로다.\",\"116\":\"첫번째. 시간의 흐름과 기억의 흐름은 공통이 되리로다.\\n두번째. 컵은 물을 담지 못하나 행운의 \\\"부드러움\\\"은 물을 담으리로다.\\n세번째. 붉음의 넷은 세워지고 붉음의 셋은 뉘어지니 그중에서 공통의 커진 숫자로다.\\n네번째. 세 명의 소녀가 왕을 바라보나 그 중 두 명은 외면하리로다.\\n다섯째. 천상의 나비는 꽃을 찾으나 꿀 은 그 뒤에 숨겨져 있는 도다.\\n여섯째. 모든 짝은 반대의 짝이 되며, 그 중에도 진실의 짝은 존재하는 도다.\",\"117\":\"첫번째. \\\"배\\\" 는 돛이 없고 \\\"길\\\"이 없이 흐르는 \\\"배\\\"로다.\\n두번째. \\\"순수함\\\" 의미 그대로 숫자의 행운은 다시 돌아오리로다.\\n세번째. 따뜻함은 공기로 전염되나, 가까움은 곧 생명의 태움이로다.\\n네번째. 백조는 검정의 띠를 두르며 그 반대쪽으로 세 번의 행복을 가지리로다.\\n다섯째. 인간은 이것으로 셋이 되며, 걸음은 곧 하나가 되리로다\\n여섯째. 白의 달콤함은 배부름이 없으리로다.\",\"118\":\"첫번째. 추위는 역행의 고드름으로 그 존재를 알림이로다.\\n두번째. 갈매기는 땅에 떨어지나 불은 그 생명을 살릴 것이로다.\\n세번째. 턱수염이 긴 신사는 \\\"나무의 적\\\" 이로다.\\n네번째. 행복은 \\\"어린아이의 눈\\\" 에서 시작되리로다.\\n다섯째. 열 마리의 돼지가 존재하며, 그 중 흑돼지는 아홉 마리의 어미로다.\\n여섯째. \\\"선\\\"은 빛과 기억과 뜨거움을 나타낼 것이니, 이중 천사의 선물은 하나로다.\",\"119\":\"첫번째. 함성 속에 묻힘은 곧 夏 로 시작되는 도다.\\n두번째. 빛의 존재인 \\\"비밀의 방\\\"은 동쪽으로 시작되니, E 의 시작이로다.\\n세번째. 인간사의 \\\" 참된 정직 \\\" 의 의미로다.\\n네번째. 문자는 여덟을 바라보고 있으며, 그 두번째의 마지막에 그 숫자가 다치리로다.\\n다섯째. 양과 양은 열아홉의 의미로 생겨나며, 그 열아홉은 또 다른 의미의 존재로다.\\n여섯째. 촛불의 그림자로 가장 가까운 의미로다.\",\"120\":\"첫번째. 흰천 아래 \\\"돌\\\"이며, 그 \\\"천\\\"은 돌 대신 맞으리로다.\\n두번째. 세 번 나비의 날갯짓은 행운을 불러 오는구나.\\n세번째. 동남의 바람은 오리를 두 번 살리는구나.\\n네번째. 천상의 소리를 내는 악기며, 그 음악은 길을 비추어 주리로다.\\n다섯째. 龍 은 푸른 龍 이 아닌 적색의 龍 이로다.\\n여섯째. 원숭이의 재주는 거울로 부터 나오리로다.\",\"121\":\"첫번째. 붉은 표범은 창에 갇히리로다.\\n두번째. 흑 구름은 바닥에 존재하며, \\\"제비\\\"의 비상이로다.\\n세번째. 불속에 남은 곰은 문자의 첫수로 존재하리로다.\\n네번째. 마지막 깃발은 꺾이며 파편의 조각이로다.\\n다섯째. 어두움의 빛은 선으로 인도되는구나.\\n여섯째. 세 번째 끈은 두 번째 끈과 연결되며, 첫 번째 끈과 세 번째 끈의 마지막은 같아 뒤집힘이 생기리로다.\",\"122\":\"첫번째. 슬픔의 리본은 봄의 \\\"風\\\" 이로다.\\n두번째. 더함은 두개의 표식을 남기니 기쁨의 눈물이로다.\\n세번째. \\\"口\\\" 로 세 번 들어가니 \\\"11\\\" 이 더하리로다.\\n네번째. 여인의 옷은 흑 푸름이요, 흑 푸름은 호수에 빠짐이로다.\\n다섯째. 아이의 숨소리는 셋으로 나타나며, 둘은 하나와 틀림이로다.\\n여섯째. 자신의 이름중 하나는 하늘과 공통이리로다.\",\"123\":\"첫번째. 들판위에 호박은 황금을 부르는도다.\\n두번째. 학이 원숭이 덫에 갇히니 쥐는 행운이로다.\\n세번째. 금색종과 은색종이 울리며 가장 높은 곳에 자연과 화합하리로다.\\n네번째. 해적의 깃발은 동쪽에 세워지리로다.\\n다섯째. 피부의 지도는 소용돌이의 지도로다.\\n여섯째. 별 속에 별이 존재하니 역금별의 통로가 되는구나.\",\"124\":\"첫번째. 독수리는 붉은 열매를 따고 곧 하늘로 날아오르니 일곱의 날갯짓이로다.\\n두번째. 공주는 두 번의 거짓과 네 번의 진실을 말하리로다.\\n세번째. 토인은 검으며, 진실된 행운은 그 가까운 곳에 존재하리로다.\\n네번째. 하늘에 검은 연기는 그 추락 속에 존재로다.\\n다섯째. 나뭇가지는 여섯이며, 짧은 가지 중 가림이 존재하리로다.\\n여섯째. 걷고, 뛰며, 날고, 타며, 작은 생명체는 그 자체의 신비로다.\",\"125\":\"첫번째. 달콤함은 부드러움을 녹이나, 그 옆에 딱딱함은 달콤함에 사라지리로다.\\n두번째. 부드러움의 선은 더함의 순간에 얼려 그 형상이 변하리로다.\\n세번째. 세상을 다 덮는 마술은 밤에 이루어지는 도다.\\n네번째. 인간 세속의 \\\"위선\\\" 이로다.\\n다섯째. 손을 쥐고 잡을수록 더욱 사라져 고통이로다.\\n여섯째. 탈은 하나의 진실을 보이며 하나의 거짓도 보이리로다.\",\"126\":\"첫번째. 에펠탑은 쓰러져 가까운 다침이 존재하는 도다.\\n두번째. 큰 냇물이 흘러가니, 선행의 川 이로다.\\n세번째.하늘이 뚫린 탑은 다섯이 존재하며, 그 탑의 사이에는 행운의 공간이 존재하니 그 공간은 오리의 집이로다.\\n네번째. 다이아몬드 는 낚싯줄에 걸림이 있을지로다.\\n다섯째. 천사의 날개와 천사의 창이 존재하며, 그 주위에 한 번의 띠를 두르고 두 번의 띠는 구멍이 나리로다.\\n여섯째. 과거 속에 잊혀진 五 이로다.\",\"127\":\"첫번째. 압정은 세워지며 서로 찔러 중용의 숫자로 나타나니, 존재 속에서도 先 이로다.\\n두번째. 지팡이는 오리를 찌르며, 그 시작 속에 첫번째로다.\\n세번째. 첫 만남으로 산과 하늘이 시작되며, 그 뒤로 세 번의 큰 걸음을 띄우리로다.\\n네번째. 원과 원에는 \\\"1\\\"이 존재하며, 휴식의 숫자가 그 열쇠이니로다.\\n다섯째. 거짓의 두번째 획은 같으며, 첫 번째 획은 無 가 되리로다.\\n여섯째. 하늘이 지붕을 덮고, 그 아래 큰 산이 존재하니 그 바닥에 중용이로다.\",\"128\":\"첫번째. 머리위에 존재는 양쪽으로 물리니, 손가락은 빛을 명령하리로다.\\n두번째. 열둘의 기사는 차례로 세 개의 창에 찔리며, 가장 얇은 창은 빠를 것이니 이중 공통은 여섯 중 다름이 존재하리로다.\\n세번째. 거미위에 얽힌 거미줄은 행운을 부르리로다.\\n네번째. 두개의 망치로 두들겨 힘을 받으니, 중심에서 깨어져 알에서 깨어나리로다.\\n다섯째. 한 식구며, 23의 식구와 33의 식구 뒤에 작은 3 이 남으리로다.\\n여섯째. 죽음의 바다를 흔드는 칼상어의 쫓김이로다.\",\"129\":\"첫번째. 삼각산 옆에 열쇠가 보이니, 高 의 상징이 되리로다.\\n두번째. 차가움 이후에 꽃의 향기나 취하면 죽으리로다.\\n세번째. 白 과 靑 의 함성 속에 \\\"천사의 계급\\\" 은 합이 있을 지로다.\\n네번째. 쉽게 타며 변형되며 생각을 전달하리로다.\\n다섯째. 태양을 부르는 소리의 발생체로다.\\n여섯째. 쥐가 헛간 구멍에 들어가나 곧 잡히며, 메기가 그 열쇠가 되리로다.\",\"130\":\"첫번째. 배부른 악어는 동쪽의 친구를 쫒는구나.\\n두번째. 동그라미 속에 세상은 빛으로 전달되는 도다.\\n세번째. 여름소나기에 지친 돼지로다.\\n네번째. 전쟁의 신은 둘과 둘의 힘으로 난관을 극복하리로다.\\n다섯째. 행복한 어부의 그물에 존재하는 행운이로다.\\n여섯째. \\\"삶 그리고 공간 그리고 숨\\\" 은 세 차례 뜀이 있을 지로다.\",\"131\":\"첫번째. 굴뚝에 연기는 검정이 아닌 흰색이며, 그 시간이 행운이로다.\\n두번째. 노인과 여인이 함께 앉고, 그 후 어린이의 웃음이로다.\\n세번째. 붉으며 셋에 앞뒤가 같으며, 땅에서 취하리로다.\\n네번째. 달 속에 꿀이 있으리로다.\\n다섯째. 물을 조심하며, 바람 속에 가벼우리로다.\\n여섯째. 네 개로 지탱하고 하나로 움직이나, 그 다섯은 모두 같은 형제로다.\",\"132\":\"첫번째. 거짓 새우의 상승이로다.\\n두번째. 오리는 세 번의 흰 날갯짓으로 그 존재를 알리는 도다.\\n세번째. 흑풍은 할퀴며, 상처 난 통나무집이 보이는 도다.\\n네번째. 비밀의 友는 아홉의 거짓으로 상처를 입으리로다.\\n다섯째. 압정은 나누어지며 각 세 개의 압정을 가진 \\\"탑\\\"의 존재로 시작되리로다.\\n여섯째. 열둘의 쌍 마차는 바람에 흔들리니 백마가 필요하도다.\",\"133\":\"첫번째. 창과 방패의 싸움은 \\\"네 번의 지침\\\"과 \\\"두 번의 부딪힘\\\"으로 결과가 나타나리로다.\\n두번째. 우주심의 날개는 두개가 존재하며 두 번의 추락이 생김이로다.\\n세번째. 천상락은 지상락과 통하리로다.\\n네번째. 냇물은 모여 폭포수로 모이니 그 血 이로다.\\n다섯째. 호랑이의 발톱은 사슴을 해치며 죽음의 독이로다.\\n여섯째. 눈은 날카로움을 바라보며 무디게 하리로다.\",\"134\":\"첫번째. 멈추는 돌이로다.\\n두번째. 일곱의 사파이어에는 바람이 불어 靑 이 되리로다.\\n세번째. 북쪽의 아침은 밝으니 토끼의 뜀은 바빠지는구나.\\n네번째. 새벽아침의 안개는 세 번의 보임과 세 번의 가림으로 시작되는구나.\\n다섯째. 뱀 사냥꾼은 알을 깨리로다.\\n여섯째. 네모와 원이 존재하며 인간의 허망한 力 이로다.\",\"135\":\"첫번째. 솟으니 압정과 두개의 깃발이 나타나리로다.\\n두번째. 흙으로 형상을 만드나, 존재의 힘으로 다시 흙이 되리로다.\\n세번째. 여우의 목도리는 슬픔의 목도리로다.\\n네번째. 창문은 닫혀있고, 장미는 밖이나 그 닫힘 안에 존재하리로다.\\n다섯째. 선으로 불이 일어나리로다.\\n여섯째. 나무는 도끼에 쓰러져 사라지며 선비는 기록하리로다.\",\"136\":\"첫번째. 우물에 낙엽이 떨어지니, 하늘을 가리는구나.\\n두번째. \\\"추락의 무게\\\"는 \\\"시간의 무게\\\"와 같아지리로다.\\n세번째. 심장의 위치는 행운의 위치로다.\\n네번째. 만년설(萬年雪) 의 기적이로다.\\n다섯째. 그 자리에 있으나, 낮에는 볼 수 없도다.\\n여섯째. 거울 속에 용머리는 깨짐이 있으리로다.\",\"137\":\"첫번째. 우주의 꽃을 삼키는 자연이로다.\\n두번째. 아침의 참새는 두개의 산을 넘은 참새로다.\\n세번째. 용암은 칼을 녹이나, 생명도 같이 녹이리로다.\\n네번째. 인간세속의 \\\"성공의문\\\" 이로다.\\n다섯째. 폭우는 두개로 의미가 생기며, 그 진실은 세번째로 남으리로다.\\n여섯째. 바람에 쓰러지는 것은 세 마리의 양이며, 이중 한마리만이 살 것 이니로다.\",\"138\":\"첫번째. 산과 두개의 터널에 갇힌 탑이 존재하며, 그 머리로다.\\n두번째. 닿으니 넷은 12를 가리키며, 하나는 태양을 가리키는 도다.\\n세번째. 빛으로 더욱 잘 보이며, 빛이 사라지면 같이 사라지리로다.\\n네번째. 붉은색은 멈추지 않고 이끌어 죽음으로 인도하리로다.\\n다섯째. 산삼은 \\\"인간의 효\\\" 속에 그 해답이 있으리로다.\\n여섯째. 네 번의 승리 옆에 세 개의 통나무가 존재하며 첫 번째 통나무는 가라앉아 첫수를  알려주리로다.\",\"139\":\"첫번째. 천사의 적화살은 희망에 꽂히리로다.\\n두번째. 눈으로 볼 수 없으나 물로 보이게 되리로다.\\n세번째. 몸으로 같이 사라지게 하리로다.\\n네번째. 기역(ㄱ) 이 다섯 개로 의미가 생기리로다.\\n다섯째. 무거움은 가라앉지만 가벼움은 움직이지 못하리로다.\\n여섯째. 無 로서 치유되나, 죽음은 그 안에 존재하리로다.\",\"140\":\"첫번째. 천둥소리와 함께 떨어지는 비밀의 복숭아로다.\\n두번째. 행운의 다침과 함께 맹수가 나타나리로다.\\n세번째. 사냥꾼은 스스로 판 함정에 몸을 숨기리로다.\\n네번째. 빛을 꺾는 도구는 세번째에 힘을 실으리로다.\\n다섯째. 흰 나방은 이슬 뒤에 존재하며, 행운을 가져다주리로다.\\n여섯째. 붉은 10월의 木 로다.\",\"141\":\"첫번째. 비밀의 열쇠는 리본이며, 그 리본 속에 네 개의 보물이 존재하리니, 선택은 하나며, 첫 관문에 두번째에 그 행운이 존재하리로다\\n두번째. 우측의 담은 세상을 덮쳐 죽음 앞에 멈춰 서리로다.\\n세번째. 독수리의 먹이가 된 뱀은 땅에 존재하지 않으리로다.\\n네번째. 붉은 자두를 가진 두 명의 기사는 행운의 기사로다.\\n다섯째. 허상의 빛이로다.\\n여섯째. 낚시의 침은 바다를 꿰뚫어 그 아래 두개의 대어를 낚으리로다.\",\"142\":\"첫번째. 가장 높은 곳을 날아도 한 번의 쉼이 존재할 때 덫에 걸리는 도다.\\n두번째. 아홉 방의 황금열쇠는 가장 가까운 곳에 존재하리로다.\\n세번째. 먹은 하늘을 검게 물들이니 이는 곧 \\\"흑풍\\\" 이로다.\\n네번째. \\\"붉음\\\" 과 \\\"깊음\\\" 속에 갇힌 \\\"의미\\\"로다.\\n다섯째. 악어와 악어새의 화합 속에 행운이 있으리로다.\\n여섯째. 겨울이 멈춘 시간 속에 비밀이로다.\",\"143\":\"첫번째. 세상에서 가장 작은 통로이며, 인간과 교류하리로다.\\n두번째. 어린아이의 넘어짐에 자연과의 첫 상처로다.\\n세번째. 창으로 부터 시작하며, 막아서니 그대로 굳어 버리는 도다.\\n네번째. 창을 넘어선 갑옷엔 부드러움이 존재하며, 달콤함이 있으리로다.\\n다섯째. 셋으로 나누어지는 孝 는 心 만이 아닌 다른 의미로 행운을 잡으리로다.\\n여섯째. 두 가지 자아의 발견이로다.\",\"144\":\"첫번째. 모든 것을 다 죽이지 못하나, 내 스스로가 갇혀 보호를 받으리로다.\\n두번째. 행운을 감싸는 꺾임은 셋의 의미와 통하리로다.\\n세번째. 세번째 소의 우측에 위치하며, 기사를 가진 숫자로다.\\n네번째. 여덟 개의 의미는 자신의 지도로다.\\n다섯째. 石 이 세 개와 石 이 두개의 차이로다.\\n여섯째. 천상의 계단에는 죽음이 존재하며, 꽃 아래에 감추어져 보이지를 않는구나.\",\"145\":\"첫번째. 레몬나무의 향내는 남쪽으로 가는구나.\\n두번째. 모래폭풍은 언덕을 만드니, 그 언덕은 천상의 언덕이로다.\\n세번째. 행동은 하나요 말은 둘이 되니, 일곱 날에 하나로 모일 것이니로다.\\n네번째. 당나귀는 여덟 번째로 나서니, 곧 지쳐 쓰러지리로다.\\n다섯째. 숲 은 일곱 人間 의 천국이로다.\\n여섯째. 福 안으로 빠져 행운 속에 죽으리로다.\",\"146\":\"첫번째. 걸리니 아픔이요, 걸리지 않음도 아픔이니 아픔이 아닌 두번째 아픔 속에 그 의미가 존재하리로다.\\n두번째. \\\"水\\\"로써 그 빛을 나타내니 그 빛은 결국 \\\"水\\\"를 죽이리로다.\\n세번째. 남극으로 향한 펭귄의 행복이로다.\\n네번째. 보호를 하며 봉쇄하나, 여행 후에 보호는 파괴되리로다.\\n다섯째. 바람을 타는 날개는 하늘을 날지 못하리로다.\\n여섯째. 선은 보이질 않고 날카로움은 함정으로 인도하리로다.\",\"147\":\"첫번째. 밤에 이동하며 낮에 잠을 자는 섬이로다.\\n두번째. 재물의 나타냄은 행운의 표식이 되리로다.\\n세번째. 왕은 거짓으로 세상을 어지럽히며 남는 것은 고통이로다.\\n네번째. 모두 7로서 이루어지는 세 쌍이 존재하니, 굴러 행운의 받침이로다.\\n다섯째. 두개의 손바닥과 두개의 눈이 같아지며 의미를 생각함이로다.\\n여섯째. 바람과 죽음 속에 갇힌 회호리가 존재하며, 살아남을 \\\"길\\\"은 하나로다.\",\"148\":\"첫번째. 흰색은 의미가 있으며, 사랑의 결실이로다.\\n두번째. 태양과 흙의 가족 중 한 가지가 빠지리로다.\\n세번째. 불과 나무의 화합이 단 한번으로 그 생명을 다 하리로다.\\n네번째. 대나무의 소리는 여덟 개 중 3개만이 남으리로다.\\n다섯째. 밥솥아래 땔감은 행운의 땔감이구나.\\n여섯째. 목을 감싸 \\\"가식\\\"을 가지리로다.\",\"149\":\"첫번째. 산 두개가 좌측으로 쓰러지며, 쓰러진 산 아래에 태양이 뜨며, 안정된 또 다른 산 두개가 나타나니, 그 후에 의미가 나타나리로다.\\n두번째. 깨끗함으로는 자신을 나타낼 수 없고, 더러움으로 자신을 명확히 나타낼 수 있을 것이니로다.\\n세번째. 행운은 쇠와 번개와 뜨거움으로 나타나리로다.\\n네번째. 구슬 열개를 가진 노인이로다.\\n다섯째. 파란 우산은 아홉이니, 그 중 한 개만이 펼쳐지리로다.\\n여섯째. 순리의 회전은 들어가나, 역행의 회전은 뱉으리로다.\",\"150\":\"첫번째. 별을 쓰며, 초록얼굴은 남고 붉은 얼굴은 사라짐이로다.\\n두번째. 보호를 받으면서 보호를 할 것이며, 보호자는 딱딱하나 자신은 부드러울 것 이니로다.\\n세번째. 셋중 가장 큰 사람이 가장 빠르나, 느린 작은 사람을 영원히 앞지를 순 없음이로다.\\n네번째. 밝은 곳은 빛이 있으나, 스스로의 몸도 태우리로다.\\n다섯째. 뛰어들어 떨어지니 물은 깊으며, 우측의 물살은 하나씩 더할 것이니, 이는 곧 바람을 맞아 더함으로써 그대로 멈출 것 이니로다. 37\\n여섯째. 노란 제비의 하강은 먹구름의 시작이로다.\",\"151\":\"첫번째. 떨어진 오리는 생명의 화살을 맞음이니, 깨어질 때 첫 시작의 증표로 시작됨이로다.\\n두번째. 無로써 커지고, 작은 \\\"선\\\"으로써 탈출하리로다.\\n세번째. 기사는 깃발 속에 전쟁을 하니, 세 개의 첨탑 속에 붉은색은 곧 \\\"적\\\"이로다.\\n네번째. 空 은 六 으로 채워지리로다.\\n다섯째. 두개는 공중에 뜨고 선은 지나가며 그 후에 그 두개는 땅으로 내려오는구나.\\n여섯째. 하늘에 존재하는 사자의 꿈이로다.\",\"152\":\"첫번째. 달콤함은 나무를 살리지만, 사라짐은 나무를 버리는 도다.\\n두번째. 도끼는 찍혀 죽음 속에 갇히나, 끊어짐은 곧 새싹을 틔우리로다.\\n세번째. 생명을 지탱하나 구멍으로 생명이 꺼지리로다.\\n네번째. 규칙 속에 움직이며, 사라지며, 큰 것을 노리리로다.\\n다섯째. 굴러 커지며 같은 형상의 힘으로 사라지게 하리로다.\\n여섯째. 닿으니 퍼지며, 사라지니 하늘이로다.\",\"153\":\"첫번째. 인간세속의 \\\"차가움의 결실\\\" 이로다.\\n두번째. 달팽이의 길은 빗물의 길과 통하리로다.\\n세번째. 창을 든 雪人은 오리와 마주치니 그 뒤로 눈물의 존재로다.\\n네번째. 멀리 흔적을 남기나, 그 흔적을 못 남김은 곧 자신의 파멸이로다.\\n다섯째. 천상하늘은 이동하며, 목적에 사랑이 더하리로다.\\n여섯째. 아홉에 선두개가 들어가니 곧 삶이로다.\",\"154\":\"첫번째. 붉은 사막의 石 은 행복의 石 이로다.\\n두번째. 중용의 문자에 오리두마리가 갇혀 있으니,태양으로 향한 두 번의 전진이로다.\\n세번째. 여덟 개의 사냥개는 일곱의 목수로부터 채찍을 받을 것 이니로다.\\n네번째. 성스러운 \\\"술\\\"이 존재하며, 그 아래 경배를 하는 人 이로다.\\n다섯째. 자신을 거짓 복사하며, 복사가 곧 그를 나타냄이로다.\\n여섯째. 빗물이 떨어지며 계단은 시작되고 그 끝의 마지막엔 행운의 기다림이로다.\",\"155\":\"첫번째. 검은 흑 갈매기의 낙하로다.\\n두번째. 고양이는 8번의 울음 속에 존재를 나타내리로다.\\n세번째. 두개의 비추는 모양은 열둘의 속삭임에 모양이 바뀜이로다.\\n네번째. 찔러 터지니 광대의 거짓웃음이로다.\\n다섯째. 낙엽 속에 부서짐은 곧 선(線)이 나타남이니라.\\n여섯째. 불상은 열의 모양새에 그 가치를 지니리로다.\",\"156\":\"첫번째. 인간세속의 \\\"순종\\\" 이로다.\\n두번째. 열둘의 시간 속에 셋은 죽음이요, 나머지는 삶이구나.\\n세번째. 바닥은 바닥으로 떨어지며, 하늘은 하늘로 일으켜 세워져 福을 이루리로다.\\n네번째. 불빛의 물고기는 생명의 물고기로다.\\n다섯째. 타는 재는 \\\"물\\\"이 아닌 \\\"불\\\"로 다스리도다.\\n여섯째. 아홉의 잔나비는 세 번의 재주로 기회를 얻으리로다.\",\"157\":\"첫번째. 춤추는 시간에 생명과 전쟁과 사랑이 녹아 의미가 생기리로다.\\n두번째. 龍은 푸른빛이 나며, 들소 떼가 그 앞길을 열어주리로다.\\n세번째. 단단한 돌 속에 세 번 파인 \\\"흠\\\" 이로다.\\n네번째. 시장에 소리는 밤을 깨우는 소리로다.\\n다섯째. 맑은 찻잔에 띄어진 낙엽은 새벽을 깨우는구나.\\n여섯째. 물을 건너는 뱀은 흰색으로 변하리로다.\",\"158\":\"첫번째. 함정에 빠진 球 는 열매를 얻으리로다.\\n두번째. 바람은 초라해지고 흰나비는 화려해짐이로다.\\n세번째. 상생과 상극이 존재하며, 네 번의 불로 상생이 꺼지리로다.\\n네번째. 별 여섯에 무지개가 걸리니 푸른색은 사라질 것 이니로다.\\n다섯째. 장미의 사랑은 가장 먼 곳으로부터 오는 차가움의 사랑이로다.\\n여섯째. 야생마가 뛰어노니 갈대가 흥이 겹구나.\",\"159\":\"첫번째. 소리의 神은 다섯으로 갇혀 여섯의 소리를 내리로다.\\n두번째. 흑 구름은 시간을 멈추게 하리로다.\\n세번째. 모닥불은 차가움으로 행복해지리로다.\\n네번째. 인간세속의 \\\"지배\\\" 로다.\\n다섯째. 시간의 지배는 모래왕국의 무너짐이로다.\\n여섯째. 물위로 달려 겨울이 되니 두선이 남으리로다.\",\"160\":\"첫번째. 진실의 열쇠는 다섯 고비에 찾을 것이며,\\\"눈\\\" 하나를 잃을 지로다.\\n두번째. 축복속의 꽃잎은 바람 속에 낙인이로다.\\n세번째. 友는 七속에 잠기니 곧 세 번의 진실이 숨어있으리로다.\\n네번째. 누런빛의 힘은 보이질 아니하고, 낙엽아래 사라짐은 없으리로다.\\n다섯째. 흙 속에 \\\"雪\\\"은 붉은색이로다.\\n여섯째. 여왕의 힘은 다섯의 힘으로 나타나며, 그 다섯은 그림자에 존재하리로다\",\"161\":\"첫번째. 날카로움 속에 형제는 \\\"갑옷\\\"속에 장수로다.\\n두번째. 13속에 하늘은 검은 형체며, 떨어져 빛을 남기리로다.\\n세번째. 어린아이의 장난은 꿈속에 기억이로다.\\n네번째. 사각의 틀 속에 꺾어짐은 의미로 존재하며, 하나만이 사라짐이로다.\\n다섯째. 엄지는 넷의 희생 속에 존재하며 하나가 더할 것이니, 이길 자는 정해져 있도다.\\n여섯째. \\\"노란클로버\\\"는 \\\"노란 장미\\\"아래 피는구나.\",\"162\":\"첫번째. 학이 날아드니, \\\"일장춘몽\\\"이구나.\\n두번째. \\\"짝\\\"은 일어난 \\\"짝\\\"이며, 쓰러진 \\\"짝\\\"과 공통은 다섯이니, 둘의 뜀이 행운이로다.\\n세번째. 밤 속에 나무의 빛은 행운을 비치는구나.\\n네번째. 날개는 떨어짐으로 땅과 친함이로다.\\n다섯째. 가을로 존재하는 초록바위 로다.\\n여섯째. 공포의 \\\"용\\\"은 죽음이며, 사용됨의 \\\"용\\\"은 삶이로다.\",\"163\":\"첫번째. 해, 달, 구름을 이루며, 易의 三 은 행운이로다.\\n두번째. 까치 산에 소의 뿔이 존재하며, 그 뿔이 생명이로다.\\n세번째. 바람은 \\\"관\\\"을 타고 \\\"원\\\"이 되어 사라지는 도다.\\n네번째. 십자가는 사각을 만드니, 날카로움이 남고 삼의숫자가 빠져 그 의미를 남기리로다.\\n다섯째. 인간중심의 표식은 그것의 반대로 남으리로다.\\n여섯째. 사진을 보여 나를 나타냄이로다.\",\"164\":\"첫번째. 기다림의\\\"종\\\"은 북쪽으로 가는구나.\\n두번째. 겨울은 네모 속에 존재하며, 뜨거움으로 더 필요하리로다.\\n세번째. \\\"불\\\"로 찍어 \\\"가치\\\"를 표현하리로다.\\n네번째. 사각에 맞서며, 원으로 이기며, 白 과 赤은 곧 승리의 표시니로다.\\n다섯째. 사용함으로 볼 수 있음이니, 나오면 벗으리로다.\\n여섯째. \\\"쇠\\\"는 부드러움 위로 가며, \\\"물\\\"이 도와 이룰 것 이니로다.\",\"165\":\"첫번째. 사각의 공간에 사람이 존재하니, 천상으로 오름이로다.\\n두번째. 컵은 쓰러져 심장을 잃으니, 땅이 취하리로다.\\n세번째. 쇠는 꺾임이나, 나무는 잘림이로다.\\n네번째. 파괴의 왕은 불이요, 안식의 왕은 행운이로다.\\n다섯째. 황소는 토끼로 인해 두 뿔이 사라지리로다.\\n여섯째. 龍 은 水 로서 힘을 얻으리로다.\",\"166\":\"첫번째. 여덟 개의 술잔 속에 구름이 비침이로다.\\n두번째. 하나가 둘이 되며 한번 사용하니 슬픔이로다.\\n세번째. 赤 은 글자와의 입맞춤이자, 자신의 복사로다.\\n네번째. 생활 속에 첫 구멍은 통하니 바다로 향하리로다.\\n다섯째. 종이는 자신을 빛내며, 이름으로 끝남이로다.\\n여섯째. 솔은 \\\"오리\\\"를 털어내고 세 번의 기회를 가지리로다.\",\"167\":\"첫번째. \\\"알\\\"은 원통에 존재하며, 불에 닿아 사라지리로다.\\n두번째. 자신은 중간으로만 존재하며, 둘을 하나로 만들리로다.\\n세번째. 눌러 창이 생기며, 전진하니 흔적이 남으리로다.\\n네번째. 거북의 등에 五 와 三 의 글자가 찍힘이로다.\\n다섯째. 오랜 古木 은 수요일의 휴가로다.\\n여섯째. 고리는 셋으로 꿰뚫며, 두개의 선으로 교차되리로다.\",\"168\":\"첫번째. \\\"낡은 가방의 봄 여행\\\" 은 따뜻함으로 첫발을 디딤이로다.\\n두번째. 접고 접으니 아홉의 면이요, 그 시작은 생명을 나타남이로다.\\n세번째. 바람에 쓰러진 푸른 소나무로다.\\n네번째. 별 속에 아름다운 소리는 여덟 계단에 걸리는 도다.\\n다섯째. 버려짐으로써 자신의 존재가 생기며, 다시 사용하니 그 존재는 사라짐이로다.\\n여섯째. 두개의 동굴은 하나로 연결되고, 작은 동굴로부터 계단이 곧 열리니 그 마지막에 행운의 열매를 얻으리로다.\",\"169\":\"첫번째. 죽음의 반지는 떠나가며, 잡으면 살지만 놓으면 죽음이로다.\\n두번째. 세 개의 안정과 세상의 기억은 공존하리로다.\\n세번째. 독버섯은 느티나무 안에 감싸 존재하며, 단한번의 추락이 있으리로다.\\n네번째. 거울은 알맹이의 달콤함만 보여주리로다.\\n다섯째. 밤에 더 크게 나타나니 상상의 현실은 허무함이로다.\\n여섯째. 生 과 不 은 그 뜻이 곧 이루어짐이로다.\",\"170\":\"첫번째. 선을 가진 도구는 가족을 이루며, 오름은 단 한번으로 나타나리로다.\\n두번째. 깊은 흙 웅덩이에 셋이 빠지니, 그중 둘은 서쪽으로 이동하리로다.\\n세번째. 山은 이름 속에 존재하며, 자신은 남을 인도하며 살고, 正이 부러짐으로써 그 생명을 다 함이로다.\\n네번째. 黃 은 씨앗을 감싸며, 해를 바라볼 것이니로다.\\n다섯째. 철의 열기는 장작으로 이루어지니 따뜻함이로다.\\n여섯째. 無 無 無 無 無는 빛으로 시작되며,\\\"방\\\"의 역행은 다섯으로 갈 것이로다.\",\"171\":\"첫번째. 맑은 거울에 비친 보리 싹은 동풍에 흔들리는구나.\\n두번째. 다리는 나무로 되어 있으며, 그 위에 붉은 깃발의 존재로다.\\n세번째. 눈 속의 사람과 생명의 알이 만나니, 형상이 나타남이요 감싸는 생명의 존재로다.\\n네번째. 압정은 서로 찔러 앞에 서며, 의미는 뒤로 서리로다.\\n다섯째. 오리 셋의 죽음은 사냥꾼이 애도하며, 방패로 무덤을 만들리로다.\\n여섯째. 벽돌이 쌓여 \\\"왕의 계단\\\"을 이루니 \\\" 城 \\\" 의 받침대가 되리로다.\",\"172\":\"첫번째. 흰 장갑은 선을 세우지만 흰 신발은 선을 가져감이로다.\\n두번째. 잘 익은 배는 떨어져 깨짐으로써, 땅의 재물이 되리로다.\\n세번째. 땅과 붙음은 잠시요, 하늘로 올라감은 잠시니, 이동함으로써 그 가치를 지니리로다.\\n네번째. 노랑 튤립의 향기는 나비의 유혹이 될 것 이니로다.\\n다섯째. 축제는 끝나고 갈대가 두 번 흔들리니, 귀뚜라미 소리만 들리는구나.\\n여섯째. 푸른 하늘의 장대비는 대나무를 적시지 못함이로다.\",\"173\":\"첫번째. 전쟁의 신은 평화의 신을 뜨거움으로 사라지게 하리로다.\\n두번째. 셋의 발걸음을 걸으며, 둘은 합침이요 하나는 멈춤으로 그 길이 보이는 도다.\\n세번째. 세 번의 박수 속에 가족이 만나며, 둘만이 빛으로 향하리로다.\\n네번째. 용암은 흘러 마을을 덮치니 그 마을은 金을 가진 마을이로다.\\n다섯째. 왕을 지킨 기사는 공주의 왕관을 취하며 큰 행운을 얻음이로다.\\n여섯째. 거울은 네 조각으로 깨지나 비춤의 형상은 깨지지 않으며, 그대로 다시 존재하리로다.\",\"174\":\"첫번째. 검은 컵을 뒤집어 물을 담으려 하는구나.\\n두번째. 콩 다섯 개가 들어가 초록으로 갈 것이니, 씨앗이 아닌 보화로다.\\n세번째. 벌은 침을 쏘며, 여왕벌 앞에 죽음을 가져가리로다.\\n네번째. 살인을 한 죄인은 두려움에 떨며, 龍 에게 잡히리로다.\\n다섯째. 열두 전사는 마지막 생명의 물을 마시며, 전쟁의 신호만을 기다리로다.\\n여섯째. 바이올린소리는 구름을 타고 천상의 멜로디가 되는구나.\",\"175\":\"첫번째. 다슬기는 봄의 아지랑이로다.\\n두번째. 붉은 광장에 분수가 보이며, 분수는 행운을 뿜어내리로다.\\n세번째. 코끼리는 얼룩말을 쫓아가니, 큰물을 얻으리로다.\\n네번째. 원숭이의 행복은 나무위에서 시작되는 도다.\\n다섯째. 미꾸라지는 진흙 속에 \\\"7\\\" 을 더 구하리로다.\\n여섯째. 여섯의 찔림은 터트리며, 그 아래 천상의 구름이 덮치리로다.\",\"176\":\"첫번째. 절벽을 올라가는 첫 \\\"충돌\\\"이로다.\\n두번째. 하루가 지나 산에 걸려 늦어짐이로다.\\n세번째. \\\"새를 위한 컵\\\"은 뒤집혀 나타나리로다.\\n네번째. 안정의 받침은 다른 하나를 받들리로다.\\n다섯째. 땅의 압정은 신발에 그 위력이 휘어짐이로다.\\n여섯째. 두 형제는 男 과 金 의 존재로다.\",\"177\":\"첫번째. 水를 가진 생명은 하나의 뿌리로부터 일어나니 탄생의 신호로다.\\n두번째. 화살의 진행을 막아 적이 생기니 그 적은 곧 자신임이로다.\\n세번째. 네 개의 골짜기에 봉우리가 둘이며 오리의 떠남이 보일것이니로다.\\n네번째. 사람은 걸으며, 태양을 피해 씀이로다.\\n다섯째. 불신의 안경은 나를 바라보며 불신의 왕이 가져가 쓸 것이로다.\\n여섯째. 인간 세속의 \\\" 영광의 과정 \\\" 이로다.\",\"178\":\"첫번째. 대지의 입맞춤은 날개의 짐승이 차지하며 하나를 세워 차지하리로다.\\n두번째. 하나는 날이 되어 둘로 가르니 여섯이 남으리로다.\\n세번째. 뚜껑과 받침이 존재하는 물 받음은 그 자리에 서 있는 도다.\\n네번째. 두개의 봉우리는 하늘을 꿰뚫는 낫의 보호를 받으리로다.\\n다섯째. 마음을 진정 비우며, 이것을 버리며 공을 들일 것이니 행운이로다.\\n여섯째. 孝 는 子 와 心 과 心 과 心 으로 이루어지며 이것이 곧 열쇠로다.\",\"179\":\"첫번째. 각과 원은 하나로 통하리니, 이는 곧 \\\"天\\\" 이로다.\\n두번째. 승리는 두 적(敵)의 목표가 되며, 한 적(敵)에게 잡히리로다.\\n세번째. 연결되니 하나는 뚫림이요, 다른 하나와 둘은 막힘이로다.\\n네번째. 행운의 \\\"거리표식\\\" 은 앞으로 존재하며, 빛으로 비추리로다.\\n다섯째. 가장 늦어짐 둘에 하나는 위에 서리로다.\\n여섯째. 돌 을 깎는 칼이며 세 번을 더 나아갈 것이로다.\",\"180\":\"첫번째. 좌는 구르며, 우는 멈추리니 그곳이 황금의 밭이로다.\\n두번째. 돛을 단 비수는 머리가 아닌 다리에 꽂히리로다.\\n세번째. 붉은색 생명은 아름다운 나라의 문자로 남으리로다.\\n네번째. 福 은 土 와 金 로서 생김이로다.\\n다섯째. 걸림은 둘이요, 하나는 안정됨으로 걸을 것이니 자연이 부르는 행운의 숫자로다.\\n여섯째. 범은 구슬을 삼키고 龍 이 되리로다.\",\"181\":\"첫번째. 하나가 되며 커져 둘이 되며 반은 넘지를 못함이로다.\\n두번째. 사탕의 달콤함은 둘로 나누며, 하나는 버림이요 하나는 취함이로다.\\n세번째. 시간의 하늘은 처음 것을 취하며, 시간의 서쪽은 행운을 가짐이로다.\\n네번째. 첫 만남의 시작이 되며 낫을 잃어 의미의 생김이로다.\\n다섯째. 비둘기의 소리는 셋으로 나누며 이중 두 소리만을 가져가리로다.\\n여섯째. 산이 작아 도구로써 윗산이 더 크게 보일것이로다.\",\"182\":\"첫번째. 가장 가까우나 만날 수는 없으니 안타까운 \\\"이별\\\" 이로다.\\n두번째. 크고 작고 크며 다시 작고 커지니 無 가 되리로다.\\n세번째. 만물의 공간속 의미가 생기며, 황금 꽃의 시작이자 마지막이 되리로다.\\n네번째. 인간은 씹어 의미며, 산에서 나는 \\\"세월\\\"의 선물이로다.\\n다섯째. 두개의 찔림만을 받쳐 드니 결코 뚫지 못하는 찔림을 위한 받침목이로다.\\n여섯째. 계단 모서리에 승리가 피어나며 하나의 존재가 합치리로다.\",\"183\":\"첫번째. 자신은 둘이나 하나로 만나며, 만남이 끊어지니 곧 無想 이로다.\\n두번째. 선은 공통이고 완전함이요, 반만 가진 선은 앞이로다.\\n세번째. 白 은 매일 부딪히니 생명이 연장됨이로다.\\n네번째. \\\"딱따구리의 부리\\\"는 행운만을 쪼움이나 비춤으로 이루어지리로다.\\n다섯째. 인간의 말을 막아 소리가 들리지 않으니 대복의 증표로다.\\n여섯째. 나무는 밤으로 부터 살며, 사람은 갇혀 사는구나.\",\"184\":\"첫번째. 세 개의 숫자가 모두 존재하는 하나의 숫자가 보이는구나.\\n두번째. 좌로 시작되는 二 의 막음에 五 침의 존재로다.\\n세번째. 거울 빛이로다.\\n네번째. 소리의 울림으로 소용돌이치니 멀리 가며, 멀리 가니 펴지리로다.\\n다섯째. 낮음이 아래에 쌓이고 높음은 나중의 순서이니, 그 순서만이 비(雨)를 이기리로다.\\n여섯째. 여인의 아름다움은 초록으로만 나오고, 떠날 때만이 의미가 생기며 그 이유를 알 것 이니로다.\",\"185\":\"첫번째. 성스러움의 끝이 바닥에 무릎을 꿇을 지로다.\\n두번째. 소년은 붉은 옷을 입고 달 위를 밟아 내려앉음이로다.\\n세번째. 국화가 된 젊은이의 소원이로다.\\n네번째. 안경아래 수염을 기른 男 이 존재하며, 행운이 그를 안내하리로다.\\n다섯째. 세 아이의 웃음은 철(鐵)과 나무(木)와 물(水)의 웃음이로다.\\n여섯째. 빛은 종이를 대신하여 연필을 사라지게 하니, 그 길에 서리로다.\",\"186\":\"첫번째. 붙어 해를 가리며, 하나가 서리로다.\\n두번째. 푸른봄의 노란꽃은 비를 만나 피어나니,행운의 꽃이 되는구나.\\n세번째. 달걀이 깨져 생명이 나와 相生 이 되리로다.\\n네번째. 새장안의 12 동물중 왕을 찾을것이니로다.\\n다섯째. 비를 만난 진흙은 뭉쳐 붙으나, 해를 만난 진흙은 갈라져 떨어지니 비통함이로다.\\n여섯째. 미래는 홀로 허상이며, 현실은 미래를 만들어 바치니 길을 걸어감이로다.\",\"187\":\"첫번째. 창은 구멍을 찾고, 살이 찌니 이제야 이동하는구나.\\n두번째. 은장도는 항아리 안에 담겨 숨겨짐이나, 어둠의 빛이 존재를 알림이로다.\\n세번째. \\\"25시간\\\" 을 가진 사람만이 살아남으리로다.\\n네번째. 흑인은 고양이로부터 지켜짐이요, 붉은 커튼은 겆히리로다.\\n다섯째. 황금곰의 발톱은 버팀목의 발톱이로다.\\n여섯째. 나무소리는 공간을 지키며, 하나의 원은 순서를 기다리니 소원의 이룸이로다.\",\"188\":\"첫번째. 無 와 國 은 휘날림에 비밀이 존재함이로다.\\n두번째. 붉음에 푸름이 생기니, 서로 도울때만이 행운을 일으키리로다.\\n세번째. 어긋난 하나는 찔리며, 잡혀 오르리로다.\\n네번째. 환갑의 더함은 붉은 아침의 비춤이로다.\\n다섯째. 구렁이는 원숭이와 함께 매의 부리에 잡히리로다.\\n여섯째. 바름(正)을 뒤로한 三 中 一 이로다.\",\"189\":\"첫번째. 더러움과 함께 사라지며 돌며 나누어지리로다.\\n두번째. 하늘아래 미끄러짐은 白위에 人間 이로다.\\n세번째. 불이 켜짐을 동시에 \\\"거절\\\" 도 함께 하리로다.\\n네번째. 나라를 \\\"中\\\" 에 두니 싸움은 시작되리로다.\\n다섯째. 심장을 움직이는 바람의 통로는 뒤에 서게 되며, 앞은 혼자가 되리로다.\\n여섯째. 하나가 모자라 채우니 또 하나가 모자라 죽음이 벗(友)이 되리로다.\",\"190\":\"첫번째. 도구를 사용해 셋의 형상을 만드나, 그들은 형제로다.\\n두번째. 겨울나무는 태양을 가릴수가 없으니 땅의 행복이로다.\\n세번째. 만나면 다섯으로 감싸며, 못만나면 하나로 감싸니 부부로다.\\n네번째. 七의 짝을 찾아 택하나, 三 이 짝이 없고 그중 一 이 구원하리로다.\\n다섯째. 쌀씻는 아낙네의 손은 따스함의 손이로다\\n여섯째. 맑은 아이들의 웃음을 막고 존재하는 어른들의 욕심이로다.\",\"191\":\"첫번째. 中 의 방향은 쓰러질때 一 이 되리로다.\\n두번째. 서로 보면 같으나 하나가 더 무거울지로다.\\n세번째. 오리는 붉음으로 다섯뜀을 뛰며,그 존재가 나타나리로다.\\n네번째. 원두막 아래 수박은 동심이며,손을 드는 존재의 출현이니로다.\\n다섯째. 그물은 작아 새를 잡지 못하며 새보다 더 무서움을 가져가리로다.\\n여섯째. 방에 갇혀 존재하는 두사람중 한명만이 발을 뻗을것이며,하나의 방은 복제 되리로다.\",\"192\":\"첫번째. 하나는 추락이요, 하나는 상승이니 둘은 한몸에서 서로 적이 되리로다.\\n두번째. 지팡이를 타고 올라간 뱀은 안식을 취하는 뱀이로다.\\n세번째. 칼의 날카로움은 꺾이고, 칼집속에서 비로소 행운의 안식을 느끼리로다.\\n네번째. 사라진 케잌은 시집간 공주의 밑천이로다.\\n다섯째. 다리를 건너는 아이들뒤에 쫒아오는 \\\"黑나비\\\" 로다.\\n여섯째. 천사들의 저축은 血 의 저축이로다.\",\"193\":\"첫번째. 둘이 붙어 地와 함께 하나를 만들 것 이니로다.\\n두번째. 두개는 쌍둥이며, 두개가 더 많고 열 일때 다섯이 더 많아짐으로써 비밀을 벗으리로다.\\n세번째. 노란 양산을 쓴 여인은 비를 맞을 것이니로다.\\n네번째. 세속의 강과 용기의 강은 맞서며, 한물줄기로 나타나리로다.\\n다섯째. 하프의 연주는 아홉 번 울리니 천상락의 연주로다.\\n여섯째. 백마의 채찍은 黑 의 차지로다.\",\"194\":\"첫번째. 폭력의 마크는 바람과 함께 셋이 사라져 나타나는구나.\\n두번째. 땅위에 선 거대한 중심이로다.\\n세번째. 발이 열개로 일곱의 진주를 가지고 달아나는 도다.\\n네번째. 선물속의 비밀은 금색의 리본과 빛과 물로써 알 수 있을것 이니로다.\\n다섯째. 東은 도끼를 가지며, 西는 활을 가지니 다섯 계단에서 만나 부딪치리로다.\\n여섯째. 폭포 앞 신호등은 볼 수 있는 자연의 신호로다.\",\"195\":\"첫번째. 無 아래에 五와 一은 부딛쳐 그것이 나타나리로다.\\n두번째. 담을 넘은 \\\"환호\\\"로다.\\n세번째. 12의 전사는 성을 지키며 하나의 표시로 땅에 서리로다.\\n네번째. 얼음을 깨무는 소리에 차가운 종소리가 울리는도다.\\n다섯째. 바람이 불어 황금이 쓰러지니, 평화로운 잠이로다.\\n여섯째. 갈매기의 비행은 여행이 아니며, 파도아래 사냥이로다.\",\"196\":\"첫번째. 승리 뒤에 패자는 마지막에 행운으로 돌려받으리로다.\\n두번째. 뜨거움의 음악은 소리로 나타나며, 곧 안개 속에 사라지는 도다.\\n세번째. 세발을 가진 닭은 발자국을 남기며, 둘을 더하리로다.\\n네번째. 고래를 탄 세 명의 어부 중에 두 명은 \\\"正\\\" 이로다.\\n다섯째. 하나는 \\\"묶임\\\"이요, 하나는 \\\"묶음\\\"이니 단 하나만 자유로다.\\n여섯째. 아무것도 행함이 없으니 이름이 되고  이름의 결과는 과정으로 나타남이로다.\",\"197\":\"첫번째. \\\"水\\\" 를 담아 하나가 작아지리로다.\\n두번째. 세상을 담는 그릇이며, 어깨에 놓인 꽃이로다.\\n세번째. 구름속의 달은 행복하며, 무지개를 만나니 더함이 없어라.\\n네번째. 12살의 행복과 21살의 행복은 조화를 이루며, 靑木 을 키우리로다.\\n다섯째. 東으로 떠난 전사의 아들이로다.\\n여섯째. 압정은 왕에 도전하며, 그 위에 날이 서리로다.\",\"198\":\"첫번째. 배는 기러기를 따라 고래를 쫓아가니 행운의 길이로다.\\n두번째. 벌레의 왕이 나타나며, 아홉으로 갇힘을 당하리로다.\\n세번째. 일곱 중 하나만 땅이며, 하나는 하늘이니 중용속에 꽃이 피리로다.\\n네번째. 사각은 원으로 정지가 되며, 영원히 기억되리로다.\\n다섯째. 셋의 발자국 속에 이루어진 둘의 이동이로다.\\n여섯째. 죽음위에 존재하는 초록생명이로다.\",\"199\":\"첫번째. 반원은 천장에 있으며 벗음은 곧 죽음을 알리는구나.\\n두번째. 생명의 부활은 붉은색 성을 찾아 그 입구에 서야 나타남이로다.\\n세번째. 검은색은 흰색이 되며 자라나자 곧 자르니 그것은 인간이로다.\\n네번째. 네개를 선택하여 하나이니 그 네개는 善으로 나타나리로다.\\n다섯째. 용광로의 기적은 꿈이 녹아 일어나니 아홉번째 꿈을 찾을지로다.\\n여섯째. 사람은 빗속에서 존재하니 세아이를 가진 사람이로다.\",\"200\":\"첫번째. 천사의 방패는 7로 이루어지며 그것을 뚫는 창이로다.\\n두번째. 용기를 가진 악행은 불속에 사라지는구나.\\n세번째. 뱀은 타조의 알을 삼키며, 늪 속에 잠이 드는구나.\\n네번째. 아기를 위한 기사는 창이 아닌 하프를 연주하는구나.\\n다섯째. 풀벌레 소리는 네 번의 울림 속에 의미가 있으며, 그 이외는 폭풍 속에 사라짐이로다.\\n여섯째. 낚시꾼의 함성은 시작 속에 들리는 도다.\",\"201\":\"첫번째. 세상에 거짓왕은 빛과 함께 사라짐이로다.\\n두번째. 잘라 의미가 있지만, 자르지 못하는 것에 그 힘을 잃으리로다.\\n세번째. 붙는 돌은 태양으로 부터 버림을 받으리로다.\\n네번째. 인간세속의 \\\"信\\\" 과 \\\"義\\\" 그리고 九 로다.\\n다섯째. 땅을 쳐다보니 곧 하늘이 되며 하늘을 쳐다보니 곧 땅이 되며, 동심만이 그 의미를 아는도다.\\n여섯째. 아름다움 속에 아름다움이 있으리로다.\",\"202\":\"첫번째. 장작은 다섯 번째가 진실이며, 재가 되니 곧 행운이로다.\\n두번째. 용기와 별을 가진 사자로다.\\n세번째. 두개의 나무를 가진 인간이로다.\\n네번째. 낮에는 조이며, 밤에는 풀리니 조일수가 없을 때 영원히 풀리는도다.\\n다섯째. 난장이는 나무 옆에 존재하며, 함정이 기다리는구나.\\n여섯째. 돌아가면 세상이 보이며, 멈추면 세상이 사라지니 천기의 머무름이로다.\",\"203\":\"첫번째. 생선은 도마 위에서만 존재하는구나.\\n두번째. 문자 두개는 黑속에서 그 의미를 더하며, 하나를 빼니 곧 비춤이로다.\\n세번째. 나무의 부러짐은 창이 되어 인간에게 돌아감이로다.\\n네번째. 노를 젓는 아낙네는 물속에 존재하는 힘을 모르는구나.\\n다섯째. 오른손의 장미꽃은 왼손이 부러우니 오른손의 존재를 잊어버리는 도다.\\n여섯째. 발을 떼니 공중에 오르며 선과 바람이 곧 친구로다.\",\"204\":\"첫번째. 기다리는 인간은 쓰러지며, 달려가는 인간은 복을 받으리로다.\\n두번째. 직업은 그곳에 존재하며, 자신을 빛내어 알림이로다.\\n세번째. 문안에 문이 있고, 움직임 옆에 움직임이 존재하리로다.\\n네번째. 자를 수가 없지만 자를 수가 있을 때가 되면 세 번 더 강해지리로다.\\n다섯째. 귀의 힘으로 막지만, 결코 막을 수 없으며 귀로 증명되는 도다.\\n여섯째. 같은 것이나 하나는 하나를 깎을 수 있지만 하나는 하나를 깎을 수 없도다.\",\"205\":\"첫번째. 돌리니 빛이요 ,역행이니 어둠이로다.\\n두번째. 밤에 필요하며 눌려지니 이는 곧 여행을 떠나보냄이로다.\\n세번째. 종이에 붙이니 움직여짐이요 종이와 함께 사라지리로다.\\n네번째. 자유를 억압하며 자유를 지키며 자유를 누릴 수 있는 철이로다.\\n다섯째. 꽃을 녹이는 방패는 폭포 뒤에 숨겨짐이로다.\\n여섯째. 바지가 잘림은 의미가 없으나 주인은 의미가 생기는 도다.\",\"206\":\"첫번째. 차는 사람아래 존재하며, 사고는 차를 파괴하지 못하나 사람은 파괴하리로다.\\n두번째. 다침은 더함으로 이동하며 살리니 더함을 떠나니 그 이동이로다.\\n세번째. 네 개의 감자 꽃은 태양을 항하여 피어나니 이제야 태양 꽃이 되는구나.\\n네번째. 하늘의 번개는 집으로 향하며 향함의 반대쪽에 행운이 향하리로다.\\n다섯째. 산 아래 악기는 신선의 악기로다.\\n여섯째. 장미의 배반은 왼손으로만 이루어질 것이리로다.\",\"207\":\"첫번째. 불빛은 파란 잎사귀에 휘둘리며, 자명종소리는 세 번의 의미를 갖고 사라지는도다.\\n두번째. 배추는 아름다운 행복이 되리로다.\\n세번째. 산소와 산소는 심장으로 향하며 두 번의 뜀으로 존재하리로다.\\n네번째. 둘의 존재는 약속의 징표이나 하나의 존재는 의미가 없도다.\\n다섯째. 어린이의 白은 행복의 白이며 따뜻함 속에 사라지는구나.\\n여섯째. 소리의 입구는 딱딱함이 꿰뚫으며 그 앞에 굳건히 서리로다.\",\"208\":\"첫번째. 선행의 잔은 검은 흑포도주가 담긴 잔이로다.\\n두번째. 낡은 수레를 찾아 바퀴를 고쳐야 황금 밭을 구를 수 있음이로다.\\n세번째. 배신의 창은 가시나무위의 갑옷을 뚫는구나.\\n네번째. 흑의 전사는 북으로 가니 두개의 동굴과 하나의 지팡이를 볼 것 이니로다.\\n다섯째. 두개의 숲속에 사냥꾼의 곰덫이 존재하며, 황금으로 그 의미를 새기리로다.\\n여섯째. 볼에 태양이 두개요, 두 손에 무지개가 존재하니 행복이로다.\",\"209\":\"첫번째. 사각 속에 불빛을 내는 상자는 행복의 상자로다.\\n두번째. 태움으로써 작은 전쟁의 시작을 알림이로다.\\n세번째. 벽은 중용으로 연결되며, 통과된 첫번째 관문이로다.\\n네번째. 龍 은 붉은 태양을 향하여 남쪽으로 가는구나.\\n다섯째. 12계단은 짝과 짝으로써 의미를 찾으며 이중 바람과 통하리로다.\\n여섯째. 세 개의 옷을 입은 악어새는 악어만을 따르리로다.\",\"210\":\"첫번째. 마법의 칼은 구름을 잘라야 하며, 비가 내림으로 증명되리로다.\\n두번째. 별은 바닷속에 갇히며, 그곳에서 북쪽으로 모이는구나.\\n세번째. 셋의 마음속에 셋의 영원함이 깃들 것이니 이는 곧 \\\"천상향\\\" 이로다.\\n네번째. 흰색과 검은색은 땅이 되며, 땅을 밟으니 곧 천사의 소리로다.\\n다섯째. 10년 전의 추억은 되돌아 올수 없으나, 10년 후의 추억은 되돌아 오늘이로다.\\n여섯째. 창을 맞은 돼지는 산에서 추락할지로다.\",\"211\":\"첫번째. 연기가 되어 피는 꽃이로다.\\n두번째. 인간세속의 \\\"순정속의 첫 만남\\\"이로다.\\n세번째. 두 소의 싸움은 흰색 벌판에서 이루어지는구나.\\n네번째. 달콤한 집은 남쪽으로 향하는 길목에 있도다.\\n다섯째. \\\"붓\\\" 속의 쥐는 \\\"우산을 가진 쥐\\\"로다.\\n여섯째. \\\"붓\\\" 속의 칼은 \\\"왕을 향한 칼\\\" 이로다.\",\"212\":\"첫번째. 카시오페이아의 행운은 붉은빛 사이에 존재하는구나.\\n두번째. 바다가 보이는 신선의 계곡을 찾아야 하며, 그곳에서 가장 높은 곳에 서리로다.\\n세번째. 오리 셋은 죽음의 통로 안에 서며, 가장 처음의 시작이니로다.\\n네번째. 원본 체와 중용의 만남은 이루어지며, 그 안에 셋의 의미가 더할 것이니로다.\\n다섯째. 창을 든 병사들은 지쳐 쓰러지고 말을 탄 기사들이 그 앞에 서니, 요새속의 영웅이로다.\\n여섯째. 포수와 오리는 한길에서 만나며 서로 그 존재를 감추지만, 포수는 결국 오리를 잡으리로다.\",\"213\":\"첫번째. 뱀은 두개의 피라미드를 막아서니 행운을 찾으리로다.\\n두번째. 날개하나를 잃은 역회전은 처음만남을 가지리로다.\\n세번째. 땅을 파내는 숫자 위에는 자유가 존재하는구나.\\n네번째. \\\"용의 얼굴\\\"은 바로 자신이로다.\\n다섯째. 거짓을 역행하여 채워 3이니, 그 절벽의 중용이로다.\\n여섯째. 셋의 제외는 첫 문자로 채워지며, 그 뜻으로 위치가 존재하리로다.\",\"214\":\"첫번째. 두개의 다른 사각이 존재하며, 보다 큰 사각의 시작은 행운을 가진 시작이로다.\\n두번째. 어부가 고기를 잡아 세 마리가 그물에 걸리니, 그중 첫번째니라.\\n세번째. 두 눈을 감은 사람의 왼쪽엔 한 눈을 감은 사람이 존재하며, 오른쪽 눈의 바닥에 고인 눈물이 그 행운이로다.\\n네번째. 흰색거품의 마술체로다.\\n다섯째. 행운을 기울이는 초인간의 숫자로다.\\n여섯째. 보이질 않는 압정의 반쪽은 그 해답이 되며, 중용의 낙하로다.\",\"215\":\"첫번째. 붉은 오렌지는 여섯으로 나뉘어 동쪽으로 떨어지는구나.\\n두번째. 여덟 창 아래 무지개가 걸려 있으니 구름 속에서 그 행운을 찾는구나.\\n세번째. 머리를 감은 아낙네의 빗을 찾을지로다.\\n네번째. 걸어서 三 이요, 뛰어서 五 이니 행운은 둘의 차이에서 올 것 이니로다.\\n다섯째. 馬車는 六의 힘으로 움직이리로다.\\n여섯째. 용기를 가진 항아리는 스스로 깨짐으로써 물을 쏟으리로다.\",\"216\":\"첫번째. 두개가 붙어 있어 움직임이 생기나 두개가 합하면 火가 생기리로다.\\n두번째. 신뢰로 만나며 인사도 하며 도움도 줄 것이나, 떨어짐은 곧 머리로 대신할 것 이니로다.\\n세번째. 작은 원이 큰 원보다 더 행운이며, 파괴가 그 목표이니로다.\\n네번째. 열두 마리의 뱀은 가족이며, 세 마리의 거북은 그 위에 서리로다.\\n다섯째. 소리를 가진 원은 빛으로 탄생되는구나.\\n여섯째. 원통의 양쪽에 불과 물이 존재하니, 연기와 함께 스스로 타리로다.\",\"217\":\"첫번째. 칼을 버린 왕은 王을 해치지 못하니, 하나로 시작되리로다.\\n두번째. 박쥐 두 마리의 보금자리는 사각이며, 날아오르니 그 표식이 생기리로다.\\n세번째. 얼음 속에 남겨진 신의 메모로다.\\n네번째. 독수리는 황금 밭을 맴돌며, 그 위에 방패가 존재하니 황금을 보호함이로다.\\n다섯째. 백꽃이 만발하여 향내는 水를 따르리로다.\\n여섯째. 숨 막히는 \\\"열꽃\\\"은 오른쪽에 서리로다.\",\"218\":\"첫번째. 불을 가진 선은 물에서 탄생되는구나.\\n두번째. 삼각은 원으로 돌며 木을 잘라 그 생명을 이어가리로다.\\n세번째. 흰색위에 검정색이 존재하며, 그 사각이 가라앉아 자신을 표현하리로다.\\n네번째. 하나에서 여러 곳으로 나뉘며, 더러움을 가져가 하나로 사라지는구나.\\n다섯째. 사각은 모여 반원이 되며, 그 반원은 생명을 지켜주는구나.\\n여섯째. 붙여 여행을 가며, 도장이 찍힘으로 그 삶은 끝이로다.\",\"219\":\"첫번째. 장미의 가시는 진실의 손가락을 찌르리로다.\\n두번째. 이발사의 까마귀는 행운의 까마귀로다.\\n세번째. 구멍이 많은 黑 은 그 색을 잃을 때 부수어 재가 되리로다.\\n네번째. 정원안의 연못은 진주위에 존재하는구나.\\n다섯째. 큰 거울은 편지위에 있으며, 거울에 비친 글씨는 다섯으로 나타나리로다.\\n여섯째. 커튼을 치자 풍경이 사라지며, 셋을 더하여 행운을 부르리로다.\",\"220\":\"첫번째. 신성한 와인은 두개의 손가락을 탐하며 행운을 가져가리로다.\\n두번째. 담배의 추락은 三 에서 만나리로다.\\n세번째. 숨겨진 독사의 독은 햇빛에 반사로 가려낼 수 있을것이니로다.\\n네번째. 녹색 코뿔소는 門 속에 존재하는구나.\\n다섯째. 동전 6개중 2개가 황금이니로다.\\n여섯째. \\\"ㄱ\\\" 과 \\\"ㄷ\\\" 은 형제가 있으며, 비밀의 열쇠는 1을 더하리로다.\",\"221\":\"첫번째. 주전자 에 담긴 물중에 \\\"꽃이 피는 물\\\"이 존재하리로다.\\n두번째. 有 는 田 과 田 과 田 을 통하여 나타나리로다.\\n세번째. 검은 콩은 보리 속에 존재하며 행운을 가져다주는구나.\\n네번째. 세 걸음 뜀은 가면의 여인을 발견하고, 네 걸음 뜀은 폭풍에 휘말릴 것이니 행복한 승리를 얻으리로다.\\n다섯째. 단추는 여덟이요 더함은 셋이니 추락하는 행운은 福 을 줄 것 이니로다.\\n여섯째. 거북의 배는 지도가 되며, 그 지도 속 마지막에 보물이 존재하리로다.\",\"222\":\"첫번째. 다이아몬드는 거울을 통하여 빛이 나며, 空 間 은 행운이 채우리로다.\\n두번째. 족두리와 연지는 신부의 얼굴을 붉게 만드는구나.\\n세번째. 검은 두건을 쓴 남자는 낙타를 타고 있고 피리를 왼손에 가졌음 이니로다.\\n네번째. 사막을 헤매는 여우는 길을 잃었으며 나무두개의 꺾임이 길을 안내하리로다.\\n다섯째. 영원의 늪 속에 빠진 목걸이는 생명의 목걸이니로다.\\n여섯째. 두 발은 차갑게 얼고 두 손은 뜨거워지니 생명불의 존재로다.\",\"223\":\"첫번째. 손에 든 지팡이는 춤을 위한 것이요, 춤이 끝날 때 빛도 사라지리로다.\\n두번째. 오리는 허상이며, 추락하니 깃털만이 존재를 알리는구나.\\n세번째. 산 정상에서 바라본 달의 모습이로다.\\n네번째. 사냥꾼은 돼지를 쫓아 언덕에 오르나, 청색나비는 사냥꾼을 잠재우리로다.\\n다섯째. 사슴은 뿔이 걸리고 호랑이는 덫에 걸리며 두 동물은 마주 치리로다.\\n여섯째. 카우보이의 모자는 신발에 걸려 땅에 떨어지지 않는구나.\",\"224\":\"첫번째. \\\"개\\\"는 \\\"쥐\\\"의 도움을 받아 물길을 건너니 행복한 모습이로다\\n두번째. 떠구지머리를 한 여인네는 부채로 얼굴을 가리는구나.\\n세번째. 세 마리의 돌고래를 가둔 창속에서 창을 깨는 돌고래를 찾을 지로다.\\n네번째. 돌절구 통에는 아무것도 없고 곡식은 옆에 있으나 찧을 필요가 없구나.\\n다섯째. 큰 바다를 건너는 배는 폭풍을 만날 것이며, 폭풍이 아닌 네번째 파도에 의해 침몰되리로다.\\n여섯째. 신발을 벗은 네 명의 인간은 그 자국을 남기며, 그중 하나는 죽고 하나는 쓰러지니 그 의미가 더하리로다.\",\"225\":\"첫번째. 머리 위를 지나가는 귀마개는 입구에 존재하며, 소리의 증명으로 나타나는구나.\\n두번째. 나무숲은 불타 재가 되 \\\"天\\\" 과 함께 하는구나.\\n세번째. 딱정벌레는 날고, 잠자리는 앉으니 거미는 딱딱함을 얻으리로다.\\n네번째. 북에 태극이 존재하는 \\\"잠들지 않는 북\\\"이로다.\\n다섯째. 임금의 망토는 바람에 날리며, 땅에 펼쳐져 하나가 되리로다.\\n여섯째. 無 는 心 을 움직이며, 無 는 과거를 회상하여 길이 되리로다.\",\"226\":\"첫번째. 겨울에 태어나 숨 쉬는 여름나무로다.\\n두번째. 세 번의 칼날 중 한 번의 칼날은 날이 부러지며, 나무속에 쇠를 발견할 것이로다.\\n세번째. 토끼는 날다람쥐와 함께하며, 여우는 여섯의 뜀을 뛰어 나란히 하리로다.\\n네번째. 폭포위에 홍학의 자태는 아름답구나.\\n다섯째. 악어가죽의 핸드백을 든 여인의 모습이구나.\\n여섯째. 五에게 향하는 행운은 세 가지 거짓약속으로 다가갈 것이니, 그중 마지막의 독잔만 피하리로다.\",\"227\":\"첫번째. 무색은 검은 알갱이로 검게 물들며 흰색은 그 후에 들어가 따뜻함에 녹으리로다.\\n두번째. 흰색수염과 흰색옷 그리고 지팡이의 이름이로다.\\n세번째. 모두 모여 조정함이요, 검지는 그 대표로다.\\n네번째. 은색접시의 상승은 3번 꺾인 상승이며 행운을 주는 상승이로다.\\n다섯째. 구렁이는 옥수수 밭에 있으며 그 행운은 2개로 나뉘리로다.\\n여섯째. 허수아비위에 개구리로다.\",\"228\":\"첫번째. 피라미드는 네 개의 입구 중 달빛이 없는 입구가 생명의 문이 되리로다.\\n두번째. 보석은 용의 머리에 존재하며 100의 추락에 휴식을 취하리로다.\\n세번째. 水는 동굴을 감추고, 네 번의 불빛이 존재하는 곳에 신호로 나타나리로다.\\n네번째. 수호신이 떨어진 문은 보물이며, 수호신의 떨어짐은 그 방향을 알려줌이로다.\\n다섯째. 두개의 손에 하나의 손이 억압하며 두 손은 그 한손에 따라가리로다.\\n여섯째. 믿음은 아들의 손에 쥐어져 있으며, 그 곳에 父 가 존재하리로다.\",\"229\":\"첫번째. 효행의 존재를 찾아내어, 진정한 효행의 존재일 때 비로소 그 숫자가 보이리로다.\\n두번째. 12개의 우물은 생명의 우물이며, 그중 가장 작은 우물이 행운을 가져다주리로다.\\n세번째. 가장 높은 곳에 한번 서며, 가장 낮은 곳에 한번 서며 세 개씩 둘이 될 때 나타나리로다.\\n네번째. 길모퉁이의 과꽃은 고무신을 감추는구나.\\n다섯째. 세찬 비는 가장 높은 첫 열매를 떨구니, 그 아래의 열매는 떨어지지 않는구나.\\n여섯째. 천재의 고통을 알지 못하나, 천재의 詩 는 느낄 수가 있을 것이로다.\",\"230\":\"첫번째. 돌아가면 설 것이요, 멈추면 넘어지니 땅과 서로 맞서는 존재가 아니라 바라보는 존재로다.\\n두번째. 만날 수가 없으며, 늘 바라보며, 남을 위해 자신의 존재가 있음이로다.\\n세번째. 잠을 청하여 여행을 떠나니 이는 곧 \\\"신선계\\\" 로다.\\n네번째. 馬 은 코끼리와의 친구가 됨이며, 둘의 역행은 행운의 역행이로다.\\n다섯째. 장바구니속의 오렌지는 3을 구하리로다.\\n여섯째. 달려 \\\"선\\\"을 쥐어주니 그 \\\"선\\\"은 \\\"선\\\"을 통과할 때 멈추리로다.\",\"231\":\"첫번째. 흑색 진주에 피는 石의 花 로다.\\n두번째. 보라색 모자를 쓰고 부드러움으로 다가서는구나.\\n세번째. 인사를 하는 젊은이는 밤의 존재가 있음에 발등이 밝아지는구나.\\n네번째. 안전한 모자에 칼날이 박히며, 오른쪽의 존재에 비로소 깊어지는구나.\\n다섯째. 접고 펴며 소리의 유와 무가 존재하며, 빛의 숫자는 3시의 첫 만남을 가리키리로다.\\n여섯째. 두개의 발자국은 열 명의 전사를 따라가나, 열 명의 전사가 사라질 때 두개의 발자국은 멈추리로다.\",\"232\":\"첫번째. 용기를 가진 호수는 60의 나이를 가진 호수로다.\\n두번째. 황금과 부를 따르는 오리는 천상의 오리가 되리로다.\\n세번째. 겨울의 상자는 번개의 힘으로 만들어지리로다.\\n네번째. 불이 꺼지자 연기가 나며 그 연기는 적을 사라지게 하리로다.\\n다섯째. 선은 교차하며 두개의 원은 닮았으나 적이 되어 경쟁하리로다.\\n여섯째. 원과 원 사이에 선이 존재하며, 그 존재는 또 다른 원위에 나타남이니 두들김으로써 이유를 알 것이리로다.\",\"233\":\"첫번째. 밀은 고기를 품고 더움으로 익혀 나감이로다.\\n두번째. 뿔은 福속에 존재하며, 산에서 보게 될 것이리로다.\\n세번째. 사각 속에 또 다른 사각들이 존재하며 그 사각의 불빛은 가족과의 만남이로다.\\n네번째. 머리를 통과하지만 몸은 빠져나가지 못하며 걸려 빛이 나리로다.\\n다섯째. 채를 사이에 둔 거짓 새로다.\\n여섯째. 철이 눈을 감아 손님을 사라지는 도다.\",\"234\":\"첫번째. 색은 손안에 나타남이요 열개로 나누어지리로다.\\n두번째. 불은 아래에 존재하며 뜨거움에 비로소 열리는구나.\\n세번째. 한걸음에 하늘과 가까워지는 마술의 길이로다.\\n네번째. 차가움의 물에서 나오니 이는 곧 옆으로 걷는 행운이로다.\\n다섯째. 선물의 동물이며 동심의 동물이니 복을 가져오는구나.\\n여섯째. 3번의 메아리는 \\\"木\\\"에 걸려야만 살 수 있을 것 이니로다.\",\"235\":\"첫번째. 걸어가는 휴식의 나무는 동쪽으로 가는구나.\\n두번째. 어린이의 웃음은 존재하다 떠나며 이는 곧 흔들림의 멈춤이로다.\\n세번째. 두 손은 끈을 잡고 있으나, 모래에 인연으로 끈을 다시 놓으리로다.\\n네번째. 사수자리는 흑곰의 동쪽에 존재하리로다.\\n다섯째. 지평선에 파도는 고래를 밀치는 파도로다.\\n여섯째. 얼음 속에 핀 불이 존재하며 죽음이 그 불을 지키는 도다.\",\"236\":\"첫번째. 세 번의 약속은 거짓으로 나타나니 手를 믿어야 함이로다.\\n두번째. 서풍이 불어 떠나는 인간은 足으로 구분해 낼 지로다.\\n세번째. 태풍을 막는 우산이며 비를 피하리로다.\\n네번째. 눈물을 흘리는 초록은 태양을 보며 얼굴이 붉어지리로다.\\n다섯째. 네 개의 사랑이 모여 그 복사의 역행을 받아들이는구나.\\n여섯째. 하늘을 오르니 집의 도착은 곧 \\\"파멸\\\"이 되어 끝이로다.\",\"237\":\"첫번째. 아홉 개의 별을 가진 낫이로다.\\n두번째. 두개의 뿔을 가졌고, 갑옷을 입고 움직이는 네 개의 다리를 쓰러뜨려야 함이며 세 명의 전사를 잃고 한명의 전사만이 살아남을 것이 니로다.\\n세번째. 두개의 보석이 달린 분홍의 드레스는 영광을 가져다 줄 것이 니로다.\\n네번째. 늙은 나무를 조이는 화려한 덩굴이 존재하나, 그 미약한 뿌리가 약점이로다.\\n다섯째. 올챙이는 아이의 손에 담겨져 비로소 고향을 떠나리로다.\\n여섯째. 나무는 뜨거움으로 옷을 네 번 바꿀 것이니, 이중 세 번째와 네 번째 옷이 행운이로다.\",\"238\":\"첫번째. 컵이 네 개요, 손잡이도 네 개이며 쓰러져 동서남북의 방향으로 각각 결정되리로다.\\n두번째. 붉은색과 보라색풍선이 함께하며 그중 바람에 하나를 잃을 것이 니로다.\\n세번째. 시원한 바람은 內 이며 뜨거운 바람은 外 이니 여름에 필요함이로다.\\n네번째. 참나무는 한 뺨의 두께와 두 뺨의 길이로 잘려 탄생되니, 꿈을 가져다주는 나무로다.\\n다섯째. 땅의 진동은 돌을 붓고 그 돌의 채움은 기름이 덥히니 그것이 이동의 증표로다.\\n여섯째. 사냥개의 움직임은 왼쪽의 덫을 피하나 오른쪽의 덫에 걸려 울부짖는구나.\",\"239\":\"첫번째. 뜨거움은 강할 때만이 다치고, 다칠 때 숫자는 그 옆으로 연결되리로다.\\n두번째. 바위산속의 용광로는 붉게 타는구나.\\n세번째. 트럭은 흑돼지를 싣고 세 개의 마을을 지나는 도다.\\n네번째. 피아노는 흙탕물에 잠겨 소리가 나지 않는구나.\\n다섯째. 白 은 풀려 부풀어지고 감아 작아지니 기둥만이 남겨질 것이니로다.\\n여섯째. 비가 온 후 달팽이는 수채화속에 남겨지는 도다.\",\"240\":\"첫번째. 죄수와 자유와 연결되는 통로로다.\\n두번째. 사슴벌레는 붉은 낙엽 속에 감추어짐이로다.\\n세번째. 소녀의 기도는 그 첫 만남이 그 열쇠며 그 첫마디로다.\\n네번째. 물 아래에 붉음의 의미는 두 번 돌아 위치가 정해지리로다.\\n다섯째. 계단의 아래에 열린 포도는 행복을 가져다주는 포도구나.\\n여섯째. U 는 U 로 연결되며 또 다른 U 는 하나로 나누어지는구나.\",\"241\":\"첫번째. 자유의 여신상의 가장 높은 곳에 존재하는 천기의 숫자로다.\\n두번째. 캥거루의 주머니는 情을 가져다주리로다.\\n세번째. \\\"양\\\"과 \\\"여우\\\"는 한배를 탔으며, \\\"양\\\"의 죽음이 곧 \\\"여우\\\"의 죽음이로다.\\n네번째. 초롱불빛은 어둠속에 눈이며, 곧 희망이로다.\\n다섯째. 목수의 못은 녹이 슬지 않으며, 手의 마술 속에 남을 것이 니로다.\\n여섯째. 영원한 氣속에 의미가 있으며, 눈꽃송이가 증거가 될 것이 니로다.\",\"242\":\"첫번째. 음악은 車가 되며, 곧 길을 달리니 행복이구나.\\n두번째. 환상은 물을 보이며, 그 물은 초록모래를 사라지게 하리로다.\\n세번째. 일곱 개의 별은 십자의 형상이 태양을 향할 때만이 그 행운을 볼 수 있을 것이로다.\\n네번째. 한국에 존재하는 기린은 순수함의 주인이로다.\\n다섯째. 사각상자에 진동은 담기며, 그 진동이 전달되는구나.\\n여섯째. 압정은 N극에 존재하며 그 추락이 존재하는 도다.\",\"243\":\"첫번째. 곰의 아픔은 찔림에 있으며 그곳에 행운이 존재하리로다.\\n두번째. 아비뇽의 행운은 찾아오며 그 두번째의 인간이 열쇠로다.\\n세번째. 시간의 산을 찾아야 하며, 승리가 동쪽으로 향할 때 그 숫자 둘이 보이리로다.\\n네번째. 길을 떠나니, 惡 과 善 을 나누는 지팡이로다.\\n다섯째. \\\"언니의 동생\\\"은 \\\"누나의 동생\\\"과 다름이 존재하니 천기의 수로다.\\n여섯째. 흰색을 등에 담고 가장 무거운 곳으로 들어가니 생명이로다.\",\"244\":\"첫번째. 천원의 푸름은 원을 뜻하며, 그 숫자를 찾을지로다.\\n두번째. 뒤집혀 붙으니 물을 담으며, 그 속에 하나가 세워져 보이질 않는구나.\\n세번째. 한번 돌고 다섯 번을 꺾여 의미가 생기며, 열네 전사의 이름이 되리로다.\\n네번째. 죽음의 땅속에 파묻힌 항아리이며, 그 항아리는 白 의 의미를 담으리로다.\\n다섯째. 인간세속의 \\\" 성공의 질투심 \\\" 이로다.\\n여섯째. 無 의 용기는 거북이로부터 탄생될 지로다.\",\"245\":\"첫번째. 사각은 네 개의 원을 가두며, 가둠으로 인간은 사라지는 도다.\\n두번째. 고래의 수염은 북극으로 향하며, 세 개의 빙하를 지날 때 멈춰 서리로다.\\n세번째. 물개는 낙원 속에 춤을 추며, 태양아래 증표를 남기는구나.\\n네번째. 꽃을 따르는 벌은 바람을 따라 동으로 향하며, 벽에 막힐 때 솟아 그 뜻을 이루리로다.\\n다섯째. 잔디를 심는 아낙네는 셋을 건너 띄며, 낙엽을 밟지 않으리로다.\\n여섯째. 남쪽의 神 은\\\"농구공의 지도\\\"를 풀어, 죽음을 맞이하리로다.\",\"246\":\"첫번째. 폭우는 멈추고, 달빛아래 노랑우비는 자연이 되는구나.\\n두번째. 궁도의 표적은 천사의 화살이 향하며 올빼미의 눈으로 볼 수 있으리로다.\\n세번째. 태풍은 오렌지나무를 흔들어 열매를 떨어뜨리는 도다.\\n네번째. 마법의 가위 속에 금발은 잘리며, 흙으로 담아내리로다.\\n다섯째. 인절미는 색동 속에 어울림이로다.\\n여섯째. 북쪽의 호수는 네 번의 불을 담그고 차가운 얼음을 지닌 호수로다.\",\"247\":\"첫번째. 사랑의 열매는 금송아지의 탄생으로 이루어지리로다.\\n두번째. 빛의 파도는 피라미드의 전사가 지킴이로다.\\n세번째. 12의 전령들은 아홉의 약속을 지키고 하나의 거짓을 행하니, 남은 행운이 뒤따라가리로다.\\n네번째. 용서를 구하는 삶의 방식이로다.\\n다섯째. 거미는 서쪽에 존재하며, 그 음악은 표시가 되리로다.\\n여섯째. 원반을 던지는 사람은 福 으로 녹으리로다.\",\"248\":\"첫번째. 당근 속에 당나귀의 천국이 존재하는구나.\\n두번째. 일곱 개의 은수저는 꽃의 향연이로다.\\n세번째. 둘은 공중에 여덟은 땅에 존재하니 그 둘은 으뜸의 표시로다.\\n네번째. 날카로운 바늘은 바위를 만나 부러지고 실만이 그 하나를 붙잡아 간직하리로다.\\n다섯째. 다리는 빙판위에 존재하여 그 의미를 되찾지 못하는구나.\\n여섯째. 남에게 빌려준 입은 \\\"지식의 입\\\"이로다.\",\"249\":\"첫번째. 문어는 두 가지를 잊고 있어 돌아갈 것이니 이중 가장 넓은 것을 골라내야 함이로다.\\n두번째. 사냥꾼에게 돌아간 선물은 곧 나를 향한 비수이니, 그것을 넘을 때 행복이 찾아올 것이리로다.\\n세번째. 좌를 돌아 뾰족하며, 상승하니 원이라 그곳에 生은 행운의 꽃이 피리로다.\\n네번째. 추락의 승리는 黑의 다이아몬드 속에 박히리로다.\\n다섯째. 상처난 가죽옷을 입은 다섯 병정은 어둠속에 갇히는구나.\\n여섯째. 돌로 된 사자는 병아리의 놀이터가 됨이로다.\",\"250\":\"첫번째. J를 치는 그 순간에 시간이 멈춰 영원한 행복의 도착임을 알리는구나.\\n두번째. 비가 내려 행복이나 비가 내려 불행이니 제3의 雨 로다.\\n세번째. 토끼의 얼굴은 보물섬이로다.\\n네번째. 럭비공의 움직임은 6의 시작과 3의 뜀으로 시작되며, 게임의 규칙은 X의 존재로다.\\n다섯째. 선글라스가 네 개요, 빛은 없음이니 생명의 시간이구나.\\n여섯째. 천막 속에 녹색풍선이 가득 들어 있구나.\",\"251\":\"첫번째. 흑인은 손톱이 길고, 백인은 손톱이 짧아 그대로 하나로 보이는구나.\\n두번째. 선인장속에 생명의 물은 세 번을 건너야 삶이로다.\\n세번째. 구렁이는 임금을 휘감아 번개를 맞으니 無 로다.\\n네번째. 폭포수의 쏟아짐은 낚시꾼의 눈을 가리는구나.\\n다섯째. 표를 산 손에 잡힌 조개로다.\\n여섯째. 얼굴에 가면은 쌍둥이를 구분하지 못하며, 움직임의 크기로 구분해내리로다.\",\"252\":\"첫번째. 지푸라기 속에 반딧불이로구나.\\n두번째. 생일을 맞은 허수아비는 3번째 옷을 갈아입는구나.\\n세번째. 안경의 빛은 꺾임이 존재하며, 목적을 속이리로다.\\n네번째. 황금마차의 축배로다.\\n다섯째. 사마귀의 전사는 흑두건을 쓰리로다.\\n여섯째. 연은 하늘에 뜨며, 붉은 날은 세 번 기억나리로다.\",\"253\":\"첫번째. 장수하늘소는 북쪽에 존재하며 그 투구를 벗으리로다.\\n두번째. 젖은 빨래의 지폐는 한숨 속에 나타나리로다\\n세번째. 진흙에 굴러 진주는 사라지나 묶인 돼지의 나타남이로다.\\n네번째. 하얀 손수건은 하늘에서 떨어지니 장독대는 그 자리로다.\\n다섯째. 호랑이는 무늬가 사라지며, 덫을 놓고 기다리는구나.\\n여섯째. 허름한 초가에 플렌카드의 나부낌이로다.\",\"254\":\"첫번째. 복숭아밭에 낙하산은 펼쳐짐으로 나타나는구나.\\n두번째. \\\"이황이 가진 비밀의 꽃\\\" 은 완전함으로 찾아낼 지로다.\\n세번째. 종이학을 비추는 전신거울이구나.\\n네번째. 긴 칼 위에 광어는 생명이로다.\\n다섯째. 금반지는 광화문에 걸리니, 위태롭구나.\\n여섯째. 목탁 속에 바람은 머무르니 자정에 나오는구나.\",\"255\":\"첫번째. 풍선을 든 악어는 웃음을 조심하는구나.\\n두번째. 벌에쏘인 여우는 세바퀴 굴러 생명을 가지리로다.\\n세번째. 얼굴에 의미가 존재하며,두개를 의지하여 하나를 이롭게 하는구나.\\n네번째. 흰색선은 돌며 춤을 추며,꽹가리의 소리는 흥을 돋구리로다.\\n다섯째. 밤벌레는 밤속에 안식을 취하는구나.\\n여섯째. 모래사장에 빠져 멈춘말은 사라지고, 달리는 말은 빠져나오리로다.\",\"256\":\"첫번째. 하늘의 사과를 깎은 과도는 \\\"천상도\\\" 로다.\\n두번째. 나그네의 나이는 주막의 한잔술에 어울림이로구나.\\n세번째. 아파트마다 다른색이 붙어 있으며, 같은층에서 바라봄이로다.\\n네번째. 엽서는 두개의 바람을 타고, 한개의 산을 넘어 전해지리로다.\\n다섯째. 이슬을 피해 처마아래에 앉아 별을 바라보는구나.\\n여섯째. 나라사랑은 인간 손바닥의 복제로 시작됨이로다.\",\"257\":\"첫번째. 꿩은 흰 고양이의 눈을 피하여 숨는구나.\\n두번째. 12지신은 땅과 인연이 있으며, 불을 좋아할 때 그 모습이 보이리로다.\\n세번째. 붉은 카펫위의 원과 끈이 움직이며 그 장난감은 가을의 왈츠로다.\\n네번째. 물총을 쏘는 동심은 黑海에서 이룰 지로다.\\n다섯째. 흰 번호판의 주인은 파랑색의 글씨를 남기리로다.\\n여섯째. 용이 떨어뜨린 왕관은 용의 것이 아니며, 그 주인은 그 뒤에 가려 존재하리로다.\",\"258\":\"첫번째. 야구장불빛은 잠자리 떼의 보금자리로다.\\n두번째. 아낙네의 소풍은 돗자리위에 낮잠이 되는구나.\\n세번째. 아이의 바지는 왼쪽발위에 걸치며, 하나는 껴입지 못하는 도다.\\n네번째. 놀이공원에 짐승들이 풀어지니, 입이 큰 짐승이 가장 늦는구나.\\n다섯째. 성문(城門) 위에 올라가 앉아 아래를 내려다보니, 네 명의 병사가 보이는구나.\\n여섯째. 11월의 보석을 지닌 지구는 넷으로 나누어 셋은 밤이 되는구나.\",\"259\":\"첫번째. 나무는 황금 옷을 입고, 그 옷을 벗어 진실된 사랑에게 주니 받은 자는 행복이로다.\\n두번째. 검정색 꼬리는 초록색구슬로 찾으니 일곱의 별이 기다리는구나.\\n세번째. 황소와 우산은 폭우에 떠내려가며 다리는 생명의 탈출구가 될 지로다.\\n네번째. 용기를 얻은 까마귀는 반지와 신발을 물어 떨어뜨리니 그곳에서 행운은 도착하는구나.\\n다섯째. 도둑이 숨은 옥수수집이 존재하며 불에 타 재만 남으리로다.\\n여섯째. 시장상인의 강아지는 \\\"복사과\\\"를 훔치리로다.\",\"260\":\"첫번째. 동그라미와 달콤함은 아이들의 울음을 그치게 하며 馬 위에 천사가 타는 풍경이로다.\\n두번째. 만년설위에 작은 돌은 바람을 타고 이동하는구나.\\n세번째. \\\"백운호수\\\"속에 비친 소나무로다.\\n네번째. 임신한 여인은 아궁이에 불을 지피는 도다.\\n다섯째. 단풍잎은 바닥이 아닌 옥탑방 창가위로 날려 쌓이는 도다.\\n여섯째. 이불을 널어 해를 기다리나, 가을비가 심술을 부리니 어찌할 것이더냐.\",\"261\":\"첫번째. 다이아몬드는 강원도로 가며, 강원도 안에 두 개의 원은 大福의 심장이 되리로다.\\n두번째. 솜사탕을 만들어 보라고 하니, 아이는 보라색의 설탕을 섞는구나.\\n세번째. 마늘과 보리는 서로 만나 행복이로다.\\n네번째. 똑똑똑 세 번 두드려 열리니 황금알을 낳는 거위로다.\\n다섯째. 복어의 毒은 毒으로써 파괴되리로다.\\n여섯째. 황금동전은 딸기밭 위에 뿌려지니 황금밭이로다.\",\"262\":\"첫번째. 두 개의 링으로 수첩을 만들고, 수첩을 뜯어버린 아이만이 바로 앞에서 행운을 찾지 못하는구나.\\n두번째. 담배잎으로 만든 담배는 곧 꺼지나, 연기는 하늘로 오르리로다.\\n세번째. 앞으로 가는곳에 계단이 있으며 뒤에는 절벽이니, 좌측의 친구는 도움을 주는 친구로다.\\n네번째. 중용의 역으로 도니, 다섯 번이 꺾여 두 개가 붙는 첫번째의 별이로다.\\n다섯째. 빗자루는 파란색이며, 주황색 망토는 빗자루를 덮으리로다.\\n여섯째. 가면은 뿔로 연결되며, 세가지 뿔 중에 가운데 뿔이로다.\",\"263\":\"첫번째. 흰옷을 입은 남자가 울고 있으며, 머리위에 끈이 보이는구나.\\n두번째. 세 명의 발레리나는 춤을 추며 그중 두번째 묘기의 주인은 붉은 치마로다.\\n세번째. 웃음 아래에 빛이 들어오며, 갈채 속에 연극은 세 번의 나눔으로 끝이 나리로다.\\n네번째. 피아노에서 책이 떨어지니 피아노가 가벼워지는 책이로다.\\n다섯째. 이발사는 가위로 오이를 자르는구나.\\n여섯째. 잠을 청한 나그네 둘은 福이며, 붙어있는 친구 중 한명은 수염을 깎지 않은 노승이로다.\",\"264\":\"첫번째. 너구리의 잠수는 \\\"삶\\\" 이며, 방향은 구슬을 얻음으로 시작되리로다.\\n두번째. 비가 온 후 다림질은 뜨거움이 사라진 후에 끝이 되는도다.\\n세번째. 기사의 창은 \\\"철갑馬\\\"를 뚫고 승리의 깃발을 세우리로다.\\n네번째. 향수의 향내는 금빛반지의 깨짐으로 퍼짐이로다.\\n다섯째. 두개를 바꾸어 네개를 가져옴이니,일년의 곡식을 얻으리로다.\\n여섯째. 삼각의 안식처에 동물의 얼굴을 보았음이니,이는 곧 천상이로다.\",\"265\":\"첫번째. 붉은 태양을 등에 지는 시계는 태양과 함께 할 때, 그 숫자가 보이는구나.\\n두번째. 용의 승천은 友 의 배신을 나타냄이요, 그 뒤에서 세번째에 의미가 있으리로다.\\n세번째. 자동차는 사거리에 도착하니, 북쪽엔 黑의 차가 존재하며, 남쪽엔 白의 차가 존재하고 있슴이니, 나머지 두 방향에 황금을 찾으리로다.\\n네번째. 빛은 잎이 아닌 꽃을 비추고, 천상에서 두개의 잎이 떨어질 때 그 시간을 알리는구나.\\n다섯째. 잃어버린 첫사랑을 찾아내나, 이미 세 번의 기회가 사라짐이요, 그 이후에 찾아든 사랑의 흔적이 남으리로다.\\n여섯째. 금붕어의 죽음은 흙토가 아닌 \\\"황금물\\\"에 있슴이니로다.\",\"266\":\"첫번째. 흰뱀은 버섯 3개를 취하며 나무에 오르는구나.\\n두번째. 거울은 사랑으로 통하는 문이 될지니,거인은 거울을 지켜내리로다.\\n세번째. 흙탕물에 진주 여섯은 거북이가 삼키며,학은 그위로 날아가리로다.\\n네번째. 죽음을 태운 불의 총이 존재하며,그 총의 탄환이 달로부터 떨어지리로다.\\n다섯째. 왕의죽음은 적색깃발의 기사의창에서 시작되며,그 무리들은 함정에 빠지는구나.\\n여섯째. 하늘과 맞닿은 구(球)는 독수리의 먹이가 되리로다.\",\"267\":\"첫번째. 영광의 十 은 태양의 방향에 존재하며, 동일한 태양의 꽃이 피며 밤이 찾아올 때 눈 안에서 맺히리로다.\\n두번째. 어둠속에 갇힌 노루는 세번의 종소리와 깃발의 신호로 찾을것이니로다.\\n세번째. 구슬을 가진 동자는 福 을 가져다주며 忍 으로 구슬을 얻으리로다.\\n네번째. 환갑의 의미는 북두칠성으로 가려지며,둘로 쪼개어 바람을 타고갈때에 행운이 찾아오는구나.\\n다섯째. 겨우살이는 초록의 나무를 감싸고,초록의 나무는 東 과 함께 기운을 얻으리로다.\\n여섯째. 엄지의 자리는 하나며, 가장 가까운 두형제를 찾아서 하늘로 향할 때 의미가 생기니, \\\"二\\\"는 죽음과 가까이 할때 그 숫자가 맞으리로다.\",\"268\":\"첫번째. 검은 화요일날은 검은 빗줄기의 날이며, 담쟁이 벽을 타고 흐르는구나.\\n두번째. 산삼은 붉음이 두번에 거쳐 찾아올때 나타나며, 복을 가진 늙은이는 동굴아래 그 존재가 보이는구나.\\n세번째. 용왕제는 어정(御井)에서 나타나니 그 그림자를 찾을지로다.\\n네번째. 초가집은 얼음에 갇히며, 큰 망치를 찾아서 깨뜨리는구나.\\n다섯째. 수미산(須彌山) 정상에 효심(孝心)을 가진 두 아이로다.\\n여섯째. 두바닥을 칠때 세개로 나누어지며,한개의 선을 그을때 밝아지는 숫자로다.\",\"269\":\"첫번째. \\\"독도\\\"의 위에서 잉어가 뛰어노니, 파랑새가 맞는구나.\\n두번째. 사랑의 추락속에,해를 담는 주머니구나.\\n세번째. 동쪽이 곧 북쪽이 되니,자연의 풍경이 바뀌는구나.\\n네번째. 바닷속의 보물은 山 과 통하며,두개의 보물을 취하리로다.\\n다섯째. 중년신사의 중절모는 나이를 감추고, 그 위에 나비가 앉으리로다.\\n여섯째. 11명이 쓰러지니 그 시작은 \\\"완전함\\\" 이니로다.\",\"270\":\"첫번째. 무척 작으나, 100명이 먹을수 있는 가장 정직하고,큰 그릇이 되리로다.\\n두번째. 천장의빛은 3개로 나누어지며, 그 아래의 그림자는 힘을 잃으리로다.\\n세번째. 진동은 위로 두번울리며 땅이 갈라짐은 서쪽으로 시작되니 행복이구나.\\n네번째. 영혼을 가진 나무는 두개의 황금열매를 가졌으며, 하나는 추락속에 압정의 힘이 존재하리로다.\\n다섯째. 배의 사라짐은 세개의 점이 나타나는 중앙에 위치하며, 그 실체가 증명되리로다.\\n여섯째. 비가 곧 눈으로 바뀌어, 얼어가는 얼음의 모자로다.\",\"271\":\"첫번째. 초침은 열두번을 돌며, 바람과 만날때 솟구쳐 승천하리로다.\\n두번째. 작은돌과 큰돌의 존재는 안경을 통하여 보이고,그안에\\\"水\\\"와\\\"木\\\"이 존재하리로다.\\n세번째. 다이아몬드는 서쪽을 기준으로 세번을 역행하며, 7시와 만날때 멈추어 이루어지리로다.\\n네번째. 손바닥에 압정은 찔리지 아니하고,봄빛은 손바닥을 따뜻하게 하리로다.\\n다섯째. 目 과 耳 는 흐려지며, 푸른색을 더함이 곧 회생이로다.\\n여섯째. 보물선은 고래의 왕을 찾아가야하니 그 마지막이며, 서쪽으로 부터 계단의 문이 시작되는구나.\",\"272\":\"첫번째. 땅아래에 둘의 존재는 방향이 교차하며, 깨어날때 행운이 되며, 하나가 되리로다.\\n두번째. 달빛 하늘은 사라지며, 사냥꾼은 두눈만이 어둠에서 깨어날 것이니, 바로 앞의 먹이로다.\\n세번째. 작은빛은 큰빛을 위해 밝히며,큰빛이 살아나면 작은빛은 꺼질것이니 작은빛의 시작을 찾을지로다.\\n네번째. 눈물속의 회초리는 그 아픔을 찾을때만이 그 소원을 이루리로다.\\n다섯째. 아이들의 인사는 행복으로 바꾸어지는구나.\\n여섯째. 7 의 형상을 가진 제3의 보물이며,생명을 지키리로다.\",\"273\":\"첫번째. 슬픈숲을 찾아 행복의 목걸이를 걸어주리로다.\\n두번째. 오른손의 네번째 루비를 낀 손가락을 찾아 비밀을 풀지로다.\\n세번째. 목탁위의 나비는 코스모스를 쫒아가니 三 의 역풍을 맞으리로다.\\n네번째. 황금국자를 얻은 요리사가 보이는구나.\\n다섯째. 개구리의 울음소리는 十 으로 나뉘며, 그선으로부터 두번돌것이니로다.\\n여섯째. 황금을 묻은 땅을 찾아야 함이니 그 앞은 선녀의 옷이로다.\",\"274\":\"첫번째. 돌멩이는 쌓여,일곱의 무지개 위에 올려져 그 선택을 받으리로다.\\n두번째. \\\"카\\\" 의 의미로다.\\n세번째. 전쟁의 \\\"신\\\"은 존재하며,그 \\\"신\\\"은 왼손이 가장 무거워질때 행운을 가져오리로다.\\n네번째. 보석과 함께 하는 호박의 꽃이로다.\\n다섯째. 부둣가에 배는 세번묶이며, 바람이 불때 풀려나리로다.\\n여섯째. 칠월의 향기는,호랑이의 발톱에 맺히는구나.\",\"275\":\"첫번째. 두개의 컵이 만나 얼음불을 꺼뜨리는구나.\\n두번째. 버섯을 먹은 사슴의뿔은 황제의 이름을 새기리로다.\\n세번째.지하철의 동냥은 맨발을 가진자에게 돌아갈것이니로다.\\n네번째. 타이어가 사라진 車는 전화박스앞에 멈추는구나.\\n다섯째. 황금의 벌집은 장독대에 존재하며 大福 이구나.\\n여섯째. 폭풍은 사라져,두개의 그림자를 남기우며 두개의 火石이 곧 열쇠로다.\",\"276\":\"첫번째. 세개의 별에 존재하는 \\\"도왕(刀王)의 칼집\\\"은 그 그림자를 찾아야 풀수 있으리로다.\\n두번째. 오아시스가 사라진 사막은 두개를 지나가며,그 이후에 전갈의 독에 갇혀 그 표시가 남으리로다.\\n세번째. 호수에 빠진 음악은 무지개를 더하리로다.\\n네번째. 처음의 소리를 따라갈때,그 길속에 존재하며 그중 가장 큰 소리를 대표하는 숫자로다.\\n다섯째. 목숨과 아름다움의 문자는 이제 곧 뒤집혀 교환이 있을것이니로다.\\n여섯째. 새소리는 시간속에서 북쪽 방향을 잡아주며,이때 반을 지나간 형제로다.\",\"277\":\"첫번째. 왕은 반지의 \\\"구멍\\\"만을 통하여 \\\"행운의 인어\\\"를 볼수 있슴이로다.\\n두번째. M의 비밀은 넷을 세워 찾았을때, 양산을 가진 여인을 볼수 있으리로다.\\n세번째. 모두 하나씩 가지며,거울속의 자아는 그것을 이루는 숫자로다.\\n네번째. 手 속의 사각은 역으로 7을 움직이니,황금의 방향을 가르쳐 주리로다.\\n다섯째. 분수대는 \\\"곰\\\"의 놀이터이며,물이 떨어질때 행복이 찾아올것이니로다.\\n여섯째. 딱지를 가진 아이는 넷이며 질서에서 의미를 찾아야 함이로다.\",\"278\":\"첫번째. \\\"원\\\"에 거북형제가 나타나며 그것을 뺀 버팀목이니로다.\\n두번째. 박수를 쳐서 알릴때 사냥꾼의 첫 사냥감이 나타나는구나.\\n세번째. 선의 형상속에,양쪽은 黑 이 존재하며,사람의 엄지가 곧 시작을 알림이로다.\\n네번째. 올리면 하나며, 내릴때 둘이며,人間 속에서 찾을지로다.\\n다섯째. 뱀은 세개의 항아리에서 찾아야하며,단 하나만이 술항아리요 뱀의 안식처로다.\\n여섯째. 바람속에 고구마를 캐는 노인은 그 호미가 부러져야만 황금을 찾으리로다.\",\"279\":\"첫번째. 양 돌(石)이 태양을 가려 의미가 생기니로다.\\n두번째. 날개달린 붉은 돼지는 서쪽으로 향하는구나.\\n세번째. 먹과 벼루는 한곳에서 필요하며,그 이후에 붓은 七 로써 움직여 행운을 선택함이로다.\\n네번째. 빛은 사막에 내리며 그곳의 중용을 찾아감이니, 三 의 田 을 취하리로다.\\n다섯째. 누에는 태양을 먹고살며,그 껍질을 벗었을때 행운을 간직하리로다.\\n여섯째. 목성의 기운은 곧 대지의 기운이로다.\",\"280\":\"첫번째. 無의 종이로 시작하며 접힌 종이배를 띄운 한강이로다.\\n두번째. 무너진 赤 속에 의미가 존재하니, 솟구쳐 다시 태어나리로다.\\n세번째. 영원히 도는 물레는 둘이며, 태양의 비춤이로다.\\n네번째. 구름속에 흰나비는 남으로 가며 행복의 표식에서 멈추리로다.\\n다섯째. 노루는 흰눈아래 발자국을 남기어 신선의 길 앞으로 인도하리로다.\\n여섯째. 천둥은 아파트를 지나며,차가운 호수위에 남겨질것이니로다.\",\"281\":\"첫번째. 소(牛)의 피는 더운 물속에서 그 해답을 찾을것이니로다.\\n두번째. \\\"영\\\"의 의미속에 지친 \\\"행복\\\"은 정상에 서는구나.\\n세번째. 배부른 하마는 입을 벌리고 딱정벌레 한쌍이 그위로 날아드는구나.\\n네번째. 반드시 돈을 주고 산 감자만이 행운속에 가치를 지니리로다.\\n다섯째. 보라고양이 파란고양이는 검은종 아래에 존재하는구나.\\n여섯째. 서쪽 엘리베이터가 열리는 곳에는 빙하가 보이리로다.\",\"282\":\"첫번째. 기울어진 달에서 \\\"무지개 폭포\\\" 의 쏟아짐이로다.\\n두번째. 協 은 큰 총의 표적이 될때 화합하며 버팀목의 비밀이 풀리는구나.\\n세번째. 큰 파도는 번개를 맞으며 나무로 향하니 人間 이로다.\\n네번째. 사막의 뱀은 물길에 존재하며,두개의 선인장과 붉은돌이 그 안내자가 되리로다.\\n다섯째. \\\"용의 폭포수\\\"는 사라져 그 자리를 찾으려면 7의 단추를 풀어야 함이로다.\\n여섯째. 두 탑 뒤에 죽음이 세개가 존재하며,우주의 앞에서 그 의미가 생기는구나.\",\"283\":\"첫번째. 거위산의 암초로구나.\\n두번째. 가장 큰새는 큰부리로 존재하며,두계단에서의 멈춤이로구나.\\n세번째. 우편은 붙임의 끝점속에서 시작되며 5시의 열쇠로부터 행운을 얻어 끝을 알림이로다.\\n네번째. 자전거를 탄 광대는 연필을 세우리로다.\\n다섯째. 구름위에 놓인 붉은집은 버섯의 형제가 받쳐주니 영광이로구나.\\n여섯째. 빛은 중심에 서니 북쪽 오리가 보일것이며,그 짝은 달의 영광을 지켜내리로다.\",\"284\":\"첫번째. 나방이 초 위에 앉으니 이는 곧 \\\"불\\\"이 되리로다.\\n두번째. 용기의 샘에 두개의 도끼가 존재하며,가득찬 물에 들어가야 얻을수 있으리로다.\\n세번째. 수도꼭지에 황금뱀이 나오니 행운을 얻어가리로다.\\n네번째. 4개의 짝이 쌓여 재물이 되며, 두개의 나무가 타서 은구슬을 얻으리로다.\\n다섯째. 사마귀는 날개가 펴지며, 모자를 써 그 챙이 서리로다.\\n여섯째. 굼벵이는 초가집에 달려있으니 그 끈이 생명이구나.\",\"285\":\"첫번째. 황금포도를 따는 여인네는 나그네의 모자를 빌려 도움을 받으리로다.\\n두번째. 편지봉투속에는 열쇠가 담기며, 주소속에 도형은 의미가 있음이로다.\\n세번째. \\\"마이크\\\"의 의미는 帝 의 소유로다.\\n네번째. 둘의 의미를 담고 두개의 선을 타며, \\\"왕\\\"으로 시작되는 보물이로다.\\n다섯째. 거울에 비친 비녀는 \\\"장미의 향을가진 비녀\\\"이며, 또 다른 거울이 존재하여야만 볼수 있슴이구나.\\n여섯째. 고향집을 지키는 三馬 의 비밀은 하나로다.\",\"286\":\"첫번째. 우유의 증표는 의미가 있으며,붉은 지갑속에서 열리는구나.\\n두번째. 다섯개의 톱은 소원의박을 향하여,아래로 자르며,그 씨앗을 얻으리로다.\\n세번째. 행복은 두개의 전봇대에 존재하며,불이 켜질때 그아래에 보이는구나.\\n네번째. 서쪽에 둥근달이 떠오를때 나타나는 비행체를 피하면 행운을 잡으리로다.\\n다섯째. 우주의 다섯번째 행성은 月의 힘과 통해야만 이루어지는구나.\\n여섯째. \\\"거위의 만찬\\\"은 일곱의 황금속에 보일것이니로다.\",\"287\":\"첫번째. 저금통속에 첫번째의 진주가 빠지니 행운이로다.\\n두번째. 세개의 동전이 물위에 세워질것이니 그 방법이 열쇠로다.\\n세번째. \\\"龍의 왕관\\\"은 L 을 비추는 은빛호수가 삼키는구나.\\n네번째. 서쪽으로 향하여 한걸음 다가설때 두개를 잃어버리며,그 위에는 진(珍)의 존재로다.\\n다섯째. \\\"예내우물\\\"의 보금자리는 따뜻함으로 다가가는구나.\\n여섯째. 귀걸이속에 비친 사물이 보이며 그것은 녹은 아이스크림이로다.\",\"288\":\"첫번째. 코끼리를 문 악어는 웃으리로다.\\n두번째. 행복의창은 붉은땅위에 흰색돌을 사이에 두고 존재하니, 창과 돌이 아닌 붉은땅이로다.\\n세번째  나무에 걸린 풍선은 \\\"회색곰\\\"의 차지로다.\\n네번째. 병사는 성으로 올라가는 길을 찾을것이며,두개의 깃발은 마지막길에 존재하리로다.\\n다섯째. 흰색옷을 입은 사람은 \\\"색의끈\\\"으로 묶이고,그 고함이 주문의 열쇠로다.\\n여섯째. 행운의개가 존재하는 숲으로 떨어져 보화를 얻음이로다.\",\"289\":\"첫번째. 口 로 들어가는 방향을 찾아 目 을 녹이리로다.\\n두번째. 부산은 \\\"큰왕\\\" 이 살며, 그 \\\"왕\\\"의 의미는 새로운 의미로다.\\n세번째. \\\"별\\\"로 떨어지는 꽃밭의 결혼식이 존재하니, 사랑을 담은 \\\"별\\\"이로구나.\\n네번째. 갈림길의 의미를 찾아 떠남이니, 이는 곧 세번째의 갈림길에 멈추리로다.\\n다섯째. 거북선을 만든 망치는 승리를 위한 망치로다.\\n여섯째. 안정의 문자로 시작되며, 시작의 문자가 역으로 존재하는구나.\",\"290\":\"첫번째. 十의 토굴에서 뛰어나온 토끼로다.\\n두번째. 지네는 초가집위에서 떨어지며, 새는 하나의 흔적을 남기리로다.\\n세번째. 山 을 넘어 벽이 존재하며, 그 벽과 만남속에 하늘은 맞닿으리로다.\\n네번째. 두마리의 호랑이는 서로 다투며, 푸른 발자국에 의하여 존재를 나타냄이로다.\\n다섯째. 고양이 울음소리는 단잠을 깨우나, 새장에 갇힌 다람쥐는 행복의 다람쥐로다.\\n여섯째. 인간세속의 \\\"홍(紅)삼각\\\"과 \\\"청(靑)삼각\\\"이로다.\",\"291\":\"첫번째. 나팔수는 두번째 손가락으로 덮을때 \\\"작은 돌\\\" 을 얻으리로다.\\n두번째. 해적의 만찬 은 레몬의 향내로 구분하는구나.\\n세번째. 꽃사슴의 날개를 찾으니, 그 뿔이 잘림을 보호하는구나.\\n네번째. 당나귀를 끌고가는 어린아이의 손은 부자로구나.\\n다섯째. 하늘의 침입자로부터 숲지대를 보호하는 \\\"귀족의 용사\\\" 로다.\\n여섯째. \\\"숫탉알\\\" 에 사라짐은 행운으로 그 가치를 찾으리로다.\",\"292\":\"첫번째. 두쌍의 붉은 두루미는 호랑이 울음소리에 놀라 날아오르리로다.\\n두번째. 8월의 영광이 빛난 아침에 나타난 \\\"구름의 龍\\\" 이로다.\\n세번째. 시간을 지난 풀벌레소리는 \\\"하모니카의 탄생\\\" 과 연결이 되는구나.\\n네번째. 무지개 영혼의 속삭임은 하나의 꽃으로 탄생되니 \\\"천상화\\\" 로다.\\n다섯째. 전기에 갇힌 아이는 울음을 멈추리로다.\\n여섯째. 비행체가 지나간 자리에 자라난 새싹의 표시로다.\",\"293\":\"첫번째. \\\"새우의 섬\\\" 에 雨 로다.\\n두번째. 발레리나의 눈물은 행운을 가진 열쇠로다.\\n세번째. 파도를 넘어 두개의 섬이 존재하나 하나는 無 의 의미며, 또하나는 石 의 의미로다.\\n네번째. 세워진 나룻배에 노인은 대나무를 가졌구나.\\n다섯째. 반짝이는 돌은 바닥이요, 숯은 하늘이니 이는 곧 떨어질때 비추리로다.\\n여섯째. 뒤로 가는 시계는 종소리가 네번 울리며 \\\"짝\\\" 을 건너 끝으로 멈추리로다.\",\"294\":\"첫번째. 東으로 쏟아지는 \\\"석유\\\" 는 보물의 집에 머무는구나.\\n두번째. 마음을 받치고 있는 門 이로다.\\n세번째. 大國의 지평선은 짦아짐과 길어짐에 의미가 있구나.\\n네번째. 반달의존재속에 전구가 세개의 빛을 모아서 띄울지로다.\\n다섯째. 쥐를쫒는 고양이는 천장에서 더 큰 재난을 일으키는구나.\\n여섯째. 가람에 들리는 소리는 첫만남속에 의미가 숨어있으니 즐거움 이로다.\",\"295\":\"첫번째. 솟구침은 한바퀴의 물레를 움직여 내는구나.\\n두번째. 구렁이는 흰색 문앞에 멈출것이니, 셋을 띈 검은색 나무를 휘감을지로다.\\n세번째. 걸어가는 人間은 뒤를 돌아보지 않으며,그 뒤의 人間은 앞을 넘어서지 않을것이니로다.\\n네번째. 순수함을 잃어버린 \\\"파괴의 낙엽\\\"이로다.\\n다섯째. 도끼가 찍힘은 깨어진 그릇속에 존재하며 이는곧 \\\"천상의 福\\\" 이로다.\\n여섯째. 水와 상승의 중용이로다.\",\"296\":\"첫번째. 생명의 검을 잃어버리면,그 뒤에 가려진 황금활의 존재를 볼수 있구나.\\n두번째. 한사람이 죽으면 나오는 숫자요,그중 밝은것은 의미가 없도다.\\n세번째. 오리의 갑옷은 수중에서 만나리로다.\\n네번째. 네 가족은 공통의 선으로 나뉘며, 더 작은 한가족은 달라짐이 있을것이니,그것이 열쇠로구나.\\n다섯째. 두 소녀가 합창을 하여 승리요,여름의 모기가 사라져 패배로구나.\\n여섯째. 영원히 만날수가 없어서 의미요, 평생 단 한번만 만날수 있어서도 의미로다.\",\"297\":\"첫번째. 백장미의 행운에 찔린 여인이로다.\\n두번째. 황금어망은 가장 가난한 나그네의 차지로다.\\n세번째. 번개를 삼킨 호랑이는 용기를 가졌슴이로다.\\n네번째. 처음의 친구와,처음이 가장 작게 보일 친구는 천상의 조화로구나.\\n다섯째. 두 짝은 세개의 力 과 두개의 空 을 가졌구나.\\n여섯째. 붙어 여인이 사라지면,두번의 꺾임만이 남으리로다.\",\"298\":\"첫번째. 사랑을 가진 네번째 남자는 첫번째 흑인의 앞에 서리로다.\\n두번째. 두번을 훔쳐야만 하나의 \\\"쓰러진 보물\\\"을 얻으리니 행운이로다.\\n세번째. 하나가 걸림으로 門 이 되니, 첫번째 꺾임은 네번째 꺾임으로 연결될때 방향이 나타나는구나.\\n네번째. 원숭이에게 잡힌 고래는 황금만찬 이로다.\\n다섯째. 바닷속의 찻잔을 찾으니 모두 백색이며 상어는 그중 은구슬이 담긴 찻잔을 알려주는구나.\\n여섯째. 네명의 여인은 무지개 우산을 가졌으며, 그중 한명은 우박을 피하지 못함이니 안타깝구나.\",\"299\":\"첫번째. 眞 과 中 의 중용이로다.\\n두번째. 거미는 소금의 방향으로 떨어지는구나.\\n세번째. 배를 삼킨 섬은 세개의 방향을 가진 산이 뒤집힐때 존재하는도다.\\n네번째. 돼지의 안경은 호롱속에 갇힐지로다.\\n다섯째. 일곱번 뛴 개구리는 호수를 세번 건너며 두번의 태양을 피하리로다.\\n여섯째. 천하태평은 한농부의 피리로부터 나타나리로다.\",\"300\":\"첫번째. 황금비늘에 구두로다.\\n두번째. 아흔아홉번의 막힘속에 하나의 존재로서만 無가 될지니,이제는 뚫릴것이니로다.\\n세번째. 구경꾼들은 하늘을 쳐다보나, 단 한명의 장님은 황금바닥을 살피는구나.\\n네번째. 화살의 방향에 두 벽이 존재하며 가장 먼벽으로 넘어 그림자를 만날것이며, 그 후로 네명의 은인을 만나 도움을 받는구나.\\n다섯째. 바람은 독을 가졌으며, 그앞에 선 참새는 행운의 두 날개를 잃는구나.\\n여섯째. 복어는 고슴도치를 찾을지로다.\",\"301\":\"첫번째. \\\"서쪽의 뿌리\\\"가 계속 자라야만 두개의 잎을 가진 새싹이 되리로다.\\n두번째. 쥐는손과 딱딱한 바닥손의 친구들은 땅으로부터 서리로다.\\n세번째. 검은색은 묶이며, 흰색은 박힘이니 하나로 모이는구나.\\n네번째. 한발은 두공위에 있고 두손은 짝이 맞으며,다른 한발은 이것으로부터 떨어지리로다.\\n다섯째. 네모가 세개요,오른쪽으로 쓰러진 다섯과 세워진 다섯이 두 네모와 짝이 맞음이요,나머지 하나의 의미는 사라짐이니 찾을지로다.\\n여섯째. 병풍을 가진 사내는 금빛이로다.\",\"302\":\"첫번째. 여섯개의 두소리와 네개의 한소리가 존재하며, 그중 첫번째 소리의 비밀을 풀어 그 안에서 찾음이로다.\\n두번째. 밟고 있는 이곳은 두개의 이름을 찾아야만 하나의 열쇠가 되며, 또 다른 하나의 승리를 더할것이니로다.\\n세번째. 東 으로 향하는 \\\"뗏목\\\"은 그 연결로써 물에 뜨는구나.\\n네번째. 멕시코 의 흥겨움은 햇빛을 가리는구나.\\n다섯째. \\\"쇠메\\\"의 짝은 \\\"낫의 날\\\"을 세워 두드리니 그제서야 열리는구나.\\n여섯째. 술병에 달을 담아 마시는 노인은 행복하도다.\",\"303\":\"첫번째. 가장 높은 독수리는 태양이 불타는 도시위에서 그 의미를 찾으리로다.\\n두번째. 들판에 곡식은 존재하지 않으며, 낫을 든 농부의 땀만이 그 아래에 남으리로다.\\n세번째. \\\"섬\\\"의 지진은 \\\"감꽃\\\" 을 떨어뜨리니 행운이로구나.\\n네번째. 손가락 사이의 도구는 손끝이 되며, 전기의 \\\"力\\\"으로 움직이는구나.\\n다섯째. \\\"적\\\" 을 날려버리는 \\\"폭풍의 머리카락\\\" 을 찾을지로다.\\n여섯째. 과일나무 앞에 선 향나무의 존재는 王 이 되리로다.\",\"304\":\"첫번째. 바람이 부는 교실이 존재하며 그 안에 \\\"낙서\\\"로 증명되는구나.\\n두번째. 우물에 빠진 황소는 금빛으로 태어나리로다.\\n세번째. 구렁이는 바람을 역행하며, 벽을 만나니 세번의 고난을 넘어가리로다.\\n네번째. 나무꾼의 도구는 세워지며, 그 아래에 받치는 비밀의 상자가 존재함이니, 첫번째 존재하는 모서리로다.\\n다섯째. 사각의 번호를 가슴에 달고 두개의 선은 서로 만나서는 안될 선이니, 만남은 곧 실패로다.\\n여섯째. 두마리의 거북은 물구나무를 선 토끼를 막힘없이 볼수 있구나.\",\"305\":\"첫번째. 영광의 투구를 가진자는 目 을 구하나,두명의 병사를 잃어버릴것이니로다.\\n두번째. 白馬는 열매의 계곡을 지나며,그 중용이로다.\\n세번째. 쥐를 만난 원숭이는 세번의 재주를 넘는구나.\\n네번째. 봉황위에 세발 까마귀는 날개를 가졌구나.\\n다섯째. \\\"짝\\\"은 黑 속에 존재하며,이는 곧 나뭇잎으로 가리는구나.\\n여섯째. 돌과 인간은 나란히 존재하며, 돌에 묻은 세속을 훔치리로다.\",\"306\":\"첫번째. 기와위 호박꽃은 인간의 것이구나.\\n두번째. 개에게 쫓긴 닭은 雪宇 뒤에 숨는구나.\\n세번째. 비행기는 추락하나,붉은우산을 가진자 만이 살것이니로다.\\n네번째. 장미꽃을 가진 분수는 \\\"장미수\\\"를 뿜어내니 행운의 水 로다.\\n다섯째. 세마리 작은뱀은 바닥위에 존재하며, 그중 지혜를 선택함이로다.\\n여섯째. 지구위에 풍선은 모두 50 이며 뜨거움에 터지니 \\\"황금\\\"을 던져 주리로다.\",\"307\":\"첫번째. T 는 세번의 山 을 넘어 쉬어가리니, 그 시각은 無로다.\\n두번째. 군밤은 연탄위에 구워지니 세번 익는 소리로다.\\n세번째. 목성은 모래알속에 잠기니 금빛魚의 탄생이구나.\\n네번째. 파도아래 숨은 배는 뒤집혀 있으며,뜨거움은 두개로다.\\n다섯째. 반대의 표시는 두개며, 형제는 하나와 無 의 표식이 그 위치를 선택하리로다.\\n여섯째. 오른쪽의 기울임은 하늘을 오르게 하며,행복을 가져다 주리로다.\",\"308\":\"첫번째. 검은 토요일에 축제의 나비를 따라갈지로다.\\n두번째. 혼자걷는 노인은 우물가에서 세번을 쉬며, 황금잉어를 낚으리로다.\\n세번째. 커피잔이 떨어질때만이, 노란사슴의 존재를 알수 있구나.\\n네번째. 七 의 검투사는 등뒤에 적의칼을 돌아보지 않을지로다.\\n다섯째. 黃龍 을 담은 \\\"술\\\"은 탁자의 이름이로다.\\n여섯째. 하나로 태어나나,형제로 두번 나뉘며 하루세번 불이 되어, 하나로 사라지는구나.\",\"309\":\"첫번째. 장난감기차를 가진 소녀는 主人이 되리로다.\\n두번째. 축구경기는 시작되며, 관중은 해를 가린위치에 앉는구나.\\n세번째. 열살의 나이가 움직여가니, 갈색의 치마에 흰티의 소녀가 보이리로다. 5\\n네번째. 거울속에 겨울은 눈이 내리며, 자아는 눈을 감으리로다.\\n다섯째. 포도나무는 열매를 맺고, 농부는 땀을 만들어내니 가장 신성한 땀을 찾을지로다.\\n여섯째. 육지거북을 탄 아이는 흑구슬을 따라 세발을 건너가리로다.\",\"310\":\"첫번째. 무거운 봉투를 뜯어서 그안이 보일때, 西로 넷 이동하리로다.\\n두번째. 파티는 열리고 둥근테이블에 음식은 없으니 어찌할 것이드냐.\\n세번째. 황금술을 파는 주막은 술취한 나그네의 엽전이 모이는구나.\\n네번째. 부모가 던지는 낚시의 미끼는 \\\"土\\\" 이로구나.\\n다섯째. 아이의 책은 사전이며 신발끈이 풀릴때 비밀이 풀릴지로다.\\n여섯째. 번개의 시각에 끈이 없는 \\\"연\\\"이 그 주인을 찾으리로다.\",\"311\":\"첫번째. 아이의 친구는 파도를 가지며 성을 무너뜨려야 보일것이니로다.\\n두번째. 마을의 무궁화가 눈에 보이면 그 위에 비둘기가 보이니 셋의 \\\"통함\\\" 이 비밀의 열쇠로다.\\n세번째. 태양을 가린 초록은 두개의 나팔로 바람을 가르며 달려가는구나.\\n네번째. 펭귄의 집은 五 를 넘지 못함이니 그 이름을 가지리로다.\\n다섯째. 無 와 그 아래엔 자신이 둘이 되며, 또 다른 둘은 죽음을 가진 새로운 신호가 되리로다.\\n여섯째. 깃발아래 생명이며, 과일을 취하리로다.\",\"312\":\"첫번째. 참새의 굴뚝은 세번 갈라지니 아침이로구나.\\n두번째. 늑대는 七 의 흰색옷을 가져갈것이니 東 이로다.\\n세번째. 통나무집은 겨울이며,얼음 탁자에 세개의 의자가 놓여있구나.\\n네번째. 거미줄에 붙어 있는 거미는 一 을 새기며,태양을 볼수 있으니 행복이로다.\\n다섯째. 절구통이 門 이며,지하실이 마지막 안식처구나.\\n여섯째. 파도는 열과 증기로 잠잠해지는구나.\",\"313\":\"첫번째. 새가 앉지를 못하는 굴뚝은 이동의 굴뚝이로다.\\n두번째. 겨울나무는 황금옷을 벗으나, 떨어진 자신이 모으며 그 주인은 x 표시로다.\\n세번째. 시간의 정차역은 욕심을 부린 택시의 정차역이로다.\\n네번째. 인간의 벽은 암흑을 일으키며, 빛을 찾으려 필요한 도구로다.\\n다섯째. 노인의 바이올린은 피아노를 위하여 존재하는 열쇠가 되리로다.\\n여섯째. 행운을 가진 동생은 흰옷을 입은 사촌과의 만남으로 행복을 얻는구나.\",\"314\":\"첫번째. 나뭇잎 속에 구멍이 존재하며, 그 구멍을 통하여 바라볼 때 행운은 보이리로다.\\n두번째. 검은 닭은 항아리 뒤에 숨어 모습을 감추는구나.\\n세번째. 7번째의 전쟁은 흰구름이 찍히는날 시작되리로다.\\n네번째. 쓰러질때 가장 가까운 벗은 절벽에서 나를 구하는구나.\\n다섯째. 차가운 호수의 물은 세번 들이키며, 황색의 물이 그곳에 녹아드는구나.\\n여섯째. 달려가며 앞선 존재는 은색 승리의 표시를 가지리로다.\",\"315\":\"첫번째. 땅콩을 심는 아낙내는 오리가 사라질 때 행복의 땀을 흘리는구나.\\n두번째. 개는 하늘로 오르며, 흰 구렁이가 쫒아가리로다.\\n세번째. 文 으로 시작되는 첫계단을 밟아 자연으로 내려오니 차가운계단 이로다.\\n네번째. 바람을 이용한 범선은 행운으로 가장 빨리 도착하리로다.\\n다섯째. 뜨개질이 반을 이룰때, 식탁에 음식이 오를것이니로다.\\n여섯째. 광주로 가는 열차는 사거리에서 멈추리로다.\",\"316\":\"첫번째. 범의 눈물은 호수의 사라짐이 있을때,형상만이 남으리로다.\\n두번째. 한 교실로 들어간 초록옷의 두 학생은 안경을 잃는구나.\\n세번째. 원안에 차가움과 움직임이 존재하며,박수소리가 들리는구나.\\n네번째. 얼룩말은 침대위에 서니, 창문을 볼수없구나.\\n다섯째. 전쟁속에 모자는 행운의 꽃을 세번 보호하리로다.\\n여섯째. 줄이 끊어진 연은 용을 만나 꼬리를 잃을때 추락하리로다.\",\"317\":\"첫번째. 잘려진 늙은호박은 山 으로 떨어질때 그 행운을 더하리로다.\\n두번째. 가위로 자른 드레스는 두개의 방울이 빛을 내리로다.\\n세번째. 용의 구름을 지난 비행은 계속되며,붉은색에 멈추리로다.\\n네번째. 자작나무의 비밀은 \\\"대장경\\\" 이 그 열쇠로구나.\\n다섯째. 두개의 함정은 木 으로 피하며, 水 는 빠짐이로다.\\n여섯째. 은색종소리는 12시에 시작되며, 어린아이는 끝나는 시각을 찾는구나.\",\"318\":\"첫번째. 붉은탁자위 잔의 주인은 여자가 둘이요,남자가 한명이니 이 잔이 두번 부딛힘으로서 단한명만이 황금잔이 될지로다.\\n두번째. 망원경으로 본 山 은 붉은사과의 추락이 존재하는 산이로다.\\n세번째. 인생에 가장 많이 사용된 시간은 축복의 시간이로구나.\\n네번째. 폭설은 범을 얼게하니,이동을 멈추게 하리로다.\\n다섯째. 호수위에 떨어뜨린 가방은 젖지 않는 가방이로다.\\n여섯째. 말하는 고양이는 반달위에 서리로다.\",\"319\":\"첫번째. 큰빌딩의 청소도구는 얼음빛으로 향하는구나.\\n두번째. 밤에 내려와 인간의 무거움을 받치며, 낮에는 오르니 행복이구나.\\n세번째. 과채의 비밀은 황금색을 지난후에 생겨나며, 星 과 연결되리로다.\\n네번째. 물위의 피아노는 두번째 건반이 움직이며,동그라미의 의미가 존재하는구나.\\n다섯째. 강이 있는곳에 하나가 있고 돼지가 존재할때 그 숫자가 나타나리로다.\\n여섯째. 다이아몬드가 존재하는 \\\"이마\\\"를 찾아 그 다음이 열쇠로다.\",\"320\":\"첫번째. 첫만남은 시작되며,고무로 만든 줄의 당김은 두개의 무지개를 낚는구나.\\n두번째. 삼각위의 원은 붉은색이요,사각위의 원은 푸른색이니 그 곳의 차이는 분명하구나.\\n세번째. 해녀를 만난 신부는 한개의 조개를 받아 행복하리로다.\\n네번째. 눈썰매는 세개의 높은 산봉우리를 지나야만 멈추리로다.\\n다섯째. 학꽁치는 두개의 바다위에만 존재하며, 가득찰것이니로다.\\n여섯째. 가방안에 편지는 버리고, 잉크가 묻은 편지를 구하리로다.\",\"321\":\"첫번째. 붉은 시계탑위에 앉은 동물은 날개 여섯을 가졌구나.\\n두번째. 석탑속에 두개의 종이 있으며 그림자는 하나로 의미를 전하는구나.\\n세번째. 기차는 폭탄을 가졌으니,金을 버려야만 나머지가 살것이로다.\\n네번째. 방패를 가진 범선은 바람을 막을수는 없으며,선이 다섯번 기울어질때 막을수 있을것이로다.\\n다섯째. 초록의 나이를 가진 노인은 하늘에서 나타나며, 날개를 잃어 추락하는구나.\\n여섯째. 水 에서 시작된 행운과 압정은 불화의 시작이로다.\",\"322\":\"첫번째. 무대위 검은안경에 조명이 비출것이며,조명은 井의 이름을 가졌구나.\\n두번째. 다람쥐의 먹이는 폭포위에서 구하리니, 나무를 피하리로다.\\n세번째. 시험지는 낡은 오두막에 있으나, 악어를 피하여 도착함이 최선이로다.\\n네번째. 용사가 가진 카드는 사랑과 별의 공통이로다.\\n다섯째. 주유소 앞의 검은 택시는 생명의물이 필요하구나.\\n여섯째. 돼지는 홍수에 떠내려가니, 검은두루미가 도우리로다.\",\"323\":\"첫번째. 모래는 휴지통에 쌓여 포장되리로다.\\n두번째. 선녀의 부채를 찾아 화로 뒤에 감추니 복이로구나.\\n세번째. 석유를 담은 드럼통은 열개이며, 그 아래 황금꽃이 피는구나.\\n네번째. 하늘에 장미는 선인장을 향해 두번 다가서리로다.\\n다섯째. 아침의 나비는 태양을 피하지 못하니 그림자를 찾을지로다.\\n여섯째. 폭포아래 황소는 절벽아래 돼지를 세번피해 건너가리로다.\",\"324\":\"첫번째. 붉은 꽃은 \\\"水\\\"와 통하며, 불화산이 되리로다.\\n두번째. 화살은 꺾여 바람을 타지 못함이니,한곳에 걸려 쉼이로다.\\n세번째. 돌이 많아 행운의 이름이 되며 세개의 열쇠를 가지리로다.\\n네번째. 두뿔은 무늬를 나타내며, 걷는 사람은 하나의 안경을 가졌구나.\\n다섯째. 어린이가 가진 막대는 행복의 술잔을 가려내리로다.\\n여섯째. 사슴은 용의 날개를 얻고 뿔을 내어주리로다.\",\"325\":\"첫번째. 전갈은 거북의 등에서 떨어져 土 와 만나는구나.\\n두번째. 容 은 셋이 하나며, 북쪽의 지평선이 되리로다.\\n세번째. 금가락지는 별의 움직임속에 존재하리니 오리를 따라감이로다.\\n네번째. 靑 속에 빠진 다리는 가장 큰 다리로다.\\n다섯째. 손안에 은구슬은 나무를 타야만 맞추리니 동심이로다.\\n여섯째. 선비는 큰물에 빠져야만 깨달음을 얻을지로다.\",\"326\":\"첫번째. 첫 비가 내릴때 보이는 압정은 행운의 열쇠로다.\\n두번째. 황소가 가진 도구는 큰 \\\"홍수\\\"를 불러오는구나.\\n세번째. 일곱의 별은 푸른 땅에서 올라오며, 불로 구울때 빛이나리로다.\\n네번째. 감자의 씨앗은 손위에 올려질때 황금으로 변하리로다.\\n다섯째. 믿음의 나무 열개는 도끼의 표시가 생기며, 그 마지막 나무에 숨은 토끼를 찾을지로다.\\n여섯째. 돼지는 낙엽위에 떨어지며, 전사의 창은 돼지를 노리는구나.\",\"327\":\"첫번째. 낙지는 금항아리속에서 존재하며,별이 뜰때 바다위로 떠오를지로다.\\n두번째. 十을 가진 노란나무는 가지가 꺾여, 검은소 등에 꽂히는구나.\\n세번째. 사막속에 두건을 두른 두명의 남자가 걷고 있으며,그 앞은 오아시스가 없는 길이로다.\\n네번째. 동굴에서 등불을 비출때 보이는것은 식탁위의 흰손수건이구나.\\n다섯째. 아침을 먹고 점심에는 일하니, 왕을 쫒는 노예는 허상이로구나.\\n여섯째. 낫을 가진 여인은 아이를 낳을것이니 그 이름은 \\\" 정복 \\\" 이로다.\",\"328\":\"첫번째. 박쥐는 태양을 따라가며, 雨 속에 갇힐때 행운의 자리가 나타나는구나.\\n두번째. 구렁이는 돌담을 넘지못하며,인간의 돌에 맞아 뒤로 가는구나.\\n세번째. 나무는 큰모성애를 가져야만 \\\"행운의 나무\\\"로 선택될지로다.\\n네번째. 번개가 칠때 그림자가 생기며,그 그림자 앞에 맞서는 남자로다.\\n다섯째. 사슴벌레는 동쪽의 길을 따라 움직이며, 열두번째 길에서 멈추리로다.\\n여섯째. 호수의 물줄기는 계단으로 모이며,가장 뜨거운 물줄기를 찾을지로다.\",\"329\":\"첫번째. 人 안에 目 이 존재하며,거울속에 비칠때 의미가 더하리로다.\\n두번째. 독수리는 靑과 赤으로 만나며,행운을 지킴이로다.\\n세번째. 노인의 선택은 金 이요, 청년의 선택은 風 이니 둘의 공통이로다.\\n네번째. 육지거북의 두번째 걸음은 스핑크스로 향하는 문에 빠지리로다.\\n다섯째. 모래성은 고래가 다녀가고, 진흙성은 새우의 집이 되는구나.\\n여섯째. 빛은 불로써 끝나며, 저녁의 만찬이 되리로다.\",\"330\":\"첫번째. 땅위에 세워진 주걱은 쌀을 못뜨는 주걱이구나.\\n두번째. 거절을 할때만 세번을 양보할지니 행운이구나.\\n세번째. 방향을 타는 미로는 서쪽으로 한번만 꺾이리로다.\\n네번째. 사슴은 범에게 물리며 뿔만이 남는구나.\\n다섯째. 둘은 同 이며 쓰러짐에 넷도 同 이나 그 받침만이 同 이 아니로다.\\n여섯째. 맑은 물이 많음은 水가 되며, 불을 지날때 그 의미가 생기는구나.\",\"331\":\"첫번째. 건물은 웃으며, 그 얼굴은 비밀의 열쇠로다.\\n두번째. 선인장에는 금반지가 걸려 인간으로부터 지켜주리로다.\\n세번째. 규칙은 3가지이며 칠판에 쓸것이며, 일곱을 깨뜨릴것이며, 통나무를 자를것이니로다.\\n네번째. 여왕은 황금색 은행나무에 숨을지니, 그 그림자를 쫒는구나.\\n다섯째. 門 의 의미는 花 에 있으며 네번째 별이 새겨지리로다.\\n여섯째. 새집으로 이사갈때 첫 꽃을 받아야하며, 피아노를 취하리로다.\",\"332\":\"첫번째. 텐트안에 금고는 황금의 이름을 가지리로다.\\n두번째. 수표는 가마솥안에 붙어 존재하며, 뚜껑이 그 행운이로다.\\n세번째. 밤을 주워야만 계단의 문은 열리니,왕의 계단이 보이는 입구로다.\\n네번째. 금팔찌의 병사는 촛불을 지키며 두번의 상승을 이루리로다.\\n다섯째. 황금잉어는 세번 튀어 오르니, 두번째 화살에 잡히는구나.\\n여섯째. 시작의 질서속에 그늘로만 추락하며, 그 마지막 멈춤은 날개를 가졌구나.\",\"333\":\"첫번째. 꺼짐과 켜짐의 약속은 우주속에 존재하며,하늘과 가장 가까울때 나타나리로다.\\n두번째. 항아리속은 황금국자가 놓여 있고, 두번의 차례에서 사용할지로다.\\n세번째. 木으로 만든 카메라는 흰낙타를 찍으니 우측에 서리로다.\\n네번째. 용기의 풍차는 첫번째 날개가 파괴되리로다.\\n다섯째. 호박의 꽃속에 美 의 표시로다.\\n여섯째. 세개의 방패는 정면을 보며,공격하는 적을 찾을지로다.\",\"334\":\"첫번째. 흰두꺼비는 비가 올때 문앞에 서니 福을 가진 두꺼비로다.\\n두번째. 태양의 빛은 까마귀를 비추고 바람은 황금깃털을 취하리로다.\\n세번째. 山은 역이며 그위에 차가움이 돌아갈것이며, 부드러움으로 사라지리로다.\\n네번째. 세마리의 토끼는 사각속에 木 과 水 를 넘어야 살것이니로다.\\n다섯째. 행운을 가진 물레방아는 오각의 늪속에 갇히리로다.\\n여섯째. 도토리는 읽어버린 구두속에서 찾을수 있을것이니로다.\",\"335\":\"첫번째. 치마는 클로버의 뜻을 가지며,두남자의 보배로다.\\n두번째. 사막의 전갈은 햇빛을 피해 두더지를 만나리로다.\\n세번째. 검지는 흑백의 소리길로 가며,나비와 통하리로다.\\n네번째. 여덟개의 왕관에 하나의 구리 왕관을 찾을지로다.\\n다섯째. 나무는 바다에 뜨며,인어의 선물은 생명이구나.\\n여섯째. 우체국을 찾아 남쪽으로 날아가는구나.\",\"336\":\"첫번째. 동굴속에 옥수수는 불에 구워지며 겨울의 옥수수로다.\\n두번째. 붉은진주는 천사의목소리를 세번 새기리로다.\\n세번째. 가격은 비밀이며, 황금사자가 그려진 비단이 열쇠로다.\\n네번째. 삼각길에는 가지말 것이며, 노리는 늑대를 피하리로다.\\n다섯째. 비행체는 목성에 도착하며, 3일간의 폭풍이 일어날것이니로다.\\n여섯째. 용의 깃발은 나무의 뿌리를 만나니 행운이로다.\",\"337\":\"첫번째. 배를 탄 기사는 \\\"황금거북\\\"을 가질것이며 폭풍의 적이로다.\\n두번째. 나무위에 원은 터지지 않고 세번 맺혀 의미를 새기는구나.\\n세번째. 호수위에 나무는 파란사과 두개를 얻을것이니 행운이로다.\\n네번째. 낙타의 시계는 하늘을 보며 동쪽에서 온 손님이 그 주인이로다.\\n다섯째. 호박꽃은 열개의 거울을 가지니 그 중 세번의 비춤이 존재하는구나.\\n여섯째. 쌍잠자리는 거미의 초대장을 받으니 슬픔이로다.\",\"338\":\"첫번째. 금귤로 태산을 만드니, 그 이름은 \\\"福\\\" 이로다.\\n두번째. 은행나무위에 거북이는 날개를 가진 거북이로다.\\n세번째. 키스를 받은 망치는 손으로 감쌀때 때리리로다.\\n네번째. 초록의 개구리를 가방속에 숨기니 행복이로구나.\\n다섯째. 칼과 포크는 x 이며 파장의 의미를 되새기리로다.\\n여섯째. 바구니안에 복숭아는 원숭이의 \\\"약\\\"이로다.\",\"339\":\"첫번째. 口는 口에 찔리니 뚫리지 않으리로다.\\n두번째. 케잌에 초는 혼자 녹으리니, 그 옆의 모자로다.\\n세번째. 거미는 불에 떨어지고,거미줄의 시작이 추락을 알리는구나.\\n네번째. 호랑이는 소금밭에 존재하며, 쓰러질때 황금빛을 비추리로다.\\n다섯째. 독수리는 손거울에 비추며, 세번째 허상이로구나.\\n여섯째. 밥그릇을 밟은 돼지는 두꺼비를 찾으리니 행운이로다.\",\"340\":\"첫번째. 서쪽의 양은 크며, 황금알의 깨짐은 곧 비행체의 보금자리로다.\\n두번째. 바퀴가 달린 의자는 더함의 벽에 부딛히는구나.\\n세번째. 코끼리는 분홍 장미위에 서며,외줄을 타리로다.\\n네번째. 사랑을 잃은 아내는 비를 맞으니,눈물이 사라지는구나.\\n다섯째. 호박위에 버섯은 크고, 태양은 남으로 지는구나.\\n여섯째. 벌꿀은 반지위에 쏟아지니,달콤한 반지로구나.\",\"341\":\"첫번째. 절벽위에 두루미는 한다리를 절며,황금의 옷을 입으리로다.\\n두번째. 달위에 떨어진 사과는 스물셋이며 그 마지막 받침은 행운이로다.\\n세번째. 여인의 팔을 휘감은 하얀뱀은 하늘을 쳐다보는구나.\\n네번째. 스케이트는 날을 잃었으니,서쪽의 무덤에 던져지는구나.\\n다섯째. 세번의 달을 만나고 네번의 붉음을 나타내니 山의 아들이로다.\\n여섯째. 귀를 막은 소녀는 번개를 피해 집으로 향하리로다.\",\"342\":\"첫번째. 밤을 구워 검은숯이 꺼질때 둘이 설것이며, 兄의 죽음이로다.\\n두번째. 태양에 비친 나비는 雲속을 지나 숨을지니 행운이구나.\\n세번째. 여우가 가진 풀밭에 존재하는 세번째 문이로다.\\n네번째. 다이아몬드를 버린 기사는 大王의 이름을 가진 기사로다.\\n다섯째. 회초리는 암초위에 있으며,黑으로 덮히리로다.\\n여섯째. 우박은 옥돌위에 빛나니 마지막 기회로구나.\",\"343\":\"첫번째. 책을 넘겨 구멍이 존재하며, 한손을 넣어야 잡히는구나.\\n두번째. 음은 셋이요 양은 둘로 향하니 天 속에 빠지리로다.\\n세번째. 팔괘의 호수속에 말이 빠지니 행복의 말이로구나.\\n네번째. 구름속에 빠진 달팽이는 낙엽을 입는구나.\\n다섯째. 로마의 휴일은 7일이 주어지며 식탁위에 서리로다.\\n여섯째. 토지의신은 단 하나며 흰돌로 찾을지니 福이로구나.\",\"344\":\"첫번째. 절벽끝에 지어진 집은 비가 올때 가장 처음의 위태로움이로구나\\n두번째. 다섯의 선을 가진 사다리는 초록의 벽을 넘으리로다.\\n세번째. 천사의 날개는 상자에 담겨 東으로 가는구나.\\n네번째. 白衣는 가장 크게 감싸며,옷을 모두 벗어야 죽음이로다.\\n다섯째. 승리와 죽음의 달리기는 도착지로부터 약속을 지킴이로다.\\n여섯째. 불을 내뿜는 모자는 어둠속에 존재하리로다.\",\"345\":\"첫번째. 가장 작은 찻잔위에 떨어진 구리동전이로구나.\\n두번째. 트럭 세대는 주유소앞에 서며,그림자는 행운을 부르는구나.\\n세번째. 공으로 가장 큰 빛을 내는 인간은 승리를 가졌으며,그 벗은 音을 즐기는구나.\\n네번째. 붉은 꽃은 두개의 선을 이어 하나의 벽을 만드니 生 이로다.\\n다섯째. 가장 높은 집은 들어갈수도 없으며, 꺾어야만 서리로다.\\n여섯째. 막음은 세번째 태풍을 불러들여 태산을 움직이리로다.\",\"346\":\"첫번째. T는 구에서 출발하며 찔림이 사라질때 하나가 되리로다.\\n두번째. 젖소로부터 나오는 태양은 두개이며 행운의 기둥이로다.\\n세번째. 사람뒤에 서는 형제며, 그 형제가 사라질때 형상이 나타나리로다.\\n네번째. 비가 온 땅과 인간의 순수한 만남이며 그 표식이로다.\\n다섯째. 번개는 수양버들 뿌리에 도착하니 안식이로구나.\\n여섯째. 손수레위에 바람은 북쪽에서 부는구나.\",\"347\":\"첫번째. 셋은 둘로 이루어지며, 첫사랑의 연주자가 가져간 시간이로다.\\n두번째. 目은 한개의 통로와 세개의 다리를 가진 달이 함께 하리로다.\\n세번째. 기와는 白의 木위에 세워지니 행운이로다.\\n네번째. 술병속에 띄운 낙엽은 五 로 향하리로다.\\n다섯째. 날개잃은 오리는 배의 침몰속에 갇히는구나.\\n여섯째. 두개로 일어선 나침판으로 남쪽을 찾으리로다.\",\"348\":\"첫번째. 편지는 행운을 불러오며 여인이 곧 주인이로다.\\n두번째. 品 을 만지니 하나가 사라지며 행운이로다.\\n세번째. 태양을 쫓는 갈매기는 열개의 호수를 건너 한번을 쉬리로다.\\n네번째. 방패의 숲을 지나 일곱번째 전사중 세번째 위치에 서리로다.\\n다섯째. 등을 맞댄 두남자중 가면을 쓰지 않은 한명만이 샘의 주인이로다.\\n여섯째. 황금밭을 걸으며 火 와 만나니 남쪽의 귀인이 되는구나.\",\"349\":\"첫번째. 안경은 열이요 반으로 나뉠때 태양의 선택은 하나로다.\\n두번째. 돼지는 창에서 떨어지니 나무의 차지로다.\\n세번째. 짧은 선은 긴선에 걸려야만 꺾이니,세번째 길이 열리는구나.\\n네번째. 세 아이의 동전은 방향을 뜻하리니,아이가 가진 나무에서 잠이 들것이니로다.\\n다섯째. 원과 선은 구를 만나 水가 생기리니 행운이로다.\\n여섯째. 배를 탄 어부는 50의 고기를 잡으리니 배부른 고기를 놓아주는구나.\",\"350\":\"첫번째. 북쪽의 귀인은 두개의 石 을 가졌으며 푸른 지팡이로 선택하리로다.\\n두번째. 龍은 황금 井속에 존재하는 날로부터 세번째날에 오르리로다.\\n세번째. 발톱을 잃은 곰은 白이라 하며,나무에 오른 곰은 黑 이로다.\\n네번째. 기회는 두번이요 인간의 그림자는 칼날에 서나 자를수가 없구나.\\n다섯째. 배추는 태양을 가질것이나 거울에 비출때 시들것이니로다.\\n여섯째. 탁자위에 손바닥은 세번을 내려쳐 남쪽으로 향하는구나.\",\"351\":\"첫번째. 검은조개는 땅아래에 존재하며 두벽을 가진 집이 세워지는구나.\\n두번째. 하늘을 가진 세개의 지구는 사각이며 원의 비밀을 찾을지로다.\\n세번째. 수영장위에 돌고래는 水를 새기며 헤엄치는구나.\\n네번째. 일곱의 낙타는 거미줄을 피해 바다로 갈것이니 행운이로다.\\n다섯째. 하나로 흡수할때 둘이 되며 동쪽으로 하늘이 보이는 길이로다.\\n여섯째. 두개의 동물은 하나의 의미를 가지니 땅에서 인간을 보호하리로다.\",\"352\":\"첫번째. 깃발속에 오리는 숨겨지며, 힘찬 꼬리는 생명이로다.\\n두번째. 결혼식은 단 한번의 종소리로 시작되며, 바람이 흔들때 이루어지리로다.\\n세번째. 두개의 \\\"쌍\\\"은 한개의 \\\"쌍\\\"을 앞 질러 가리니 그 의미로 존재하는구나.\\n네번째. 접히니 셋은 하나로 굽히며, 나누니 아무도 없구나.\\n다섯째. 땅에서 시작된 화산은 이제 막 시작이요, 오두막이 위험하구나.\\n여섯째. 호박에서 태어난 보석은 새로운 씨앗을 뿌리리로다.\",\"353\":\"첫번째. 나라(國)는 十을 지어 세개를 내어주니 남는 수로다.\\n두번째. 기적은 여든셋의 숫자와 하늘이 통할때 보이리로다.\\n세번째. 빛이 통하지 못하는 암흑의 열쇠를 내가 취하리로다.\\n네번째. 천상에서의 낚시는 두개의 미끼가 드리워지니 이중 우측이 先 이로다.\\n다섯째. 赤龍은 일곱의 산을 넘어 두개의 필요한 보물만을 취하는구나.\\n여섯째. 인간세속의 \\\"父子의 후회\\\" 로다.\",\"354\":\"첫번째. 거북은 무수천을 만나니 한발자국만을 남기는구나.\\n두번째. 땅과 금속이 만나 함께 할것이니 새로운 福 을 만드리로다.\\n세번째. 푸른눈동자가 합쳐져 서쪽을 바라볼지로다.\\n네번째. 나무아래 븕은벽돌은 장수풍뎅이의 안식처로구나.\\n다섯째. 나무편지는 하얀호수 위에만 존재하리니 행운이로다.\\n여섯째. 항해사는 적이며 적으로 부터 숨겨놓은 두 아이를 찾으리로다.\",\"355\":\"첫번째. 계란은 月 속에 담겨 행운으로 태어나는구나.\\n두번째. 노란색 자동차속에 보이는 검은색 의자의 존재로다.\\n세번째. 한개의 석(夕)에 十이 들어갈때 비로서 선택받을지로다.\\n네번째. 두책을 가진 소년은 선택의 지팡이를 가졌으며,그 앞에 꽃을 피우리로다.\\n다섯째. 일곱의 박쥐는 일곱의 의자에 앉으리니 이중 여왕을 찾을지로다.\\n여섯째. 불의 장난은 장갑을 가진 어린이로부터 시작되리로다.\",\"356\":\"첫번째. 세개의 톱속에 비친 나이테는 나무의 것이로구나.\\n두번째. 영원속에 사는 새는 모래의 성을 지키는 새로다.\\n세번째. 번개가 있는 골목을 지켜야만 잃어버린 두개의 섬을 찾을수가 있구나.\\n네번째. 종이 호랑이는 검은색 인디언의 활에 맞으리로다.\\n다섯째. 지진이 지나간 자리에 검은 콩만이 존재하며 취하리로다.\\n여섯째. 북두칠성이 지나간 자리에 해당화만 피었구나.\",\"357\":\"첫번째. 보트는 Q 로 나타내며 앞으로 나아가야 물길이 보이는구나.\\n두번째. 빗은 두개요 여인은 꽃을 달지 않으리니 흰구름을 가리는구나.\\n세번째. 전봇대의 편지는 작은 손바닥이 먼저 다녀가리니 행운이로다.\\n네번째. 종이를 네번접어 두번은 서쪽이요, 한번은 남쪽이니 또 다른 하나를 남기리로다.\\n다섯째. 폭풍은 불가사리를 만나며 세번의 바다소리가 그 시작을 나타내는구나.\\n여섯째. 태양아래에 자석의 존재요,끌리는 에펠탑은 무너지지 않는구나.\",\"358\":\"첫번째. 石과 石과 石은 물과 만나니 친구로다.\\n두번째. 승리가 새겨진 원은 지하에 묻히고 비를 맞아 기쁨이로다.\\n세번째. 짚신은 용의 머리에 떨어지는구나.\\n네번째. 두개의 바지는 가위를 만나며 영원을 이루리로다.\\n다섯째. 시간을 X 로 이루며 동생이 먼저 서리로다.\\n여섯째. 두레박에 핀 세번째 나팔꽃은 행운의 꽃이로구나.\",\"359\":\"첫번째. 돌고래는 세개의 바위섬앞에 나타나리로다.\\n두번째. L의 냉각탑으로 향하는 자전거의 길이로다.\\n세번째. 바람과 사진이 공통으로 날리는 들판은 행운이구나.\\n네번째. 비행은 겨울낙엽에 감추어진 산에서 끝나리로다.\\n다섯째. 스핑크스 아래 큰 주유소는 행운의 주유소로다.\\n여섯째. 붉은전화기는 거인의손에 잡혀 出 이로다.\",\"360\":\"첫번째. 포장마차의 위치를 찾아 그안에 땅을 지우리로다.\\n두번째. 불은 흙을 시간속에서만 만나리니,세번 돌아 황금이 될지로다.\\n세번째. 유모차는 흰색 車 안에서만 보이리니 그 표시는 善 이로다.\\n네번째. 태풍은 바람을 만나 雨 와 雨 를 건너가리로다.\\n다섯째. 풍차는 v 아래로 지어지며 세번째로 돌아가리로다.\\n여섯째. 동궁을 황제가 찾으리니 세번째 力 에 멈추리로다.\",\"361\":\"첫번째. 검은 소나기는 우산을 뚫을것이니 비로소 바위와 만나는구나.\\n두번째. 붉은 망토의 소녀는 책을 읽으리니 그 앞의 곰은 보이지 않는구나.\\n세번째. 사각은 삼각을 만들어 접히니 남쪽에 빛이 주인이로다.\\n네번째. 아홉 손가락에 가장 큰 손가락이리니 目 의 중심에 서리로다.\\n다섯째. 소방관은 불을 피해 모래로 향하리니 행운이구나.\\n여섯째. 바퀴가 있는 대포는 검에 찔려 승리로다.\",\"362\":\"첫번째. 되돌아가는 항구에는 단 한명만이 존재하며,푸른 깃발 앞에 서리로다.\\n두번째. 피아노 위에 존재하는 벨소리는 행운이며,정시에 피아노를 멈추게 하리로다.\\n세번째. 두 나무에는 황금사슴벌레가 존재하리니,황금으로 변하는 시간을 기다릴지로다.\\n네번째. 잠자리는 그늘위에 앉으리니 三 을 가져야 六 위에 놓이는구나.\\n다섯째. R 은 P 로써 사라지니 잡힌 물고기가 곧 행운이로다.\\n여섯째. 징검다리는 두개의 열쇠를 놓고간 자리로부터 추락하리니 끝에 서리로다.\",\"363\":\"첫번째. 탑속에 갇힌 원숭이는 뱀을 쫒는 원숭이로다.\\n두번째. 흰색 보트는 천사의 사냥터로다.\\n세번째. 검은색 리본이 달린 벽돌은 城이 되리로다.\\n네번째. 불장난을 하는 어린이 둘은 흰색모자를 가졌구나.\\n다섯째. 지나가는 바람은 오이를 떨어뜨려 福 이로다.\\n여섯째. 불에 갇힌 먹장어는 인간이 가진 水를 만나 사라짐이로다.\",\"364\":\"첫번째. 두마리의 사슴은 발이 셋이며 東門으로 들어가는구나.\\n두번째. 쵸코렛에 새겨진 장미로다.\\n세번째. 기차역의 기적소리는 붉은깃발위에서 울리는구나.\\n네번째. 인디언 절벽을 찾아 그 아래에 묻히리로다.\\n다섯째. 세개의 부채는 하루며,이중 두개의 부채가 같아질때 남은 부채는 가장 커지리로다.\\n여섯째. 선은 手로 흐르니 가장 큰 기둥아래에 존재하는구나.\",\"365\":\"첫번째. 김밥을 싸는 아낙네의 즐거움은 그 안으로 존재하리로다.\\n두번째. 다리를 건너 흰 항아리를 찾으리니,두 뱀은 방향의 길잡이로구나.\\n세번째. 종이 뒤짚힐때,두개의 잎을 만들어 하늘위로 오를때 樂 이로다.\\n네번째. 철갑을 입은 초록용은 땅으로 기어 산위로 오르리로다.\\n다섯째. 호수위에 존재하는 도장을 버리며,나무위에 존재하는 도장을 취할때 나타나는구나.\\n여섯째. 인간세속의 유혹은 人間의 등뒤에서 나타나는구나.\",\"366\":\"첫번째. 커피잔 위에 개미는 잠이들때 행운이로다.\\n두번째. 成 의 비밀은 서쪽에서 힘이 빠질때 나타나리로다.\\n세번째. 기억의 전쟁은 역으로 시작되며 첫병사가 사라져야 보일지로다.\\n네번째. 장군의 자리로 여치가 움직일것이나 열매가 없는 자리로구나.\\n다섯째. 노인은 笛 을 취하여 항아리속에 숨으리로다.\\n여섯째. 龍이 되어 六의 꽃병중에 향기가 없는 꽃을 찾아 선택하리로다.\",\"367\":\"첫번째. 옥수수는 冬장군에게 잡힐때 보물이 되리로다.\\n두번째. 두바위는 木 과 土 가 새겨있으며 거북이 그 위에 서리로다.\\n세번째. 아홉의 빛은 인어를 따라가는 빛이로다.\\n네번째. 인간의 짚신은 푸른뱀을 피하기 위하여 존재하리로다.\\n다섯째. 선은 높고 낮으며,가장 낮은곳에 존재하는 인간의 발을 조심할지로다.\\n여섯째. 敵 을 보호하기 위한존재이나 敵 을 공격하리로다.\",\"368\":\"첫번째. 봉투는 九 와 力 을 담을지로다.\\n두번째. 냉장고를 열어 황금딸기의 존재를 찾는구나.\\n세번째. 황금나비는 백호위에 앉아야 기쁨이로다.\\n네번째. 반지는 거북의 등위에 떨어질때 目의 길로 가리로다.\\n다섯째. 하늘색옷은 바람을 타고 산을 세번 넘어야 주인에게 돌아가리로다.\\n여섯째. 모자는 서쪽이며 금지된 장소의 표시로다.\",\"369\":\"첫번째. 붉은 리본을 가진 W 는 창을 맞는구나.\\n두번째. 두개의 달을 찾아,하나의 龍이 새겨진길로 가는구나.\\n세번째. ㄷ의 길이 세개요 東으로 터진길은 中의 의미로다.\\n네번째. 어둠속에서 박수를 세번칠때 반지하나를 잃으리로다.\\n다섯째. 삼각은 열로서 전하며,사각은 얼음으로 전하리로다.\\n여섯째. 비밀의함정은 다섯을 뛰어야지만 남으로 빠질지로다.\",\"370\":\"첫번째. 곰의 앞치마에 새겨진 노랑색 장미는 행운이로구나.\\n두번째. 두번의 냉수는 한번의 온수와 가장 가까와질때 그 우측에 서리로다.\\n세번째. \\\"나\\\"를 두의미로 찾아야 하며,그 앞쪽으로 두번을 보태리로다.\\n네번째. 白속에 黑이 존재하며,白은 뜨거우며 인간에게로 사라질지로다.\\n다섯째. 달릴때 올라가며 내릴때 0 이 되는구나.\\n여섯째. 네식구중 한명은 외롭고 그 옆에 버팀목과 그림자가 함께 하는구나.\",\"371\":\"첫번째. ㄱ을 가진 붉은벽돌은 달팽이의 집이로구나.\\n두번째. 금화가 들은 상자는 木 의 상자로다.\\n세번째. 뱀에게 잡힌 뱀은 세번째 밭에 갇히리로다.\\n네번째. 잃어버린 지갑은 케잌속에 감추어졌구나.\\n다섯째. 새가 앉음은 시작이요,계단을 내려갈때 돌고래를 만나리로다.\\n여섯째. 가장 큰 고구마는 멧돼지의 덫이로다.\",\"372\":\"첫번째. 돛을 단 배는 항구를 찾아 갈지니 푸른사과가 그 입구로다.\\n두번째. 지네는 복숭아잎에 존재하니 이틀후 땅에 떨어지는구나.\\n세번째. 여든여섯의 밤송이는 밤과 낮으로 나뉠지로다.\\n네번째. 검은 원숭이는 고래의 등에 자신의 이름을 새길지로다.\\n다섯째. 추락하는 사자는 병을 고치는 사자로구나.\\n여섯째. 오이를 담은 바구니는 날개를 가진 바구니로다.\",\"373\":\"첫번째. 天 속에 다이아몬드는 셋이붙어 하나가 될지로다.\\n두번째. 군화밑의 장미는 生 이로다.\\n세번째. 호랑이를 가진 종이는 12시의 여우를 피할지로다.\\n네번째. 수요일에 정십이면체의 비밀은 풀리는구나.\\n다섯째. 따뜻함위에 붉은장갑은 한쌍이며,그중 하나가 먼저 식는구나.\\n여섯째. 치마를 접고 강을 세번건너니 하루는 행복하구나.\",\"374\":\"첫번째. 나무무늬는 十 이요,시간의 역행속에 水 가 존재하리로다.\\n두번째. 버려진 운동화는 서쪽이며,그늘속에 빛은 숨어있을지로다.\\n세번째. 바위위에 묶여있는 풍선은 \\\"三\\\" 이로다.\\n네번째. 집은 두개의 고개를 넘어 하나의 정원을 지나 비로소 존재하는구나.\\n다섯째. 다이아몬드를 지난 원이 존재하니 죽음이로구나.\\n여섯째. \\\"사랑과 재물의 신\\\"이 만들어준 \\\"상처\\\"로다.\",\"375\":\"첫번째. 백기를 든 병사는 \\\"오리의 슬픔\\\"이로다.\\n두번째. \\\"황금화분\\\"속에 \\\"난과 조약돌\\\"은 선택받을지로다.\\n세번째. 유모차는 빛을 가린 잎을 따라가리로다.\\n네번째. 나무숲에 느티나무는 세개의 은도끼와 별을 피할지로다.\\n다섯째. 접시가 둘인 인간은 따뜻함으로 \\\"十二\\\" 를 담으리로다.\\n여섯째. 적십자가 가린 시간은 9시20분 이구나.\",\"376\":\"첫번째. 황금을 지키는 주전자는 끓어야 生이로다.\\n두번째. 코스모스잎은 두개의 진주를 감싸 父情이 되는구나.\\n세번째. 물고기는 표주박에 담겨 南으로 가는구나.\\n네번째. 조개의 무늬는 八 이요, 그 아래 石 이로다.\\n다섯째. 봉황머리에 붙은 火는 바다를 건너리로다.\\n여섯째. 방 세개를 찾아 가장 큰방의 주인을 피해 숨을지로다.\",\"377\":\"첫번째. 心을 통과한 골프공은 승리의 공이로다.\\n두번째. 꿀통은 태양을 보는 위치에 나타나 중심이 되는구나.\\n세번째. 검은반지는 번개를 맞아 호수에 추락하리로다.\\n네번째. 사과는 압정을 피해 가까운 서랍속에 담기리로다.\\n다섯째. 청개구리는 열두번 울며 붉은태양 아래 서는구나.\\n여섯째. 젖소는 月안에서 찾을지로다.\",\"378\":\"첫번째. 버스가 멈춘 다리는 큰홍수를 만날지로다.\\n두번째. 화요일의 주인은 그네이며,세번 흔들려 행운을 이루리로다.\\n세번째. 공주의 바구니속에는 \\\"흰쌀밥\\\"이 존재하는구나.\\n네번째. 붉은망토는 거울속에 존재하리니 3월에 사라짐이로다.\\n다섯째. 천칭자리를 가진 왕관은 福 이 담긴 왕관이로다.\\n여섯째. 品 속의 압정은 비밀의주머니에 빠지는구나.\",\"379\":\"첫번째. 龍의 그림자를 찾아 승리의 표시를 잔에 남기리로다.\\n두번째. 범선은 여섯의 창끝에서 깃발을 세우리로다.\\n세번째. F 피아노는 땅에 세울때 金은 가득 차는구나.\\n네번째. 인디언 마을에 태어난 독수리는 ㄱ 을 가졌구나.\\n다섯째. 숲은 거북을 감싸고 그 사진을 하나로 만드는구나.\\n여섯째. 도장은 서쪽으로 돌고있는 바람을 단한번 찍으리로다.\",\"380\":\"첫번째. 벽돌은 五이며,무너져 함정에 갇히리로다.\\n두번째. 서쪽의 방패는 三을 새기며, 모래속에 깃발을 세우는구나.\\n세번째. 바람을 막은 \\\"칼\\\"은 배신자이며,꼬리를 쳐야만 보일지로다.\\n네번째. 황금돼지는 눈을 가리고 9개의 井속에 남으리로다.\\n다섯째. 夕은 노인의것이며 지팡이가 그 꿈을 이루리로다.\\n여섯째. \\\"종\\\"을 뒤집어 \\\"흰눈\\\"을 쌓으니 행운이구나.\",\"381\":\"첫번째. 해운대를 피하고,위험한 상어를 잡을지로다.\\n두번째. 황소의뿔은 오른손에 놓여 추락하는구나.\\n세번째. 태양을 등진 암초에서 사진만 남으리로다.\\n네번째. 五가 잡혀 그중 운전하지 않은 사람이 풀려나리로다.\\n다섯째. 남쪽 깃발속에 곰두마리를 찾으니 평온하구나.\\n여섯째. 비밀의 주머니는 용천폭포를 담는 주머니로다.\",\"382\":\"첫번째. 두개의 안경은 공룡의 그림자를 바라보니 그 後가 보이는구나.\\n두번째. 태양은 달로부터 6年을 돌아 찾아올때 빛이 나리로다.\\n세번째. 4월의 馬는 동심을 태우고 달리며 밤에만 쉬는구나.\\n네번째. 칡을 캐는 노인은 원두막에 쉬어가리로다.\\n다섯째. 비가 내리는 숲속에 동전은 단 하나 떨어져 있으니 세속의 아픔이로구나.\\n여섯째. 보물섬위에 번개는 동굴을 감싸는 번개로다.\",\"383\":\"첫번째. 다섯개의 태양은 하나의 山 위에만 서리로다.\\n두번째. 生은 도끼가 녹아야 만들어지는 열쇠로다.\\n세번째. 하늘위에 존재하는 세번째 \\\"地\\\" 는 빛이 되리로다.\\n네번째. 용기의 다리는 \\\"짝\\\"이되어야 용광로에 녹는구나.\\n다섯째. 창은 3시에 멈추고 북쪽의 여신은 \\\"口\\\" 앞에 기다리는구나.\\n여섯째. 겨울의 여왕은 나무와 흙과 불을 선택하리로다.\",\"384\":\"첫번째. 곶감은 할머니의 주머니에서 나오니 행복이구나.\\n두번째. 집을 등에진 낙타는 발자국으로 그 위치를 찾을지로다.\\n세번째. 열쇠를 쥔 손은 차가운 태양속에 담그리로다.\\n네번째. 피리는 구멍이 세개며 가장 무거운 피리가 되리로다.\\n다섯째. 코스모스의 향은 고향을 지키는 어린이의 차지로다.\\n여섯째. 젓가락은 세쌍이니 비밀의문을 지나가야 행운으로 바뀌는구나.\",\"385\":\"첫번째. 일곱개의 바위는 동쪽벽을 가진 바위로구나.\\n두번째. 좋은 친구는 다섯의 目 속에서 존재하리로다.\\n세번째. 누룽지를 받은 솥뚜껑은 행운이 있으리로다.\\n네번째. 제비는 별을 넘어야 口 속에 갇히리로다.\\n다섯째. 기사는 황금옷을 벗고 물에 빠진 人間을 구하리로다.\\n여섯째. 둥근테이블위에  보자기는 구멍이 셋이니 손으로 가려 보이지 않는구나.\",\"386\":\"첫번째. 편지는 도착할것이니, 소나무 아래에서 읽는구나.\\n두번째. 보물지도가 사라진 시간은 木 이 되며 그 이후가 차갑도다.\\n세번째. 팽이는 절벽위에 서며 아이는 보이지 않는구나.\\n네번째. 걸음은 나이가 가장 많은 사람이 가장 빠를지로다.\\n다섯째. 차는 지나가고 꽃은 떠나야 행운이로다.\\n여섯째. 책위에 황소의 안경이 눈부시구나.\",\"387\":\"첫번째. 잔디를 깎는 사람은 장미를 피해 동쪽에 서리로다.\\n두번째. 모래를 빠져나가야 三의 불꽃이 보이는구나.\\n세번째. 압정은 벽으로부터 선에 닿아 七 이 되리니 행복이구나.\\n네번째. 편지가 달린 나무아래 호박은 의미가 있구나.\\n다섯째. 하늘에 기둥이 둘이니 형제는 의리가 있구나.\\n여섯째. 十의 받침은 넷이며 하나가 쓰러질때 행운이 보이는구나.\",\"388\":\"첫번째. 푸른지구는 달위에서 거울로 비출때 그 의미가 있구나.\\n두번째. 녹색의 잔속에 범선은 日 이요,그 시간속에 멈추리로다.\\n세번째. 귀걸이와 반지를 함께 소금물에 담글때 하나가 생기리로다.\\n네번째. 눈이올때 나비가 하늘을 날으리니 이것이 \\\"天上畵\\\" 로다.\\n다섯째. 주전자는 七 이며, 동쪽에서 둘을 가져갈때 \\\"남음\\\"을 찾을지로다.\\n여섯째. 삿갓을 쓴 나그네는 호박잎을 따는구나.\",\"389\":\"첫번째. 하안 달팽이는 녹색나무를 가진 달팽이로구나.\\n두번째. 솟구쳐 오르니 웃음이요 다섯계단에 걸려 내려오니 울음이로다.\\n세번째. 공룡발자국 위에 개미 한마리가 집을 짓는구나.\\n네번째. 가위를 컵에 넣으니 木이요 그 빛은 아침에 사라지는 빛이로다.\\n다섯째. 낚시바늘이 一일때 참새가 잡히며 \\\"不殺生\\\" 이로다.\\n여섯째. 때는 백제요 신은 금동이니 행운이 담겼구나.\",\"390\":\"첫번째. 환갑속에 세움이 존재할때 곧 깨달음을 얻으리로다.\\n두번째. 계단에서 폭포를 만나며, 이마에 나비가 앉으리로다.\\n세번째. 함정은 흑인을 가두며, 네번째 갇히는 동물과 마주하리로다.\\n네번째. \\\"효도\\\"와 \\\"불효\\\"의 공통점은 선택받으리로다.\\n다섯째. 무지개떡은 七 을 넘어야 그 의미가 생기는구나.\\n여섯째. 여인은 \\\"싸리비\\\"를 지나쳐야만 생명의 보리밥을 볼수 있구나.\",\"391\":\"첫번째. 오렌지를 딴 동자는 바구니를 버리는구나.\\n두번째. 코끼리와 범은 三 의 길중 二 의 길을 함께 걷을지로다.\\n세번째. 총성이 들려 해가 뜨니 그늘은 사라지리로다.\\n네번째. \\\"종이\\\"는 아픔을 낫게하는 \\\"종이\\\"이며 옷을 입으리로다.\\n다섯째. 하나가 들어간 새소식은 남자에게만 들리는구나.\\n여섯째. 표주박안에 동전하나는 아래로 추락하며 결국 반이되어 나타나리로다.\",\"392\":\"첫번째. 보물이 고등어 위로 떨어지니 力 이로구나.\\n두번째. 지하로 젓가락 三 이며, 이를 水 위에 세워야 하니 고민이구나.\\n세번째. 나비는 벽으로부터 삼일간 움직일수 있으며,그 이후로는 존재치 않으리로다.\\n네번째. 해바라기는 東 과 만나 행운을 얻을지로다.\\n다섯째. 별은 끝에서 끝으로 연락을 취하며 두번 접히리로다.\\n여섯째. 이층 고리를 만들고 삼층석탑을 부수는구나.\",\"393\":\"첫번째. 두개의 통조림은 바이올린의 양옆으로 존재하리로다.\\n두번째. 태극의 열쇠를 찾으리니,고래가 그 증표로다.\\n세번째. 물이 필요한 사슴은 은쟁반을 바라보는구나.\\n네번째. 번개는 악어의꼬리를 내리쳐야만 행운을 얻으리로다.\\n다섯째. 조약돌은 냇가에서 불을 피하리로다.\\n여섯째. \\\"福\\\"은 거울의 中心 속에서 숫자가 보이는구나.\",\"394\":\"첫번째. 어부의 황금그물에 흑상어가 걸렸구나.\\n두번째. 불국사의 友는 石 과 함께 하리로다.\\n세번째. 발레슈즈는 보라색위에서 빛이 나는구나.\\n네번째. 검은굴뚝위에 연기는 피하며,제비는 세번돌아 남쪽으로 가는구나.\\n다섯째. 할머니집에 찾아가니,문앞에 멧돌의 존재함이로다.\\n여섯째. 낙엽은 황금이요,황금위에 도장은 나의것이로구나.\",\"395\":\"첫번째. 노란모자위에 장미는 고양이의 꽃이로구나.\\n두번째. 해바라기위에 개미는 하얀개미로다.\\n세번째. 소녀의 흰티는 붉은 치마위에 어울리는구나.\\n네번째. 밀림의 총소리는 나무가 쓰러질때 동시에 울려 퍼지리로다.\\n다섯째. 목걸이는 죽음의 이름을 뜻하니 다시 태어나리로다.\\n여섯째. 하얀 눈위에 커피의 향이 행복한 마음을 움직이리로다.\",\"396\":\"첫번째. 행운위에 두개의 도끼를 세워 하나의 그림자를 만들지로다.\\n두번째. 나팔위에 승리는 木의 좌측에 서리로다.\\n세번째. 두창은 맞서며,하나의 휘어지는 창이 승리하리로다.\\n네번째. 물동이를 가져간 날이 존재하며,다람쥐는 초록옷을 입는구나.\\n다섯째. 기와는 三이요, 먹구름은 땅을 적시는구나.\\n여섯째. 수염을 가진 황금곡식은 산돼지를 무서워하는구나.\",\"397\":\"첫번째. 통나무집은 벽이 사라져 무의미로 남는구나.\\n두번째. 군인의 \\\"담배\\\"는 개울물에 그 \\\"불씨\\\"가 꺼짐이로다.\\n세번째. 회초리는 장미덩쿨 아래에 올려져 있구나.\\n네번째. 황금색의 다슬기를 잡은 아이는 행복하리로다.\\n다섯째. 토마토는 계단아래 죽음을 피하며,거북이 알 앞에 존재하리로다.\\n여섯째. 뿌리는 세개요 잎은 네개에 열매는 三이니 山蔘 이 되리로다.\",\"398\":\"첫번째. 요리사는 북을 쳐 \\\"요리\\\"의 시작을 알리는구나.\\n두번째. 가위는 캐나다의 선물이 되리로다.\\n세번째. 폭포는 두개이며 숨겨진 황금알을 찾아 그 위에 올려놓을지로다.\\n네번째. 코끼리위에 타조는 상자의 중심으로 떨어지는구나.\\n다섯째. 노란 화분위에 민들레는 행운이 되리로다.\\n여섯째. 두개의 리본은 머리위에 장식이 되며 동쪽으로 향하리로다.\",\"399\":\"첫번째. 녹지않는 冬의 의미는 夏 의 우두머리에 존재하리로다.\\n두번째. 뒷문의 아이는 기다리는 人의 존재를 찾으리로다.\\n세번째. 꽃과 구름과 다리를 하나로 가져가리로다.\\n네번째. 지구위에 존재하는 큰 \\\"분수\\\"가 보여 그 숫자를 이루리로다.\\n다섯째. 세개의 \\\"짚신\\\"위에 동전이 놓이리니 중심을 찾는구나.\\n여섯째. 식탁위에 붙여놓은 이쁜 나비그림이 보기좋구나.\",\"400\":\"첫번째. 선을 가장한 원은 돋보기 끝에 모이리로다.\\n두번째. 공주의 반지는 붉은 금붕어가 삼키리로다.\\n세번째. 해적의 표시는 흙과 세개의 대나무위에 세워지리로다.\\n네번째. 동쪽바람이 불고,바람을 가진 동물이 나타나리로다.\\n다섯째. 十 은 존재함속에 사라지고,달이 뜨니 풍월을 낚는구나.\\n여섯째. 입구는 단하나요,세월이 石에 멈추어야 비로소 비밀이 풀리는구나.\",\"401\":\"첫번째. 수박은 目과 함께 어울려야 비로소 열리는구나.\\n두번째. 호수위에 서있을때 달과 해가 비추리로다.\\n세번째. 연못에 거북이는 존재하며, 그 알은 세개로다.\\n네번째. 사파이어 반지는 네번째 손가락이 주인이며 그 의미를 새기리로다.\\n다섯째. 山 이 불타 돼지와 노루가 함께 도망가는구나.\\n여섯째. 번개가 치는날 동전을 주워 행운을 얻으리로다.\",\"402\":\"첫번째. 포도위에 비둘기는 善 이로다.\\n두번째. 다섯의 붓은 붓아래에 매화가 함께 하는구나.\\n세번째. 우물에 빠진 초록의 동물이 보이니 행복하구나.\\n네번째. \\\"반달\\\"은 쫒아오는 \\\"벌\\\"에게 빛을 주리로다.\\n다섯째. 툇마루에 앉은 노인은 낫을 가지고 있구나.\\n여섯째. 신부의 혼례가 시작되는 시간에,군불아궁이에 불을 지피리로다\",\"403\":\"첫번째. 장미는 깍두기 위에 나타나리로다.\\n두번째. 라디오,국자,술은 단 하나의 입구가 되는구나.\\n세번째. \\\"얼굴\\\"속에서 존재하는 가장 큰 열쇠로다.\\n네번째. \\\"고래\\\"는 집안에 갇히고 \\\"거북\\\"은 집밖에 갇히는구나.\\n다섯째. 비를 맞으니 \\\"火\\\" 로부터 가장 멀리 떨어지리로다.\\n여섯째. 산소는 태양속에 녹아 \\\"행복\\\"을 찾으리로다.\",\"404\":\"첫번째. 가장 강한 문자중 둘째 형제이며 하나가 사라져 그 뜻을 이룰지로다.\\n두번째. 별을 가진 개구리는 그림속의 개구리구나.\\n세번째. 세번째 약속은 아파트에서 하리니,그 문은 세번 두드려 열리는구나.\\n네번째. 산을 오르니 물을 찾으며,땅에 내려오니 구름을 찾는구나.\\n다섯째. \\\"시작\\\"의 사다리를 탄 삐에로는 두개의 공을 담으리로다.\\n여섯째. 목욕하는 人間은 七이며 수건은 一 이로구나.\",\"405\":\"첫번째. 태풍은 天 속에 들어가 우산을 가져가리로다.\\n두번째. 금옥이 거북위에 존재하여 물속에 잠기리로다.\\n세번째. 소나무향기는 가야금소리와 어울리는구나.\\n네번째. 방패는 동쪽으로 향하여 방향을 잡고 창은 부러져 의미가 생기니 金 이 되는구나.\\n다섯째. 비가 내려 연못을 이루며 \\\"홍학\\\"은 인간을 피하여 숨는구나.\\n여섯째. 石 은 두개의 福 을 지니며 첫번째 福은 二人이 도와주리로다.\",\"406\":\"첫번째. 개미는 호박위에 모여 햇빛을 받으리로다.\\n두번째. 사슴은 흰돌을 굴려 절벽에 세번 떨어뜨리니 행운의 표시로다.\\n세번째. 바퀴 셋에 사람은 등지고 있으니,북쪽의 행운이로다.\\n네번째. 국수를 좋아하는 선비는 국수집을 지나야 시험을 볼수 있구나.\\n다섯째. 열쇠는 사람위에 서며 이는 곧 \\\"발\\\"이 될지니,우측으로 쓰러질때 그 끝에 서리로다.\\n여섯째. 밤이 세번 지나야 나무는 평화롭구나.\",\"407\":\"첫번째. 푸른 풍선은 우산끝에 걸려 좌측에 존재하리로다.\\n두번째. 신호등은 \\\"五의道\\\" 속에 존재하리니 한번 돌아 첫번째 길이로구나.\\n세번째. 이주가 지난후 물을 가진 어항은 모두 깨지며, 흙을 가진 어항만 남으리로다.\\n네번째. 새벽 닭은 황금알을 품어 신발위에 올려놓으리로다.\\n다섯째. 공을 불어 소리를 내며 貝로 막아도 지나가 멈추리로다.\\n여섯째. 人을 八로써 나누어 그중 二에서 멈추는구나.\",\"408\":\"첫번째. 쵸코렛의 함정으로 도둑을 잡는구나.\\n두번째. 거울속에 비친 얼굴에 十 을 찾아 답을 구하리로다.\\n세번째. 종이학을 탄 난장이는 金구슬을 하나 지녔구나.\\n네번째. 주머니속에 모래는 한주먹이며 남은 모래를 지켜낼지로다.\\n다섯째. 三 은 쓰러지고 그 의미는 하늘을보며 우측에 존재할것이니 행복의 의미로다.\\n여섯째. 거북은 東 속에 존재하리니 이제 그 꼬리를 찾을지로다.\",\"409\":\"첫번째. 성냥은 雪위에서 존재하니 그 아래 열쇠로다.\\n두번째. 인간의 만남은 욕심으로 채워질것이니,두개의 마음이 빠져 의미를 새기리로다.\\n세번째. 전쟁과 음식과 날씨는 공통이 될지니,上과下로 나누는구나.\\n네번째. 十 의 동쪽에서 시작되어,순리를 따라 안으로 흘러 갈지니 1년의 시간이 흐르리로다.\\n다섯째. 잠수함속에 두사람이 존재하며 앞사람은 붉은꽃을 좋아하며 뒷사람은 푸른꽃을 좋아하는구나.\\n여섯째. \\\"투우장의 함성\\\"은 역으로 세번돌때 멈추리로다.\",\"410\":\"첫번째. 집속에 갇힌 여섯개의 붓은 \\\"황금용\\\"의 눈이 되리로다.\\n두번째. 풍선이 터져 일곱개의 나무와 한개의 반지가 나오리로다.\\n세번째. 번개는 달리는 馬 위에 존재하며,폭풍은 종소리가 끝날때 부는구나.\\n네번째. 비가 내리면 기왓장이 무너져 \\\"꽃\\\"을 다치게 하는구나.\\n다섯째. 세상의 컴퓨터는 안경을 쓴 소년이 주인이로다.\\n여섯째. 주인은 三 을 보내고, 하인은 九 를 가지니 가장 큰 보물이 되는구나.\",\"411\":\"첫번째. 마술주머니는 기러기의 둥지로부터 시작되리로다.\\n두번째. 白鶴은 동쪽으로 부터 붉은옷을 받아 입으리로다.\\n세번째. 동굴속에 녹색의 십자가가 존재하리니 철문을 찾으리로다.\\n네번째. 흰색곰과 흑색곰은 天地에 집을 지으리니 이것이 天上樂 이로다.\\n다섯째. 金 과 숲과 金 과 숲 이 존재하며 네등분하니 첫번째 조각의 짝이로다.\\n여섯째. 용궁속에 토끼는 보물을 찾으리니 12시간을 더 줄것이로다.\",\"412\":\"첫번째. 미끄럼틀에 묶여 있는 풍선은 바람에 흔들리는구나.\\n두번째. 닭은 오리를 만나,王의 우측에 서리로다.\\n세번째. 문경세재의 주막에 행운이 존재하리니,동쪽길을 따라 갈지로다.\\n네번째. 끝 위에 서며 마지막 우측의 그림자는 날개를 가진채 존재하리로다.\\n다섯째. 태양의 완전함은 행운으로 나누어지며,두개의 주머니를 가지리로다.\\n여섯째. 초록옷을 입고 노란옷을 입고 붉은옷을입으니, 그이후에 보이지 않는구나.\",\"413\":\"첫번째. 엘리베이터는 상승하여 1과 7시에 멈추리니 그곳에서 비상벨을 찾는구나.\\n두번째. 안경속에 꽃은 갇히며,행복의 결혼식은 그안에서 시작되는구나.\\n세번째. 두번의 행운과 한번의 고생은 하나의 인생속에 나타나는도다.\\n네번째. 구름은 꽃바구니에 담겨 행운으로 찾아오는구나.\\n다섯째. 오렌지는 과녘속에 살며 날카로운 사랑을 얻으리로다.\\n여섯째. UFO 가 꺼꾸로 설때 양의 시간은 멈추어지는도다.\",\"414\":\"첫번째. 一의 배추는 잘려지며,그 이후에 五의 호박잎은 아래로 숨는구나.\\n두번째. 벼루의 용머리는 天地를 호령할지로다.\\n세번째. 고무줄은 신발에 묶어 겨울에 끊어지리로다.\\n네번째. 강태공은 八月八日에 그림자속에서 대어를 낚으리로다.\\n다섯째. 별을 가진 호주머니는 다섯에 비로서 열리는구나.\\n여섯째. 오래된 전화기와 향수는 門 안으로 들어오리로다.\",\"415\":\"첫번째. 공룡의 사라짐은 하늘로부터 시작되며 불꽃화산의 재를 맞으리로다.\\n두번째. 항아리를 깨어뜨린 범인은 바로\\\"겨울\\\"과 \\\"물\\\"이로다.\\n세번째. 낙엽을 태우는 소리에 행복의 웃음을 더하는구나.\\n네번째. 사슴의뿔위에 개구리가 존재하며 서쪽으로 세번가는구나.\\n다섯째. 七 과 七 은 뒤집혀 반으로 나뉘며,엽전속에 머물것이로다.\\n여섯째. 동쪽에 뜬 해는 세개의 그릇속에 담기며 天王門을 통과하리로다.\",\"416\":\"첫번째. 서울의 강아래에 흰돌을 주워 남쪽 계단에 올려놓으리로다.\\n두번째. 마굿간에 갇힌 흰야생마는 날개를 잃은 야생마로구나.\\n세번째. 지구는 태양을 세번돌아 10월의 시간으로 역행하니 주인공은 한명이로다.\\n네번째. 막차를 탄 여인의 자리는 가장 앞쪽의 자리로구나.\\n다섯째. 신발을 벗어 방으로 들어가니 신발은 나무와 짝을 이루리로다.\\n여섯째. 서쪽으로 돌아가는 지름길은 두개며 하늘과 가까운 지름길을 택하리로다.\",\"417\":\"첫번째. 별은 山으로 나누어지며 초록의 항아리속에 담기리로다.\\n두번째. 열쇠는 하나며 동전속의 용이 그 앞으로 인도하리로다.\\n세번째. 검은개미 다섯마리와 그 먹이를 주는 노인은 평온하구나.\\n네번째. AB형의 남자가 일곱계단에서 멈출때 행운은 시작되리로다.\\n다섯째. 돛을 단 배는 구름을 따라가며 그 길에서 고래를 피하리로다.\\n여섯째. 五의 붓은 가장 작은 별을 따라 남쪽의 끝에 서리로다.\",\"418\":\"첫번째. 三門 을 넘어 곰이 존재하니 첫번째 시작이로다.\\n두번째. 가장 큰 컵을 찾아 시간으로 만들지니 그위에 존재하는구나.\\n세번째. 주전자속에 담은 귤은 보약이 되리로다.\\n네번째. 누에를 치는 방속에 숨겨진 보화로다.\\n다섯째. 신묘년의 휴일은 별속에 갇혀 서쪽에 서리로다.\\n여섯째. 십자군의 기사는 안개속에 감추어져 있으니 물의 전쟁이 시작되리로다.\",\"419\":\"첫번째. 고래소리는 곧 七의 악기가 되니 행운이로다.\\n두번째. 거북이는 신호등속에 그려져 있으며 자리는 붉은색자리로다.\\n세번째. 밀짚모자속에 담겨진 장미는 시들지 않을지로다.\\n네번째. 고구마싹은 도끼로 잘려지며,멧돼지는 잠들지로다.\\n다섯째. \\\"4층의보물\\\"은 그방의 주인이 감추었으니,木이 그 열쇠로다.\\n여섯째. 容 속에 존재하는 생명의 비밀이로다.\",\"420\":\"첫번째. 그림자속 도로는 군고구마가 떨어진 道路로구나.\\n두번째. 아홉개의 생명과 물은 낙엽속에 담겨있구나.\\n세번째. 행운속 고드름은 연탄불의 따뜻함으로 녹으리로다.\\n네번째. 창문은 거북이형상이 비치며 그 위로 상승이로다.\\n다섯째. 투우사의창은 곱추의 등에 떨어져 아픔이로다.\\n여섯째. 성탄절 트리는 별여섯의 목각도장이 새겨지리로다.\",\"421\":\"첫번째. 동굴속에 갇힌 새우는 태양을 볼수 없음이로다.\\n두번째. 한복을 입은 눈사람은 폭설에 쓰러지니 그 자리로다.\\n세번째. 빌딩위에 얼음은 떨어지리니,세종대왕의 머리로구나.\\n네번째. 수염을 기른 장군의 눈물은 따뜻함으로 빛나리로다.\\n다섯째. 十의 도형은 3시로부터 시작되어 5시에 끝나리로다.\\n여섯째. 방아간의 쌀은 많으며,그 안에서의 보리는 부족하니 가져다 놓을지로다.\",\"422\":\"첫번째. 국자위에 설탕은 녹아 별이 찍히리로다.\\n두번째. 도깨비가 사는 동굴을 찾아 화로불을 피우리로다.\\n세번째. 편지는 붉은벽돌위에 올려져 있으리니 뒤집어 놓을지로다.\\n네번째. 바늘귀속에 宇를 모두 넣어 세상을 바라볼지로다.\\n다섯째. 열기구는 구름속에서 동쪽으로 움직이리로다.\\n여섯째. 와이셔츠속의 거미는 독거미로구나.\",\"423\":\"첫번째. 연탄난로위에 밤은 익으리니 童子는 즐겁구나.\\n두번째. 해일이 곧 닥칠것이나,만두의 김은 참으로 느리구나.\\n세번째. 지우개로 지우는것은 책상위의 낙서로다.\\n네번째. 사탕은 입에 없으며 거짓말에 속지 않는 깃발이 존재하리로다.\\n다섯째. 우주는 하늘아래 존재하며,바다와 사막의 공통이로다.\\n여섯째. 버섯을 가진 손가락에는 반지가 존재하리로다.\",\"424\":\"첫번째. 공주가 사라진곳에 나타난 天의 접시로다.\\n두번째. 코끼리의 등에 놓여진 사과는 생명이로다.\\n세번째. 탐험가의 추락이 보이며,빈공간에 놓여진 시간의차이는 3일이구나.\\n네번째. 고래에 그려진 장미는 눈물로써 지워지리로다.\\n다섯째. 자물쇠와 열쇠는 두개의 상아로 만들어지는구나.\\n여섯째. 따뜻한 손장갑은 \\\"孝\\\"를 만드는 도구로 쓰일지로다.\",\"425\":\"첫번째. 사진속 선생님의 이름은 \\\"甲\\\"이로다.\\n두번째. 낙지와 참기름이 한곳에 존재하리니,생일은 겨울을 선택하리로다.\\n세번째. 눈화장을 한 흑인은 도시의밤에 존재하리로다.\\n네번째. 우유는 반드시 십만원에 팔아야하며,분홍색 고양이가 지켜보는구나.\\n다섯째. 풍선을 터트리니 그 이후에 태권도의 시작을 알리는구나.\\n여섯째. 잔디속에 감추어진 공주의 반지는 2월의 반지로다.\",\"426\":\"첫번째. \\\"공작새의 전설\\\" 속에 \\\"꼬리\\\"가 존재하리니 황금왕관을 취하리로다.\\n두번째. \\\"꾀꼬리버섯\\\"을 따고 있는 아낙네의 휴일이로다.\\n세번째. 갈매기는 붉은부츠를 감싸안으리로다.\\n네번째. 풍선을 달고 달리는 기차로다.\\n다섯째. 한시간의 생명은 千年의 생명이로다.\\n여섯째. 가장 높은 땅에서의 물을 찾아내니 \\\"福의水\\\" 로다.\",\"427\":\"첫번째. 東 에서 東으로 움직이니,그곳에 멈춤이로다.\\n두번째. 백두산에 사는 \\\"오리\\\"는 白 을 가졌구나.\\n세번째. 太의 下로 낙하산은 펴지니 그늘이 안식처로다.\\n네번째. 다이아몬드로 만든 썰매는 빛이 없어 애처롭도다.\\n다섯째. 붉은색과 푸른색에 감겨진 붕대로다.\\n여섯째. 부엉이는 3시에 날며 태양이 뜨기전 돌아올수 있으리로다.\",\"428\":\"첫번째. 풍뎅이는 덮여진 낙엽위에 승리의 표시를 남기리로다.\\n두번째. 소방차는 약국에 멈추리로다.\\n세번째. 노랑머리와 검은머리를 가두는 감옥이로다.\\n네번째. 옷장위에 사과는 七을 가지며,헤어질때 나누어지리로다.\\n다섯째. 사냥꾼은 토끼를 놓치고 시계를 쫓으리로다.\\n여섯째. 겨울옷을 만드는 까마귀를 볼지로다.\",\"429\":\"첫번째. 두개의 버팀목이 쓰러짐을 받치며,쓰러짐이 사라질때 더함을 얻으리로다.\\n두번째. 하나로 붙으니,땅위에 삼각은 우주의 힘과 함께 하는구나.\\n세번째. 잔속의 포도주는 담길수가 없으며 그 옆은 \\\"상승중\\\"이로다.\\n네번째. 힘을 등에 지고 날아가니 등대의 빛을 따라가 멈추리로다.\\n다섯째. \\\"田\\\"위에 존재하는 곶감과 대추를 찾을지로다.\\n여섯째. 4人의 만찬은 오각탁자에서 이루어지며 각각 식사를 하기전 탁자로구나.\",\"430\":\"첫번째. 자신이 볼수 없는 人은 月 속에 함께하는구나.\\n두번째. 남산의 石은 명동의 입구에도 나타나리로다.\\n세번째. 수도꼭지 아래는 이사온 거미들의 차지로다.\\n네번째. 흰달팽이에게 도움을 청하니,세번째 편지를 받을것이로다.\\n다섯째. 철은 달리기위하여 먹고,그 \\\"口\\\"를 찾을지로다.\\n여섯째. 선택의 옆에 서며,진실과 거짓을 더하여 진실을 만들때 필요함이로다.\",\"431\":\"첫번째. 두개의 화살이 東 을 맞출때 황금알이 부화하리로다.\\n두번째. 커피를 마시는 \\\"二人\\\"속에서 \\\"담배\\\"는 사라지리로다.\\n세번째. 쌀가마니에 火가 존재하리니 \\\"호랑이\\\"의 저녁식사로다.\\n네번째. 세번의 \\\"거짓말\\\"속에서 다이아몬드는 나타나며,그것이 사라질때 의미가 생기리로다.\\n다섯째. 소나무 이름은 태양속에 빛나는구나.\\n여섯째. 황금계단은 비를 피하며,장미를 그곳에서 만나는구나.\",\"432\":\"첫번째. 사각은 초록색이요,그 속에서 스승을 찾을지니 두번째 제자가 대답을 하리로다.\\n두번째. 구름에 가려진 금색나팔은 \\\"오목교\\\"에서 울리는구나.\\n세번째. 흰제비꽃은 봄비를 선물하리로다.\\n네번째. 소금이 사라질때 제비가 나타나리로다.\\n다섯째. 古木 을 찾는 코끼리는 王 이 되리로다.\\n여섯째. 번개를 맞지 않는 車 는 \\\"정직한 빛\\\"이 필요하구나.\",\"433\":\"첫번째. 검은양복위의 다리미는 \\\"善\\\"속에서 뜨거움을 나타낼것이로다.\\n두번째. 시계는 十 으로시작되며 태양을 등지고 川 을 더하리로다.\\n세번째. 거북은 3月에 존재하며, 머리위로 별을 지니고 있구나.\\n네번째. 반으로 나뉘어 하나를 만들고 사각을 나누어 또하나를 만들어야 福을 가질것이로다.\\n다섯째. \\\"천사의가면\\\"은 땅에 묻히리니,그위에 화산을 덮는구나.\\n여섯째. 八 아래 존재하는 無의 우측에는 \\\"네개의점\\\"이 나타나며,이중 마지막을 찾을지로다.\",\"434\":\"첫번째. 태양아래 보리밭은 뜨거움이 사라져야만 존재하리로다.\\n두번째. 버스를 함께 탄 友情속에서 내 짝의 이름을 얻는것이 그 열쇠로다.\\n세번째. 지갑속의 사진은 數와 女와 龍을 가졌구나.\\n네번째. 바다고래의 집은 목성이되리로다.\\n다섯째. 별은 자신의\\\"짝\\\"이 사라지고 十이 남을때 그 의미가 생기리로다.\\n여섯째. 신발이 놓인 놀이터에서 모래성을 쌓는 동자가 보이는구나.\",\"435\":\"첫번째. 겨울아이는 지갑속에 숨은 아이로다.\\n두번째. 두뺨에 붉은태양이 두개요,머리는 왕관이로다.\\n세번째. 비둘기는 田 속에 존재하며 水와火와土를 피하리로다.\\n네번째. 눈물을 가진 병사는 아기를 보호함이며,병사8명이 필요하구나.\\n다섯째. 고목은 바람을 피하며,잠자리를 찾는구나.\\n여섯째. 전쟁을 피하여,바퀴로 가장 높은 성을 쌓으리로다.\",\"436\":\"첫번째. 산양은 늑대를 피해 황금절벽에 서리로다.\\n두번째. 커피잔은 서쪽에서 오고,빵은 동쪽에서 오니 한곳에 서는구나.\\n세번째. 큰 짐을 짊어진 곰은 門에서 田을 찾는구나.\\n네번째. 태양을 피해 장미를 찾는 병사만이 큰 전쟁을 피하리로다.\\n다섯째. 十은 순리대로 건널목을 세번 건너 돌아오며,그 끝이 의미있는 선이 되리로다.\\n여섯째. 징검다리는 하나요 오른쪽에 맹인이 존재할때 의미의 글이 보이는구나.\",\"437\":\"첫번째. 클로버는 땅에 서며 그림자가 주인공이니,좌측에 태양이 뜨는구나.\\n두번째. 압정은 거울을 깨뜨리지 않도록 마주하며,단 한번의 행복을 더하리로다.\\n세번째. 장군의 화살을 가진 상자는 바닷속으로 침몰하는구나.\\n네번째. 숲속의 나무토막은 전화기를 찾아 헤메는 인간의휴식처가 되리로다.\\n다섯째. 천둥속에 춤을 추는 학은 모두 눈을 감고 있구나.\\n여섯째. 봄이 오는 길목을 찾아 토끼를 기다리는것은 나뭇꾼이구나.\",\"438\":\"첫번째. \\\"고향의비\\\"는 세탑속에 존재하는 석류를 적시는구나.\\n두번째. 홍당무는 千年의 시간을 여는 열쇠가 되리로다.\\n세번째. 다이아몬드위에 튜울립이 피어나리로다.\\n네번째. 다섯개의 탑속에 갇혀있는 피노키오의 코를 찾으리로다.\\n다섯째. 짚신은 세짝이며,무도회장의 주인이 되는구나.\\n여섯째. 가장 무거운 새끼돼지는 양의 시간속에서 선택받으리로다.\",\"439\":\"첫번째. 하루의 시작에 나타나는 태양과 하루의 마지막에 나타나는 태양의 공통이로다.\\n두번째. 이층버스위에 송이버섯은 소낙비가 필요하리로다.\\n세번째. 다윗과 골리앗이 나란히 설때 나타나는 \\\"중용의도구\\\"로다.\\n네번째. 천둥오리알 옆에 숨죽인 포수가 기다리고 있으니 슬픔이구나.\\n다섯째. 善 을 가진 惡 이 남긴 보물이로다.\\n여섯째. 백두산이 하늘과 맞닿을때 남겨진 흔적이로구나.\",\"440\":\"첫번째. 하늘의 달팽이와 땅의 달팽이는 서로 교차하리로다.\\n두번째. 피라미드의 심장은 品 의 우측이로다.\\n세번째. \\\"바다의천사\\\"는 그숫자를 몸에 새기리로다.\\n네번째. 투우사의 창은 천리를 볼수있는 보물상자를 꿰뚫으리로다.\\n다섯째. 비행체의 추락은 정오의\\\"石\\\"을 남기리로다.\\n여섯째. 튜울립의 초대로 동쪽에서 나타난 흰수염을 가진 손님을 기다리는구나.\",\"441\":\"첫번째. 지구에서 無 를 가진 人 의 숫자가 그 열쇠로구나.\\n두번째. 기울어진 탑은 하나요 사각틀속에서 존재하리로다.\\n세번째. 푸른안경을쓴 여인은 붉은우산을 쓰고 번개를 피하리로다.\\n네번째. 三의 문자는 새를잡고,압정은 땅을 찌르며,마지막이 세워지는 순간 나타나리로다.\\n다섯째. 강위에 피라미드는 태양을 반사하리로다.\\n여섯째. 가장 높은집으로 도망가는 통로를 찾을지로다.\",\"442\":\"첫번째. 가득찬 열차의 主의 자리를 반드시 얻어야 출발하리로다.\\n두번째. 수첩에 적힌 글씨는 空과 西와 手를 표시하리로다.\\n세번째. 겨울나라의 국화는 日을 찾아 目을 더하여 잡을수가 있구나.\\n네번째. 황금상어는 불꽃에 녹아 계단에 떨어진 엽전이 되는구나.\\n다섯째. 축시에 태어난 죽음의 카드는 결국 샴페인을 터트리는구나.\\n여섯째. 농부의 牛는 밭의 대나무를 모두 꺾으리로다.\",\"443\":\"첫번째. 休日의 검은구슬은 은빛쟁반위에 굴러가는구나.\\n두번째. 신사의구두 아래에는 사각 나무조각이 존재하리로다.\\n세번째. 흐린구름아래 하늘로 향하니, 모두 둥글고 땅으로 향하니 모두 하나가 되니 화합이구나.\\n네번째. 주사위속에 행운이 존재하며,세번을 돌릴때 놀라운 선물이 나타나리로다.\\n다섯째. 돌고래의 풍선에 무지개가 걸리는구나.\\n여섯째. 삐에로는 보석을 지니고 있으니,슬픔의 보석을 가려내야 하는구나.\",\"444\":\"첫번째. 人生과 기왓장과 하루살이와의 공통이로구나.\\n두번째. 12개의 자석은 북쪽으로 향하리니,目위에 설지로다.\\n세번째. 지는 태양이 부르는것은 행운이며,바람은 그위에서만 부는구나.\\n네번째. 붉은공과 흰공은 삼각형을 이루며, 門의 출입은 네번 이루어지는구나.\\n다섯째. 항아리에 가득찬 막걸리는 깃발을 든 주인을 따라가는구나.\\n여섯째. 토끼는 교차로를 만나,동북방향 모서리에 집을 짓는구나.\",\"445\":\"첫번째. 네개의 원이 한가운데로 겹치며 木 위에 걸리는구나.\\n두번째. 왕관을 가진 야채는 東의 王에게 전달되리로다.\\n세번째. 金의 형제는 토성의 방향으로 연결되리니 행운이구나.\\n네번째. 바람은 사라지고 세개의 수평선위에 붉은색 보트만이 남는구나.\\n다섯째. 세월의 기록은 一 이 됨으로써 세상에 나타나리로다.\\n여섯째. 초록의 잔디위에 男이 쓰러질때,행운의 보석을 얻으리로다.\",\"446\":\"첫번째. 보물상자의 이름은 Z 이며,그 위에 포도송이를 심으리로다.\\n두번째. 백자를 찾는 길은 학과 거북과 나비로 이어지는 길이로다.\\n세번째. 코스모스와 안개는 6년의 추억과 늘 함께 하리로다.\\n네번째. 두손위에 잡히는 두개의 구슬은 세상에서 가장 슬플때 잡히는 구슬이로다.\\n다섯째. 소리를 담는 그릇을 찾아서 火에 녹이리로다.\\n여섯째. 주전자에 끓인 해바라기의 향기는 福을 불러오리로다.\",\"447\":\"첫번째. 승리의 병사는 王의 가운데에 서며 \\\"창\\\"을 세워 행운을 지키리로다.\\n두번째. 手에서 시작되는 빛은 사각속에 머물며,만물의 허상이로다.\\n세번째. 黑龍은 田 속에 존재하리니,天이 사라질때 나타나는구나.\\n네번째. 동쪽에서 온 타조는 알을 낳고,정상에 서리로다.\\n다섯째. 원숭이는 붉은사과를 들고 농부를 찾아가리로다.\\n여섯째. 사마귀의 행운은 밤이슬이 되며,나뭇잎속에 맺히리로다.\",\"448\":\"첫번째. 두개의 그물은 하나의 물고기를 잡으며 물고기는 땅에서 헤엄치리로다.\\n두번째. 원두막아래 참새는 북쪽으로 세워질때 천둥과 비를 피하는구나.\\n세번째. 생명의토끼는 바위와 함께하며,구름위에 닿으리로다.\\n네번째. 二人을 더하여 四人이 될때,축시가 되리로다.\\n다섯째. 할아버지는 장독위에 신발을 놓으리로다.\\n여섯째. 여신은 정의의 저울로써 남쪽의 행운을 똑같이 나누리로다.\",\"449\":\"첫번째. 돌두꺼비 속에 흰알은 林 위에 서리로다.\\n두번째. \\\"7월의새\\\"는 동쪽에서 온 귀한 보물이로다.\\n세번째. 十二時의 女는 一時의 男을 두번 기다리게 하리로다.\\n네번째. 인간세속의 \\\"오해\\\"와\\\"진실\\\"을 비추는 거울이로다.\\n다섯째. 완성된 탑속에 존재하는 빛은 가장 큰 빛이로다.\\n여섯째. 강뒤에 一이요,개 앞에 또 하나가 있으니 축제가 되리로다.\",\"450\":\"첫번째. 좌측은 절벽이요,산에서 내려오는 水를 피해야 사는구나.\\n두번째. 말안장의 주인은 \\\"先\\\"이며,구름이 해를 가릴때 나타나는구나.\\n세번째. 人馬宮 가운데에 우뚝선 보물이구나.\\n네번째. 다섯알의 포도가 자라며 구두위에 담겨지리로다.\\n다섯째. 전쟁의신에게 가장 필요한것은 \\\"참새\\\"로다.\\n여섯째. 수박을 잘라 상했으며,수박의 주인은 나타나지 않는구나.\",\"451\":\"첫번째. 은하수에서 양파가 사라질때 약속이 이루어지리로다.\\n두번째. 九의 비밀은 土를 서쪽으로 두번 이동할때 풀리는구나.\\n세번째. 8월의 늙은사자와 7월의 어린토끼는 함께 우리에 갇히는구나.\\n네번째. 동굴에 숨은 곰을 잡은 포수는 승리의 깃발을 세우리로다.\\n다섯째. 共 에서 空 이 사라질때 그 의미가 존재하리로다.\\n여섯째. 원숭이의 함정은 네개이며,세명의 흑인과 한명의 백인이 갇히리로다.\",\"452\":\"첫번째. 치마를 입은 남자는 붉은모자를 쓸것이로다.\\n두번째. 검은 여름은 사라지고,세개의 태양을 가진 겨울이 올지로다.\\n세번째. 허상을 따라 여인은 지하로 내려가니 그 또한 두번째의 허상이로구나.\\n네번째. 아이를 가진 여인은 기와집 아래에서 생명의 탄생을 지켜보는구나.\\n다섯째. 기린의 뿔은 赤龍의 먹이가 되는구나.\\n여섯째. 세개의 별이 뜨고,땅위에 사랑이 세워질때 그의미가 생기리로다\",\"453\":\"첫번째. 상점의 이름은 K 이며,땅위에서 바로볼때 상품이 보일지로다.\\n두번째. 三과二와一로 나아가며,태양이 사라질때 늘 앞에 서리로다.\\n세번째. 두개의 사각과 세개의 삼각이 나타날때 입이 가장 커질지로다.\\n네번째. \\\"높음\\\"위에 갓을 쓰고 있으나,하늘아래에 뒤짚혀서 바로 잡히리로다.\\n다섯째. 해를 바라보며,북극에서 세칸을 뛰고,남극에서 다섯칸을 뛸지로니 신생명이 발견되는구나.\\n여섯째. 차는 넘어져 양쪽에 더함이 사라질지리니,같은 형제의 수로다.\",\"454\":\"첫번째. 서쪽에서 큰바람이 불며,가장 높은 탑이 쓰러지리니 그 소리는 \\\"無\\\"로구나.\\n두번째. 쓰러진 칼은 날카롭고 우측의 당근을 잘라야만 그\\\"날\\\"이 지켜지리로다.\\n세번째. 꿈속의 꿈은 지금의 현실이 될지니,五日이 지나야 그 의미를 깨닫는구나.\\n네번째. 수영을 하는 토끼는 \\\"거북\\\"을 피하고 \\\"거위\\\"를 만나리로다.\\n다섯째. 같은 시간속에 \\\"양\\\"을 피해 같은 의미를 가져야만 金 을 얻는구나.\\n여섯째. 공장의 굴뚝은 화요일에 \\\"흰색\\\"과 \\\"검은색\\\"의 연기만을 피우리로다.\",\"455\":\"첫번째. 동쪽에서 온 장어는 신의 축복이되리로다.\\n두번째. 더함이 열개가 있으며,두개의 행운중 하나가 쓰러지리로다.\\n세번째. 八月은 토요일날의 행복과 목요일의 불행이 함께 하는구나.\\n네번째. 흰색천을 머리에 쓰고 내몸과 달빛이 하나가 되는구나.\\n다섯째. 눈을 감고 걸음을 걸어 川이요,고개를 들어 天이니 바로 그자리구나.\\n여섯째. 효도는 여섯개의 흰콩과 다섯개의 국수로 이루어지리로다.\",\"456\":\"첫번째. 無를 보호하며 左는하늘의빛이요, 右는水요 上은 차가우니 천상락으로 모일지로다.\\n두번째. 曰위에 曰이 있으며 세울때 하늘에서 행운이 비추는구나.\\n세번째. 로켓은 나무에 걸려 멈추고 七의 십자가에 걸리는구나.\\n네번째. 거북은 아홉번 멈추고,父는 그위에 서리로다.\\n다섯째. 동쪽에서 온 손님은 \\\"술\\\"을 싫어하며 두 발위에 서리로다.\\n여섯째. 일곱의 학은 검은띠를 가졌으며,아홉의 범은 일곱띠를 가졌으니 용서하리로다.\",\"457\":\"첫번째. 三의 오렌지위에 수박이 존재하며 \\\"세움\\\"의 해답을 찾을지로다.\\n두번째. 생명의 門은 王과 門의 중용에서 만나는구나.\\n세번째. 뜨거움으로 펴고 물로 식히니 인간의 모습이구나.\\n네번째. 별은 손님으로 찾아오며,우물로 인도하는구나.\\n다섯째. 안경속에 존재하는 코뿔소는 태양의노예로다.\\n여섯째. 연필을 눌러 부러지면 안되며,가장 강함으로 남을지로다.\",\"458\":\"첫번째. 북쪽에서 온 사자를 환영하는 신비한 문이로다.\\n두번째. 컵속에 들어간 강아지는 파티에 초대될지로다.\\n세번째. 폭포에서 온 천사는 十으로 부서져야 보이는구나.\\n네번째. 집에서 잠을 자는 노인은 셋이며,그중 가장 평화로운 노인이로다.\\n다섯째. 노예와 주인은 함께 배를 타며,열명의 노예속에 강함을 가진 한명의 노예가 주인앞에 서리로다.\\n여섯째. 풍선과 옷을 모두 선물받고,水와 木사이에 갇히리로다.\",\"459\":\"첫번째. 火 를 막는방법은 우측으로부터의 \\\"E\\\"를 가진 방패로다.\\n두번째. 바다를 건너 \\\"不\\\"를 세움은 그 존재를 입증하려는 시도로다.\\n세번째. 동시에 깃발을 세워 네명의 식탁을 공평하게 하리로다.\\n네번째. 맹인은 자신의 개를 나무라며 기어이 혼자 그 길을 가려하는구나.\\n다섯째. 석탑은 사랑을 포함하며,거울과 빗과 양심을 가졌구나.\\n여섯째. 창가의 불빛을 시작으로 한정거장 앞에서 내려야 번개를 피할수 있구나.\",\"460\":\"첫번째. 가장 먼곳이 가장 가까움이 되는곳을 찾아 첫번째에 서리로다.\\n두번째.目과 月의 공통은 땅과 가장 먼곳에서 그 해답을 찾을지로다.\\n세번째.九月에 존재하는 행복의숲은 호박과 메밀밭사이에 존재하리로다.\\n네번째. 용의 옷을 찾아서 나무뒤에 숨겨야 행운을 얻을수가 있구나.\\n다섯째. 세번째 다리를 건너 태양의 불빛과 가장 먼곳에서 시작되리로다.\\n여섯째. 다이아몬드는 사막과 노예와 뱀을 지나 마지막에 취하리로다.\",\"461\":\"첫번째. 한날 한시에 태어난 수저는 앞뒤가 바뀌어 존재하는구나.\\n두번째. 솔방울을 떨어뜨려 연못위에 뜰때 행운이 찾아오리로다.\\n세번째. 品 과 三 이 더할때 열매는 추락하리로다.\\n네번째. 쓰러져 그늘에 감춰지며,새벽에 일어나 태양을 향하는구나.\\n다섯째. 東의 교차로는 트럭를 방해하며,소나무앞에 서리로다.\\n여섯째. \\\"오리\\\"는 사과를 먹으며 사과에 그 흔적을 남기는구나.\",\"462\":\"첫번째. \\\"산의 휴식\\\"속에는\\\"더함\\\"이 존재하니 신비로운 수로구나.\\n두번째. 진실의 눈물을 흘려 찻잔에 담길것이니,그중에서 \\\"효도의 찻잔\\\"을 찾을지로다.\\n세번째. 인간세속의 情속에만 존재하는 \\\"후회의 사라짐\\\"이로다.\\n네번째. 태양을 가진 산삼을 찾아서 바다로 향할지로다.\\n다섯째. \\\"발이 머리에 존재하는 새\\\"를 찾아야 \\\"포수의총\\\"으로 부터 살아남으리로다.\\n여섯째. 심장은 거울에 비추어지고 오른쪽으로부터 사라져 차가움만 기억되리로다.\",\"463\":\"첫번째. 하나의 승리를 가진 三 에 태양은 사라지는구나.\\n두번째. 죽음이 사라진 友 는 비를 피하며,산에서 행운을 얻을지로다.\\n세번째. 돌하루방의 사라진 심장이 바로 보물이로다.\\n네번째. 앞선 꿀벌은 노란 책으로 덮으며,뒤따라온 벌이 \\\"여왕\\\"이 되는구나.\\n다섯째. 전화벨이 네번 울리면 두개의탁자와 시계가 사라지리로다.\\n여섯째. 북쪽에 핀 무궁화는 움직이며 목적지는 뜨거운 온천이로구나.\",\"464\":\"첫번째. 門에는 窓이 五이며,들어가 우측에 단한명의 아이가 앉아있으니 행운의 자리로구나.\\n두번째. 돌이 물위에 세워질때,꺼꾸로 된 마법사를 찾을지로다.\\n세번째. 11월에 태어난 아기는 二를 더하며,뱀을 피할지로다.\\n네번째. 火속에 갇힌 木은 三의 절벽을 지나 그대로 멈추는구나.\\n다섯째. 흰수염고래는 땅에서 해적의 깃발을 세우리로다.\\n여섯째. 호랑이를 탄 12월의 노인은 행복의 선물을 숨겼구나.\",\"465\":\"첫번째. \\\"원\\\"속에는 일년이 살아있으니,月을 쳐다볼때 가장 밑바닥에 남으리로다.\\n두번째. 한개의 뿔을 가진 기린의 목에는 생명의 반지가 걸렸구나.\\n세번째. 구렁이는 돼지를 감아서 나무와 친구가 되리로다.\\n네번째. 마음과 귀와 눈을 닫을때 하나로 보이는 거울이로구나.\\n다섯째. 거미의 함정으로부터 방패는 다리가 되리로다.\\n여섯째. 東 과 西 는 부딛혀 계곡위로 일어서리로다.\",\"466\":\"첫번째. 川과 中을 더하니,천하대장군이 태어나는구나.\\n두번째. 원숭이는 셋이며,수갑에 묶여 하늘을 바라보는구나.\\n세번째. 力과 力은 바위위에 서며,田은 그 그림자가 되는구나.\\n네번째. 8月의 호박은 잘려야지만 행운이로다.\\n다섯째. 사과를 흰천에 쌓으리니,이는 곧 王위에 서리로다.\\n여섯째. 검은책상위에 독수리의 발톱이 남을지로다.\",\"467\":\"첫번째. 十의 교차로위에는 붉은車와 녹색車가 충돌하는구나.\\n두번째. 허수아비는 목도리를 잊지말아야 하며,새벽에 쓰러지는구나.\\n세번째. 벽돌아래에 존재하는 시계는 항아리곁으로 세걸음 움직일지로다.\\n네번째. 황금부채는 오른쪽에 있으며,물동이는 왼쪽에 존재하니 正 이로다.\\n다섯째. 세번의 번개를 맞고 지팡이는 세방향을 가리칠것이니 山과 가까운곳에 멈출지로다.\\n여섯째. 두번째 손님은 막걸리를 원하며,취할때 서있는 자리로다.\",\"468\":\"첫번째. 검은풍선은 구름에 걸리니 동쪽의 스님이로다.\\n두번째. 오리는 사냥개에 잡히고,사냥개는 사자에게 잡히리로다.\\n세번째. 태양의신은 피라미드위에서 正을 가진 그늘을 만드는구나.\\n네번째. 행운을 가진 비행체는 山과 月사이에 존재하는구나.\\n다섯째. 비가 오면 번개는 五를 취하리로다.\\n여섯째. 심해의 \\\"目\\\"이 사라져야만 \\\"보물\\\"을 건져내리로다.\",\"469\":\"첫번째. \\\"국화꽃밭\\\" 에 숨겨져 있는 얼룩말을 찾을지로다.\\n두번째. \\\"金\\\"을 가진 기사와 함께 田 앞에 서는구나.\\n세번째. 바다를 모두 담는 그릇에 \\\"딸기\\\"의 존재로다.\\n네번째. 기차는 서울로 향하며,세명의 신사를 만날때 멈추리로다.\\n다섯째. 호박은 불에 타며 그 연기는 북쪽으로 향하리로다.\\n여섯째. 거짓을 가진 꽃은 善을 향한 선물이 되리로다.\",\"470\":\"첫번째. 사람위에 열쇠는 처음으로 이동하는 방법이로다.\\n두번째. 항아리속에 향내가 없슴이 곧 \\\"보물\\\"이며 슬픔에 잠긴 여왕을 기쁘게 하리로다.\\n세번째. 검은콩과 녹색콩의 조화는 正 이 되는구나.\\n네번째. 종이 울릴때 돌아가며 선을 통과할때만이 승리하리로다.\\n다섯째. 물개와 조개의 공통은 새로운 생명이 되는구나.\\n여섯째. 國 속에 숨어 있는 천사의 악기로다.\",\"471\":\"첫번째. N 과 X 사이에는 행운의 존재가 나타나리로다.\\n두번째. 감나무 아래에 물이 흐르니 세월의 증표로구나.\\n세번째. \\\"별속의 비밀\\\"은 배를 탄 노인의 삿갓에 있구나.\\n네번째. 독수리의 먹이는 가장 빛나는 月 아래에 존재하는구나.\\n다섯째. 금으로 만든 그물은 황금지갑을 건져내리로다.\\n여섯째. 접시위에 포도는 \\\"백곰\\\"의 식사가 되리로다.\",\"472\":\"첫번째.\\\"月\\\"속에 남겨진 여왕의 발자국을 찾을지로다.\\n두번째. 東은 역행하여 九로부터 가장 무거운것을 남기는구나.\\n세번째. 검은뱀과 흰뱀은 한쌍이며 갈증속에 수박이 그 먹이가 되리로다.\\n네번째. 젓가락은 번개에 맞아 초록불에 녹을지로다.\\n다섯째. 요리사는 세번의 기회를 얻어 王의 반지를 돌려받을지로다.\\n여섯째. 사과는 엄지위에 존재하리로다.\",\"473\":\"첫번째. 행운은 제주도의 石 으로 부터 시작되는구나.\\n두번째. 짚신의 짝과 아파트의 짝은 하나가 되리로다.\\n세번째. \\\"봄\\\"의 뒤집힘은 의미가 생기니\\\"상생락\\\"이로다.\\n네번째. 절벽위에 바람은 \\\"거울방패\\\"로 막으리로다.\\n다섯째. 고양이는 안경을 쓰고,호랑이는 모자를 쓰는구나.\\n여섯째. 두번의 박수속에 붉은지붕은 무너지고 얼음속에 갇히리로다.\",\"474\":\"첫번째. 남자는 스키를 타러 산정상으로 오르니 풍월이로다.\\n두번째. 소방차는 뒤집혀 불사조를 잡는구나.\\n세번째. 금메달위에 푸른수정은 미래로 가는 구슬이로다.\\n네번째. 불과 불 사이에 존재하는 사막이로다.\\n다섯째. 흰색과 붉은색은 서로 형제며 두개의 무덤을 함께 쓰는구나.\\n여섯째. 야구와 농구의 공통이며 한 운동장에는 두개의 압정이 박히리로다.\",\"475\":\"첫번째. 행복을 주는 열매는 서풍을 맞아 떨어지리로다.\\n두번째. 동대문을 열고 나오는 장수는 태양그늘속에 숨는구나.\\n세번째. 인생을 훔친 곰은 함정에 빠져 비밀의문으로 나오리로다.\\n네번째. 二月은 몸통이며,어깨위에 손은 \\\"천사의 손\\\" 이구나.\\n다섯째. 4는 우측으로 쓰러져 춤을 추는 오리의 짝을 찾으리로다.\\n여섯째. 검은 흑구름은 지평선에 걸리며 붉은 회오리만 남기리로다.\",\"476\":\"첫번째. 행운을 가진 박쥐는 주전자속에 갇히는구나.\\n두번째. 강위에는 통나무가 세개씩 놓이며,노인은 그 통나무위에 서있구나.\\n세번째. 오렌지를 먹은 닭은 태양을 품으리로다.\\n네번째. 황금으로 만든 레몬트리뒤에서 약속의 선물을 받을지로다.\\n다섯째. 팔월의 지진은 T 와 ㅗ 가운데에 존재하리로다.\\n여섯째. 에스키모와 인디언의 만남속에서 水를 더하니 잃어버린 열쇠를 찾을지로다.\",\"477\":\"첫번째. \\\"北\\\"속에는 성냥이 네개요,바둑돌이 세개이니 남은것은 행복이구나.\\n두번째. 전쟁에서 마지막에 살아서 오는 원숭이는 \\\"金\\\"을 얻으리로다.\\n세번째. 반을 접은 종이는 동쪽바다의 \\\"海風\\\"을 막으리로다.\\n네번째. 공주를 안고 왕자를 밀어 운명의 계단을 찾을지로다.\\n다섯째. 세탁소에서 존재하는 \\\"활\\\"을 찾을때 그 의미가 생기는구나.\\n여섯째. 十을 건너뛰고 단 한번으로 소원을 이루려고 하면,주인은 남서쪽으로 가야 함이로다.\",\"478\":\"첫번째. \\\"붉은 도마뱀\\\"을 잡아서 宇 속에 담을지로다.\\n두번째. 작은집위에 심어진 사과나무는 폭풍우가 사라질때 그 생명이 나올지로다.\\n세번째. 금성위에 존재하는 여우는 明 의 이름을 가질지로다.\\n네번째. 씨름판은 자신이 가진 자전거의 안식처가 되는구나.\\nHOLD — 원자료상 해당 문장 식별 불가\\n여섯째. 시장의 상인은 엽전 다섯개를 땅에 묻을지로다.\",\"479\":\"첫번째. 거미줄에 걸린 축구공은 밤이 지나야 떨어지는구나.\\n두번째. 해바라기는 바다를 바라보니 행복하구나.\\n세번째. 부채는 땅위에서 세번째 밤을 담을지로다.\\n네번째. 남대문과 동대문은 폭우속에서 단하나로 태어나리로다.\\nHOLD — 원자료상 중복후보 존재\\n여섯째. 두개의 보물은 양반과 상민의 차지가 되리로다.\",\"480\":\"첫번째. 전봇대는 하나요 그림자는 두개이니 이상하구나.\\n두번째. 붉은색을 가진 나무는 호랑이의 등을 장식하리로다.\\n세번째. 신발이 사라져 땅의 만남은 달라지는구나.\\n네번째. 곡괭이의 끝은 네모이나 땅에는 날카로움이 살아있으리로다.\\n다섯째. 땅위에는 승리가 서며,감싼것은 S 이니 경이롭구나.\\n여섯째. 水를 만나니 紅이 되며 火를 만나니 水가 되는구나.\",\"481\":\"첫번째. 경찰은 서있으며,도둑은 앉아있으니 안정이로다.\\n두번째. 붉은방석은 죽음이되며,주황방석위에 오리가 앉아있구나.\\n세번째. 네모가 둘이요,거짓이 그속에 들어갈것이니 진실만이 나타날지로다.\\n네번째. 네개의 손이 모여서 물을 담아 金을 만드는구나.\\n다섯째. 쌍둥이는 上이 가려져,완전과 불완전의 받침대가 되리로다.\\n여섯째. 달이 높은날 세번째에 열린 쓰레기통에는 보물의 존재가 숨어 있구나.\",\"482\":\"첫번째. 전쟁을 담은 구슬은 바다속에 존재하는 龍의 口속에 있도다.\\n두번째. 回 와 十 을 더하니 행운의 수로다.\\n세번째. 뉴욕의빵집은 門 앞에 붉은표시가 나타나리로다.\\n네번째. 점퍼를 입은 한남자는 검은 안경과 검은 넥타이를 착용하리로다.\\n다섯째. 가장 높은 산이 二요,쌀이 두포대이니 가장 큰부자로구나.\\n여섯째. 쵸코렛을 담은 바구니는 한강위에 존재하리로다.\",\"483\":\"첫번째. 갑옷속에서 태어난 나비는 남쪽바람을 타고 그 끝에 도착하리로다.\\n두번째. 양파는 반으로 잘려 불에 탄 나무위에 붙어 있구나.\\n세번째. 三國의 中에는 비밀의 통로가 있으며 황금문을 선택할지로다.\\n네번째. 포도는 白이며 사과도 白이니 풍월이로다.\\n다섯째. 가장 긴수염을 가진 동상은 광대를 바라보는구나.\\n여섯째. 태풍은 파도를 세번 넘어 어둠의 고래를 깨우리로다.\",\"484\":\"첫번째. 목탁속에 313번의 소리가 하나로 갇히리로다.\\n두번째. 八月의 물은 쉽게 떠나보내니 삼일후에 황금과 불이 함께 찾아오는구나.\\n세번째. 뒤에오는 車는 앞으로 오는 音 아래에 도착하리로다.\\n네번째. 거울은 하나요,소리도 하나이니 귓속에 들리는 소리는 눈을 보고 이야기해야만 들리는구나.\\n다섯째. 현실에서의 \\\"도착\\\"은 \\\"시작\\\"으로 부터 세번 건너야 생명을 살릴수 있구나.\\n여섯째. 傘 은 비를 피하고 두사람이 존재하리로다.\",\"485\":\"첫번째. \\\"가\\\"\\\"다\\\"를 반복하여 이어지며, 木에 닿을때 행운의 꽃을 피우리로다.\\n두번째. 비밀의 종이컵은 五이며,이중 물이 두개가 담겨져 있으니 목화씨로 찾을지로다.\\n세번째. 동전을 던져 세움이 있는 자리에 배움의 존재가 생기는구나.\\n네번째. 낙타는 가을속에 사라진 빛을 찾아서 동쪽으로 이동하리로다.\\n다섯째. 다섯개의 알은 세개의 탑과 네개의 상자속에 각각 담기리로다.\\n여섯째. 선함은 악함을 이겨내니 그것을 깨달을때만이 행복한 자전거가 보일지로다.\",\"486\":\"첫번째. 東海의 황금고등어를 찾아 천사의 낚시로 잡을지로다.\\n두번째. 세개의 널빤지는 놓여 있으니 가장 큰 널빤지에는 깃발이 꽂히리로다.\\n세번째. 거북의 등에는 石 이 세번 새겨지는구나.\\n네번째. 王 은 \\\"섬\\\"을 등지고 도도새는 그 \\\"섬\\\"을 찾으리로다.\\n다섯째. 나비는 K 위에 앉아 행운을 알려주는구나.\\n여섯째. \\\"말\\\"과 \\\"오리\\\"와 \\\"사람\\\"이 모두 함께 존재하는 목조를 반드시 찾아야,그 의미의 마지막을 알수있구나.\",\"487\":\"첫번째. 뜨거운 태양아래 八月 의 이사는 가장 차가운날이 될지로다.\\n두번째. 일곱의 흰색 찻잔에 두개의 별이 떠오를때 행운이 찾아오리로다.\\n세번째. 붉은색 전화기는 七 이요, 이중에서 다섯번째 전화기가 울리는구나.\\n네번째. 곰인형을 가진 아이는 가장 큰 문앞에 설지로다.\\n다섯째. 남쪽으로 간 무지개는 지구를 돌아 가장 늦은 시간앞에서 멈추리로다.\\n여섯째. 인간세속에서 \\\"노인\\\"의 순수한 눈으로 볼수있는 가장 필요한 \\\"보물\\\" 이로다.\",\"488\":\"첫번째. 남쪽방향에는 전봇대가 하나 있으니 그위에 月 의 걸침이 있으리로다.\\n두번째. 좌측으로 향하는 고래는 세상을 가득메우고 첫숨을 쉴때 그 행운이 따라가리로다.\\n세번째. 새는 머리위에 앉으며,두 다리는 지구위에 존재하리로다.\\n네번째. 100년의 나이를 가진 거북은 인간을 태우고 무인도로 향하는구나.\\n다섯째. \\\"진실\\\"은 초록옷을 입은 두명의 인간에게 있으며 불을 태워 상승하리로다.\\nHOLD — 원자료상 해당 문장 식별 불가\",\"489\":\"첫번째. 역행의 風은 붉은하늘과 초록땅의 가운데에 존재하리로다.\\n두번째. \\\"중절모\\\"속에 들어있는 토끼는 九 이며 黑手가 잡으리로다.\\n세번째. \\\"집\\\"에는 사냥꾼이 숨어있으니 흰곰은 하늘을 보고 누울지로다.\\n네번째. 작은집이 十이요 큰집이 百 이니 큰집위에 작은집이 놓일지로다.\\n다섯째. \\\"은하수\\\" 아래에는 가장 빛나는 북두칠성이 존재하니 이중 두개의 생명선을 찾을지로다.\\nHOLD — 원자료상 중복후보 존재\",\"490\":\"첫번째. 손은 달콤함을 가지며,이동하며 꽃밭에 머물지로다.\\n두번째. 금요일에 태어난 흰고래는\\\"인간\\\"이 볼수 없는 고래로다.\\n세번째. 서쪽에 七을 새긴 황금계단은 \\\"흑용\\\"이 지키고 있을지로다.\\n네번째. 부모의 마음속에 담을수 있는 가장 소중함을 찾을지로다.\\n다섯째. 세개의 손가락에는 \\\"다름\\\"이 존재하며,그 \\\"다름\\\"과 다른 손님을 찾고있구나.\\n여섯째. 동그라미에서 태어난 사각은 하늘을 날지 못하는구나.\",\"491\":\"첫번째. 번개와 비를 모두 피한 해바라기는 새벽에 자라나리로다.\\n두번째. 악어를 잡은 하마는 또다른 黑사냥꾼의 표적이 될지로다.\\n세번째. 왕거미의 초대장은 땅개미의 행운이 될지로다.\\n네번째. 행복과 웃음을 담은 老人의 막걸리가 존재하는구나.\\n다섯째. 우산을 피하니 책이 나옴이요,그 책속에는 手 가 존재하는구나.\\n여섯째. 흑인과 백인은 한배에 타고 있슴이니 가장 좋은 옷을 걸치리로다.\",\"492\":\"첫번째. 가장 큰 나무를 만들어줄수 있는 가장 작은 나무로구나.\\n두번째. 피사의사탑에 존재하는 첫번째의 보물을 찾을지로다.\\n세번째. 木은 홀로서며 오른쪽가지는 가장 길게 자랄것이니 불에 타지 않는 나무로구나.\\n네번째. 장미를 가장 많이 가진 남자가 존재하며,여자 앞에서 향기를 잃어버릴지로다.\\n다섯째. 세개의 계단을 내려와 세마리의 비둘기가 존재하니 그중 한마리가 날아가는구나.\\n여섯째. 소는 휴식을 취하며 붉은색 리본을 달고 있구나.\",\"493\":\"첫번째. 영국은 삼각과 사각의 틀에 존재하며,그 경계속에서 보물을 찾을수 있으리로다.\\n두번째. 가장 큰 나라와 가장 작은 나라의 공통점이로다.\\n세번째. 초록의 정사각형위에 뚜껑이 덮혀 있으니 그 남은 공간이로다.\\n네번째. 음악의 끝에는 세형제가 존재하리니,좌로는 쓰러짐이요 우로는 세움이며 가운데는 잠자리채로다.\\n다섯째. 황제의 밥상과 황후의 밥상이 나란히 있구나.\\n여섯째. 황금종은 세번울려 소나무의 가장 낮은 곳으로 떨어질지로다.\",\"494\":\"첫번째. 행복한 직업을 가진 검은고래가 나타나리로다.\\n두번째. 눈은 즐거우나 시간의 흐름은 3시간씩 끊기는구나.\\n세번째. 별이 여섯개요 달이 세개가 겹치는 하늘이구나.\\n네번째. 폭우가 오는날에는 초록색의 장화가 반드시 필요하구나.\\n다섯째. 폭풍이 그치니 쌀가마니를 모두 버리고 빈배만 떠나리로다.\\n여섯째. 대나무 아래의 달콤한 키스는 병사의 행운이 되리로다.\",\"495\":\"첫번째. 가장 중요한 손님의 주소는 가장 처음에 나타나리로다.\\n두번째. 사내는 머리를 쓰며 다리로 행운을 가질것이니로다.\\n세번째. 북쪽의 스케이트는 동자의 장난감이로구나.\\n네번째. 행운을 가진 거울을 살펴보니 반이 사라짐이요 반은 남을지로다.\\n다섯째. 正 은 아래로 두개 더 하며 위로는 셋을 더하는구나.\\n여섯째. H 와 T 는 형제이니 각각 그 부모를 찾을지로다.\",\"496\":\"첫번째. 사각의 틀속에는 三人 의 존재가 있지만, 손가락은 모두 합해 十 인 이유가 있을지로다.\\n두번째. 박수를 치는 광대는 관객석에 있고 관객들이 무대에 존재하니 이상한 풍경이로다.\\n세번째. 새로운 눈을 더하면 우주가 될지로니 연결된 통로를 찾을지로다.\\n네번째. 비가 올때는 집에서 나오며 비가 그치니 집으로 들어가는구나.\\n다섯째. 모자아래에는 감옥이며 그 감옥속에는 토끼가 갇혀있구나.\\n여섯째. 왼쪽에는 目 이며 오른쪽에는 시간을 거슬러 올라감이로다.\",\"497\":\"첫번째. 한국에 존재하는 가장 큰 물체로구나.\\n두번째. 필리핀에서 온 금빛사과는 행운의 선물이로다.\\n세번째. 한강에 두개의 분수가 존재하며 그 두개를 이어 하나의 사랑을 만들수 있구나.\\n네번째. 비가 오는날 평범함이 아닌 특별함으로 우산을 펼쳐 볼지로다.\\n다섯째. 세개의 심장과 하나의 달팽이와 두개의 구두주걱으로 만들어진 행복이로다.\\n여섯째. 무대에서 가장 말을 많이 하는 사람을 찾아 휴식을 취하게 하리로다.\",\"498\":\"첫번째. 첫사랑과 다섯번째 사랑과 일곱번째 사랑의 공통점은 하나로다.\\n두번째. 약속은 다섯명이 하리니 세명은 善 이요, 두명은 惡 이로다.\\n세번째. 나무의자 위에 놓인 신문은 영원히 햇빛이 들지 않을지로다.\\n네번째. 부모님의 세번째 가장 큰 보물이로다.\\n다섯째. 風을 잡는 나그네는 그 안에서 \\\"달\\\"도 함께 잡을 지로다.\\n여섯째. 구름은 두개가 떠 있으며 그 아래에는 산이 하나요 오른쪽에 강아지가 짖는구나.\",\"499\":\"첫번째. 오이밭 위에는 사과셋이 존재하며,이중에서 황금사과를 찾을지로다.\\n두번째. 거북의 등에는 호박이 존재하며,호박을 취한 노인의 나이는 13으로 돌아갈지로다.\\n세번째. 수박을 五 로 쪼개며, 모자쓴 아이들의 각각의 차지로다.\\n네번째. 짝이 다섯으로 맺어지니 네개의 장미는 시간과 공간으로 각각 한번씩 다시 만나리로다.\\n다섯째. 붓은 행운의 열쇠를 그려내며,불에 절대 타지 않을지로다.\\n여섯째. 보이지 않는것을 만나야 하며,\\\"그것\\\"은 모든것을 사라지게 만들지로다.\",\"500\":\"첫번째. 다섯개의 대문은 존재하며,그림자가 사라진 대문을 찾을지로다.\\n두번째. 기쁨의 여인은 왕관을 감추고,가장 큰 소나무뒤에 숨을지로다.\\n세번째. 비행체는 추락하여 바닷속에 잠기며,다섯개의 빛을 모두 담을지로다.\\n네번째. 종이는 벽을 뚫고 칼날은 종이를 자를수가 없구나.\\n다섯째. 행복은 이 시간에서 의미를 가지고 있으니,주머니에 담는 방법이 있을지로다.\\n여섯째. 태어난 오리의 부모는 \\\"접란\\\" 이구나.\",\"501\":\"첫번째. 식탁과 은수저와 거북이는 서로 마주보며, 같은것은 모두 사라지고 하나만 남을지로다.\\n두번째. 王 과의 약속을 지키는 병사는 모두 아홉이며 이중 세번째 병사로다.\\n세번째. 거울이 필요없는 세상과 우산이 필요없는 세상은 모두 같은 세상이로다.\\n네번째. 사막에서 꿈을 담을수 있는 황금 항아리를 찾을지로다.\\n다섯째. 황소는 세사람의 주인이 생기며 세번째 음식만 먹을지로다.\\n여섯째. 공은 굴러 절벽에서 떨어지며,물이 닿을때 새로운 의미가 존재하리로다.\",\"502\":\"첫번째. 태양을 담을수 있는 방법은 세워진 \\\"돌\\\"에 있구나.\\n두번째. 황금빌딩은 녹색정원으로 둘러싸여져 있으며 불과 물이 반드시 필요하구나.\\n세번째. 다리가 여섯인 동물은 검은색옷을 입으리로다.\\n네번째. 오렌지색 항아리는 사각깃발에 새겨지는구나.\\n다섯째. 한국과 영국과 스페인은 공통점이 있으리로다.\\n여섯째. 양의 마음은 구름속에 파묻혀 단하나로 존재하는구나.\",\"503\":\"첫번째. 비너스의 몸통은 피라미드 위에 존재하리로다.\\n두번째. 동쪽의손님은 아홉을 입고 열을 짊어지며 하나를 버리는구나.\\n세번째. \\\"걸어다니는 상어\\\"를 찾아 깃발위에 세우리로다.\\n네번째. 세상에는 七人이 존재하며,가장 먼곳에 위치하는 인간이구나.\\n다섯째. 녹색의열쇠는 가장 가까우면서 가장 멀며 가장 큰곳으로 가는 \\\"지름길\\\"이로다.\\n여섯째. 유리는 風을 만나 깨지며,방패는 창을 만나 뚫리니 이상하구나.\",\"504\":\"첫번째. 전쟁을 막을수 있는 도구는 비를 피하여 사용할지로다.\\n두번째. 고래는 九 이며,바다는 十二 이니 태양은 나타나리로다.\\n세번째. 足 을 가진 생명체는 다섯이 모여 열매를 맺는구나.\\n네번째. 나무의 \\\"후\\\"는 \\\"전\\\"보다 빠를지로다.\\n다섯째. 두개의 톱으로 하나의 나무를 벨지로니 두개의 글씨가 새겨지는구나.\\n여섯째. 세번을 건너띄어 젊음이요,다섯번을 건너띄어 늙음이니 인생이로구나.\",\"505\":\"첫번째. 화성이 태양을 일곱번 지나갈때 생기는 나무로다.\\n두번째. 금빛부채는 한강에 빠지며 행운은 그 시간에 찾아오리로다.\\n세번째. 우주의 중심을 찾아서 서쪽으로는 장미를 찾고 우측으로는 생명수를 찾을지로다.\\n네번째. 검은까마귀와 황금까마귀는 붉은색 양탄자위에 내려앉는구나.\\n다섯째. 젊어지는 연못을 찾아 발을 세번 담그니 노인의 소망이 이루어지리로다.\\n여섯째. 승리를 가진 目은 세개의 手를 위해 존재하는구나.\",\"506\":\"첫번째. 낚시대는 단하나요,금요일에 잡힌 고기는 고등어로다.\\n두번째. 요리사는 남산위에서 \\\"대나무\\\"를 준비하는구나.\\n세번째. 30센치의 세상에서의 장독대는 가장 큰 아들이 차지하리로다.\\n네번째. \\\"북어\\\"와\\\"복어\\\"의 공통은 人間 과 통하리로다.\\n다섯째. \\\"원\\\"이 화성과 통할때\\\"사각\\\"의 의미가 생기리로다.\\n여섯째. 白 과 黑 을 가진 시계는 동굴속에 존재하리로다.\",\"507\":\"첫번째. 동쪽의 \\\"늙은곰\\\" 에게는 가을이 돌아오지 않을지로다.\\n두번째. 나무와 가죽의 만남이 곧 높은 점수가 되는구나.\\n세번째. 보물선은 벼랑으로부터 추락할지니 곧\\\"자아\\\"로다.\\n네번째. 백합은 구름위에 존재하며 어울리는 음악은 곧 멈출지로다.\\n다섯째. 파란 피아노는 얼음속에 갇혀 있구나.\\n여섯째. 하루는 겨울전에 멈추며 삼일은 여름전에 멈추리로다.\",\"508\":\"첫번째. 전쟁의신은 구름의신 앞에서 방패가 되리로다.\\n두번째. 보물은 五 이며 부엉이가 자리에 없을때 발견되리로다.\\n세번째. 잠수함은 바닷속에서 일곱의 나이를 가진 인어를 찾을지로다.\\n네번째. 사공은 고래를 건져내니 행운의 그물이구나.\\n다섯째. 푸른거위는 오렌지를 먹이로 삼을지로다.\\n여섯째. 다람쥐의 통로는 왕의 왕관속에 존재하리로다.\",\"509\":\"첫번째. 正이 세겨진 石은 바다위에 세워지리로다.\\n두번째. 무인도에 가장 먼저 도착한 인간이 가장 필요한것이로구나.\\n세번째. 다섯개의 별과 일곱개의 별은 전쟁의 별이 되리로다.\\n네번째. 포도로 술을 만드니 아홉개의 잔을 모두 채우리로다.\\n다섯째. 손에든 전구는 비가올때 깨어지리로다.\\n여섯째. 주먹은 가장 높은곳에 오를때 가장 낮아지로다.\",\"510\":\"첫번째. 서울 하늘아래에 붉은소나무로다.\\n두번째. 곰취는 밤나무속에서 겨울잠을 자는구나.\\n세번째. 바람은 바닷속에서 불어오니 세상은 조용하구나.\\n네번째. 흰쌀을 가진 노인은 북쪽에 태양이로다.\\n다섯째. 9월의 별을 가진 사냥꾼은 마법의 창을 손에 넣을지로다.\\n여섯째. 손은 열이요,발도 열이니 자유를 상징하는축제가 되는구나.\",\"511\":\"첫번째. 태양을 여섯가진 나무는 땅에서 태어나리로다.\\n두번째. 바위는 열개의 손가락을 마주하고 세개의손가락을 부딛히리로다.\\n세번째. 잠을 잘때 사라지며,일어날때 사라지리니 세상에는 꿈이 존재하지 않는구나.\\n네번째. 세개의 낙엽과 두개의 꽃잎을 모두 구해야 행운의 짝이 이루어지리로다.\\n다섯째. 선은 P로 돌아가며,누울때 그대로 멈추리로다.\\n여섯째. 바구니와 그속에 존재하는 와인은 여인을 춤추게 하리로다.\",\"512\":\"첫번째. 바나나는 화를 다스리는 물건과 만나리로다.\\n두번째. 거북이는 금색옷을 입고 두루미는 은색옷을 입었구나.\\n세번째. 여든여덟번째 만들어진 옷감은 천사의 옷이 되리로다.\\n네번째. 겨울에 만들어진 신발을 신고 바람을 타리로다.\\n다섯째. 주인은 걸으며 손님은 뛰어가니 둘이 만나는 지점이구나.\\n여섯째. 三 의 동굴은 마지막구름속에 존재하리로다.\",\"513\":\"첫번째. 가장 높은곳에서 가장 믿었던 人은 바로 \\\"함정\\\" 이로다.\\n두번째. 축하는 \\\"별\\\"이 하며, 슬픔은 \\\"달\\\"이 하는구나.\\nHOLD — 원자료상 해당 문장 식별 불가\\n네번째. 여덟개의 손가락은 짝이 되어 두개의 반지를 만나는구나.\\n다섯째. 계단은 善의 계단이며,그중 빛이 없는 계단을 선택하여 내려오는구나.\\n여섯째. 붉은모자는 의자위에 존재하며 비와 바람을 맞으리로다.\",\"514\":\"첫번째. 겨울고구마는 무거운 바위위에 존재하는구나.\\n두번째. 다람쥐의 집을 찾아 가장 첫번째 먹이을 찾을지로다.\\n세번째. 별을 훔쳐간 사람을 찾을지니 인간의 실수로구나.\\n네번째. 인간의 욕심을 가장 많이 담을수 있는 그릇이로다.\\n다섯째. 가장 큰 수박을 찾을때 인간의 고향은 함께하리로다.\\n여섯째. 복제하여 자신을 세우며, 가장 편안한 의자가 되리로다.\",\"515\":\"첫번째. S가 N을 만날때 장미의 전쟁이 시작되리로다.\\n두번째. 소풍은 태풍이 불때 떠나며 가장 안전한 소풍이 되리로다.\\n세번째. 비는 하루종일 내리며 새신부는 세번의 휴일을 맞으리로다.\\n네번째. 파동은 황금빛으로 빛나며 人은 바다밑에 새겨지리로다.\\n다섯째. 흰수염을 가진 노인을 찾아 가장 높은 바다에 오를지로다.\\n여섯째. 벽이 존재할때 뒤로 세번물러서야 하며,꽃이 함께할때 그 의미가 생기리로다.\",\"516\":\"첫번째. 石 과 水가 만나 天 위에 설지니 화합이구나.\\n두번째. 주먹을 이기는 방법은 맥주병속에서 꽃이 사라질때 가능할지로다.\\n세번째. 바다위에서 세번의 수영과 네번의 달리기를 통하여 진실이 밝혀지리로다.\\n네번째. 코끼리는 \\\"고래\\\"위에 존재하며,고양이는 \\\"범\\\"위에 존재하리로다.\\n다섯째. 행복의 순위는 \\\"별\\\"의 \\\"目\\\"을 가질때 차오를지로다.\\n여섯째. 헤어짐을 다섯배로 말하며 그중에서 가장 끝으로 가는구나.\",\"517\":\"첫번째. 날아가는 새의 부리는 두개의 선을 넘어 의미가 생기리로다.\\n두번째. 클로버는 정사각형의 틀안에 갇혀 초록의 반대 세상으로 나갈지로다.\\n세번째. 兄弟는 品의 上에 존재하여 그 곳에서 똑같이 나누어 가지는구나.\\n네번째. 진주는 생명의 나무에 걸려있으니 가장 큰 진주를 찾을지로다.\\n다섯째. 용의갑옷을 입고 태풍의눈으로 향할지니 전쟁의 신이 함께 하리로다.\\n여섯째. 보름뒤에 다섯개의 태양을 잃어버리고 일곱개의 태양을 찾을지로다.\",\"518\":\"첫번째. 세속에서의 \\\"그림의떡\\\"을 찾아야 함이로다.\\n두번째. 성냥을 가진 소녀는 \\\"화성\\\"에 남을지로다.\\n세번째. 12월의 신부는 태양의꽃을 가지며 五를 넘어서리로다.\\n네번째. 진실의장갑은 증표를 간직하며 目의 행복을 만나리로다.\\n다섯째. 비밀은 九의 오른쪽에 서며 진실은 三의 위로 오르리로다.\\n여섯째. 十二개의 도너츠로 사랑을 만들며 가장 낮은곳에서 가장 높은곳으로 오르리로다.\",\"519\":\"첫번째. 風을 二로 나누니 방법은 하나로구나.\\n두번째. 감자와 돌은 한 가마솥속에서 끓는구나.\\n세번째. 세번의 웃음과 네번의 슬픔을 가지고 일어서며 그 뒤에 오는 행운이로다.\\n네번째. 지하여장군은 겨울에 소중한 만남을 이루리로다.\\n다섯째. T 는 바지를 쫒고 바지는 고무신을 쫒는구나.\\n여섯째. 비가오는밤에는 흰색우산이 친구에게 반드시 필요할지로다.\",\"520\":\"첫번째. 正 과 井 의 공통을 찾아 木 을 빼리로다.\\n두번째. 十의 발들이 춤을 출지니 그중에서 가장 큰 발의 선택이로다.\\n세번째. 전쟁에서 패배한 병사는 日이 하늘에 오를때 백색의 깃발을 감추리로다.\\n네번째. \\\"선\\\" 다섯이 모여 사라질것이며,마지막날짜에 가장 큰 빛이 나타나리로다.\\n다섯째. \\\"삼각\\\"은 등을 보이지 않으며,\\\"사각\\\"은 등을 보이리로다.\\n여섯째. 무릎은 오른쪽으로 가며 손은 왼쪽으로 갈지니 이상하구나.\",\"521\":\"첫번째. 축복을 받는 아기의탄생은 쌍둥이 날짜와 함께 하리로다.\\n두번째. 사과나무는 七 위에 서며 화산은 그 七을 덮는구나.\\n세번째. 행복을 가지려면 긍정의 두손과 연필을 가져야 하는도다.\\n네번째. 우주선은 상승하며 가장 높은곳에서 금빛바다를 바라볼지로다.\\n다섯째. 보리싹은 포효하는 사자의 먹이가 될지로다.\\n여섯째. 쌍둥이 무지개를 가진 태양은 일곱개의 별을 지켜내리로다.\",\"522\":\"첫번째. 선녀와나무꾼 사이에는 감추어진 징표가 있구나.\\n두번째. 거울의 열쇠는 \\\"은솔\\\"이 그 비밀이로다.\\n세번째. 태평양을 사이에 두고 검은 활주로가 나타나는구나.\\n네번째. 행복한 해바라기는 부산의 꽃이로구나.\\n다섯째. 포도주를 담가 세번째 \\\"벗\\\"에게 선물로 주리로다.\\n여섯째. 불을 통과하는 남자가 존재할지니,공간의 주인이 될지로다.\",\"523\":\"첫번째. 행운의 전쟁은 \\\"사과\\\" 위에 존재하는구나.\\n두번째. 도마는 세개요 그위에 생선은 고등어로구나.\\n세번째. 나무로 만든 문이 다섯개가 있으며 그 앞에 두개의 고목나무가 서있구나.\\n네번째. 일곱번째 약속은 태양의 이름아래에 지켜지리로다.\\n다섯째. 지나간 시간은 의미가 없으며,해뜨는날의 3시에 징표가 나타나리로다.\\n여섯째. 행운의 눈이 내려 바다를 덮으리로다.\",\"524\":\"첫번째. 도미니카의 중심은 바로 \\\"전설\\\"이 되리로다.\\n두번째. \\\"허수아비\\\"위에 참새는 \\\"짝\\\"이며,그 위에는 독수리가 숨겨져 있구나.\\n세번째. 검은 바위위에 새겨진 글씨는 \\\"門\\\" 이로다.\\n네번째. 모든 사랑이 첫사랑이 될때 비밀의 문이 열릴지로다.\\n다섯째. 서울로 가는 기차는 \\\"七\\\"이 새겨져 있으며 \\\"東\\\" 으로 가는 기차로다.\\n여섯째. 金과 水와 金이 모이며,가장 큰 열매를 가져올것이로다.\",\"525\":\"첫번째. R 은 일곱개의황금기둥에 새겨지리로다.\\n두번째. 생명을 지키는 \\\"전사\\\"는 안경을 잃어버리는구나.\\n세번째. 車 로 問 을 지나가니 붉은열매를 얻을지로다.\\n네번째. 99개를 가진 남자는 1개를 가진 여자에게 승리에서 패하리로다.\\n다섯째. 검치호랑이는 태양이 가장 빛날때 사냥을 시작하리로다.\\n여섯째. 물을 이용하여 겨울과 여름을 나눌지로다.\",\"526\":\"첫번째. 콩을 구울수 있는것은 여든여덟번째의 성냥중 가장 높은 하나로구나.\\n두번째. 붉은색 자동차를 팔고 초록색 나무를 가져오리로다.\\n세번째. 바위가 막고,창은 부러지며,파도는 사라지는구나.\\n네번째. 선풍기는 겨울의 입구를 지키는구나.\\n다섯째. 카메라 눈은 十 의 눈을 가졌구나.\\n여섯째. 총을 가진 농부는 행운의 옥수수를 따가지고 가는구나.\",\"527\":\"첫번째. 태양을 등지고 하늘로 향하며 땅과는 상생의 친구가 되리로다.\\n두번째. 열림과 닫힘을 모두 가진 \\\"물건\\\"은 바로 행운이로구나.\\n세번째. 위로는 태극이 다섯개 모이니 겨울의 행운이로다.\\n네번째. 교차로를 세번지나 떨어지니 그 앞은 바위가 서 있구나.\\n다섯째. 비가 와도 쓰지 말아야 하리니,그 주인은 황금우산을 가져오리로다.\\n여섯째. 바다와 친구와 고래는 한배에 있으며,북극과 만나리로다.\",\"528\":\"첫번째. 세상에서 가장 공정한 \\\"저울\\\"을 가져와 나무와 돌을 올려놓았구나.\\n두번째. 가장 편안한 휴식을 찾을지니 세개의 모퉁이로 해를 가릴지로다.\\n세번째. \\\"하나\\\"와 \\\"셋\\\"과 \\\"하나\\\"는 모두 같은 모양이며 처음의 편안 공간이 답이로구나.\\n네번째. 입을 보고 눈을 생각하며.눈을 보고 거리를 걸을지니 바로 내 자신이 되는구나.\\n다섯째. 인간세속의 \\\"미숙함\\\"과\\\"완벽함\\\"이 존재하며 이 차이를 알아낼지로다.\\n여섯째. \\\"용\\\"은 항아리속으로 들어가며 백일을 품어야 비로소 \\\"행운\\\"이 나타나리로다.\",\"529\":\"첫번째. \\\"꿀벌\\\"은 검은 코끼리를 만나야 행운을 얻을지로다.\\n두번째. 슬픔의 악기를 연주할것이니, 三의 하프가 해답이로구나.\\n세번째. 진주는 피라미드의 우측에 존재하리로다.\\n네번째. 범을 쫒는 기사는 문앞에서 휴식이 필요하도다.\\n다섯째. 하늘로 향하는 배는 황금고리를 열어야 떠날수 있으리로다.\\n여섯째. 울지않는 소를 찾으니 인간의 복이로구나.\",\"530\":\"첫번째. 숲속의 연기로 사람을 만나며 이틀간 헤어져서는 안되리로다.\\n두번째. 보이지 않는 옷을 만드는 기구는 세상에서 단 하나로 존재하리로다.\\n세번째. 비밀의 정원에는 반드시 꽃과 물과 옷이 함께 존재하리로다.\\n네번째. \\\"아마존\\\"에 존재하는 황금대나무는 가장 높은곳에 존재하리로다.\\n다섯째. 노란색 장미꽃은 부채를 가진 물고기를 유혹하는 꽃이로다.\\n여섯째. 오렌지로 만든 거인을 만나리로다.\",\"531\":\"첫번째. 등산은 山 이 아닌 海 에서 할지니 이상하구나.\\n두번째. 88 과 井 의 사이에 존재하는 門 이로구나.\\n세번째. 그네를 가진 백만장자에게 가장 소중한것은 \\\"행운\\\"으로 다가오는구나.\\n네번째. 뱃머리에서 고등어를 낚으니,삼각의 중심에 서리로다.\\n다섯째. 우유를 먹는 아기의 모습이 비친 사과로구나.\\n여섯째. 황금태양과 검은모래알은 우물속에 함께 존재하리로다.\",\"532\":\"첫번째. 거북의 등에 있는 멧돼지는 행운의 열쇠로다.\\n두번째. 세가지 케익이 준비되며 초가 없는 케익을 선택하리로다.\\n세번째. 서쪽이 하늘이 되며 첫글자가 새겨질터이니 벗이 함께 하리로다.\\n네번째. 문에서 나온 거북은 안경을 쓰고 집으로 돌아가리로다.\\n다섯째. 十의 열쇠를 땅에 묻을때 열매를 만나리로다.\\n여섯째. 복주머니는 하나이며 새겨진 글씨는 꿈이로다.\",\"533\":\"첫번째. 감옥에 갇힌 원숭이에게는 나무가 꼭 필요하구나.\\n두번째. 겨울비가 사과가 되어 우산위에 떨어지는구나.\\n세번째. 하루의 삶과 백년의 삶을 동시에 담을수 있는 그릇이로다.\\n네번째. 나뭇잎 세개는 집과 하늘과 땅을 모두 가릴수 있구나.\\n다섯째. 걸음은 다섯걸음이요,붉음이 존재하며 이후에 휴식이로다.\\n여섯째. 자신과 함께 하는 \\\"가장 소중한 사람\\\"의 의미로구나.\",\"534\":\"첫번째. 노인은 홀로 안개의 섬을 따라 들어갈지니 오징어떼를 볼수있구나.\\n두번째. 겨울 난로속에 책과 연필은 가장 큰 의미를 가지리로다.\\n세번째. 山 이 F 를 넘을때 행운의 시간으로 다가오는구나.\\n네번째. 아이는 별을 다섯개 받고 금을 일곱개 줄때 동심의 해가 뜨는구나.\\n다섯째. 벽돌과 풍선은 깃발을 따라서 東 으로 이동하리로다.\\n여섯째. 종과 곰과 짐이 하나로 존재하니 신비하구나.\",\"535\":\"첫번째. 낙엽을 밟을때 자신의 발로부터 시작하여,도끼의끝에 서리로다.\\n두번째. \\\"전투\\\"의 의미는 삶의 경계선뒤에 숨겨져 있구나.\\n세번째. 사슴의뿔을 가지고 낚시를 할때 가장 멀리가는구나.\\n네번째. 호롱불을 만들어서 열집을 나누어주나 두집이 불을 꺼뜨리는구나.\\n다섯째. 금과 은은 한구덩이에 심어져 1년이 지난후에 새로운 꽃을 피우리로다.\\n여섯째. 일기를 쓴 소녀는 \\\"불로초\\\"를 얻을수 있을지로다.\",\"536\":\"첫번째. 오리는 반달속에 숨어 새로운 생명이 태어나리로다.\\n두번째. 하늘을 모두 덮는 보자기는 땅을 반으로 나누리로다.\\n세번째. 도끼는 가장 높은 나무위에 표시를 남기며 흰색은 모두 사라지는구나.\\n네번째. 두발을 넣고 세발을 뺄때 행복의 열매를 구하리로다.\\n다섯째. 길을 걸으니 햇빛아래에서 인간에게 가장 위험한 도구로구나.\\n여섯째. 소화기는 계단을 피해 떨어지며 두번째 만난 불을 사라지게 하리로다.\",\"537\":\"첫번째. 흰색의 門을 열어 행복과 웃음을 더하여 火가 되는구나.\\n두번째. 일곱개의 고드름은 땅위에 존재하며 동쪽에서 音 이 들리는구나.\\n세번째. 여덟개의 황금잔은 포도주로 채워지며 단 한잔만이 모래로 채워지는구나.\\n네번째. 오른쪽의 통로는 행운이요,막힌곳은 두개이니 이제 세워진 깃발은 영원히 없구나.\\n다섯째. 해바라기숲에 서 있는 황금버섯의 존재로구나.\\n여섯째. 바구니안에 신발은 태양과 가까운곳에 놓여있구나.\",\"538\":\"첫번째. 가장 살찐 오소리는 도망가지 못하고 거북이에게 잡히는구나.\\n두번째. 주사위를 세번굴려 가장 높은곳에 존재하는 압정을 보호하리로다.\\n세번째. 金의 존재를 알리는 종소리는 순리의 시간속에,태양을 등지고 바람을 맞으리로다.\\n네번째. 인생의 짐은 세개의 발자국을 남기며 그중 한개는 자신의 것이로구나.\\n다섯째. 오렌지색은 빛속에 존재하며 상투를 쓴 구경꾼을 데려올지로다.\\n여섯째. 네개의 공간속에 한개의 공간은 반이 되며,하나를 더할때 작아지리로다.\",\"539\":\"첫번째. \\\"전쟁\\\"은 풍선에 담겨 가장 높은 \\\"天\\\"으로 올라가리로다.\\n두번째. U 와 P 는 한가지의 공통점을 가지며,서쪽으로 향할지로다.\\n세번째. 작은 거북이를 태운 흰색코끼리는 얼룩말 뒤에 서리로다.\\n네번째. \\\"비밀의문\\\"속에는 태양의 사과가 존재하며 반으로 잘릴때 그 문이 열리는구나.\\n다섯째. 돼지는 곧 \\\"죽음\\\"이며,그 위에 十을 가진 방패만이 살길이구나.\\n여섯째. 삼형제가 사는 집에는 손님이 찾아들며,세번째 방문때 승리를 할수 있구나.\",\"540\":\"첫번째. \\\"정원\\\"속에 큰 빛이 존재하며,\\\"火\\\"는 태양을 삼키리로다.\\n두번째. 압정이 百 이요,중용의 문속에 남는 압정만이 행운의 열쇠가 되리로다.\\n세번째. \\\"날카로움\\\"은 바나나 껍질속에 쌓여 사라지는구나.\\n네번째. \\\"태백산\\\"에 사는 불곰은 박쥐를 쫒아 동굴속에 숨는구나.\\n다섯째. 인간세속에 존재하는 가장 \\\"가벼움\\\"과\\\"무거움\\\" 이로다.\\n여섯째. 스핑크스의 차가움을 찾고 피라미드의 뜨거움을 찾아야 행운이 보이는구나.\",\"541\":\"첫번째. 굴업도의 큰바위는 행운의 지도가 되는구나.\\n두번째. 캐논변주곡에는 산이 존재하니 가장 긴 산을 찾을지로다.\\n세번째. 겨울에 사라지면 여름에 다시 태어나고 여름에 태어나면 겨울에 다시 사라지는구나.\\n네번째. 동명왕릉의 전설은 노인이 아닌 어린이만 알수 있을지로다.\\n다섯째. 개를 피하여 돼지를 찾고,용을 피하여 범을 쫒으리니 한달이 필요하도다.\\n여섯째. 圖 의 비밀은 서쪽으로 한번 남쪽으로 세번 지나갈때 풀릴것이니로다.\",\"542\":\"첫번째. 도마뱀의 꼬리에 仁 이 새겨지는구나.\\n두번째. 봄 여름 가을 겨울과 山 의 공통점이로구나.\\n세번째. 낙엽에 숨겨진 기타는 金 이로구나.\\n네번째. 코끼리의 발에 사자의 머리를 가지며 흑인 세명이 그 앞을 막으리로다.\\n다섯째. 하늘에 존재하는 의자는 꺼꾸로 서리로다.\\n여섯째. 추락하여 가장 달콤한 열매를 찾으리니 火를 피하는구나.\",\"543\":\"첫번째. 주머니속에 케잌은 三 이 될때 녹지 않으리로다.\\n두번째. 항공모함은 \\\"진주\\\"를 담아서 동쪽으로 항해를 하리로다.\\n세번째. \\\"백학\\\"의 의미는 夢 에서 찾으리니 사라지는것은 白 이로구나.\\n네번째. 음악을 가지고 태양도 가지고도 그 뒤로 남는것은 밧줄 네개로다.\\n다섯째. 黑 을 가진 오리는 세번째 바위에 존재하여 友를 만나리로다.\\n여섯째. 포도주는 기차에 실려서 가장 차가운 북극으로 가는구나.\",\"544\":\"첫번째. 이름이 존재하는 가장 큰 구멍에 빠지리로다.\\n두번째. 5月 하고 이주뒤에 고래의 이름은 일곱개의 천사가 되는구나.\\n세번째. 바구니는 뫼비우스의 띠속에 갇히는구나.\\n네번째. 태양앞에서 손을 들면 어둡고 손을 내리면 밝아지는구나.\\n다섯째. 목이 긴 기린의 星을 찾아서 그 앞으로 八을 건너리로다.\\n여섯째. 포도와 오렌지를 실은 기차는 부산으로 향하리로다.\",\"545\":\"첫번째. 두 눈이 두번 마주치며,이루어질수 없는 사랑이 슬프도다.\\n두번째. 겨울의 차가움과 여름의 따뜻함이 만나 행복의 열매를 맺는구나.\\n세번째. 거북의 걸음은 느리지만 소중한 心 을 얻는것은 빠르구나.\\n네번째. 5月에는 축복의 기회가 찾아오리니 첫번째는 술을 거절하며,두번째는 말을 거절할지로다.\\n다섯째. 거울을 쳐다보며 더 나은 자아를 발견할때 들을수 있는 소리로구나.\\n여섯째. 세상과 소통할때 사용하는 꽃이로구나.\",\"546\":\"첫번째. 바다와 비행기와 배의 \\\"통함\\\"은 곧 \\\"운\\\"이 되리로다.\\n두번째. 동쪽으로 걸어가는 인간의 땅이 모두 \\\"바다\\\" 가 되리로다.\\n세번째. 기쁨과 슬픔을 가진 \\\"손\\\" 이 모두 함께 쥔 도구로다.\\n네번째. 왕을 뒤에 모시며 맨앞의 두개의 동굴을 찾아내면, 네번째 순서가 곧 답이로구나.\\n다섯째. 오렌지색 신발을 신은 여신을 찾아 그앞에서 \\\"왕관\\\"을 숨기리로다.\\n여섯째. 장마가 끝날때 보여지는 환상은 구름다리 위에 나타나리로다.\",\"547\":\"첫번째. 빵과 커피와 아이스크림과 우유를 모두 섞으면 단 한개만 남으리로다.\\n두번째. 치유가 필요한것은 마음이며 그 마음을 열 열쇠가 곧 치유가 되리로다.\\n세번째. 별을 모두 가진 부자는 아주 작은 시장에서 살고 있구나.\\n네번째. 세상에서 가장 편한 의자는 거인의 의자로다.\\n다섯째. 캐나다의 첫번째 보화를 찾으면 전봇대를 볼수 있으며 한사람이 살고 있구나.\\n여섯째. 제주도에는 가장 작은 별장이 있으며 그 집에는 아주 작은 사람이 존재하리로다.\",\"548\":\"첫번째. 세상의 가장 처음과 끝에서 볼수 있는 흑태풍 이로구나.\\n두번째. 망원경으로 본 별은 九 속에 갇혀 있으니 행운이로구나.\\n세번째. 山 이 사라지고 두개의 高 가 모여 그늘에 가리는구나.\\n네번째. 땅위에 땅이 존재하며 그 위에 덮힌 초록 땅의 주인이로다.\\n다섯째. 아침에 모여 세번의 모임을 가지며 모두 女子 로구나.\\n여섯째. 보라색 색연필을 구하여 생명의 유리를 보호하리로다.\",\"549\":\"첫번째. 거북선을 탄 장군의 이름은 별이 되는구나.\\n두번째. 두개를 잃고 두개를 얻어야 함이니 시간속에서 찾을지로다.\\n세번째. 더운 겨울에 추운 여름이 존재하며 노랑색 외투를 입었구나.\\n네번째. 다섯개의 火 를 적으며,가장 빨리 평화를 얻는 방법을 찾을지로다.\\n다섯째. 바다위에서 꼬마는 악기를 들고 있으며,돌 위에서는 흰색 모자를 쓰고 있구나.\\n여섯째. 江 위에 실과 바늘은 하나의 의미를 만드는구나.\",\"550\":\"첫번째. 컵속에 담긴 열쇠는 보이지 않는구나.\\n두번째. 산을 넘어 신발이 존재하며 그 신발을 가져와 돌위에 자리를 잡는구나.\\n세번째. 거북의 등에는 의자가 셋이요, 붓이 둘이구나.\\n네번째. 북쪽의 그림자는 열세번째 거울에 잡히는구나.\\n다섯째. 왼쪽시계를 찬 어린이는 붉은색 신발로 바꾸어 걸을지로다.\\n여섯째. 거짓은 열여덟번째 이루어지며,진실의 문은 M 을 볼때 이루어지는구나.\",\"551\":\"첫번째. 햇빛을 가린 허수아비는 口 앞에 존재하리로다.\\n두번째. 일곱개의 풍선속에 편지는 다섯이며 해골은 둘이로구나.\\n세번째. 妬 는 木 위에 서리로다.\\n네번째. 인간세속에서 子 의 가장 큰 후회와 기억이로구나.\\n다섯째. 오렌지 신발을 신은 소녀와 흰색 신발을 신은 소년의 만남이로다.\\n여섯째. 사람의 \\\"등\\\"을 양쪽에서 막고 있으니 그곳이 곧 길이 되리로다.\",\"552\":\"첫번째. 사과를 심어 十年이 지날때 사과나무 아래에서 빛이 나리로다.\\n두번째. 선행을 가진 소녀는 그네에서 약속을 지킬지로다.\\n세번째. 세상에서 거북을 만지지 말고 낙타를 소중히 여길지로다.\\n네번째. 컵을 가져온 일곱 아가씨는 태양을 얻을지로다.\\n다섯째. 천사들은 가족들과 함께 행복을 가져오며 그대신 기억을 잃는구나.\\n여섯째. 主人 은 인어를 만나야 행운을 얻을지로다.\",\"553\":\"첫번째. 서울을 향한 세명의 남자는 꽃과 나무와 우산을 들었구나.\\n두번째. 하늘아래에 산과 바다를 고치는 의사를 찾을지로다.\\n세번째. 태풍이 불어오니 코스모스는 자신으로부터 가장 먼 여행을 떠날지로다.\\n네번째. 열쇠는 냉장고속에 존재하며 큰아들이 주인이구나.\\n다섯째. 가장 아름다운 집을 가진 사람은 가장 많은 별을 가졌구나.\\n여섯째. 7월의 감자는 다섯이요,사람은 둘이로다.\",\"554\":\"첫번째. 호랑이는 원숭이의 함정을 피하며 황금잉어를 잡으리로다.\\n두번째. 태풍이 지나간 여름의 비는 가장 아름다운곳에서 맞아야만 행운이 올지로다.\\n세번째. 가장 큰 숫자는 리본을 묶어 매달수 있으며 집안에 존재하리로다.\\n네번째. 공원을 지나 뒷문으로 나올지니 보석이 달린 꽃을 취하리로다.\\n다섯째. 피라미드를 지나는 비행체는 十의 동쪽에 위치하며 木과 일치하리로다.\\n여섯째. 오리는 검은흙으로 목욕하며 태양으로부터 보호를 받으리로다.\",\"555\":\"첫번째. 달이 하나에 호수도 하나이니 행복이구나.\\n두번째. 토요일의 천사는 화요일에 꽃을 받으리로다.\\n세번째. 끝은 처음에 존재하며 삼각산이 그 아래에 보이리로다.\\n네번째. 물은 다섯모금이며,마지막 노인은 금을 취하는구나.\\n다섯째. 냉장고를 열어서 金山을 찾으리로다.\\n여섯째. 오후에 받은 열쇠는 아침에 들어갈수 있는 門 의 열쇠로구나.\",\"556\":\"첫번째. 벽돌은 가장 작은 구멍에 의해서 뚫리는구나.\\n두번째. 별과 거짓은 七의 바람이 알고 있구나.\\n세번째. 붉은코끼리와 행복하게 웃는 자연의 소리로구나.\\n네번째. 도토리는 연기를 피하며,도시는 유리에 가리는구나.\\n다섯째. 검은구름은 흰색종이에 쌓여져 새로운 문명이 되리로다.\\n여섯째. 피리부는 사람은 \\\"검은진주\\\"를 갖고 싶어하는구나.\",\"557\":\"첫번째. 행운은 바람소리와 함께 돌아오며 그곳에 해바라기가 피는구나.\\n두번째. 가위와 계란이 함께 하며 행복한 얼음이구나.\\n세번째. 동쪽에는 무지개빛 코끼리가 있고, 남쪽에는 東風이 부는구나.\\n네번째. 기억의 그네는 열일곱번 움직이며 마지막 멈출때 선택된 여인 이로구나.\\n다섯째. 포도는 아이의 손에 담겨져 금방울이 존재하리니,사랑의 가족이로다.\\n여섯째. 하나의 나팔과 다섯개의 북이 울리니 雨內人 이로다.\",\"558\":\"첫번째. 행운의福 은 두개의 비짜루와 한개의 열린주머니로 들어가리로다.\\n두번째. 十日의 행복은 \\\"검은 흑두루미의 날개\\\"로 시작되는구나.\\n세번째. 오리는 두개의 진주를 숨기며 잉어는 한개의 진주를 삼키는구나.\\n네번째. \\\"태양\\\"은 하늘과 땅과 그늘속의 진흙으로 만들어지는구나.\\n다섯째. 이사를 가는 날짜는 비가 오지 않지만,땅이 젖은날을 선택하는구나.\\n여섯째. 그리움과 미움은 두개의 태양속에 존재하는 흑기사로다.\",\"559\":\"첫번째. W 와 P 는 동쪽의 수호신이로구나.\\n두번째. 거짓을 네번 만나며,그림자속에 五의 진실이 숨어 있구나.\\n세번째. 이름을 가진 男 과 이름이 없는 男 이 만나야 生 이로다.\\n네번째. 별은 九로부터 시작되며 달은 口 로부터 시작되며 끝은 같도다.\\n다섯째. 일기장을 감춘곳은 흰색나무 밑이로다.\\n여섯째. 잠수함은 섬 가운데 존재하며 그 섬의 이름은 無 로다.\",\"560\":\"첫번째. 산위에 떠있는 별 은 七의 양말을 신었구나.\\n두번째. 가장 큰 위대함을 찍을수 있는 \\\"도장\\\"의 존재로다.\\n세번째. 거울에 갇힌 돼지는 十의 의미와 통하리로다.\\n네번째. 目의 中 에 담긴 장미는 12월의 신부에게 전달되리로다.\\n다섯째. 새로 태어난 생명체는 토끼의 머리와 거북의 심장을 가졌구나.\\n여섯째. 가장 느리게 달리는 물체는 가장 빠르게 달리는 물체의 등에 탈수 있으리로다.\",\"561\":\"첫번째. \\\"석상\\\"은 선물과 선물 사이에 존재하리로다.\\n두번째. 品 과 曰 과 目의 공통은 하늘과 함께 존재하는구나.\\n세번째. \\\"나팔\\\"은 파란나무위에 존재하리니 9월의 보석이 되는구나.\\n네번째. 지구와 화성의 부모는 달과 한가지 공통점이 있으리로다.\\n다섯째. 달리면 물이 부족하고 멈추면 물이 넘치는구나.\\n여섯째. 검은곰과 흰곰은 다섯마리의 금붕어를 차지하는구나.\",\"562\":\"첫번째. 도토리를 가진 다람쥐는 \\\"청색다람쥐\\\"로구나.\\n두번째. \\\"石\\\"이 세번 깨져서 \\\"木\\\"위에 서리로다.\\n세번째. \\\"전쟁의신\\\"이 내려주신 선물은 \\\"거울방패\\\"로구나.\\n네번째. 토끼의 귀를 가진 악어는 사막에 존재하리로다.\\n다섯째. 가을의 이름을 가진 百一 페이지는 \\\"九月成\\\" 이로다.\\n여섯째. 태양의 이름은 \\\"草\\\" 의 이름을 가졌으니 행운이로다.\",\"563\":\"첫번째. 전쟁과 평화를 동시에 바라볼수 있는 \\\"거울\\\"이구나.\\n두번째. 세번의 약속을 지키며 금빛 화산은 十으로 폭발하리로다.\\n세번째. 노인은 山으로 올라가며 젊은이는 水로 향할지니 하나의 공간에 서리로다.\\n네번째. 가장 큰 피라미드 위에 존재하는 태양의 그림자를 찾을지로다.\\n다섯째. 잊혀진 보물은 \\\"보검\\\"으로 부터 가장 먼곳에 존재하며 눈을 감으니 보이는구나.\\n여섯째. 술래를 찾아 동네를 세바퀴 돌며,그안에서 여섯번의 연기를 볼수있으리로다.\",\"564\":\"첫번째. \\\"거짓\\\"과\\\"진실\\\"의 형제는 하나의 \\\"배\\\"를 타며 모두 同 이로다.\\n두번째. 가장 널리 보여주는 발명품은 王으로 부터 태어나리로다.\\n세번째. 마지막 잎새는 9月에 존재하며 \\\"여왕\\\"의 눈물위에 떨어지는구나.\\n네번째. 회색빌딩 속에는 七의 악기가 존재하며 이중 네번째 악기를 찾아내리로다.\\n다섯째. 여섯개의 사진은 떨어져 하얀 \\\"눈\\\"위에 멈추리로다.\\n여섯째. 미래를 볼수 있는 영화는 하늘과 바다가 뒤바뀔때 \\\"행운의징표\\\"가 나타나리로다.\",\"565\":\"첫번째. 가장 큰 도토리와 가장 작은 태풍이 만나야 이루어지는구나.\\n두번째. 행복을 가진 태양은 슬픔을 가진 달 위에 존재하는구나.\\n세번째. 多 를 서쪽에서 만나야 행운이 되리로다.\\n네번째. 국자위에 별이 여섯 담기며,끝이 가장 빛나는구나.\\n다섯째. 수레바퀴는 다섯이요 나무가 셋이니 기쁨이구나.\\n여섯째. 군인은 복주머니를 가지며 東과 연결된 다섯개의 보석을 취하리로다.\",\"566\":\"첫번째. 제주도는 태풍속에 갇히는구나.\\n두번째. \\\"거울\\\"속에 \\\"거울\\\"은 세번의 종소리에 깨지리로다.\\n세번째. 龍은 기와집위에 나타나며 방문으로 빗물이 넘치는구나.\\n네번째. 거북의 王 은 잠이들며 하늘위에 꽃이 필때 깨어나리로다.\\n다섯째. 노인은 十 을 가지며, 아기는 三 을 숨기리니,황금문을 찾아 들어가리로다.\\n여섯째. 네개의 눈과 두개의 입을 가진 식물은 태양이며 나뭇꾼의 차지로다.\",\"567\":\"첫번째. 황금무대는 피에로와 코끼리의 집이로구나.\\n두번째. 세번의 쉼은 月을 움직일것이며,단 한번의 구멍을 만나게 되리로다.\\n세번째. 갑옷을 잃어버린 세번째 장수는 행운의 신발을 찾을지로다.\\n네번째. 검은 양복을 입은 남자는 다섯발걸음으로 경복궁을 지나야 행운을 만나리로다.\\n다섯째. 세번의 약속을 지키고 다섯번의 노래를 부르며 단 한번의 낮잠을 자야지 보이는구나.\\n여섯째. 부모의 사랑을 담은 상자는 언제나 가장 큰 보물상자로다.\",\"568\":\"첫번째. 10月 행운은 세상에서 가장 높은곳에 올라 가장 낮은곳을 바라볼때 나타나는 징표로구나.\\n두번째. 현명한 의사와 가난한 환자는 모두 한배를 타리로다.\\n세번째. 일곱개의 알을 가진 타조는 모두 흰색이로구나.\\n네번째. 龍 은 三 의 뿔을 가졌으며 五木을 감싸는구나.\\n다섯째. 성을 포위한 병사들은 창이 없으며 갇혀있는 병사들은 창을 숨기는구나.\\n여섯째. 두개의 바위는 새로운 생명을 탄생시키며 사랑을 녹이리로다.\",\"569\":\"첫번째. 나무 아래에 압정은 뒤집혀지며 하루가 앞서리니 고통이로다.\\n두번째. 염소는 조각난 청동위에 새겨지리로다.\\n세번째. 이슬을 받아야 生이며,가장 낮은곳에서 기다림이로구나.\\n네번째. 바다에 방패를 빠뜨리니 비로소 바다의 독수리가 존재하는구나.\\n다섯째. 뱀은 三 속에 들어가리니 火위에 존재하는구나.\\n여섯째. 東의 환영받지 못한 손님은 口에 갇혀 쉬지 못하는구나.\",\"570\":\"첫번째. 세상에서 가장 빠른 물고기는 두개의 섬속에서 존재하는구나.\\n두번째. 발자국을 남긴 거울은 눈위에서 사라지는구나.\\n세번째. 인디안 추장은 흰호랑이를 잡을지로다.\\n네번째. 남쪽에 세개의 컵을 세워놓고 세번째 손님을 기다리는구나.\\n다섯째. 물이 있는 날에는 두마리의 오리가 사라지고 가장 큰형과 친구로구나.\\n여섯째. 달은 행운을 가져다 주며,한번 추락하니 역행이로구나.\",\"571\":\"첫번째. 겨울외투를 벗어 가장 작은 나무를 찾아 덮으리로다.\\n두번째. 쫒기는 사슴과 상승하는 뱀이 만나 하나를 이룰지로다.\\n세번째. 세상에서 가장 따뜻한 겨울을 만드는 마법이구나.\\n네번째. 빠르게 달려 다섯번 멈추니 그 앞이 형제의 우정이로구나.\\n다섯째. 正 과 無 와 九 는 단한번의 공통점으로 연결되리로다.\\n여섯째. 새벽에 보이는 전봇대는 새벽눈이 와야 증표가 남으리로다.\",\"572\":\"첫번째. 골프채와 골프공은 산속에 존재하리로다.\\n두번째. 고목나무 아래에서 세개의 빛나는 동전을 찾을지로다.\\n세번째. 고래의등에는 열쇠가 존재하며 꼬리에는 자물쇠가 존재하는구나.\\n네번째. 숲에 폭포는 세번 떨어지며, 종소리가 시작을 알리는구나.\\n다섯째. 호미가 세번 낙엽을 쓸때 사람은 사라지는구나.\\n여섯째. 부자를 막는 부채는 동굴속에 갇히리로다.\",\"573\":\"첫번째. 신발과 우주의 이름은 하나의 공통점이 존재하는구나.\\n두번째. \\\"겨울\\\"을 가둔 시계탑에는 세명의 동자가 살고 있구나.\\n세번째. 두개의 바지를 취하며,하나의 모자를 소유하는 주인을 찾을지로다.\\n네번째. 금방울과 은방울은 각각 코끼리 앞다리에 묶이리로다.\\n다섯째. 저녁의 연기와 새벽의 연기는 노인의 청춘과 연결되리로다.\\n여섯째. 달콤함을 가진 방패에는 두개의 八 이 새겨져 있구나.\",\"574\":\"첫번째. 시골의 풍경에 취할때 두 男子는 田속에 갇히는구나.\\n두번째. 一과一이 만나 二 가 아님을 12月은 증명하는구나.\\n세번째. 짝수로 여섯번 이루어질때 구름이 보이며, 우측이 모두 사라질때 행운이 오는구나.\\n네번째. 코끼리는 장님을 태우고 북극으로 한걸음 뜀 이로다.\\n다섯째. 두명의 손님이 서로 다투며,단 한번도 서로 섞일수가 없구나.\\n여섯째. 독수리 머리에 별세개는 금별이로다.\",\"575\":\"첫번째. 금빛접시와 나무접시가 존재하며 하나가 깨어질때 나머지 하나가 보일지로다.\\n두번째. \\\"숭어\\\"가 두손에 잡히며 그것은 \\\"고래\\\"의 먹이가 될지로다.\\n세번째. 바이올린을 가진 거지는 동전을 가진 부자를 만나리로다.\\n네번째. \\\"행운의집\\\"에 살게되며,뒷집과 앞집에는 각각 바늘과 실이 필요할지로다.\\n다섯째. 기회는 세번이요 단추와 검은양말과 또 하나가 그 기회로다.\\n여섯째. 가장 키가 큰 남자를 만나서 머리를 깎아야 하며, 24시간이 지나야 새로운 門이 보일지로다.\",\"576\":\"첫번째. \\\"거울\\\"에 쓰러진 나무가 세번 비출때 손님은 나타나는구나.\\n두번째. 여름을 기다리는 소년은 대나무와 접시를 절벽위에 올려놓으리로다.\\n세번째. 시간의 마지막 순간에 아홉개의 진주를 세개의 망치로 깨뜨릴지로다.\\n네번째. 검은 정장의 남자는 七의 흰페인트를 쏟으리로다.\\n다섯째. 태양을 볼수 있는 동굴에서 서쪽으로 가면 복숭아를 볼수 있구나.\\n여섯째. 열개의 우유를 세개의 컵에 담으니, 넘쳐야 九를 가지는구나.\",\"577\":\"첫번째. 무지개는 여왕의 동전위에 새겨지리로다.\\n두번째. 쌍안경으로 가장 먼 코뿔소의 뿔을 보게 될지로다.\\n세번째. 세번의 약속을 어기고 다섯번의 신의를 얻을때 북소리가 나리로다.\\n네번째. 곰 은 뒤집혀 소리가 나며 그 소리가 곧 \\\"팔정도\\\"로 가는길이로다.\\n다섯째. 애국가는 쉼이 十 이요 빠름이 七 이로구나.\\n여섯째. 이발소에는 세명의 노인과 두명의 어린이가 있으니 행복이구나.\",\"578\":\"첫번째. 카메라를 든 소녀는 세개의 연필을 가졌구나.\\n두번째. 단한번의 토요일에 열린 축제는 노인의 건강을 지켜주는구나.\\n세번째. 까마귀는 금빛 동상위에 앉으며 흰 비둘기는 바닥의 쌀을 주워먹으리로다.\\n네번째. 걸어서 태양까지 갈것이며 비는 내리지 않으리로다.\\n다섯째. 원숭이는 검은 가면을 썼으며 그중에서 세번째 원숭이가 王 이로다.\\n여섯째. 고향의 굴뚝에 세개의 깃발을 달고 있으며 단 하나만이 마지막날에 선택되어지리로다.\",\"579\":\"첫번째. 1月 속에 馬 와 馬 의 중심에 있는 날개를 찾을지로다.\\n두번째. 서울에서 기차를 타고 가장 긴 여행의 도착지로구나.\\n세번째. 태양을 위로 하여 세번 절하고 뒤 돌아볼때 보일지로다.\\n네번째. 새총을 가진 남자는 검은 흙을 담으리로다.\\n다섯째. 제주도와 가장 가까운 무인도에 존재하는 흰알은 황금알이로구나.\\n여섯째. 31일 동안에 숨겨진 남자는 太의 이름을 가졌구나.\",\"580\":\"첫번째. 지붕위에 열린 열매는 \\\"붉은색\\\"열매로구나.\\n두번째. 하나의 창문에 비친 두개의 구름은 행운의 구름이구나.\\n세번째. 북극에 존재하는 의자는 三 이요 그중 가장 높은 주인은 열쇠를 가졌구나.\\n네번째. 山위에 두개의 구멍이 존재하며 그 위에 龍 의 존재로구나.\\n다섯째. 빛은 구름속에 숨겨져 있고 하늘은 태양속에 숨겨져 있구나.\\n여섯째. 휘어진 공간속에 삼각형이 다섯을 이루리로다.\",\"581\":\"첫번째. 붉은 원반속에 번개는 보이고,동서풍이 부니 사라지는구나.\\n두번째. 금과 은과 별은 한곳에 모여,선비의 풍요로움을 즐기는구나.\\n세번째. 낯선도시의 여름은 태양속에서 멈추며 금빛 소나기는 지나가리로다.\\n네번째. 김치를 가진 농부는 뉴욕의 제일 높은곳에 서리로다.\\n다섯째. 북극에 선 남자는 일곱번 지나가며 喜 가 보이는구나.\\n여섯째. 榮이 새겨진 복주머니 속에는 일곱구슬이 존재하며 그중 하나가 王 이로구나.\",\"582\":\"첫번째. 도심속에 신호등은 꺼지며,거울속에서만 빛을 내리로다.\\n두번째. 세상속에서 \\\"세옹지마\\\"를 찾아 마지막의 의미로구나.\\n세번째. 장독대속에 비밀이 있으리니,十 을 가진 장독대를 찾을지로다.\\n네번째. \\\"열쇠와 하모니카\\\"는 바람을 만나 생명이 되리로다.\\n다섯째. 하백(河伯)은 水를 만나니 행운이구나.\\n여섯째. 루피의 나라는 공통점이 존재하리로다.\",\"583\":\"첫번째. 흰공룡과 검은공룡이 서로 만날때 생기는 그림자로구나.\\n두번째. 포도나무의 향기는 허수아비속에 남을지로다.\\n세번째. 두개의 계단을 지나 추락하니 황금나무를 보게 될지로다.\\n네번째. 三 과 川 은 하나의 원속에서 만나 그 의미를 지닐지로다.\\n다섯째. 거북의 등껍질에 새겨진 글은 人 과 太 로구나.\\n여섯째. 주인을 만난 범은 山 의 끝에 서리로다.\",\"584\":\"첫번째. 달속에 갇힌 늑대개는 푸른색의 옷을 입는구나.\\n두번째. 영을 가진 인간과 백을 가진 인간이 만나 十 을 향하여 함께 가는구나.\\n세번째. 검은 양복을 입고 흰색 모자를 쓴 소년은 얼음속에 갇히리로다.\\n네번째. 하늘과 바다는 북극에서 만나며 셋이 만나 하나가 되리로다.\\n다섯째. 불의축제는 작은주머니속에서 시작되며 가장 높은곳에 서리로다.\\n여섯째. 셋과 하나가 만나 봄이 되며 다섯과 여섯이 만나 여름이 되리니 잃어버린 겨울을 찾을지로다.\",\"585\":\"첫번째. 다이아몬드속에 지구는 중심이 되어 빛이 되리로다.\\n두번째. 十 은 九 보다 작을때 행운의 金이 될지로다.\\n세번째. 세상에서 가장 작은 폭포를 지나 가장 큰 폭포로 나아가는 길이로구나.\\n네번째. 바다의 길은 다섯개이며 불과 물과 구름과 태양과 번개가 하나의 길로 통하는구나.\\n다섯째. 일곱개의 세워진 석상 위에는 꽃이 필지니 가장 동쪽의 꽃이로구나.\\n여섯째. 머리에 쓴 왕관에 사용된 보석은 東 과 五와 가까운 보석이로구나.\",\"586\":\"첫번째. 붉은머리의 공주는 겨울을 가진 왕자를 만나리로다.\\n두번째. 용은 바닷속으로 잠기며,거북은 바다위로 오르는구나.\\n세번째. 집속에 인형은 三을 가졌으며,두손은 태양의 아래에 존재하는구나.\\n네번째. 황금성냥은 주머니속에 있으리니 슬픔을 닦아주는 손수건이 되리로다.\\n다섯째. 빛은 가장 높은곳에 존재하며 붉은여우의 따뜻한 침대가 되는구나.\\n여섯째. 운명은 이제야 끝나며 3月의 별속에서 나뭇꾼은 선녀를 만나는구나.\",\"587\":\"첫번째. 우주의 꽃은 흰색 도자기속에 담기리로다.\\n두번째. 공주의 왕관은 바다와 별속에 갇혀 존재하는구나.\\n세번째. 붉은색 리본은 세번째 나무에 묶여져 선택받을지로다.\\n네번째. 포도밭에 나비와 함께 존재하는 우물이로구나.\\n다섯째. 열번을 퍼오고 다섯번을 가져다주는 황금박 이로다.\\n여섯째. 박수소리는 가장 고요할때 시작되며 절벽에서 비가 멈출때 들을수 있을지로다.\",\"588\":\"첫번째. 느티나무 위에 걸린 가장 큰 별이로구나.\\n두번째. 생선은 꼬리부터 사라지니 행복의식탁이구나.\\n세번째. 독도와 짝으로 연결시켜 세번 넘을지니 생명의 공간이로구나.\\n네번째. 한사람에게 두개의 꿈이 존재하며 현실은 곧 영원함이 되리로다.\\n다섯째. 사막의 선인장을 따라 걸어 도착하면 비밀의열쇠가 존재하리로다.\\n여섯째. 행복과 행운과 보석은 한자리에 모여있으며, 가장 높은 시간에 함께 하리로다.\",\"589\":\"첫번째. 동화책 위에 세워진 \\\"범선\\\"이로다.\\n두번째. 천사의사과는 2개이며 비둘기앞에 놓여져 있으리로다.\\n세번째. 은구슬과 딸기는 한주머니에 담겨 아침을 맞으리로다.\\n네번째. 별은 떨어지고 노인은 눈이 가려져 함정앞에 서있으니 위태롭구나.\\n다섯째. 압정은 시간속에서 존재하며 바람앞에 쓰러지리로다.\\n여섯째. 石은 일곱개의 무지개속에 던져지니 인간의 탐욕이 되어 돌아오리로다.\",\"590\":\"첫번째. 검은동굴의 반대말을 찾아서 순서대로 여행을 떠나리로다.\\n두번째. 아래로 세번울리고 위로 다섯번 자르니 평화로구나.\\n세번째. 태양의 부모를 찾을지니 비로서 땅에서의 쉼도 이루어지리로다.\\n네번째. 일년의 마지막날 마지막시에 구름산속에서 행운이 존재하리로다.\\n다섯째. 번개는 여행을 갈때 가져가며, 바람은 집으로 돌아갈때 가져가는구나.\\n여섯째. 전화는 오늘 마지막 통화가 이루어지며, 그이후에 바다속에 가라앉으리로다.\",\"591\":\"첫번째. 땅에서의 찌름과 하늘에서의 찌름은 서로 감싸고 한 사람이 우측에 서있구나.\\n두번째. 모자는 땅을 향하여 모자의 가장 높은곳에 존재함이 곧 행운을 불러 일으키는구나.\\n세번째. 땅과 땅 사이에 만남의 다리는 하나요 그곳에서의 행복은 거울이 필요하구나.\\n네번째. 냉장고안에 소금을 담은 그릇은 단 하나로구나.\\n다섯째. 井이 움직여 다섯이 되며,다섯이 멈추니 둘이 되며 하늘의 이치로구나.\\n여섯째. 영혼을 가진 꽃은 비가 오지 않는 언덕에 반드시 존재하리로다.\",\"592\":\"첫번째. 초록열쇠를 가진 사람은 행운의 날개도 가졌구나.\\n두번째. 무인도에는 의사와 나뭇꾼이 함께 존재하리로다.\\n세번째. 세개의 동굴은 해바라기의 안식처이며 그 옆은 박쥐가 지키는구나.\\n네번째. 지구를 세바퀴 돌아야 행운이며,화산이 폭발하리로다.\\n다섯째. 화가의 연인은 작은입맞춤으로 영원히 기억되리로다.\\n여섯째. 비가오면 태양이 뜨고,그아래 유람선은 빛이 되리로다.\",\"593\":\"첫번째. 행운이 내리면 우산을 쓰고 번개를 피하여 산에 오르리로다.\\n두번째. 아이스크림위에 피에로는 별을 가지고 있구나.\\n세번째. 해마는 함정에 빠지니 고래의 도움이 필요하도다.\\n네번째. 흰구름은 한소녀만을 위하여 탄생하였으니 그 이름은 口 로구나.\\n다섯째. 북을 가진 종이학을 찾아서 우측으로 쓰러뜨릴지로다.\\n여섯째. 행복의섬은 거짓과 진실의 경계에서 찾을지로다.\",\"594\":\"첫번째. 낙타는 사막의 한가운데에 서있으며, 붉은사과를 취하리로다.\\n두번째. 작은 봉투에 열쇠는 그림자로 존재하며, 그 표식은 N 이로구나.\\n세번째. 오이는 인어와 구름의 경계선에 위치하리로다.\\n네번째. 거북의꿈은 가장 높은 山 위에 책으로써 존재하리로다.\\n다섯째. 유리를 다루는 노인의 집을 찾을지로다.\\n여섯째. 커피와 아이스크림으로 만든 집이 보이는구나.\",\"595\":\"첫번째. 전쟁의 음악은 벽돌과 피아노 사이에 존재하는구나.\\n두번째. 구두를 잃어버린 남자는 방패속에 장화를 찾아낼지로다.\\n세번째. 밤과 낮이 그 경계에서 만날지니 지구를 한바퀴 돌때 생기는 약속이 되리로다.\\nHOLD — 원자료상 중복후보 존재\\n다섯째. 구름속에 감추어진 금괴는 비가 되어 푸른숲으로 떨어지리로다.\\nHOLD — 원자료상 중복후보 존재\",\"596\":\"첫번째. 겨울에 태어난 동자는 한발로 한강을 건너가니 행운이로구나.\\n두번째. 지친병사는 두번의 음악을 듣고 세개의 이불을 덮을지로다.\\n세번째. 집으로 돌아가는 동물중 가장 빠른 동물이 선택받을지로다.\\nHOLD — 원자료상 해당 문장 식별 불가\\n다섯째. 삼각으로 이루어진 군대는 12명의 십자군에게 패하리로다.\\nHOLD — 원자료상 해당 문장 식별 불가\",\"597\":\"첫번째. 우산을 가진 형제는 금강산에 오르는구나.\\n두번째. 무대위에 광대는 공을 가지며 일곱개의 악기를 연주하리로다.\\n세번째. 책을 덮어 불을 끄며 다음날 하늘의 폭포를 담으리로다.\\n네번째. 동전을 가진 여우는 달빛아래 존재하며,사냥꾼의 덫에 걸리는구나.\\n다섯째. 도끼는 검은색 하늘을 가리고 흰부채가 필요하구나.\\n여섯째. 일곱개의 석탑은 기사의 쉼터가 되리로다.\",\"598\":\"첫번째. 태양은 ㄱ 이요 땅은 ㄴ 이니 이제 하늘이 되는구나.\\n두번째. 龍 은 다섯개의 구슬속에 갇히며 겨울이 되어야 깨어날지로다.\\n세번째. 코스모스의 향기는 뜨거운 심장속에 존재하리로다.\\n네번째. 가을로 떠난 소년은 거울속에서 자신을 만날지로다.\\n다섯째. 9시에 존재하는 흰범과 5시에 존재하는 흑사자는 사다리 위로 오르리로다.\\n여섯째. 인디언춤을 추며 세명이 모일때 지나가던 버스는 멈추리로다.\",\"599\":\"첫번째. 황금호박은 동쪽에 다침이 없는 가장 가난한 집에 존재하는구나.\\n두번째. 77세의 노인은 안경을 쓰지 않았으며 반드시 벽을 타고 내려오는구나.\\n세번째. 발을 세번 맞추어 뜀이 되며 또다시 더할지니 구름이 되리로다.\\n네번째. 안경이 깨짐으로 田 의 중앙에 존재하는 비둘기는 죽음에서 벗어나리로다.\\n다섯째. 天 과 石 은 만나며 가운데로 태풍이 지나가리로다.\\n여섯째. 인간세속에 존재하는 세가지 도장중 마지막이로다.\",\"600\":\"첫번째. 두번째 집에 들어가니 코끼리의 의자가 보이는구나.\\n두번째. 아기의 아이스크림은 풍선속에 존재하리로다.\\n세번째. 가장 높은 하늘에서 가장 낮은 땅사이에 존재하는 나무로구나.\\n네번째. 입구에서 일곱번째 박쥐는 독수리의 그늘에 숨을지로다.\\n다섯째. 가장 짧은 \\\"시간의 노예\\\"와 \\\"병정\\\"은 함께 서있구나.\\n여섯째. 龍 의 뿔을 얻어 노인을 살릴지로다.\",\"601\":\"첫번째. 아프리카의 타조는 얼음속에 갇히는구나.\\n두번째. 거울을 가진 천사는 낙엽을 모으리로다.\\n세번째. 춤을 추는 악어는 피아노 위에 존재하리로다.\\n네번째. 비행기와 거북이는 한가지 공통점이 있으며 이는 곧 행운이 되리로다.\\n다섯째. 편지와 풀피리는 농부의 안식이 되리로다.\\n여섯째. \\\"축구\\\"는 \\\"압정의 찔림\\\"의 반대쪽에 서며 1점을 만들어 가리로다.\",\"602\":\"첫번째. 처음에는 막힘이 하나요 두번째는 막힘이 둘이요 세번째는 막힘이 없으며 네번째는 막힘이 하나이니 행운이구나.\\n두번째. 운명은 바다를 건너 龍의 그림자를 밟아야 가질수 있구나.\\n세번째. 두마리의 코끼리위에 비둘기가 둘이요 그앞은 절벽이구나.\\n네번째. 태풍이 불지니,노인은 나무 뒤에 숨고 여인은 노래를 부를지로다.\\n다섯째. 사막의 가장 높은곳에서 가장 큰 거짓을 찾을지로다.\\n여섯째. 아프리카의 태양은 북극의 태양위에 서리로다.\",\"603\":\"첫번째. 中에서 과거로 각각 두번 이동하며 또 中 이 되는구나.\\n두번째. 나무와 오렌지 사이에 있는 광부의 도끼를 찾을지로다.\\n세번째. 인디언의 집은 굴뚝이 존재하며 그 굴뚝아래에 행운이로구나.\\n네번째. 금빛여울계곡에 존재하는 제비는 행복하구나.\\n다섯째. 주사위는 十月에 세번을 각각 굴러서 가장 높은곳에 오를지로다.\\n여섯째. 卄 은 立 으로 한계단 오를때 그 의미를 더할지로다.\",\"604\":\"첫번째. 가장 \\\"긴 인생\\\"을 찾아서 가장 짧은 의미로 보여줌이로다.\\n두번째. 비행체는 번개를 피하며 쌍둥이山을 지나 레몬트리위를 지나가리로다.\\n세번째. 노루는 가장 큰 폭포아래에 존재하며,사냥꾼의 눈은 가장 높은 계곡위에 서리로다.\\n네번째. \\\"삶\\\"을 다섯으로 나누어 세번째 삶의 시작을 찾을 지로다.\\n다섯째. 다섯개의 하찮음은 다섯개의 존귀함을 만나 잡히며,그 후로 뒤집혀 모두 쌓이며 동심이 되리로다.\\n여섯째. 별을 다섯개 가진 인간은 별을 두개 가진 말을 타고 여행을 떠나리니 마지막에 남는 수로구나.\",\"605\":\"첫번째. 인간세속의 가장밝은 \\\"거미줄\\\" 이로구나.\\n두번째. 童 은 피라미드의 가장 위에 서리로다.\\n세번째. 스키를 타고 내려오니 산아래에 세개의 불빛을 볼지로다.\\n네번째. 井 속에 井 이 존재할지니 川 을 만날지로다.\\n다섯째. 낙엽 세개에 악기는 단 한개이니 붓과 붉은색이 필요하구나.\\n여섯째. 악어에게 시계를 빼앗긴 男은 하나의 징표를 가졌구나.\",\"606\":\"첫번째. 검은고래는 다섯명의 노인을 위하여 존재하리로다.\\n두번째. 사막의 폭풍은 달빛아래에서 독수리의 바람을 막을지로다.\\n세번째. 남쪽의 양탄자는 새벽하늘을 가리는구나.\\n네번째. 황금사과옆에 존재하는 검은사과를 가려낼지로다.\\n다섯째. 나무아래에 떨어진 나뭇잎은 개미의 새로운 집이 되리로다.\\n여섯째. 가장 작은 구멍을 찾아서 가장 큰 돌을 채워넣으리로다.\",\"607\":\"첫번째. \\\"행복의식탁\\\"은 東으로부터 황금그릇을 취하는구나.\\n두번째. 비둘기는 날개를 감추며 그늘속에서 하루를 지낼지로다.\\n세번째. 땅위에 세운 독도는 단한명의 군인이 살고 있구나.\\n네번째. 벽은 세개요, 구멍은 하나일지니 생명의 존재로구나.\\n다섯째. 빛은 소리로부터 탄생되며,바람은 그림자로부터 탄생될지니 인연이로구나.\\n여섯째. 오리는 이제 쉴것이며,태양이 없는곳에서 王이 되리로다.\",\"608\":\"첫번째. 어린이의 웃음이 가장 많이 달린 木 을 찾을 지로다.\\n두번째. 겨울에 찾은 보물은 두루마리에 감겨져 있는 아홉개의 옥수수로다.\\n세번째. 미움을 가진 방패는 땅에 묻히며 그 위에 白鶴 이로다.\\n네번째. 전쟁은 하늘과 땅의 이어짐으로 시작되며 그 지점은 黑 기사의 나타남이로구나.\\n다섯째. 사냥꾼의 너구리는 사막으로 이동하리로다.\\n여섯째. 사라진 한글을 찾을지니, 뒤집힘이 그 열쇠로구나.\",\"609\":\"첫번째. 金 과 銀 은 火 와 함께할때 행운이 되리로다.\\n두번째. 사막위에 존재하는 거북은 龍의 길에 서리로다.\\n세번째. 가장 높은 산의 동굴속에는 해바라기가 숨어있구나.\\n네번째. 비를 피하니 죽음이요,그곳에서 東南으로 향하니 행운이구나.\\n다섯째. 흑과 백의 공존은 흑이 언제나 선이니 十 과 十 이 만나서 생명이 되는구나.\\n여섯째. 五 의 의미를 가진 번개를 피하여 三의 벗이 되리로다.\",\"610\":\"첫번째. 세명의 조리사는 경쟁하며 세번째의 요리법을 찾을지니 첫번째 요리의 시작은 \\\"장어\\\" 로구나.\\n두번째. 창문은 十이 열리며 바람은 가장 차가울때 들어오리로다.\\n세번째. 가장 무거우면서 가장 가벼움을 동시에 가진 \\\"지구\\\"안의 행운을 찾을지로다.\\n네번째. 태양은 지고 검은흑구슬은 우물에 빠질것이니 그 시간에 비밀의 문이 열리는구나.\\n다섯째. 해일이 金山을 덮치니 의사만이 살아남으리로다.\\n여섯째. 긴 동굴의 끝은 \\\"술\\\" 이 존재하며 그 반대쪽 끝에 존재하는 상대를 찾아야 하는구나.\",\"611\":\"첫번째. 흰수염을 가진 고래는 검은사막에서 찾을지로다.\\n두번째. 한개의 기둥과 세개의 원은 새로운 보금자리로 가는 길이로구나.\\n세번째. 팽이를 잡은 손은 두개이며 얼음위에 새겨지리로다.\\n네번째. 두개의 의미는 끝에서 통할때 이루어지며 뒤집혀 하나를 찾고 세번 건너띄니 또 하나를 찾는구나.\\n다섯째. 가마솥을 뒤집어 섬이 되며 그 열매는 행운을 가져다 주리로다.\\n여섯째. 거미는 王 이며 먹이는 인간에게 쫒기어 모서리에서 잡히는구나.\",\"612\":\"첫번째. 토끼를 잡은 포수는 폭포위에 황금무지개를 얻을지로다.\\n두번째. 음악을 금잔에 담는 방법이구나.\\n세번째. 세번째 잠든 곰은 나무아래에 웅크려 있구나.\\n네번째. 창문을 열고 바위를 깨뜨려 그안에 존재하는 새집을 가져오리로다.\\n다섯째. 거인은 나무를 심고 하늘은 비를 내리는구나.\\n여섯째. 열개의 반지를 바다위에 떨어뜨리니 갈매기의 먹이가 되리로다.\",\"613\":\"첫번째. 생명수는 옥수수밭으로 떨어지는구나.\\n두번째. 호랑나비의 날개짓은 추락하는 달의 신호로구나.\\n세번째. 九를 가진 七 을 찾아 나눔을 가지리로다.\\n네번째. 창문에서 본 사과는 비가 올때 사라지리로다.\\n다섯째. 암행어사의 실종은 2개의 태양이 알고있구나.\\n여섯째. 누에섬의 가장 큰 꽃을 찾아 東으로 갈지로다.\",\"614\":\"첫번째. 승리를 가진 도끼는 선녀의옷과 바람을 쓰러뜨리는구나.\\n두번째. 은하수는 네개의 별을 가졌으며,남쪽의 태양위에 존재하리로다.\\n세번째. 황소는 문뒤에 숨어 있는 투우사의 황금창을 찾아내리로다.\\n네번째. 주인은 펭귄의 옷을 가지고 곰의 옷을 얻을지로다.\\nHOLD — 원자료상 해당 문장 식별 불가\\n여섯째. 행운의 나무는 두개의 벽돌위에 존재하리니 그것이 \\\"마지노선\\\" 이로다.\",\"615\":\"첫번째. 노란비행기는 바람이 멈출때, 황금코끼리 위에 떨어지는구나.\\n두번째. 기사는 A가 B로 향할때 깃발을 내리는구나.\\n세번째. 가장 큰 별이 머리위에 존재하리니 황금사과를 발견할지로다.\\n네번째. 바람의신은 세상에서 가장 큰 전차를 타고 가장 낮은곳으로 여행을 떠나는구나.\\n다섯째. 가장 큰 거짓말과 가장 큰 진실의 차이로구나.\\n여섯째. 다섯명의 여인은 세번째 낮은 山 아래에 소풍을 떠나는구나.\",\"616\":\"첫번째. 얼음위로 기차가 다니며 그 앞에 통나무의 존재로구나.\\n두번째. 사각집에 구경꾼은 손이요, 그 안에는 방울뱀의 존재로구나.\\n세번째. 이동의 물체아래에 \\\"쉼\\\"의 표시이니 이는곧 행운이로다.\\n네번째. 시계는 가장 큰 1이 되며, 그속에서 겨울에 온기는 어린이들의 웃음속에 사라지지 않을지로다.\\n다섯째. 세번의 큰 웃음이 존재할지니 하나는 고래위의 웃음이요 둘은 놀이터에서의 웃음이요 셋은 행운의 웃음이로다.\\n여섯째. 등산을 오르니 바위위에 蔘 의 존재며 거북 폭포의 좌측에 위치하는구나.\",\"617\":\"첫번째. 해바라기위에 잠자리는 평화의 잠자리로구나.\\n두번째. 가장 높은 바다와 가장 낮은 산을 취하리로다.\\n세번째. 돌을 두개를 놓아 天 이 되는구나.\\n네번째. 세상을 다 가진 부자는 붉은 열쇠를 잃어버리는구나.\\n다섯째. 세개의 숲은 나란히 존재하며 사람은 약속의 땅에 서리로다.\\n여섯째. 행운을 따르는 발자국은 행복의 저수지위에 남으리로다.\",\"618\":\"첫번째. 황금태양은 초록빛 날개로 가려지리로다.\\n두번째. 뱀이 새겨진 칼은 하나요,태양의 도시위에 존재하리로다.\\n세번째. 가장 큰 사과는 생명의 병속에 갇히리로다.\\n네번째. 별은 여덟개가 되어 끝을 나타내며 그곳으로부터 시작을 찾을지로다.\\n다섯째. 허수아비는 東 과 七 속에 존재하리로다.\\n여섯째. 버스에 탄 노인은 초록빛 우산을 가졌구나.\",\"619\":\"첫번째. 호주는 시작이요 끝은 일본이니 그 중간에 서리로다.\\n두번째. 가장 높은 빌딩에서 동쪽을 바라볼지니 그 그림자의 끝이로구나.\\n세번째. 호수가 존재하는 산위에는 흰색 동물이 존재하리로다.\\n네번째. 비가 내리고 우산을 가진 여인이 石을 피해 나뭇잎을 모으는구나.\\n다섯째. 주어진 시간은 빠르며 빼앗긴 시간은 느릴것이니 인생의낙 이로구나.\\n여섯째. 자신이 존재함으로 겨울을 되찾으며, 그 다음 아침에 그 겨울을 잃어버릴지로다.\",\"620\":\"첫번째. 가장 맛있는 \\\"사과\\\"를 찾아서 가장 높은 땅위에 서리로다.\\n두번째. 돼지는 얼음호수 위에 존재하며 날개가 달렸구나.\\n세번째. 비가 멈추며 북극의 여름을 맞을지로다.\\n네번째. \\\"점\\\"과\\\"선\\\"은 거북의 등안에 존재하리로다.\\n다섯째. 비밀의화원속에 많은 거울이 존재하리니 새로운 숲이로구나.\\n여섯째. 月은 다섯개의 별을 만들며,가장 큰 별이 작은별을 가릴지로다.\",\"621\":\"첫번째. 돌도끼가 木 위에 존재하니 행복이구나.\\n두번째. 전날과 다음날의 만남은 한다리로 이어지니 이는곧 붉은색이로구나.\\n세번째. 노랑알은 다섯개요 흰알은 네개이니 山中樂 이로구나.\\n네번째. 보름달을 바라보며 지어진 탑은 기울어져 4시를 가르키는 구나.\\n다섯째. 샘은 마르지 않으나 붉은반지가 빠질때 보이지 않을지로다.\\n여섯째. 태평양은 집이요 九 를 가진 범선을 찾을지로다.\",\"622\":\"첫번째. 붉은색 하늘에 달이 서쪽이요,별은 동쪽이로다.\\n두번째. 비가오는 우산에는 달팽이 한마리가 존재하는구나.\\n세번째. 어린이가 가진 비행기는 별로 향하리로다.\\n네번째. 금빛 코뿔소의 다리는 휴식의 다리로다.\\n다섯째. 겨울소녀는 성냥을 잃어버리며 그 성냥은 검은나무아래 숨겨져 있구나.\\n여섯째. 가장 행복한 하늘위로 원숭이가 존재하며 동쪽의 태양은 빛나리로다.\",\"623\":\"첫번째. 가장 큰 오리는 3일을 쉬며,떠나온 고향으로 돌아가는구나.\\n두번째. 파랑새는 포세이돈을 만나니 행운이로다.\\n세번째. 유리왕국은 삼각형속에 존재하며, 행복한 인생이 존재하는구나.\\n네번째. 가장 높은 나무는 한번 쓰러진 나무위에 다시 서는구나.\\n다섯째. 제비는 나무위에 존재하며 눈이 올때 사라지리로다.\\n여섯째. 행복을 가진 나비는 해바라기위에 존재하는구나.\",\"624\":\"첫번째. 세상에서 가장 큰쌀을 담을 항아리는 숲속에 존재하리로다.\\n두번째. 장벽은 막히고 불빛은 다가오며 창문은 가리는구나.\\n세번째. 박수를 다섯번 칠때 황금태양은 떠오를지로다.\\n네번째. 十의 흔적을 가진 곰은 포수의 표적이 되리로다.\\n다섯째. 중앙의 별은 아홉개로 새겨지며, 구둣솔은 이마위에 놓여져 있구나.\\n여섯째. 비를 맞은 새는 이틀후에 굴뚝위로 날아가는구나.\",\"625\":\"첫번째. 호박을 지킨 병사는 금관을 얻을지로다.\\n두번째. 시계의 반대쪽에 그림자가 존재하리니 이는 곧 \\\"꿈\\\"이로구나.\\n세번째. 별을 가진 여우는 겨울에 낙엽이 필요하리로다.\\n네번째. 파란불꽃을 찾아 붉은불꽃과 만나니 천상락이로다.\\n다섯째. 겨울이 오며 모자를 쓴 여인이 첫기차를 기다리는구나.\\n여섯째. 흰고래는 검은고래로부터 세가지 소원을 들을지로다.\",\"626\":\"첫번째. 검은 건반에 존재하는 남쪽 흰장미로구나.\\n두번째. 나뭇잎은 절벽으로 떨어지며 바람이 함께 하리로다.\\n세번째. 구름속에 존재하는 나무는 그 존재를 감추리로다.\\n네번째. 十 을 뒤로하고 또다른 十 은 앞으로 하니 함께하나 그 짝을 가지지 않는구나.\\n다섯째. 시골의 석양앞에 쉬고있는 노인은 田 앞에서 행복하구나.\\n여섯째. 태평양을 가진 가장 큰 섬은 가장 멀리가는 친구를 가지리로다.\",\"627\":\"첫번째. 하마는 五 이며 그 속에 태양은 하나로구나.\\n두번째. 피라미드의 비밀은 인간의 배꼽과 나뭇잎의 비밀과 통하리로다.\\n세번째. 우산을 쓴 여인은 흰색 박쥐를 피해가리로다.\\n네번째. 동쪽 저수지는 깊고 그안에 빠진 다이아몬드는 三 이로구나.\\n다섯째. 사진은 十으로 나뉘며 그 안에 기쁨이 존재하리로다.\\n여섯째. 피아노를 가진 소녀는 별속에서 연주하리로다.\",\"628\":\"첫번째. \\\"연필\\\"은 곧 \\\"자신\\\"이 되리로다.\\n두번째. 뿔 위에 구슬은 세상을 비추는 빛이 되리로다.\\n세번째. 태양은 하루가 지나 七을 가졌으며, 부엉이 세마리가 그안에 갇혔구나.\\n네번째. 구슬을 가진 동자는 고래를 타고 가장 큰 바다를 건너리로다.\\n다섯째. 사막의 나그네는 수박을 가진 집에 쉬어가리로다.\\n여섯째. 十을 쉬고 五를 건너며 붉은색을 피해 안식의 나무를 찾으리로다.\",\"629\":\"첫번째. 父情은 비옷속에 감추어지는구나.\\n두번째. 말굽에 존재하는 붉은색과 파란색은 남과 북으로 갈라지는구나.\\n세번째. 우주인이 사는곳은 가장 큰 다리와 가장 높은 탑이 만나는 곳이구나.\\n네번째. 피터팬의 나이는 피라미드속 양탄자의 나이와 같구나.\\n다섯째. 세번의 박수와 두번의 인사속에 새로운연극이 태어나리로다.\\n여섯째. 쵸콜릿은 나뭇잎속에 존재하며 붉은색 모자를 쓴 어린이의 눈에 보이는구나.\",\"630\":\"첫번째. 황금 접시위에 존재하는 달이로다.\\n두번째. 종이위에 거위는 十이며 황금알을 낳으리로다.\\n세번째. 비밀의 화원속에 휴식이 있으며,바람은 열을 식히리로다.\\n네번째. 생일은 비와 태양과 나무가 함께 이동할때 의미를 찾을지로다.\\n다섯째. 겨울속 낙엽은 우체통에 담기는구나.\\n여섯째. 별을 가진 우산은 비가 오면 접을지로다.\",\"631\":\"첫번째. 나비의꿈은 주전자와 함께 하리로다.\\n두번째. 기차가 지나간후에 코끼리의 발자국이 생기리로다.\\n세번째. 거울을 가진 손님은 일곱번 박수를 치는구나.\\n네번째. 山 과 山 사이에 빛이 있는 흰색구름이로구나.\\n다섯째. 사각은 삼각을 부르며 이는곧 孔 이 되리로다.\\n여섯째. 소방차는 함정에 빠지고 산의 이름을 찾을지로다.\",\"632\":\"첫번째. 곰을 쓰러뜨리고 사슴을 쓰러뜨려야 해를 볼수 있구나.\\n두번째. 바위위에 존재하는 도끼는 세개의 금잔과 어울릴지로다.\\n세번째. 고슴도치의 비밀은 2개의 선이로구나.\\n네번째. 지우개를 던져 창문을 통해 보여지면 행운이로다.\\n다섯째. 세개의 날개와 네개의 발톱을 가진 동물이 흰색나무를 오를지로다.\\n여섯째. 노인이 준 금화는 검은탁자에 존재하는구나.\",\"633\":\"첫번째. 비행체는 十 위로 오르며 세개의 그림자를 가지는구나.\\n두번째. 빛을 손으로 담아 그릇에 담는 방법이구나.\\n세번째. 호수는 다섯의 형제가 나누어 가지며 이중 가장 첫번째 호수로다.\\n네번째. 쵸콜릿공장에 작은소녀가 춤을 추고 있구나.\\n다섯째. 소방차가 전봇대에 막혀 서있으며 불은 태양에서 떨어지는구나.\\n여섯째. 펭귄과 곰은 한배에 탔으니 생명이로구나.\",\"634\":\"첫번째. 세명의 인디언은 코뿔소 뿔을 가지고 앉아있구나.\\n두번째. 세박자와 네박자 사이에 계단이 존재하니 행운이로다.\\n세번째. 출입문은 사라지고 그 아래 세개의 담배가 존재하며 마지막 담배로구나.\\n네번째. 투구를 쓴 남자는 행운의 나무 아래에 누워있구나.\\n다섯째. 두개의 다리위에서 서로 마주보며,금수저를 나누어 가질것이니로다.\\n여섯째. 입술과 입술은 네개의 잔을 비추며 태양아래에 빛이 되리로다.\",\"635\":\"첫번째. 겨울소년은 외투를 입고 거울위에 서있으리로다.\\n두번째. 세번째 소리가 들려올때에 여름이 다가오리로다.\\n세번째. 지리산 태풍은 가장 작은 찻잔속에 갇히리로다.\\n네번째. 반지를 가진 두손에 선택은 눈사람이 하리로다.\\n다섯째. 龍의 머리는 새벽을 깨우는 북이 되리로다.\\n여섯째. 태양위에 존재하는 달이며 그 달은 왕의 달이로구나.\",\"636\":\"첫번째. 돌을 가진 맹인은 냇가를 건너는구나.\\n두번째. 태양의 가족은 황금으로 부터 차가움으로 나아갈지로다.\\n세번째. 일곱의 백기사는 고래앞에 서리로다.\\n네번째. 다가오는 폭풍을 피해,마굿간속에 숨을지로다.\\n다섯째. 피아노를 연주하는 아이와 비둘기의 만남이구나.\\n여섯째. 접시는 천상에서 내려오며, 산에 主 를 새기리로다.\",\"637\":\"첫번째. 호수는 붉으며,황금가면을 쓴 노인은 나무뒤에 서있구나.\\n두번째. 흰잎이 떨어지는 계절에는 단 하나의 악기가 존재하는구나.\\n세번째. 요리사는 뜨거운 물을 피하여 산으로 오를지로다.\\n네번째. 안경을 가진 할머니는 바닷가를 향하여 걷는구나.\\n다섯째. \\\"목성\\\"아래에 존재하는 황금박쥐는 영원히 남을지로다.\\n여섯째. 거울과 거울사이에 존재하는 선인장은 7번째 선인장이로다.\",\"638\":\"첫번째. 코끼리 위에 원숭이는 은빛왕관을 가졌구나.\\n두번째. 세개의 별은 하나로 연결되어 남산위에 떠 있구나.\\n세번째. 태풍이 오는 바닷가에서 행복의탑이 보이는구나.\\n네번째. 달팽이는 태극이 새겨진 우산위에 존재하며 비를 맞으리로다.\\n다섯째. 가장 큰 거울이 깨어질때 천상의 음악이 시작되리로다.\\n여섯째. 山 위에 존재하는 가장 큰 물은 \\\"天\\\"이 되리로다.\",\"639\":\"첫번째. 두개의 산뒤에 사막이며 그 아래에 황금밭이로구나.\\n두번째. 독수리가 새겨진 유리잔속에 담겨진 포도는 황제가 마실포도로구나.\\n세번째. 세번뛰고 네번빠지며,또한 다섯번 빛나며 상승하여 짝을 만나니 행운이구나.\\n네번째. 역삼각형은 五를 넘어서 가장 큰 \\\"안정\\\"이 되리로다.\\n다섯째. 탄생과 함께한 지진은 가장 낮은 P 를 가지리로다.\\n여섯째. 우마를 모두 가진 백발노인은 밭위에서 잠이 드는구나.\",\"640\":\"첫번째. 달빛아래에 다섯권의 노트가 존재하며 제목은 \\\"장미\\\"로구나.\\n두번째. 바람은 그림자를 따르며,가장 높은곳에서 만나리로다.\\n세번째. 윷놀이를 하는 노인은 三 과 井 사이에서 복을 받는구나.\\n네번째. 육교를 건너 다섯병사를 만나며, 가장 머리가 긴 병사를 찾을지로다.\\n다섯째. 황금기와의 세번째 고드름을 딴 어린이는 눈사람과 친구가 되는구나.\\n여섯째. \\\"감또개\\\" 는 장독에 가득차리로다.\",\"641\":\"첫번째. 책상위에 투명컵은 \\\"왕비의 컵\\\"이로구나.\\n두번째. 단추구멍속으로 보이는 \\\"사과\\\"로구나.\\n세번째. N 은 井 위에 존재하며 문뒤에 서리로다.\\n네번째. 행운을 가진 남자의 넥타이에는 금사과의 의미가 있구나.\\n다섯째. 인간세속에 존재하는 \\\"투명한 그릇\\\" 이로구나.\\n여섯째. 장난감은 두개이며 행복과 가난의 장난감이로구나.\",\"642\":\"첫번째. 걸레로 태양을 가리니 가장 깨끗한 그늘이 생기는구나.\\n두번째. 비가 온후에 번개가 생기며 희나리에 불이 붙어 생명이 탄생하는구나.\\n세번째. 우산은 五이며 이중 \\\"라온우산\\\"을 찾아 福 을 담을지로다.\\n네번째. 단추는 여인의 머리를 장식하며 모자는 꿀을 담으리로다.\\n다섯째. 얼굴에 가면을 쓴 남자는 좌측으로 걸어가며 그 뒤에 \\\"입\\\"이 따르리로다.\\n여섯째. 옥수수는 동자의 주머니에 존재하며 저녁의 보물이로구나.\",\"643\":\"첫번째. 세명의 장군뒤에 가장 작은왕이 존재하며,그뒤에 축복을 가진 나무의존재로구나.\\n두번째. 흰색코뿔소와 나무는 서로 만나며 절벽위에 서리로다.\\n세번째. 신선은 집으로 돌아와 쉴것이며,오리를 가져오리로다.\\n네번째. 통나무집은 피리소리를 따라 존재하며,가장 마지막 집으로 기억하리로다.\\n다섯째. 油 와 田 과 里 가 만나며 우측으로 쓰러질때 생명이 탄생되리로다.\\n여섯째. 피리부는 한 남자는 소나무위에 오르니 사다리를 치워야 사는구나.\",\"644\":\"첫번째. 원숭이의 손은 하늘을 향하며 행복의 주사위는 던져지리로다.\\n두번째. 주인은 노예와 함께 나무를 심을지로다.\\n세번째. 고래를 탄 거북은 태평양을 건너는구나.\\n네번째. 구름과 사탕은 흰색컵에 담겨 사막위에 존재하리로다.\\n다섯째. 입곱번째 신부는 코스모스를 넘어서 검은색 드레스를 입는구나.\\n여섯째. 딸기와 나무는 흰색천에 감싸이는구나.\",\"645\":\"첫번째. 가을이 되어 금불상은 코끼리위에 세워지는구나.\\n두번째. 붉은 가재와 포크는 인디언의 증표로구나.\\n세번째. 새벽에 출발하여 부산에 도착하니 그 사이에 세번의 쉼이로구나.\\n네번째. 임금님의 인형은 한글속에 빠지는구나.\\n다섯째. 색종이와 가위는 황금천에 가려지는구나.\\n여섯째. 七 속에 米 가 존재하며,아침이 되어야만 새로운 의미가 생기리로다.\",\"646\":\"첫번째. 황금거위를 담은 항아리는 어린이의 보물이 되리로다.\\n두번째. 겉과 속이 다른 月속에 존재하는 신기한 열쇠로구나.\\n세번째. 세번째 표지판을 보고 북쪽으로 향하리니, 음악의 고향을 찾을지로다.\\n네번째. 田 이 다섯개가 생길때 주인없는 황소가 찾아오리로다.\\n다섯째. 붉은색 짐을 가진 노인은 차가운 태양와 함께 하리로다.\\n여섯째. 가장 긴 그림자는 다섯이요, 세번째 깃발의 주인을 찾을지로다.\",\"647\":\"첫번째. 인생과 함께하는 나무는 단하나이며, 나이가 가장 많아질때 열매를 얻을지로다.\\n두번째. 세워진 탑은 하늘로부터 쓰러짐이요 이는곧 땅으로부터의 易 이로다.\\n세번째. 十이 하나요, 입은 넷이요 두번째 입속에 우산은 세개이며 그 아래에 행운이로다.\\n네번째. 에펠탑 아래로 사과는 추락하며, 가장 높은곳에 가장 맛있는 사과만 남는구나.\\n다섯째. 손가락은 피아노위에 존재하니 多 와 少 를 연주하리로다.\\n여섯째. 구름속에 휴식은 인간의 마지막 마음이로구나.\",\"648\":\"첫번째. 토마토는 동굴속에 존재하며,그앞에 낙엽은 푸르구나.\\n두번째. 검은 태양은 땅에서 가장 작은점과 하늘에서 가장 넓은점을 통과하며,마지막에 서리로다.\\n세번째. 노인의 비닐우산은 행복의 눈물 아래에 존재하는구나.\\n네번째. 인간 세속에 존재하는 가장 낮은 시간에 행복의 땀을 흘리는구나.\\n다섯째. 별을 가진 코뿔소는 태양아래의 낙타와 만나며 행운을 취하리로다.\\n여섯째. 토성과 만나는 행운은 다이아몬드의 중심속에서 열쇠를 찾을지로다.\",\"649\":\"첫번째. W 와 M 이 만나서 가장 높은 山 으로 갈지로다.\\n두번째. 유리속에 비친 과일은 먹지 못하는 과일이구나.\\n세번째. 태양을 삼킨 용을 찾아 가장 긴 川 으로 안내할지로다.\\n네번째. 두마리의 잉꼬는 황금 저금통속에서 만날지로다.\\n다섯째. 현충일에 피는 꽃은 가장 높은 나뭇잎에 가려지는구나.\\n여섯째. 눈과 눈은 죽음과 영원을 뺄것이며 그 후에 손으로 감싸리로다.\",\"650\":\"첫번째. 고래가 품은 알이로구나.\\n두번째. 이사를 가기전에 먹는 마지막 만찬이로다.\\n세번째. 백옥구슬을 가진 동자는 초가집에 머무를지로다.\\n네번째. 사자는 뱀의 꼬리를 물것이니 행운이로다.\\n다섯째. \\\"금\\\"과 \\\"은\\\"을 가진 부자의 죽음은 절벽위에서 존재하리로다.\\n여섯째. 태양의 아이들은 1월1일 1시에 여행을 떠나가리로다.\",\"651\":\"첫번째. 행복의 비둘기는 구름산위로 지나가는구나.\\n두번째. 산을 넘어가니 바다로 들어가는 길이 존재하리로다.\\n세번째. 큰 대문앞에는 비옷을 입은 남자가 존재하며, 푸른 우산을 두개 가졌구나.\\n네번째. 눈사람을 잃어버렸으나. 그 대신 큰 태풍을 취하리로다.\\n다섯째. 달콤한 입맞춤으로 잃어버린 안경을 찾을지로다.\\n여섯째. 귀를 닫고 눈을 열고 입을 닫고 손을 열지로다.\",\"652\":\"첫번째. 황금을 田에 묻어놓고 물을 뿌리니,3일째 福木이 되리로다.\\n두번째. 이름을 잃어버린 남자는 세명의 여인을 얻을지로다.\\n세번째. 소화기를 들고 山을 오를지니 서남쪽의 큰 불을 끄리로다.\\n네번째. 멧돌을 가진 여인은 콩과 옥수수를 가져오는구나.\\n다섯째. 가장 오래된 사람을 찾아서 피라미드 위에 앉히리로다.\\n여섯째. 피아노는 馬를 가진 악보를 연주하리로다.\",\"653\":\"첫번째. 소나기는 木위에 떨어지며 이는 곧 父의 사랑이로다.\\n두번째. 행운이 두개요 슬픔이 두개일때 하나가 또 나누어지는구나.\\n세번째. 별을 가진 나무는 별이 사라질때 상자안에 들어가는구나.\\n네번째. 영웅은 노인을 만날것이니, 낚시를 하며 시간을 모두 잃어버리는구나.\\n다섯째. 행복을 가진 카드는 세장이며 두개는 불과 함께 사라지고 단하나가 남았구나.\\n여섯째. 가장 높은곳에서 자라는 생명체는 행운의 水 를 받고 자라는구나.\",\"654\":\"첫번째. 종이학위에 장미는 천상위에 존재하는구나.\\n두번째. 열번째 생일날 받은 케잌은 하나요,의자가 다섯이로구나.\\n세번째. 12개의 세상에서 행복을 의미하며, 부모의 마음과 함께 하리로다.\\n네번째. 불빛을 가진 숲은 두개의 의미속에 안식을 가지며 세번의 만남이 있구나.\\n다섯째. 검은색종이에 흰색글씨는 자신을 뜻하는 여섯개의 단어를 남기는구나.\\n여섯째. 팽이와 색종이는 동심속에 기억되리로다.\",\"655\":\"첫번째. 황금연필을 가진 초록나무로다.\\n두번째. 하늘위에 존재하며, 날개가 달린 자전거로구나.\\n세번째. 인간세속의 正 을 가진 가장 빠른 雨 로다.\\n네번째. 무지개 거울속에 숨겨진 시계는 행운이로구나.\\n다섯째. 목탁은 황금탁자위에 존재하며 세번의 울림이 존재하는구나.\\n여섯째. 옥수수 100개는 아홉 난쟁이 집에 숨겨놓을지로다.\",\"656\":\"첫번째. 피라미드의 세번째 층에 황금사자의 존재로니 이는 곧 \\\"멈춤\\\"이로다.\\n두번째. 태양을 집어삼킨 삼각형은 힘을 가진 세개의 산위에 존재하리로다.\\n세번째. 발과 손은 나무와 함께 하며 雨 를 만나리로다.\\n네번째. 금성은 토성과 함께하며 이때 만난 人 은 행복이로구나.\\n다섯째. 육교는 세개의 기둥이 존재하며 우산은 그 위에 서 있구나.\\n여섯째. 불나비는 해바라기와 만나 좌측으로 쓰러지며 그 의미가 나타나리로다.\",\"657\":\"첫번째. 대나무와 조약돌은 조개와 함께 하는구나.\\n두번째. 비밀의 선물은 도착하고, 두 나그네는 동쪽으로 가는구나.\\n세번째. TV 의 비밀은 3시에 열리며, 북서쪽에 그 존재를 나타내리로다.\\n네번째. 행운의 시간은 마법과 마술의 차이로 증명되는구나.\\n다섯째. \\\"口\\\" 아래에 십자가가 존재하며 그 중심에 一 이 있구나.\\n여섯째. 우물에 빠진 태양은 파도아래에 존재하는구나.\",\"658\":\"첫번째. 코끼리의 주인은 山 과 山 속에 숨을지로다.\\n두번째. 무지개는 태양과 붉은 나무 사이에 존재하리로다.\\n세번째. 바지와 치마는 함께 있으며 그 옆으로 거위가 지나가리로다.\\n네번째. 기사가 기다리는 마지막날에 창문은 달빛에 가장 가까워 지리로다.\\n다섯째. 원이 가장 많을때 土는 끝에 오르리로다.\\n여섯째. 생명의 분수에는 행복을 가져다주는 날개가 존재하리로다.\",\"659\":\"첫번째. 시계에 감춰진 원숭이 날개를 찾을지로다.\\n두번째. 흰돼지 99마리는 백두산에 오를지로다.\\n세번째. 신비의 폭포수는 행복을 가진 새로 부터 지켜지리로다.\\n네번째. 쪼개진 사과바위 위에 독수리의 날개가 있구나.\\n다섯째. 돌을 담을수 있는 그룻에 물이 차 있구나.\\n여섯째. 붉은원반의 비행체는 황금화살을 맞으리로다.\",\"660\":\"첫번째. 가장 작은 \\\"식당\\\" 앞을 지키는 龍 은 정말 용감하구나.\\n두번째. 이상한 나라의 \\\"가시\\\" 는 그 존재를 알리는구나.\\n세번째. 사각의방에 구석에만 존재하며 가고싶은곳에 발이 없어도 갈수 있구나.\\n네번째. 행복에서 가장 먼곳과 가장 가까운곳이 한곳에서 만나는구나.\\n다섯째. 깃발을 세우고 별을 가진 숲은 얼음이 되리로다.\\n여섯째. \\\"로제타석\\\"은 천상으로 향하는 가장 빠른 \\\"문석\\\"의 징표가 되리로다. 4\",\"661\":\"첫번째. 강원도 눈물바위 아래에 존재하는 蔘 은 행운이로다.\\n두번째. 구름은 항아리에 담겨 위태로운 절벽에 놓여지리로다.\\n세번째. 신발은 세개요,이중 하나는 개구리가 주인이로다.\\n네번째. 바다속의 田 은 土 와 만나 가장 높아지리로다.\\n다섯째. 망치를 가진 흑인은 피라미드 끝에 서며 태양의 아들이 되리로다.\\n여섯째. 오아시스의 낙타는 어린이를 만나며 휴식이 필요하구나.\",\"662\":\"첫번째. 고추밭의 아낙네는 부러진 호미를 찾을지로다.\\n두번째. 자갈은 모가 나며 이것이 쌓여서 가장 마지막날에 城을 이루리로다.\\n세번째. 행복과 슬픔의 경계선을 찾아 서쪽으로 갈지로다.\\n네번째. 달빛아래 세명의 광대와 두명의 악사가 만나 공연을 하리로다.\\n다섯째. 폭포는 멈추며, 그위에 떨어진 계란을 독수리가 노리는구나.\\n여섯째. 두개의 손가락을 모두 내려서 \\\"계획\\\"을 잡을지로다.\",\"663\":\"첫번째. 계단은 세개이며 이중 피난계단을 찾을지로다.\\n두번째. 가장 큰 집에 남자는 앉아있으며, 검은 의자의 비밀이 존재하는구나.\\n세번째. 풍선은 하늘을 날며 독수리는 이것을 노리는구나.\\n네번째. 무지개빛의 구름은 서쪽에 떠 있으며 소나기가 내리는구나.\\n다섯째. 짐을 가진 짐꾼은 느티나무 아래에 쉬고 있으며 빛이 정삼각형이 될때 출발하리로다.\\n여섯째. 화산에서 세번을 건너띄고 하나의 강을 건너 생명이 지켜지는구나.\",\"664\":\"첫번째. 가장 높은곳에 위치한 동굴속에는 노란박쥐가 새로 태어나리로다.\\n두번째. 두개의 자동차에는 검은색 반지와 초록색반지가 함께 존재하리로다.\\n세번째. 소나무위에 금빛눈송이가 내릴지니 한소녀가 주인이로다.\\n네번째. 꽃위에 쵸콜릿은 마술사의 도구가 될지로다.\\n다섯째. 종이학은 태양의 오른편에 서며 十을 표시할때 불타오르리로다.\\n여섯째. 유리는 깨지고 그안에 존재하는 두번째 행운을 취하리로다.\",\"665\":\"첫번째. 父와 子는 꿈속에서의 첫만남이 이루어지는구나.\\n두번째. 오렌지를 따려는 세명의 어린이는 하나의 의자위에 서있구나.\\n세번째. 김밥을 가진 소녀는 소풍을 떠날지로다.\\n네번째. 계란을 쌓아 올려 하루가 지나니 구름이 될지로다.\\n다섯째. 효자는 지게에 돌을 실어 절벽위에 쌓아 올릴지로다.\\n여섯째. 백학의 날개는 구름속에 감추어지고 흰색꽃이 필때 나타나리로다.\",\"666\":\"첫번째. 용의 꼬리에 새겨진 D의 글씨는 바위위에 나타나리로다.\\n두번째. 행운의 꼬리는 용의 날개위에 존재하리로다.\\n세번째. 컵위의 수박은 조개와 함께하리로다.\\n네번째. 노인은 자전거를 타고 세바퀴를 돌아 산으로 올라가리로다.\\n다섯째. 비바람은 북쪽으로 흘러가고 태양은 남산아래에 비추어지는구나.\\n여섯째. 피리는 숲속에서 흘러나오며 사람들은 빌딩에서 흘러나오는구나.\",\"667\":\"첫번째. 흑갈매기는 폭풍중앙에 존재하며 雨 를 피하리로다.\\n두번째. 가장 작은 사과를 서랍에 넣어 한달을 기다리는구나.\\nHOLD — 원자료상 해당 문장 식별 불가\\n네번째. 짝이 없는 구름은 짝을 가진 산과 만나며 그 아래로 떨어지는구나.\\n다섯째. 승리는 동쪽으로 향하며 두번째의미를 가진 산은 하늘로 향하니 행운이구나.\\n여섯째. 남극의 동자는 9월에 탄생하며, 축복의 빛이 나타날때 善 이 보일지로다.\",\"668\":\"첫번째. \\\"개미\\\"는 북쪽의 황금나무를 만나는구나.\\n두번째. 가장 큰 부채의 바람을 맞으니 가장 무거운 열매가 열리는구나.\\n세번째. 기린은 아프리카의 가장 높은 산에서 부터 출발하리로다.\\n네번째. 가장 길고 가장 넓은 열매를 모두 잃어버리고 남은 두 손은 새로운 빛을 비추는구나.\\n다섯째. 코끼리 일천마리가 門 앞에 앉아있구나.\\n여섯째. 새로운 태풍은 우측으로 세번돌아 삼각피라미드 위에 존재하는구나.\",\"669\":\"첫번째. 전쟁의기사는 황금계란 3개를 봉지에 담아 계단위에 놓고 가는구나.\\n두번째. 빛은 빛으로 막고 그림자는 그림자로 막으리니 인간의 용감함이로다.\\n세번째. 수첩은17장 남았으며 가장 첫장은 T로 시작하며 두번째 장이 되리로다.\\n네번째. 걸레로 태양을 훔치니 다보탑의 그림자가 나타나는구나.\\n다섯째. 깨끗한 물은 구름위에 존재하며 일주일을 쉬고 산으로 내려오리로다.\\n여섯째. 수염을 가진 노인은 보리밭위에서 담배를 피는구나.\",\"670\":\"첫번째. 붉은달은 가장 높은산에 걸리며 보름을 기다리는구나.\\n두번째. 소화기는 태양을 삼키며 거북등위에 세워지리로다.\\n세번째. 구슬을 빼앗고 손바닥은 땅을 짚으니 그것이 천상락 이로구나.\\n네번째. 팽이가 一百번 돌아 우주중심이 되는구나.\\n다섯째. 수염을 우물에 빠뜨리는 날이로구나.\\n여섯째. 개구리는 세번의 소나기를 맞으리로다.\",\"671\":\"첫번째. 비행선은 두개의 산과 한개의 폭포를 넘어가리로다.\\n두번째. 입구에 붙여진 방향은 T 와 S 와 Z 의 중심에 세워지리로다.\\n세번째. 피아노를 배에 실어 하와이로 옮겨놓을지니 어린아이의 웃음이 들리는구나.\\n네번째. 상어는 고래와 함께 어부에 잡히며 세카드중 한카드를 골라 운명을 가를지로다.\\n다섯째. 지칠때 세번을 쉬고 나아갈때 두번을 쉴지니 3개월의 시간이 지나가는구나.\\n여섯째. 굴뚝에 연기가 나며,주머니속에 담긴 떡은 할머니의 사랑이로구나.\",\"672\":\"첫번째. 서해에 떠오른 비행체는 金山 위로 오르리로다.\\n두번째. T에 오르니 세번 낙하되며 좌측으로 쓰러지니 다섯번 올라 정상에 서는구나.\\n세번째. 세개의 기와집이 이어져 ㄷ 자가 되며,산을 등지고 남향으로 바라보고 있구나.\\n네번째. 폭풍은 3개의 돌담을 지나 큰홍수를 피해 지나가리로다.\\n다섯째. 전화기는 팔각정위에 존재하며,백의를 입은 노인들의 기다림이 있을지로다.\\n여섯째. 가장 큰 고래의 새끼는 한마리이며 그 새끼를 거북이 보호하리로다.\",\"673\":\"첫번째. 생일에 받은 아이스크림이 녹아 강이 되리로다.\\n두번째. 멧돼지는 다리를 지나친 옥수수밭에 숨어있으며 사냥꾼의 눈을 피하리로다.\\n세번째. 비옷을 입은 군인은 진흙밭에 누워 휴식을 취하리로다.\\n네번째. 고양이방울을 단 코리끼는 배고픔을 참지 못하는구나.\\n다섯째. 사과를 가진 남자는 은구슬을 가진 여자와 만나는구나.\\n여섯째. 일곱번 잠이 들고 다섯번 깨어날지니 남은것은 선몽과 악몽이로다.\",\"674\":\"첫번째. 태양의 빛을 담고 차가운 얼음속에 갇힌 투구로다.\\n두번째. 화가는 바람을 그리며 땀은 흔적이 되리로다.\\n세번째. 유리는 여덟개의 둥근 표식을 담으며 세번의 깨짐으로 그 존재를 들어내는구나.\\n네번째. 우산속에 남자는 둥근 접시를 등에 진 아낙네를 만나 쉼을 가지리로다.\\n다섯째. 열번의 뜀속에 다섯번의 쉼이 존재하며 세번의 만남을 가질것이니 행복이구나.\\n여섯째. 배고픈 상어는 덫에 걸려 가장 나이많은 어부가 살려주리로다.\",\"675\":\"첫번째. 주머니속의 구슬은 한개이며 그속에 태양이 들어있구나.\\n두번째. 호박은 사슴의 안식처가 되며 그위에 가을비가 내리는구나.\\n세번째. 우산을 가진 부부가 산의 정상을 오를지니 행운이구나.\\n네번째. 코끼리의 코는 사라지고, 그자리에 코뿔소의 뿔이 존재하리로다.\\n다섯째. 생명을 가진 운동화는 운동장속에 존재하며 진흙속에 빛이 나리로다.\\n여섯째. 은빛 비행체는 우측의 폭포와 좌측의 느티나무 사이에 존재하리로다.\",\"676\":\"첫번째. 나무와 돌은 함께 불에 타며 남는것은 하나로구나.\\n두번째. 안개가 낀 산봉우리에 존재하는 안경이로구나.\\nHOLD — 원자료상 중복후보 존재\\n네번째. 이삿짐을 하늘로 옮기며 이삿짐 속에는 황금이 존재하는구나.\\n다섯째. 붓을 다섯개 취하며, 하나의 종이를 선택하며, 세번의 걸음을 띄우리로다.\\n여섯째. 고구려장수는 화살을 가지고 은빛호수를 건너리로다.\",\"677\":\"첫번째. 가장 빠름은 종이시계속에서 가장 느림이 되리로다.\\n두번째. 해바라기를 가진 전사는 꽃으로 상처를 받을지로다.\\n세번째. 동굴속에 황금은 날개가 달린 황금돼지의 차지로다.\\n네번째. 가장 높은곳에서 내리는 비는 가장 작은 골목길 노인이 쓴 우산에 닿을지로다.\\n다섯째. 가장 잘 보이지만 갈수없는 신비로운 계곡을 찾을지로다.\\n여섯째. 사진을 태워야만 큰곰자리로 향할지로다.\",\"678\":\"첫번째. 우주의 별이 두개요,이중에서 남쪽에 존재하는 별이로구나.\\n두번째. 흰색 고양이는 붉은 지붕위에서 쉬고 있구나.\\n세번째. 초록의 아침에 태양은 뜨고 가장 늦은 시간에 약속을 잡을지로다.\\n네번째. 제주도에서 가장 빠른 기차를 타고 마지막 장소를 찾아갈지로다.\\n다섯째. 시간의 제자들은 모두 제자리를 지키며 이중 단 한명만이 배신을 할지로다.\\n여섯째. 장미가 핀 담장 밑에는 행운의꽃도 함께 피는구나.\",\"679\":\"첫번째. 소리와 함께 사는 \\\"양\\\"이로구나.\\n두번째. 유리속에 갇힌 달은 또 다른 유리속에 갇힌 태양과 단한번 만나는구나.\\n세번째. 지평선에 하늘을 떠다니는 황금침대가 감춰져 있구나.\\n네번째. 행복은 인간의 산 양쪽에 존재하며 그것은 웃음과 함께 하리로다.\\n다섯째. 열개의 다리는 흰색과 검정색의 땅을 밟고 행복을 만들지로다.\\n여섯째. 행운의 넥타이는 마술에 걸려 나무상자속에 보관되리로다.\",\"680\":\"첫번째. 꿀벌이 앉은 선인장은 山 밑에 기둥이 되는구나.\\n두번째. 육각의 상자에 존재하는 金 은 七 을 이룰지로다.\\n세번째. 도장이 찍힌 종이는 금빛모래의 이불이 되리로다.\\n네번째. 화면이 다섯개요 소리는 둘이며 숟가락은 여섯개로구나.\\n다섯째. 지갑속에 존재하는 카드는 B 이며, M 이 될때 사용되리로다.\\n여섯째. 三月이 지나가며 가장 먼저 글이 사라지고 그림이 남으니 새로운 시작이구나.\",\"681\":\"첫번째. 새벽을 여는 소리는 검은 흑구름에 갇히는구나.\\n두번째. 지하로 들어가, 긴 龍 을 타고 이동하니 田 에 도착하는구나.\\n세번째. 군인은 총을 가지고 검은 불꽃을 피우지만 ,우주아래에 흰점일 뿐이로구나.\\n네번째. 파랑새는 촛불위로 넘어가 행운의 태풍을 만나리로다.\\n다섯째. 행복을 여는 열쇠는 구름아래에 계단을 내려가 존재할지니,금빛열쇠가 아니라 녹슨열쇠를 찾을지로다.\\n여섯째. 안경을 피해 비행체는 추락하며, 이는 곧 태양의신이 지켜주리로다.\",\"682\":\"첫번째. TV속에 들어간 나무는 행운의 나무로구나.\\n두번째. 태평양을 건너 소중한 물을 얻어, 행복의 집으로 돌아가는구나.\\n세번째. 진흙뻘에 갇힌 꽃게는 황금조각을 지키리로다.\\n네번째. 오른쪽으로 다섯발자국 건너 횡단보도를 건너며 사거리 우측 약국이로구나.\\n다섯째. 하늘을 걷는 신발을 신고 지구를 세바퀴 돌아 서울에서 멈추리로다.\\n여섯째. 빗방울이 커져서 홍수가 나며 그 홍수는 고래를 살리는 생명수로구나.\",\"683\":\"첫번째. 장갑이 二 이며,하나는 물을 만나며 하나는 공을 만나리로다.\\n두번째. 별을 가진 나무는 유리가 없는 창문밖에 서있을지로다.\\n세번째. 커피는 세번째 잔에 담겨질것이니 첫번째와 두번째 커피잔은 반드시 피할지로다.\\n네번째. 동쪽의 해는 깃발의 그림자를 만들고, 가장 긴 그림자의 끝을 찾을지로다.\\n다섯째. 가장 큰 폭포의 서쪽에 생긴 동굴은 12월에 필요한 동굴이구나.\\n여섯째. 사다리를 가진 남자 다섯중 한명만이 바다를 건널지로다.\",\"684\":\"첫번째. 서커스의 광대는 세개의 줄을 타고 있으며 火 金 地 로다.\\n두번째. 사자의 이빨을 가진 소년은 동굴에 갇히는구나.\\n세번째. 코끼리의 보화는 원숭이와 태양이 만나는 신비의 섬에 존재하리로다.\\n네번째. T 는 0 으로 시작되어 마지막으로 만나 터지는 장소에서 부터 시작되리로다.\\n다섯째. 태양의 폭풍우는 생명을 지키는 항아리속을 뚫지 못하는구나.\\n여섯째. 두번의 박수속에서 점프는 열개의 손가락이 기억하리로다.\",\"685\":\"첫번째. 행복한 구름위에 지어진 집이로구나.\\n두번째. 태양이 다섯번 떠오르니 五龍이 나타나는구나.\\n세번째. 금반지는 호수안에 빠지며 홍수가 나서 먼 여행을 떠나가는구나.\\n네번째. 지구에서 가장 멀리 떨어진 별에서 온 편지로구나.\\n다섯째. 커피잔을 쏟아 행복을 담을지로다.\\n여섯째. 일곱명을 초대하는 자리는 결혼식이며, 광대와 사진사가 함께 하리로다.\",\"686\":\"첫번째. 불나방이 모닥불로 들어가며 흑진주를 얻을지로다.\\n두번째. 겨울고드름은 기와끝에 존재하며, 날카로움의 끝이 되는구나.\\n세번째. 비가 온후 진흙속에서 왕의투구를 발견하게 되리로다.\\n네번째. 별이 아홉이요 오리는 별을 담아 날개를 펴리로다.\\n다섯째. 흑인은 백인과 함께 춤을 추며 왕궁의 門 앞에서 약속할지로다.\\n여섯째. 어린이의 동심은 나무장난감으로 시작되며 이어 불장난이 시작되는구나.\",\"687\":\"첫번째. 나무로 된 숟가락은 황금호박의 주인이 되리로다.\\n두번째. 놀이터는 뱀을 만나며,어린이는 울음을 터뜨리는구나.\\n세번째. 가장 넓은 마당은 금으로 둘러쌓여 들어갈수 없구나.\\n네번째. 二月 에는 금성으로 떠나는 기회를  세번 가지며 그중 첫번째 기회로구나.\\n다섯째. 비닐우산위에 쏟아지는 우유빛 빗줄기는 거인의 생명이되리로다.\\n여섯째.  식당이 하나요 그 오른쪽에 행운의 집이 둘이며 그 둘은 모두 물바다가 되리로다.\",\"688\":\"첫번째. 사냥개는 \\\"의자\\\"를 사냥하리로다.\\n두번째. 노을은 그림자를 자라게 하며, 그림자가 가장 길때로구나.\\n세번째. 뱃고동소리는 섬으로 전달되며,기다리는 바다소녀의 꿈이로구나.\\n네번째. 불빛은 八 이요, 그 안에 따뜻한 집이로구나.\\n다섯째. 포크레인은 千개가 존재하며 모두 하늘로 날아오르리로다.\\n여섯째. 태양을 뒤로 하고 어둠을 찾을지니 가장 어두움속에서 자라는 장미로구나.\",\"689\":\"첫번째. 푸른하늘위에 존재하는 섬은 소나무섬이로구나.\\n두번째. 봄바람을 맞은 피아노는 \\\"흰고래\\\"의 등에 올려져 있구나.\\n세번째. 숲속의 거인은 안식을 가지고 구름은 숲에게 평온을 주는구나.\\n네번째. 태풍이 지나가 동쪽으로 세걸음을 건너니, 큰바위가 존재하며 그위에 한 스님이 앉아있구나.\\n다섯째. 비밀의 유리상자는 우체국에 실려가는구나.\\n여섯째. 붉은 잎사귀위에 존재하는 사마귀는 그 자리에서 움직이지 않는구나.\",\"690\":\"첫번째. 접시에 놓은 고등어는 점심만찬이구나.\\n두번째. 해바라기씨는 가장 높은 언덕위에 뿌려지리로다.\\n세번째. 유리속의 황금태양은 유리를 깨뜨리지 않고 빠져 나오는구나.\\n네번째. 세개의 가장 큰 門 중에서 약속의 문을 찾을지로다.\\n다섯째. 인간의 \\\"가장귀한보물\\\"을 찾아 구름아래에 감출지로다.\\n여섯째. 비바람은 가장 큰 주머니속에 담겨져 여왕의 선물이 되리로다.\",\"691\":\"첫번째. 비빔밥은 나무아래에 존재하며, 삿갓을 쓴 사내의 저녁식사로구나.\\n두번째. 거울을 비추니 \\\"자작나무의 시\\\" 로구나.\\n세번째. 호랑이는 태평양을 건너 王 이 되리로다.\\n네번째. 수리산에 오르니 행복의 마을이 보이는구나.\\n다섯째. 마음이 평온하며 길을 건너니, 보이는것은 \\\"잣\\\"을 까는 아낙네로다.\\n여섯째. 눈물을 세번 흘리니 행복이요, 이는 곧 유명한 사진으로 남을지로다.\",\"692\":\"첫번째. 해가 두번째 뜰때 가장 먼저 山에 오르는 남자는 행운이로구나.\\n두번째. 스케이트를 타고 사과2개와 세명의 사람이 존재하리니 그 그림자가 되리로다.\\n세번째. 고속도로는 태풍위에 놓여져 세대의 버스가 지나가리로다.\\n네번째. 3월의 손님은 주인과 함께 하며, 삼일뒤에 떠나는구나.\\n다섯째. 비바람을 장독대에 담아 행운의 밭에 묻을지로다.\\n여섯째. 순간은 의미가 없고 기억만이 존재를 나타내며, 모든것은 허상이로구나.\",\"693\":\"첫번째. 유리와 거울을 함께 물에 넣어 달걀을 비추니 행운이로다.\\n두번째. 사과는 접시에 담겨져 있으며 그 앞에는 낙타의 존재로구나.\\n세번째. 비가 오는 날에 달팽이는 느티나무위로 올라가리로다.\\n네번째. 새로운 파도는 붉은색 유리병에 담겨 프랑스로 가는구나.\\n다섯째. 악기를 연주하는 악사는 파랑새를 가지고 있구나.\\n여섯째. 노인이 탄 돛단배는 동쪽의 외로운섬앞에서 빛을 쫓으리로다.\",\"694\":\"첫번째. UFO 의 비행시간은 지구와 바둑과의 사이에 답이 있구나.\\n두번째. 배구와 농구의 공통은 사라지며 다름만 남을지로다.\\n세번째. 기러기떼들은 집으로 돌아가며 그 집은 제주도에 존재하리로다.\\n네번째. 三木 은 九木 에 가려 빛을 볼수 없으니, 빛을 볼수 있는 생명의 木을 찾아낼지로다.\\n다섯째. 요리사는 구름산에 올라 마지막 요리를 하리로다.\\n여섯째. 다리를 건너 좌측으로 가며 붉은색 차를 넘어 가장 따뜻한 집이 나타나리로다.\",\"695\":\"첫번째. 책 다섯권은 반대쪽으로 세워져 하늘위에 떠있으리로다.\\n두번째. 동쪽의 불빛은 다섯이요 세번 지나니 금밭이로구나.\\n세번째. 龍 은 상처를 받고, 회색도시의 그림자를 지나 두번의 승리를 얻어내리로다.\\n네번째. 十 을 지나니 百 을 얻어냄이요 구름이 걷히니 소낙비가 내리는구나.\\n다섯째. 휘파람새는 다섯해를 지나서 새로운 바람을 취할지로다.\\n여섯째. 물을 가진 포수는 별을 가진 의사를 좋아하는구나.\",\"696\":\"첫번째. 나무의자는 다섯이요,그 위에 독수리가 앉을 의자를 찾을지로다.\\n두번째. 창을 든 병사는 바다를 건너 쌍둥이 섬에 도착하여 공주를 찾을지로다.\\n세번째. 투명한 유리잔에 비친 집은 하늘에 떠 있는 집이로구나.\\n네번째. 책을 펴서 父 의 얼굴을 볼수 있으며, 책을 덮으니 아무도 없구나.\\n다섯째. 망치를 불에 넣어 강하게 만들어 한장의 유리를 때릴지로다.\\n여섯째. 비치볼은 마지막 해변에 세개가 존재하며 이중 주인의 것은 가장 무겁구나.\",\"697\":\"첫번째. 구름은 하늘위로 떠오르며 피라미드는 한개만이 자리를 지키고 그 아래는 눈이 보이는구나.\\n두번째. 산아래로 추락하여 바닥으로 부터 우측으로 꺾어져 그 위에 \\\"날개\\\"로구나.\\n세번째. 카페의 황금종 은 정오에 울리며, 그 시간에 \\\"王\\\"의 약속이 지켜지리로다.\\n네번째. 바닷속의 보물은 태양을 가진자만의 소유로구나.\\n다섯째. 비너스의 모자를 만들어 가장높은 탑을 세우리로다.\\n여섯째. 거목은 소나무를 가릴지니 그 옆은 행운이로구나.\",\"698\":\"첫번째. 담벼락에 핀 장미꽃은 태양이 필요하구나.\\n두번째. 소나무는 육지에 살고, 느티나무는 섬에 살리로다.\\n세번째. 무릎을 꿇고 기도를 할때 UFO 의 비밀을 알수 있을지로다.\\n네번째. 비를 맞은 단풍나무는 백마가 사는 집이로구나.\\n다섯째. 외나무다리에서 만난 곰과 사슴은 하나의 공통점이 있구나.\\n여섯째. 가장 많이 가진 人 은 가장 적게 가진 人 과 만나 행복을 가지리로다.\",\"699\":\"첫번째. 우주속에 \\\"인간의 삶\\\" 은 순간이며 시간은 영원하구나.\\n두번째. 어린아이의 웃음과 울음 사이로구나.\\n세번째. 비가 오는 날에 우산은 여섯개가 필요하며 반드시 한개의 우산은 펼수가 없구나.\\n네번째. 구름속에 숨겨진 반지는 왕의 반지로구나.\\n다섯째. 금도끼에 나무가 쓰러지며 은도끼에 바위가 깨지리로다.\\n여섯째. 세계를 여행하기 위한 가장 튼튼한 배를 고를지로다.\",\"700\":\"첫번째. 행복한 나비의 세상은 튜울립 으로부터 시작되는구나.\\n두번째. 우유를 마시는 아기는 행복의 꿈을 꾸고 있구나.\\n세번째. 네번째 널뛰기를 뛰어서 돌담을 넘어야 하며 그 이후에 자전거가 기다리고 있구나.\\n네번째. 돈을 가진 부자는 돌을 가진 거지와 친구가 되는구나.\\n다섯째. 생명보다 富를 선택한 의사의 웃음은 악마의 웃음이 되리로다.\\n여섯째. 油 는 쓰러지고 동쪽으로 향해 다섯번 건너 水가 되리로다.\",\"701\":\"첫번째. 새로운 출발은 네모난 사각위에 이루어지며 신서의붓이 첫 시작이구나.\\n두번째. 서쪽 방향에 일곱번째 존재하는 느티나무는 행복한 父子 의 안식처로구나.\\n세번째. 즐거운 낙엽을 가진 나무꾼은 비밀의 공간에 낙엽을 보관하리로다.\\n네번째. 번개를 가진 남자와 붉은컵을 가진 남자는 둘다 머리가 하얗구나.\\n다섯째. 거리의 악사는 춤을 추며 그 앞은 다섯명의 관객들이 즐거워 하리로다.\\n여섯째. 부족함을 가진 삐에로는 늘 거짓모자를 쓰는구나.\",\"702\":\"첫번째. 새벽의 희망은 소나무의 첫 이사로구나.\\n두번째. 무지개를 가진 행복의 나무탑은 이제서야 도착하니 창조의 시작이구나.\\n세번째. 머리는 두개의 선물을 가지고도 손이 가진 선물을 탐하리로다.\\n네번째. 지구속에 시간이 존재하며 지구위에는 빌딩들이 즐비하며 정오가 되리로다.\\n다섯째. 이미 사라진 두개의 병은 다시 찾을수는 없지만 녹색의 행복은 찾을지로다.\\n여섯째. 비가 내린 오후에 노인은 다시보니 백발이구나.\",\"703\":\"첫번째. 별을 가슴에 품은 사슴은 소나무 아래에 숨어 있구나.\\n두번째. 한강에 도착하니 서쪽으로 가장 빠른 자동차가 서 있구나.\\n세번째. 세월은 흘러 風 이 되어 자신의 몸을 적시리로다.\\n네번째. 山 정상까지 오르며, 다시 내려갈때 함정이 五이며,낙엽을 밟지 말아야 사는구나.\\n다섯째. 비가 내린 후에 섬에 사는 세명의 아낙네에게는 새로운 뗏목이 필요하구나.\\n여섯째. 말이 먹는 풀을 피하여 추락하니 새로운 형상이 생기는구나.\",\"704\":\"첫번째. 권투선수는 셋이며 이중 가장 무거운 선수가 링에 오를지로다.\\n두번째. 태양을 둘로 나누어 동쪽으로 金을 숨기고 서쪽으로는 銀을 숨기리로다.\\n세번째. 산을 오르는 노인의 지팡이는 셋이며 정상에 서는 지팡이로다.\\n네번째. 거미줄은 밤에 만들어지며 새벽이 되어 만찬이 시작되리로다.\\n다섯째. 붉은색 융단을 깔아 춤을 출지니 외로운 춤이로구나.\\n여섯째. B 를 시작으로 열여덟번째 남자이며 그의 짝은 모자를 썼구나.\",\"705\":\"첫번째. 코끼리는 보이지를 않고 그림자는 山中에 숨겨져 있구나.\\n두번째. 물레방아를 여덟명의 남자들이 돌리며,그 중앙에 반달이 뜨리니 행운의 방향이로구나.\\n세번째. 소나무와 대나무를 하나로 만들어 물에 띄우리로다.\\n네번째. 두개의 인생은 여왕의것이며 연탄을 가진 인생과 보석을 가진 인생이구나.\\n다섯째. 가장 무거운 신을 신고 가장 가벼운 모자를 쓰고 떠나는 여행이구나.\\n여섯째. 번개는 井속에서 맑은 물과 깨끗한 모래로만 만들지로다.\",\"706\":\"첫번째. 거울을 마주보고 오른손을 뻗어 동그라미를 만드는구나.\\n두번째. 비를 맞은 우산은 벽난로 뒤에 숨는구나.\\n세번째. 책을 가진 한남자는 이주뒤에 한 여자를 만날지로다.\\n네번째. 걸어서 사막에 도착하니 태양이 지는구나.\\n다섯째. 일꾼이 十 이요, 허수아비가 三 이니 가장 많은 곡식을 거두리로다.\\n여섯째. 서울로 올라간 청년은 둘이요, 시골로 내려갈때 세월은 흐를지로다.\",\"707\":\"첫번째. 계란을 실은 손수레는 언덕에서 멈추는구나.\\n두번째. 당근과 양배추는 바다에서 건져 올릴지로다.\\n세번째. 흰수건을 가진 세번째 남자는 닭이 울면 여섯번째 공주를 선택하리로다.\\n네번째. 생선을 가진 곰은 문앞에서 휴식을 취하리로다.\\n다섯째. 수레를 만든 사람은 황금 트럼펫을 얻을지로다.\\n여섯째. 가장 키가 큰 사람만이 가장 높은곳에 오를지로다.\",\"708\":\"첫번째. 그대로 멈춘 인생은 돌 하나로 다시 시작되리로다.\\n두번째. 王 은 龍 을 타고 가장 높은 산에 오를지니 그곳에서 천상수를 얻을지로다.\\n세번째. 원숭이는 윷을 선물로 받아 행운의 일곱을 더하리로다.\\n네번째. 태풍은 사라지고 숲에 여우와 거북이 함께 공존하리로다.\\n다섯째. 사막의 피라미드위에 별이 세개가 뜰것이며 이중 가장 우측의 별이 행운이구나.\\n여섯째. \\\"수레를 가진 거지\\\"와 \\\"비옷을 파는 사장\\\"이 함께 만나는구나.\",\"709\":\"첫번째. 식탁위에 놓인 흰종이는 검은종이를 만나 함께 공존할지로다.\\n두번째. 공작새는 대나무위에 존재하며 두개의 별을 가질지로다.\\n세번째. 세번째 섬을 찾아간 배는 폭풍우를 만나 새로운 빛이 되는구나.\\n네번째. 뱀은 항아리속에 존재하며 아홉의 표시를 만나야 행복하구나.\\n다섯째. 넥타이는 유리컵속에 담겨 의미가 생길지로다.\\n여섯째. 기차를 탄 해적은 T를 가진 유리섬에 갇히는구나.\",\"710\":\"첫번째. 사거리에서 충돌이 일어나며 붉은황소가 보이는구나.\\n두번째. 항해를 하는 남자는 갑판위에 백조를 숨기는구나.\\n세번째. 화가는 비행기를 훔쳐 가장 작은 주머니에 넣으리로다.\\n네번째. 붉은접시위에 고등어는 은빛이로구나.\\n다섯째. 아홉번 이사를 가서 마지막에 단한번 물길을 찾을지로다.\\n여섯째. 가장 빠른 지름길을 피하여 가장 높은 산을 오를지로다.\",\"711\":\"첫번째. 순리를 따라서 이동하니 하나요 그 옆에 꺾여 쌍을 이룬 셋이 남는구나.\\n두번째. 진흙길을 따라 해바라기씨가 존재하리로다.\\n세번째. 호박은 지붕위에 자라며 무르익어 꽃이 피리로다.\\n네번째. 날지 못하는 바위위에 날지 못하는 새 한마리로다.\\n다섯째. 볼펜을 가진 동자는 붓을 가져오지 못하는구나.\\n여섯째. 무인도가 존재하며, 적막함속에 태풍이 찾아오며 그 이후에 새들의 나타남이로다.\",\"712\":\"첫번째. 감자를 캐어서, 황금항아리에 담을지로다.\\n두번째. 서랍은 열리고, 소년의 심장이 멈춘뒤에 소녀는 비로소 진실을 알수 있었으니 애통하구나.\\n세번째. 우물은 사랑을 위하여 채워지고, 우물이 말랐을때 그 사람은 보이지 않는구나.\\n네번째. 나무는 서 있고 일곱의 젖소는 평화롭고 그 옆에 바람이 부는구나.\\n다섯째. 손바닥을 비비면 황금모래가 떨어지며, 그 옆에 장사꾼은 지켜보는구나.\\n여섯째. 두개의 열린 자물쇠는 열쇠를 간직한 소년의 꿈이었구나.\",\"713\":\"첫번째. 고구마를 가진 달은 행복을 가졌구나.\\n두번째. 유리가 깨진 윈도우에 홀로 서있는 마네킹은 슬프구나.\\n세번째. 코끼리는 새끼들과 사슴과 함께 북쪽 초원으로 세번 이동하리로다.\\n네번째. 구렁이는 사차선 사거리에서 버스가 올때까지 기다리는구나.\\n다섯째. 맨발의 남자가 우산을 들고 행운을 기다릴것이니 겨울이구나.\\n여섯째. 해적을 만나 날짜를 알수 있으며 북쪽으로 한단계 위에 귀인이 살고 있구나.\",\"714\":\"첫번째. 가오리는 바닷속에 존재하는 행운과 만나리로다.\\n두번째. 숲속에 보이는 꼬리는 구름과 만나 하나가 되리로다.\\n세번째. 비행기를 탄 소년은 이탈리아를 건너 유리섬에 도착하리로다.\\n네번째. 번개를 맞아 나무가 불타며,우측으로 100년의 세월이 지나 보물이 되는구나.\\n다섯째. 꽃게를 잡는 어부는 폭풍을 만나 집으로 돌아가지 못하는구나.\\n여섯째. 비밀의 화원은 十 의 모양속에 金 과 銀 을 찾을지로다.\",\"715\":\"첫번째. 꺼꾸로 말하는 동굴에서 두명중 한명이 와인한잔을 따라야 나무가 자라는구나.\\n두번째. 유리를 자르니 무지개 빛이 비추고, 그 빛으로 새로운 문이 생기는구나.\\n세번째. 고장난 피아노위에서 고양이는 새로운 연주를 시작하리로다.\\n네번째. 사막속에 더위를 피하여 모래밭에 북극의 고드름을 심을지로다.\\n다섯째. 군인의 경례는 모두 세번이요,두번째 경례속에서 작별을 할지로다.\\n여섯째. 나무꾼은 나무뗄깜을 찾아 지리산에 머무르니 폭포아래에서 선녀와의 만남이구나.\",\"716\":\"첫번째. \\\"흙벽\\\"으로 막히며 그것을 뚫을 도구로다.\\n두번째. \\\"詩\\\"로 \\\"木\\\"을 그리는 화가를 찾아 \\\"빛\\\"을 얻으리로다.\\n세번째. 굴뚝위에 연기는 서쪽으로 흘러가며 소나기가 세번 내리는구나.\\n네번째. 생일파티가 열리며 9개의 신발이 문앞에 있지만 결국 3개를 잃어버리는구나.\\n다섯째. 가장 높은곳에 사는 토끼는 달빛아래 호수가 고향이구나.\\n여섯째. 미로를 만들어가는 인간은 막힘이 세번건너뛰어,동쪽에 존재하는 미로속에 갇히는구나.\",\"717\":\"첫번째. 믿는도끼에 발등이 찍히니 후회하는 남자로구나.\\n두번째. 가장 높은 곳에서 영혼을 가진 경찰은 태양을 두개 가지리로다.\\n세번째. 비밀의 공장에서 만들어진 인형은 행복한 인형이로구나.\\n네번째. 세번의 이사는 동쪽으로 이동중에 다섯개의 함정을 만나며 이중 한곳에 빠지는구나.\\n다섯째. 유리가 깨진 창가에서 3시간동안 風을 맞으리로다.\\n여섯째. 이슬비가 내린 오후에 나비와 무지개는 하나의 그림자가 되리로다.\",\"718\":\"첫번째. 용의얼굴을 달에서 찾으리니 행운이로다.\\n두번째. 비밀의화원에서 잃어버린 우산을 찾는구나.\\n세번째. 노인의 행복한 보물은 버섯과 해바라기를 가진 밭이로구나.\\n네번째. 흰고래는 검은고래와 함께 북극으로 향하며 깃발아래에 멈추리로다.\\n다섯째. 九月 세번의 쉼속에 다섯번의 행운을 찾으며 이후에 함정에 갇히리로다.\\n여섯째. 태양속에서 꺼낸 나무망치로 집을 지을지로다.\",\"719\":\"첫번째. 미인도는 11월 가장 넓은 창문으로 볼지로다.\\n두번째. 수박과 우산을 가방에 넣어 두소녀는 가장 멀리 갈지로다.\\n세번째. 태풍이 오는 날에 날개를 잃어버리며 황금나무에 걸리는구나.\\n네번째. 세번의 기회를 가진 행운의 복주머니가 대나무속에서 나타나는구나.\\n다섯째. 인간세속에서 마지막 남은 \\\"이중성\\\"의 반대로구나.\\n여섯째. 풍선을 가진 부모는 아기를 업고 행복한 그네를 타는구나.\",\"720\":\"첫번째. 100년된 산삼은 상자에 실려 서울로 올라가는구나.\\n두번째. 도둑은 담을 넘어 함정에 빠질것이나 단풍나무의 도움을 받을지로다.\\n세번째. 두개의 돌사이에 필요한 나무는 생명의 나무이며 돌을 하나 더 더하리로다.\\n네번째. 지갑속에 황금을 잃어버리며 지갑을 버릴때 황금을 찾을지로다.\\n다섯째. 지리산 곰은 세개의 큰바위에서 잠을 자며 동쪽으로 이사를 갈지로다.\\n여섯째. 우산을 쓴 장군은 태평양을 건너 자신을 찾는구나.\",\"721\":\"첫번째. 가장 작은 고양이는 흰상자에 담겨 잔디위에 존재하는구나.\\n두번째. 유리상자에 존재하는 세가지 열쇠중에서 부러진 열쇠를 선택하는구나.\\n세번째. 파도에 부서진 바이올린은 아직도 연주가 가능한 바이올린이로다.\\n네번째. 수요일의 만찬은 七日 을 기다려야 하며 손님은 그 이후에나 오는구나.\\n다섯째. 백발은 희고 검은양복의 남성은 시간이 멈추어진 다리위에서 기다리는구나.\\n여섯째. 풍선을 가진 광대는 신문에 가려져 사진에 찍히지 않는구나.\",\"722\":\"첫번째. 하얀 풍선은 겨울기차에 묶여 있구나.\\n두번째. 바다의 중심을 찾아서 행복의 마음을 심을지로다.\\n세번째. 책을 선물로 받아 천장의 새로운 공간을 찾을수 있구나.\\n네번째. 소리를 항아리에 담아 에펠탑의 T.O.P 에 놓을지니 세상을 비추는구나.\\n다섯째. 파인애플을 \\\"+\\\" 에 나누어 담아 \\\"같은형제의 선\\\"을 찾을지로다.\\n여섯째. 여섯번째 계단에 올라 열쇠를 찾아 우측의 \\\"기다림\\\"의 문을 열지로다.\",\"723\":\"첫번째. 움직임 을 가진 푸른하늘의 \\\"눈\\\"을 찾을지로다.\\n두번째. 태평양위에 떠있는 돛단배는 태풍이 지나간후에 황금의섬을 찾는구나.\\n세번째. 十 은 산위에 떠 있으며 태양풍을 전하리니 안전한 집안에 갇히는구나.\\n네번째. 팽이는 얼음위에 서있으며 동자는 다섯번의 기회를 얻으리로다.\\n다섯째. 포도는 지나가고 귤이 다가오니 시간의 흐름이구나.\\n여섯째. 종소리를 듣고 문앞으로 나가보니 케잌이 한개 놓여 있구나.\",\"724\":\"첫번째. 이름을 가진 노루는 산에 존재하는구나.\\n두번째. 수제비를 끓이는 노모의 정성은 복이로다.\\n세번째. 황소는 별이 지는 위치에서 月 과 만남이 있으리로다.\\n네번째. 파도의끝 지점에서부터 시작하여 메마른 땅과의 만남이 이루어지리로다.\\n다섯째. 대왕릉의 이사는 완전한 비행체를 만남으로써 자리를 잡을지로다.\\n여섯째. 용의 얼굴을 다시볼수 없을때 꼬리를 만나며 이제야 행운은 찾아오리로다.\",\"725\":\"첫번째. 수도꼭지에서 네잎클로버 위로 떨어지는 물줄기는 생명수로구나.\\n두번째. 집으로부터 가장 멀리 존재하는 우주꽃을 찾아 행운을 취함이로다.\\n세번째. 가짜꽃이 九이며,이중 세번째꽃은 진짜꽃보다 더 진한 향내가 나리로다.\\n네번째. 정을 주는 버섯은 다섯이요 그 위에 구름은 여섯이니 행복하구나.\\n다섯째. 새로운 삶은 유토피아속에서 다시 태어나며 뫼비우스의 띠가 그 門 이로구나.\\n여섯째. 비밀의화원을 지키는 병사는 늙었으니 이제 새로운 병사가 \\\"쉼\\\"을 선물하리로다.\",\"726\":\"첫번째. \\\"초록의 구름\\\"이 지나간후에 가장 밝은 행복한 \\\"별빛\\\"을 볼수 있을지로다.\\n두번째. 성의 외곽을 둘러싼 장미는 아름다움이 지나간후에 가시만이 남을지로다.\\n세번째. 효도는 황금땅에서 더덕을 취하여 만들지로다.\\n네번째. 기러기는 두번 추락하여 일곱번째 기러기를 기다리다 사라지니 너무 안타까움이로다.\\n다섯째. 가장 밝은 웃음은 여덟번째의 웃음이며,행운은 하나의 나무로부터 시작되는구나.\\n여섯째. 태양은 따뜻한 물위에 존재하며 두 발을 담그니 사라지는구나.\",\"727\":\"첫번째. 탱크는 산위에 존재하며 비행기는 무지개 위에 존재하는구나.\\n두번째. 보라빛의 혹성은 달과 토성의 중간에 서리로다.\\n세번째. 북극위에 존재하는 자유의여신상 이로다.\\n네번째. 코끼리의 양탄자는 나이아가라 폭포 속에 감추어져 있구나.\\n다섯째. 스키를 탄 두 남자는 가장 낮은 산아래에서 만나는구나.\\n여섯째. 우주선은 지구에서 가장 먼곳에 안식처를 만들지로다.\",\"728\":\"첫번째. 더덕과 도라지의 만남으로 새로운 흙이 탄생하리로다.\\n두번째. 두개의 날개를 가진 태극은 사랑의 징표를 남기리로다.\\n세번째. 의자에 앉아서 우산을 펼치니 西風이 부는구나.\\n네번째. 의자 다섯을 태풍위에 올려놓는구나.\\n다섯째. 투명한 망토는 불화산위에 존재하리로다.\\n여섯째. 흑백사진속에 남겨진 풍경은 세마리의 龍이로다.\",\"729\":\"첫번째. 테니스를 치는 여왕은 북극의 가장 높은 탑에 존재하리로다.\\n두번째. 쵸콜릿을 가진 농부는 놀이공원앞에서 약속을 지키는구나.\\n세번째. 로봇은 25년중에서 낙엽을 가질때 세상에 나타나리로다.\\n네번째. 선글라스는 태양을 피할수는 있으나 소나기를 피할수가 없구나.\\n다섯째. 빌딩의 옥상끝에 휘날리는 깃발은 흰색바탕에 녹색마크로구나.\\n여섯째. 크리스마스날 담배를 가진 남자는 흰색모자에 검은색 양복을 입었구나.\",\"730\":\"첫번째. 배고픔이 존재하리니 그 앞에 가장 많은 식량이로구나.\\n두번째. 노인은 아들을 등에 지고 별속에 꿈을 바라볼지로다.\\n세번째. 세번 넘어가니 숲속이요,다섯번넘어가면 동굴이니 그 중간에 서리로다.\\n네번째. 토마토를 실은 지게차는 바다속에 잠기는구나.\\n다섯째. 마차는 연기속에서 가장 빛나는 꽃 옆에 존재하리로다.\\n여섯째. 갈매기가 존재하는곳에 새로운 흰색꽃이 피는구나.\",\"731\":\"첫번째. 외줄위에서 춤을 추는 광대로구나.\\n두번째. 간장은 옹기에 담겨 겨울땅속에 묻혀 있구나.\\n세번째. 하얀시계는 초침이 움직이며,八人은 탁자에 앉아있구나.\\n네번째. 구름다리를 건너 하늘을 바라보며 비로소 외투를 벗는구나.\\n다섯째. 11月 塞翁之馬 의 馬 를 찾을지로다.\\n여섯째. 유리컵속에 수박을 집어 넣는 방법을 찾아야 보이는구나.\",\"732\":\"첫번째. 도토리를 가진 토끼는 동굴에 들어가는구나.\\n두번째. 두개의 우산중 황금우산을 찾으나 비를 피하지 못하는구나.\\n세번째. 유리구두를 바다에 빠뜨린후 10년이 지난후 다시 되찾을지로다.\\n네번째. 바람이 불어 파란깃발이 휘날리니 시간이 멈출때 비로소 음악이 들리는구나.\\n다섯째. 가장 큰 잉어는 부산에서 서울로 향할지로다.\\n여섯째. 스님은 큰 나무사이에 앉아있으며 완두콩을 가지고 있구나.\",\"733\":\"첫번째. 기사가 잃어버린 활과 화살은 가장 높은 언덕에서 발견할지로다.\\n두번째. 한강에서 코스모스가 필때를 맞추어 배를 띄울지로다.\\n세번째. 아들과 함께 오른 나무는 아버지가 심은 나무로구나.\\n네번째. 곰은 세마리이며 폭죽이 터질때 연극무대는 막이 오를지로다.\\n다섯째. 하늘위에 독수리는 소원을 가졌으며 마지막소원은 서쪽 마지막 끝 하늘에 존재하리로다.\\n여섯째. 순풍이 불어 배는 떠나며 가장 작은 섬 옆에 가장 큰 섬이 보이는구나.\",\"734\":\"첫번째. 행복한 화가의 붓은 피아노속에 감추어져 있구나.\\n두번째. 토마토와 파인애플은 성탄절에 함께 만나서 행복하구나.\\n세번째. 낙엽을 쓸어담을 자루에는 곡괭이가 들어있구나.\\n네번째. 기억속에 찻집은 긴 외투를 입은 사람만이 들어갈수 있구나.\\n다섯째. 유리로 만든 자동차는 지구를 한바퀴 돌아서 하늘로 올라가는구나.\\n여섯째. 푸르름이 가득한 어항속에 力을 가진 작은 조개 가 살고 있구나.\",\"735\":\"첫번째. 세상에서 가장 깊은곳은 단 하나이며,이곳에 붉은색을 가진 한 남자가 빠지리로다.\\n두번째. 푸른섬에서는 이제 혼자며 이제 남은것은 하늘과 두조각의 쵸콜릿이구나.\\n세번째. 스키를 타고 내려오는 山에는 가방과 선글라스가 남았구나.\\n네번째. 田 에서 한 농부가 흰눈속에서 가장 소중한 꽃을 발견하리로다.\\n다섯째. 오렌지를 취한 소녀는 흰토끼를 안고 있구나.\\n여섯째. 바닥에 앉으니 하늘이요 하늘을 쳐다보니 땅이로구나.\",\"736\":\"첫번째. 그림자가 天이요, 실체는 地 이로구나.\\n두번째. 용기를 가진 백기사는 검은말을 타고 꽃을 피하여 폭풍의 언덕에 서리로다.\\n세번째. 커피잔은 다섯이요 사람은 여섯이니 커피잔이 없는 사람이 주인이구나.\\n네번째. 서쪽의 비상구가 잠겨있으니 들어온 입구가 곧 비상구로구나.\\n다섯째. 해바라기는 장미를 안고 자신의 색채를 뽐내리로다.\\n여섯째. 목각인형은 사람을 피하여 유리집속에 감추어지리로다.\",\"737\":\"첫번째. 삼각산 위에 사각산이 존재하며 그 위에 폭풍의 언덕이 존재하리로다.\\n두번째. 카메라는 네번째 글자에 위치하며 그 앞에 서는 의미로구나.\\n세번째. 여덟번째 씨름은 모래판이 아닌 자갈위에서 시작할지로다.\\n네번째. 공주는 백마의 기사를 앞세우고 흑마를 타리로다.\\n다섯째. 불은 밤을 밝히며 소나기는 밤을 식히니 둘이 만나면 하나가 더 생기리로다.\\n여섯째. 초원 위에 집은 별빛에 더 의미가 있으리로다.\",\"738\":\"첫번째. 책상은 유리가 되어 구름위에 존재하는구나.\\n두번째. 유성은 九時에 떨어지며 가장 뜨거울때 보이는구나.\\n세번째. 코스모스와 함께 하는 주전자로구나.\\n네번째. 커피는 王 에게 전달되며 과일은 병사에게 전달되리로다.\\n다섯째. 가장 높은곳에서 발견되며,행복을 가져다주는 수박이로구나.\\n여섯째. 다음의 약속은 사거리에서 북쪽으로 걸어갈때 비로소 지켜지는구나.\",\"739\":\"첫번째. 뿔을 세개 가진 공룡은 폭풍속에 서 있구나.\\n두번째. 봄바람은 불고 세마리의 돌고래는 뛰어오르리로다.\\n세번째. 파도 위에 반쪽무지개가 떠오를지로다.\\n네번째. K 는 L 과 만나서 가장 큰 형상을 이루는구나.\\n다섯째. 연기는 태양으로부터 힘을 가지며 네번째 구멍으로 사라지리로다.\\n여섯째. 투명한 컵위에 조각구름은 풍선을 피해야 사는구나.\",\"740\":\"첫번째. 비옷을 입은 사람들은 동물원 정문앞에 서 있구나.\\n두번째. 2월의 함정을 조심하며 세번건너뛰어 행복의 집에 도착하리로다.\\n세번째. 코뿔소는 가장 작은 구슬속에 담기리로다.\\n네번째. 군인은 밭에서 노인을 만나 황금고구마를 얻을지로다.\\n다섯째. 산위에 구름이 존재하며 가장 가까운 동굴속에서 행운의 열매를 얻을지로다.\\n여섯째. 양배추는 왕에게 존재하는 병을 이기리로다.\",\"741\":\"첫번째. 시장에 가서 가장 뾰족하고 붉은색 물건을 찾을지로다.\\n두번째. 세번째 휴일에 방패연은 나무에 걸렸으니 자유를 잃었구나.\\n세번째. 달의 뒷쪽에 새겨진 일곱개의 다이아몬드로구나.\\n네번째. 단하나의 마지막 포도주는 새로운 주인의 포도주로구나.\\n다섯째. 기차는 되풀이 돌며 멈추어진 시간속에서 정차하리로다.\\nHOLD — 원자료상 중복후보 존재\",\"742\":\"첫번째. 인형의기사는 탁자위의 공주를 찾을지로다.\\n두번째. 돌아갈 길은 사라지고 낙엽이 새로운 길을 안내하리로다.\\n세번째. 파티는 계속되며 오색광대는 황금무대에 서리로다.\\n네번째. 가장 깨끗한 물을 찾아 가장 더러운 손에 담을지로다.\\n다섯째. 소년의 음악은 항아리에 담아 10년이 지나야 들을수 있구나.\\nHOLD — 원자료상 해당 문장 식별 불가\",\"743\":\"첫번째. 장미로 만든 배는 가라앉지 않고 가장 먼곳에 도착하리로다.\\n두번째. 다