<script id="masterR2621NoticeSuggestBottomJS">
(function(){
  function hideModalR2621(){
    const modal=document.getElementById('masterR2617Modal');
    if(modal) modal.classList.remove('open');
  }
  function ensureXButton(){
    const box=document.getElementById('masterR2617ModalBox');
    if(!box) return null;
    let x=document.getElementById('masterR2621ModalX');
    if(!x){
      x=document.createElement('button');
      x.type='button';
      x.id='masterR2621ModalX';
      x.setAttribute('aria-label','종료');
      x.textContent='×';
      box.insertBefore(x, box.firstChild);
      x.addEventListener('click', hideModalR2621);
    }
    return x;
  }
  function apply(){
    const notice=document.getElementById('masterR2617NoticeBtn');
    const suggest=document.getElementById('masterR2617SuggestBtn');
    const modal=document.getElementById('masterR2617Modal');
    const title=document.getElementById('masterR2617ModalTitle');
    const text=document.getElementById('masterR2617ModalText');
    ensureXButton();
    if(notice){ notice.innerHTML='공지사항'; }
    if(suggest){ suggest.innerHTML='건의사항'; }
    if(notice&&modal&&title&&text){
      notice.onclick=function(){
        title.textContent='공지사항';
        text.textContent='항해사 MASTER R26.21\n\n공지사항 버튼을 하단 가로형으로 이동하고 좌우로 벌려 배치했습니다.\n공지사항/건의사항 내용 화면은 최상단에서 열리도록 조정했습니다.\n내용 창 우측 상단에 종료(X) 버튼을 추가했습니다.\n기존 분석 엔진·RAW·U10·성적·승인관리·백업 로직은 변경하지 않았습니다.';
        modal.classList.add('open');
      };
    }
    if(suggest&&modal&&title&&text){
      suggest.onclick=function(){
        title.textContent='건의사항';
        text.textContent='항해사 MASTER R26.21\n\n건의사항 버튼을 하단 가로형으로 이동하고 좌우로 벌려 배치했습니다.\n건의사항 내용 화면은 최상단에서 열리도록 조정했습니다.\n내용 창 우측 상단에 종료(X) 버튼을 추가했습니다.\n추가 연결·문구 정리는 다음 단계에서도 이어갈 수 있습니다.';
        modal.classList.add('open');
      };
    }
    window.__BAEKHAK_MASTER_R2621_HOME__=Object.freeze({
      version:'R26.21',
      noticeSuggestHorizontalBottom:true,
      noticeSuggestSpacedLeftRight:true,
      noticeSuggestModalTopAligned:true,
      noticeSuggestModalXClose:true,
      engineChanged:false,rawChanged:false,u10Changed:false,scoreChanged:false,approvalChanged:false
    });
    return true;
  }
  function boot(){
    let n=0;
    const t=setInterval(function(){n++;if(apply()||n>80)clearInterval(t);},120);
    setTimeout(apply,40);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot,{once:true});
  else boot();
})();
</script>



