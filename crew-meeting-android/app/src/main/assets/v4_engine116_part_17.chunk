<script id="masterR2618HomeRoundAndSmallActionsJS">
(function(){
  function nativeExit(){
    try{
      if(window.BaekhakNative && typeof window.BaekhakNative.exitApp==='function'){
        window.BaekhakNative.exitApp(); return;
      }
    }catch(e){}
    alert('종료 기능은 항해사 MASTER Android 설치본에서 동작합니다.');
  }
  function closeMasterHome(){
    const home=document.getElementById('masterR2617Home');
    if(home) home.style.display='none';
    document.documentElement.classList.remove('master-r2617-home-open');
    document.body.classList.remove('master-r2617-home-open');
    try{window.scrollTo(0,0);}catch(e){}
  }
  function findRoundCard(){
    const round=document.getElementById('round');
    if(!round) return null;
    let el=round;
    while(el && el!==document.body){
      if(el.classList && el.classList.contains('card')) return el;
      el=el.parentElement;
    }
    return null;
  }
  function matchActionSize(){
    const prev=document.getElementById('prevRound');
    const start=document.getElementById('masterR2618StartBtn');
    const exit=document.getElementById('masterR2618ExitBtn');
    if(!prev||!start||!exit) return;
    const r=prev.getBoundingClientRect();
    const cs=getComputedStyle(prev);
    if(r.width>10){start.style.width=exit.style.width=r.width+'px';}
    if(r.height>10){start.style.height=exit.style.height=r.height+'px';start.style.minHeight=exit.style.minHeight=r.height+'px';}
    start.style.fontSize=exit.style.fontSize=cs.fontSize;
    start.style.borderRadius=exit.style.borderRadius=cs.borderRadius;
    start.style.padding=exit.style.padding=cs.padding;
  }
  function install(){
    const home=document.getElementById('masterR2617Home');
    if(!home || document.getElementById('masterR2618ControlPanel')) return !!home;

    const panel=document.createElement('section');
    panel.id='masterR2618ControlPanel';
    panel.setAttribute('aria-label','홈 시작 종료 및 이번 회차');
    panel.innerHTML=`
      <div id="masterR2618ActionRow">
        <button type="button" id="masterR2618StartBtn" class="masterR2618-action">▶ 시작</button>
        <button type="button" id="masterR2618ExitBtn" class="masterR2618-action">⏻ 종료</button>
      </div>
      <div id="masterR2618RoundSlot"></div>
    `;
    home.appendChild(panel);

    document.getElementById('masterR2618StartBtn').onclick=closeMasterHome;
    document.getElementById('masterR2618ExitBtn').onclick=nativeExit;

    const roundCard=findRoundCard();
    const slot=document.getElementById('masterR2618RoundSlot');
    if(roundCard && slot){
      roundCard.id='masterR2618RoundCardMoved';
      slot.appendChild(roundCard);
    }

    requestAnimationFrame(function(){
      matchActionSize();
      setTimeout(matchActionSize,80);
      setTimeout(matchActionSize,350);
    });
    window.addEventListener('resize',matchActionSize,{passive:true});

    /* 버전 안내만 R26.18로 갱신. 기존 모달/버튼 기능은 그대로 사용 */
    const notice=document.getElementById('masterR2617NoticeBtn');
    const modal=document.getElementById('masterR2617Modal');
    const title=document.getElementById('masterR2617ModalTitle');
    const text=document.getElementById('masterR2617ModalText');
    if(notice&&modal&&title&&text){
      notice.onclick=function(){
        title.textContent='공지사항';
        text.textContent='항해사 MASTER R26.18\n\n홈 화면의 시작·종료 버튼을 이전회차 버튼 크기로 축소했습니다.\n기존 본문에 있던 이번 회차(이전회차·회차번호·다음회차·RESULT-BEFORE 안내)를 홈으로 이동했습니다.\n기존 R26.17 분석 엔진·RAW·U10·성적·승인관리·백업 로직은 변경하지 않았습니다.';
        modal.classList.add('open');
      };
    }

    window.__BAEKHAK_MASTER_R2618_HOME__=Object.freeze({
      version:'R26.18',
      roundControlMovedToHome:true,
      startExitMatchedToPrevRoundSize:true,
      resultBeforeLogicChanged:false,
      engineChanged:false,
      rawChanged:false,
      u10Changed:false,
      scoreChanged:false,
      approvalChanged:false
    });
    return true;
  }
  function boot(){
    let n=0;
    const t=setInterval(function(){n++;if(install()||n>80)clearInterval(t);},120);
    setTimeout(install,20);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>


<!-- 항해사 MASTER R26.19 · 홈 배치 재정렬
     업데이트 최상단 / 이번 회차는 업데이트 바로 아래 / 시작·종료는 회차 아래
     R26.18 엔진·RAW·U10·성적·승인관리·백업 로직 무변경 -->
<style id="masterR2619HomeOrderCSS">
/* 업데이트 버튼을 홈 최상단으로 이동 */
#masterR2617UpdateBtn{
  top:2.2%!important;
  left:28.5%!important;
  width:43%!important;
  min-height:6.2%!important;
  z-index:8!important;
