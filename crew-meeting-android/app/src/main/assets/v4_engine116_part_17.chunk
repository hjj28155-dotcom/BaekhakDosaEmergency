  width:58%!important;
  height:auto!important;
  min-height:0!important;
  padding:clamp(6px,1.0vh,10px) clamp(7px,1.25vw,12px)!important;
  gap:clamp(5px,.65vh,8px)!important;
  overflow:visible!important;
  z-index:7!important;
}

