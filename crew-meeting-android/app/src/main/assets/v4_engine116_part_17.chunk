<div id="masterR2617Home" aria-label="백학도사 마스터 홈 화면">
  <div id="masterR2617HomeBg"></div>
  <section id="masterR2630PurposeBanner" aria-label="백학도사앱의 목적">
    <button type="button" id="masterR2630PurposeClose" aria-label="배포 목적 배너 닫기">×</button>
    <div class="masterR2630PurposeEyebrow">백학도사앱의 목적</div>
    <div class="masterR2630PurposeMain">DB-1 성능 개선 · 백학신서와 로또당첨번호의 연관성 분석 · 철저한 검증</div>
    <div class="masterR2630PurposeSub">본 백학도사앱의 궁극적인 목표는 앱에 탑재된 DB-1의 성능을 개선하고, 백학신서와 로또당첨번호의 연관성을 철저히 분석·검증하는 데 있습니다. 더욱 개선되는 엔진으로 발전하여 이 앱을 사용하는 지인들에게 즐거움을 드리고자 노력하겠습니다.</div>
    <div class="masterR2630PurposeNote">비영리 배포 · 무료 · 판매수익 · 유료추천 목적이 아닙니다. 연구 · 기록 · 검증 내용을 지인들과 함께 나누는 참고용 앱입니다.</div>
    <div class="masterR2630PurposeNote" style="margin-top:6px">승인요청에서 사용자가 직접 입력해 저장하는 인적정보는 ‘누구의 지인입니다’라는 소개 관계 한 가지입니다. 승인 기능 운영을 위해 기기 식별값·승인 상태·처리 시각은 기술적으로 저장됩니다.</div>
  </section>

  <button type="button" id="masterR2617StartHit" class="masterR2617-hit" aria-label="시작"></button>
  <button type="button" id="masterR2617ExitHit" class="masterR2617-hit" aria-label="종료"></button>
  <button type="button" id="masterR2617RecoveryHit" class="masterR2617-hit" aria-label="바로 연결하기"></button>

  <button type="button" id="masterR2617UpdateBtn">↻ 업데이트</button>
  <button type="button" id="masterR2617NoticeBtn" class="masterR2617-side">공<br>지<br>사<br>항</button>
  <button type="button" id="masterR2617SuggestBtn" class="masterR2617-side">건<br>의<br>사<br>항</button>

  <div id="masterR2617Modal">
    <div id="masterR2617ModalBox">
      <div id="masterR2617ModalTitle"></div>
      <div id="masterR2617ModalText"></div>
      <button type="button" id="masterR2617ModalClose">닫기</button>
    </div>
  </div>
</div>

<script id="masterR2617DistributionHomeJS">
(function(){
  const home=document.getElementById('masterR2617Home');
  if(!home) return;

  function openHome(){
    home.style.display='block';
    document.documentElement.classList.add('master-r2617-home-open');
    document.body.classList.add('master-r2617-home-open');
  }
  function closeHome(){
    home.style.display='none';
    document.documentElement.classList.remove('master-r2617-home-open');
    document.body.classList.remove('master-r2617-home-open');
    try{ window.scrollTo(0,0); }catch(e){}
  }
  function exitApp(){
    try{
      if(window.BaekhakNative && typeof window.BaekhakNative.exitApp==='function'){
        window.BaekhakNative.exitApp(); return;
      }
    }catch(e){}
    alert('종료 기능은 항해사 MASTER Android 설치본에서 동작합니다.');
  }
  function updateApp(){
    try{
      if(window.BaekhakNative && typeof window.BaekhakNative.selectInternalUpdate==='function'){
        window.BaekhakNative.selectInternalUpdate(); return;
      }
    }catch(e){}
    alert('업데이트 기능은 항해사 MASTER Android 설치본에서 연결됩니다.');
  }

  const modal=document.getElementById('masterR2617Modal');
  const title=document.getElementById('masterR2617ModalTitle');
  const text=document.getElementById('masterR2617ModalText');
  function showModal(t,m){
    title.textContent=t;
    text.textContent=m;
    modal.classList.add('open');
  }
  function hideModal(){ modal.classList.remove('open'); }

  document.getElementById('masterR2617StartHit').onclick=closeHome;
  document.getElementById('masterR2617RecoveryHit').onclick=closeHome;
  document.getElementById('masterR2617ExitHit').onclick=exitApp;
  document.getElementById('masterR2617UpdateBtn').onclick=updateApp;

  document.getElementById('masterR2617NoticeBtn').onclick=function(){
    showModal('공지사항',
      '항해사 MASTER R26.17\n\n배포용 백학도사와 같은 홈 화면을 1차 적용했습니다.\n기존 R26.16 분석 엔진·RAW·U10·성적·승인관리·백업 로직은 변경하지 않았습니다.');
  };
  document.getElementById('masterR2617SuggestBtn').onclick=function(){
    showModal('건의사항',
      '마스터용 건의사항 기능은 기존 승인·관리 기능을 보존한 상태에서 다음 수정 단계에서 연결·정리합니다.');
  };
  document.getElementById('masterR2617ModalClose').onclick=hideModal;
  modal.addEventListener('click',function(e){ if(e.target===modal) hideModal(); });

  openHome();
  window.__BAEKHAK_MASTER_R2617_HOME__=Object.freeze({
    version:'R26.17',
    distributionHomeMatched:true,
    engineChanged:false,
    rawChanged:false,
    u10Changed:false,
    scoreChanged:false,
    approvalChanged:false
  });
})();
</script>

<!-- 항해사 MASTER R26.18 · 홈 회차이동 + 시작/종료 버튼 축소
