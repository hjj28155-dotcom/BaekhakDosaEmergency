<div id="masterR2631StartupOverlay" role="dialog" aria-modal="true" aria-label="백학도사앱의 목적 및 공지사항">
  <div id="masterR2631StartupCard">
    <button type="button" id="masterR2631StartupX" aria-label="안내 화면 종료">×</button>
    <div id="masterR2631PurposeKicker">BAEKHAKDOSA APP</div>
    <div id="masterR2631PurposeTitle">백학도사앱의 목적</div>

    <div id="masterR2631PurposeMain">
      <strong>DB-1 성능 개선</strong> · <strong>백학신서와 로또당첨번호의 연관성 분석</strong> · <strong>철저한 검증</strong>
    </div>

    <div id="masterR2631PurposeBody">
      본 백학도사앱의 궁극적인 목표는 앱에 탑재된 <b>DB-1의 성능을 개선</b>하고,
      <b>백학신서와 로또당첨번호의 연관성을 철저히 분석 및 검증</b>하는 것을 최우선 목표로 두고 있습니다.<br><br>
      더욱 개선되는 엔진으로 발전하여 이 앱을 사용하는 지인들에게 <b>즐거움을 드리고자</b> 노력하겠습니다.
    </div>

    <div id="masterR2631NonProfit">
      비영리 배포 · 무료 · 판매수익 · 유료추천 목적이 아닙니다.<br>
      연구 · 기록 · 검증 내용을 지인들과 함께 나누는 참고용 앱입니다.
    </div>

    <div id="masterR2631Divider"></div>
    <div id="masterR2631NoticeTitle">공지사항</div>
    <div id="masterR2631NoticeBox">
      <span class="r2631-point">① 본 앱의 분석 결과는 연구·기록·검증을 위한 참고자료입니다.</span><br>
      ② 로또 당첨을 보장하거나 금전적 이익을 약속하지 않습니다.<br>
      <span class="r2631-safe">③ 앱과 관련하여 별도의 판매대금·유료추천비를 요구하지 않습니다.</span><br>
      ④ 사용 중 불편사항이나 개선 의견은 홈 화면의 <b>건의사항</b>을 이용해 주세요.<br>
      ⑤ 새 버전이 배포되면 홈 화면의 <b>업데이트</b> 버튼을 이용해 최신 버전으로 갱신해 주세요.
    </div>
    <div id="masterR2631Foot">화면 오른쪽 위 × 버튼을 누르면 홈 화면으로 이동합니다.</div>
  </div>
</div>

<script id="masterR2631StartupPurposeNoticeJS">
(function(){
  function byId(id){return document.getElementById(id);}
  function openStartup(){
    const o=byId('masterR2631StartupOverlay');
    if(!o) return;
    o.classList.remove('r2631-closed');
    document.body.classList.add('r2631-startup-open');
    try{o.scrollTop=0;}catch(e){}
  }
  function closeStartup(){
    const o=byId('masterR2631StartupOverlay');
    if(!o) return;
    o.classList.add('r2631-closed');
    document.body.classList.remove('r2631-startup-open');
  }
  function bind(){
    const x=byId('masterR2631StartupX');
    const o=byId('masterR2631StartupOverlay');
    const notice=byId('masterR2617NoticeBtn');
    if(x && !x.dataset.r2631){
      x.dataset.r2631='1';
      x.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();closeStartup();});
    }
    if(o && !o.dataset.r2631){
      o.dataset.r2631='1';
      o.addEventListener('click',function(e){ if(e.target===o) closeStartup(); });
    }
    if(notice && !notice.dataset.r2631){
      notice.dataset.r2631='1';
      notice.addEventListener('click',function(e){
        e.preventDefault();
        e.stopImmediatePropagation();
        openStartup();
      },true);
    }
  }
  function boot(){
    bind();
    openStartup();
    setTimeout(function(){bind();openStartup();},80);
    setTimeout(bind,600);
    window.__BAEKHAK_MASTER_R2631_DISTRIBUTION_STARTUP__=Object.freeze({
      version:'R26.31',
      distributionBuild:true,
      startupPurposeNotice:true,
      purposeFirst:true,
      noticeBelowPurpose:true,
      closeX:true,
      showEveryLaunch:true,
      engineChanged:false,
      rawChanged:false,
      u10Changed:false,
      scoreChanged:false,
      approvalChanged:false,
      backupChanged:false
    });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot,{once:true});
  else boot();
})();
</script>
