  #masterR2617UpdateBtn{top:1.8%!important;}
  #masterR2618ControlPanel{top:9.7%!important;height:auto!important;}
}
</style>
<script id="masterR2619HomeOrderJS">
(function(){
  function arrange(){
    const panel=document.getElementById('masterR2618ControlPanel');
    const roundSlot=document.getElementById('masterR2618RoundSlot');
    const actionRow=document.getElementById('masterR2618ActionRow');
    if(!panel||!roundSlot||!actionRow) return false;
    if(panel.firstElementChild!==roundSlot){
      panel.insertBefore(roundSlot, actionRow);
    }

    const notice=document.getElementById('masterR2617NoticeBtn');
    const modal=document.getElementById('masterR2617Modal');
    const title=document.getElementById('masterR2617ModalTitle');
    const msg=document.getElementById('masterR2617ModalText');
    if(notice&&modal&&title&&msg){
      notice.onclick=function(){
        title.textContent='공지사항';
        msg.textContent='항해사 MASTER R26.19\\n\\n업데이트 버튼을 홈 화면 최상단으로 이동했습니다.\\n이번 회차(이전회차·회차번호·다음회차·RESULT-BEFORE 안내)를 업데이트 버튼 바로 아래로 배치했습니다.\\n시작·종료 버튼은 회차 아래에 두며 이전회차 버튼 크기를 유지합니다.\\n기존 R26.18 분석 엔진·RAW·U10·성적·승인관리·백업 로직은 변경하지 않았습니다.';
        modal.classList.add('open');
      };
    }

    window.__BAEKHAK_MASTER_R2619_HOME__=Object.freeze({
      version:'R26.19',
      updateAtTop:true,
      roundDirectlyBelowUpdate:true,
      actionsBelowRound:true,
      engineChanged:false,
      rawChanged:false,
