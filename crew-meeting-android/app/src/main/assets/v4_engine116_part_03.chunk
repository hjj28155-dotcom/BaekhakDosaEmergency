    line-height:1.32;
  }
}
</style>

<script id="v84BottomBlessingJS">
(function(){
  function build(){
    const footer=document.querySelector('.footer');
    if(!footer) return false;

    let warning=document.getElementById('v83BottomWarning');
    if(!warning){
      warning=document.createElement('div');
      warning.id='v83BottomWarning';
      warning.innerHTML='<strong>본 앱은 당첨을 보장하지 않습니다.</strong>';
      footer.parentNode.insertBefore(warning, footer);
    }

    let wish=document.getElementById('v84FamilyWish');
    if(!wish){
      wish=document.createElement('div');
      wish.id='v84FamilyWish';
      wish.textContent='가정의 행복을 위하여 정해진 금액으로 즐거운 주말을 보내시길 기원합니다';
      warning.insertAdjacentElement('afterend', wish);
    }

    footer.innerHTML='백학신서 비상용 독립축 V8.4 FINAL · BOTTOM BLESSING FREEZE<br>V8.3 기준 동결 + 하단 경고문 아래 파란 축복 문구 추가';
    return true;
  }

  function init(){
    let tries=0;
    const t=setInterval(()=>{
      tries++;
      if(build() || tries>60) clearInterval(t);
    },100);
  }

  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init);
  else init();
})();
</script>


<style id="v85LiveFireworksCSS">
#v85FireworksCanvas{
  position:fixed;
  inset:0;
  width:100vw;
  height:100vh;
  pointer-events:none;
  z-index:9999;
}
#v84FamilyWish{
  position:relative;
  overflow:hidden;
  background:linear-gradient(180deg,rgba(22,82,170,.92),rgba(14,53,118,.95))!important;
  border:1px solid rgba(124,183,255,.95)!important;
  box-shadow:0 0 0 1px rgba(255,255,255,.06) inset,0 0 20px rgba(65,155,255,.30),0 0 36px rgba(47,116,255,.20)!important;
  text-shadow:0 0 12px rgba(176,230,255,.45),0 0 24px rgba(99,179,255,.2)!important;
}
#v84FamilyWish::before,
#v84FamilyWish::after{
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  font-size:18px;
  opacity:.9;
  animation:v85SparklePulse 1.8s ease-in-out infinite alternate;
  filter:drop-shadow(0 0 6px rgba(255,240,140,.7));
}
#v84FamilyWish::before{content:"✨";left:12px}
#v84FamilyWish::after{content:"🎉";right:12px;animation-delay:.6s}
#v85WishBurst{
  position:absolute;
  inset:0;
  pointer-events:none;
  overflow:hidden;
}
.v85WishSpark{
  position:absolute;
  bottom:-10px;
  font-size:14px;
  opacity:0;
  animation:v85WishFloat 3.2s linear infinite;
  filter:drop-shadow(0 0 6px rgba(255,255,200,.65));
}
@keyframes v85SparklePulse{
  from{transform:translateY(-50%) scale(.92);opacity:.7}
  to{transform:translateY(-50%) scale(1.08);opacity:1}
}
@keyframes v85WishFloat{
  0%{transform:translateY(0) scale(.7);opacity:0}
  8%{opacity:.9}
  80%{opacity:.85}
  100%{transform:translateY(-70px) scale(1.06);opacity:0}
}
</style>
<script id="v85LiveFireworksJS">
(function(){
  function addWishSparkles(){
    const wish=document.getElementById('v84FamilyWish');
    if(!wish || document.getElementById('v85WishBurst')) return;
    const layer=document.createElement('div');
    layer.id='v85WishBurst';
    const icons=['✨','🎆','🎉','💙','⭐'];
    for(let i=0;i<10;i++){
      const s=document.createElement('span');
      s.className='v85WishSpark';
      s.textContent=icons[i % icons.length];
      s.style.left=(6 + i*9)+'%';
      s.style.animationDelay=(i*0.28)+'s';
      s.style.animationDuration=(2.8 + (i%3)*0.5)+'s';
      layer.appendChild(s);
    }
    wish.appendChild(layer);
  }

  function initFireworks(){
    if(document.getElementById('v85FireworksCanvas')) return;
    const canvas=document.createElement('canvas');
    canvas.id='v85FireworksCanvas';
    document.body.appendChild(canvas);
    const ctx=canvas.getContext('2d');
    let w=0,h=0,dpr=Math.max(1,window.devicePixelRatio||1);
    let particles=[];
    let trails=[];

    function resize(){
      dpr=Math.max(1,window.devicePixelRatio||1);
      w=window.innerWidth; h=window.innerHeight;
      canvas.width=Math.floor(w*dpr); canvas.height=Math.floor(h*dpr);
      canvas.style.width=w+'px'; canvas.style.height=h+'px';
      ctx.setTransform(dpr,0,0,dpr,0,0);
    }

    function rand(a,b){ return Math.random()*(b-a)+a; }
    function choice(arr){ return arr[Math.floor(Math.random()*arr.length)]; }

    function launch(){
      const x=rand(w*0.12,w*0.88);
      const y=rand(h*0.10,h*0.45);
      const colors=['#ffd76a','#ff6b6b','#75d8ff','#8cffb6','#ffffff','#c8a3ff','#ff9fe1'];
      const count=Math.floor(rand(26,42));
      for(let i=0;i<count;i++){
        const a=(Math.PI*2*i)/count + rand(-0.08,0.08);
        const speed=rand(1.2,3.9);
        particles.push({
          x,y,
          vx:Math.cos(a)*speed,
          vy:Math.sin(a)*speed,
          life:rand(50,78),
          maxLife:78,
          color:choice(colors),
          size:rand(1.5,3.1),
          gravity:0.028,
          drag:0.988
        });
      }
      for(let i=0;i<2;i++){
        trails.push({x,y,r:8+i*8,life:20+i*5,color:'rgba(255,235,150,0.22)'});
      }
    }

    function tick(){
      ctx.clearRect(0,0,w,h);
      for(let i=trails.length-1;i>=0;i--){
        const t=trails[i];
        ctx.beginPath();
        ctx.arc(t.x,t.y,t.r,0,Math.PI*2);
        ctx.strokeStyle=t.color;
        ctx.lineWidth=2;
        ctx.stroke();
        t.r+=1.8; t.life--;
        if(t.life<=0) trails.splice(i,1);
      }

      for(let i=particles.length-1;i>=0;i--){
        const p=particles[i];
        p.vx*=p.drag; p.vy*=p.drag; p.vy+=p.gravity; p.x+=p.vx; p.y+=p.vy; p.life--;
        const alpha=Math.max(0,p.life/p.maxLife);
        ctx.beginPath();
        ctx.arc(p.x,p.y,p.size,0,Math.PI*2);
        ctx.fillStyle=p.color;
        ctx.globalAlpha=alpha;
        ctx.shadowBlur=12;
        ctx.shadowColor=p.color;
        ctx.fill();
        ctx.globalAlpha=alpha*0.35;
        ctx.beginPath();
        ctx.arc(p.x,p.y,p.size*3.2,0,Math.PI*2);
        ctx.fill();
        ctx.globalAlpha=1;
        ctx.shadowBlur=0;
        if(p.life<=0) particles.splice(i,1);
      }
      requestAnimationFrame(tick);
    }

    resize();
    tick();
    launch();
    setInterval(launch, 1250);
    window.addEventListener('resize', resize);
  }

  function setFooterText(){
    const footer=document.querySelector('.footer');
    if(footer){
      footer.innerHTML='백학신서 비상용 독립축 V8.5 FINAL · LIVE FIREWORKS<br>V8.4 기준 동결 + 실시간 축포 효과 + 하단 축복 배너 반짝임 강화';
    }
  }

  function init(){
    addWishSparkles();
    initFireworks();
    setFooterText();
  }

  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>


<style id="v86FinalFireworksBannerCSS">
/* V8.6 — 기능 동결 + 원하는 축복 배너 화면 반영 */
#v84FamilyWish{
  min-height:112px!important;
  padding:0!important;
  border:0!important;
  border-radius:18px!important;
  color:transparent!important;
  text-shadow:none!important;
  overflow:hidden!important;
  background-image:url("data:image/png;base64,