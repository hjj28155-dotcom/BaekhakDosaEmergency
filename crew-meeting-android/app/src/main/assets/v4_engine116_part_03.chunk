") center top / cover no-repeat;
  border-radius:0 0 18px 18px;
  box-shadow:0 12px 30px rgba(0,0,0,.33), 0 0 18px rgba(50,145,255,.10);
  overflow:hidden;
}
#v36TopGrid{
  margin-top:0 !important;
}
#v36TopGrid #v20RulesWrap{
  grid-column:1 / -1!important;
  order:-1!important;
}
@media (max-width:560px){
  #v77HeroBanner{
    height:58vw;
    min-height:212px;
    max-height:295px;
  }
}
</style>
<script id="v77HeroRestoreJS">
(function(){
  function ensureHero(){
    const app=document.querySelector('.app');
    if(!app) return false;
    let hero=document.getElementById('v77HeroBanner');
    if(!hero){
      hero=document.createElement('div');
      hero.id='v77HeroBanner';
      app.insertBefore(hero, app.firstChild);
    }
    return true;
  }
  function keepRulesTop(){
    const grid=document.getElementById('v36TopGrid');
    const rules=document.getElementById('v20RulesWrap');
    if(grid && rules && grid.firstElementChild !== rules){
      grid.insertBefore(rules, grid.firstElementChild || null);
    }
  }
  function updateFooter(){
    const footer=document.querySelector('.footer');
    if(footer){
      footer.innerHTML='백학신서 비상용 독립축 V7.8 FINAL · SIDE BUTTONS FREEZE<br>당첨을 보장하는 기능이 아니라 결과전 해독 절차를 보존하는 보조도구입니다.';
    }
  }
  function init(){
    ensureHero();
    keepRulesTop();
    updateFooter();
  }
  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',()=>{
      init();
      setTimeout(init,250);
      setTimeout(init,700);
    });
  }else{
    init();
    setTimeout(init,250);
    setTimeout(init,700);
  }
})();
</script>


<style id="v78SideButtonsCSS">
/* V7.8 — V7.7 기준 완전 동결 + RAW 좌우 측면 버튼 2개 추가 */
#v78RawSideShell{
  display:grid;
  grid-template-columns:74px minmax(0,1fr) 74px;
  gap:10px;
  align-items:stretch;
  width:100%;
  margin-top:8px;
}
#v78RawCenter{min-width:0;}
.v78-side-btn{
  border:1px solid rgba(236,194,82,.92);
  background:linear-gradient(180deg,rgba(8,43,70,.94),rgba(4,25,45,.97));
  color:#f5d574;
  border-radius:18px;
  font-weight:900;
  font-size:15px;
  line-height:1.35;
  letter-spacing:.5px;
  min-height:100%;
  padding:10px 6px;
  box-shadow:0 0 16px rgba(245,204,92,.14), inset 0 1px 0 rgba(255,255,255,.04);
  cursor:pointer;
}
.v78-side-btn:active{transform:scale(.985)}
#v78UpdateBtn{writing-mode:vertical-rl;text-orientation:upright;}
#v78WinningBtn{writing-mode:vertical-rl;text-orientation:upright;}

@media(max-width:560px){
  #v78RawSideShell{
    grid-template-columns:48px minmax(0,1fr) 48px;
    gap:6px;
  }
  .v78-side-btn{
    border-radius:15px;
    font-size:12px;
    padding:8px 3px;
  }
}
@media(max-width:390px){
  #v78RawSideShell{
    grid-template-columns:44px minmax(0,1fr) 44px;
    gap:5px;
  }
  .v78-side-btn{font-size:11px;}
}
</style>
<script id="v78SideButtonsJS">
(function(){
  function build(){
    if(document.getElementById('v78RawSideShell')) return true;
    const raw=document.getElementById('raw');
    if(!raw) return false;
    const card=raw.closest('.card');
    if(!card) return false;
    const actions=card.querySelector('.actions');
    if(!actions) return false;

    const shell=document.createElement('div');
    shell.id='v78RawSideShell';

    const left=document.createElement('button');
    left.type='button';
    left.id='v78UpdateBtn';
    left.className='v78-side-btn';
    left.textContent='업데이트';

    const center=document.createElement('div');
    center.id='v78RawCenter';

    const right=document.createElement('button');
    right.type='button';
    right.id='v78WinningBtn';
    right.className='v78-side-btn';
    right.textContent='자동당첨번호조회';

    const status=card.querySelector('.v23-raw-status');
    if(status) status.insertAdjacentElement('afterend',shell);
    else raw.insertAdjacentElement('beforebegin',shell);

    center.appendChild(raw);
    center.appendChild(actions);

    const txt=card.querySelector('#txtFile');
    if(txt) center.appendChild(txt);

    const small=[...card.querySelectorAll('.small')].find(x=>x.textContent.includes('정확히 6문장'));
    if(small) center.appendChild(small);

    shell.appendChild(left);
    shell.appendChild(center);
    shell.appendChild(right);

    left.addEventListener('click',()=>{
      alert('업데이트 기능 연결 대기 상태입니다. 현재 V7.7 기준본은 동결 유지됩니다.');
    });
    right.addEventListener('click',()=>{
      alert('자동당첨번호조회 기능 연결 대기 상태입니다. 현재 RESULT-BEFORE 해독 기능은 변경하지 않습니다.');
    });

    const footer=document.querySelector('.footer');
    if(footer){
      footer.innerHTML='백학신서 비상용 독립축 V7.8 FINAL · SIDE BUTTONS FREEZE<br>V7.7 기준 기능·데이터·배경·해독 로직 동결 + 좌우 보조버튼 추가';
    }
    return true;
  }
  function init(){
    let tries=0;
    const t=setInterval(()=>{
      tries++;
      if(build()||tries>40) clearInterval(t);
    },100);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init);
  else init();
})();
</script>



<style id="v80RuleSentenceSplitTopCSS">
/* V8.0 — 상단 긴 해독규칙 버튼을 좌우 2분할: 좌측 해독규칙, 우측 문장선택하기 */
#v80TopSplitRow{
  grid-column:1 / -1!important;
  display:grid!important;
  grid-template-columns:1fr 1fr!important;
  gap:4px!important;
  margin:0 0 4px!important;
  width:100%!important;
  align-items:stretch!important;
}
#v80TopSplitRow .v80-top-btn,
#v80TopSplitRow .v80-top-btn:visited,
#v80TopSplitRow .v80-top-btn:hover{
  appearance:none;
  border:1px solid rgba(232,193,90,.82)!important;
  background:linear-gradient(180deg,rgba(7,36,58,.96),rgba(3,24,40,.96))!important;
  color:#f1d06a!important;
  border-radius:12px!important;
  min-height:38px!important;
  height:38px!important;
  padding:4px 8px!important;
  font-size:10.1px!important;
  font-weight:900!important;
  line-height:1.05!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  text-align:center!important;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.03), 0 0 14px rgba(240,196,82,.08)!important;
  cursor:pointer!important;
  width:100%!important;
}
#v80TopSplitRow .v80-top-btn:active{transform:scale(.987)!important}
#v80TopSplitRow .v80-top-btn.is-open,
#v80TopSplitRow .v80-top-btn:focus-visible{
  outline:none!important;
  box-shadow:0 0 0 1px rgba(255,214,108,.55), 0 0 18px rgba(255,214,108,.14)!important;
}
#v36TopGrid > #v20RulesWrap.v80-controlled{
  grid-column:1 / -1!important;
  display:block!important;
  width:100%!important;
  margin:0!important;
}
#v36TopGrid > #v20RulesWrap.v80-controlled > summary{
  display:none!important;
}
#v36TopGrid > #v20RulesWrap.v80-controlled:not([open]) > .card{
  display:none!important;
}
#v36TopGrid > #v20RulesWrap.v80-controlled[open]{
  margin:4px 0 2px!important;
}
#v36TopGrid > #v20RulesWrap.v80-controlled .card{
  margin-top:0!important;
}
@media(max-width:560px){
  #v80TopSplitRow .v80-top-btn{
    min-height:36px!important;
    height:36px!important;
    font-size:9.8px!important;
    padding:4px 6px!important;
  }
}
@media(max-width:390px){
  #v80TopSplitRow .v80-top-btn{
    min-height:34px!important;
    height:34px!important;
    font-size:9.2px!important;
    padding:3px 5px!important;
  }
}
</style>
<script id="v80RuleSentenceSplitTopJS">
(function(){
  function getSentencePanel(){
    return document.getElementById('v25SentencePanel');
  }
  function toggleRules(rules, btn){
    if(!rules || !btn) return;
    const willOpen = !rules.hasAttribute('open');
    if(willOpen){
      rules.setAttribute('open','');
      btn.classList.add('is-open');
      btn.setAttribute('aria-expanded','true');
      setTimeout(()=>{
        try{ rules.scrollIntoView({behavior:'smooth', block:'nearest'}); }catch(_e){}
      }, 60);
    }else{
      rules.removeAttribute('open');
      btn.classList.remove('is-open');
      btn.setAttribute('aria-expanded','false');
    }
  }
  function jumpSentence(btn){
    const panel = getSentencePanel();
    if(!panel) return;
    panel.classList.add('v80-jump-highlight');
    try{ panel.scrollIntoView({behavior:'smooth', block:'start'}); }catch(_e){}
    setTimeout(()=>panel.classList.remove('v80-jump-highlight'), 1400);
  }
  function build(){
    const grid=document.getElementById('v36TopGrid');
    const rules=document.getElementById('v20RulesWrap');
    if(!grid || !rules) return false;

    rules.classList.add('v80-controlled');

    let row=document.getElementById('v80TopSplitRow');
    if(!row){
      row=document.createElement('div');
      row.id='v80TopSplitRow';
      const left=document.createElement('button');
      left.type='button';
      left.id='v80RulesTopBtn';
      left.className='v80-top-btn';
      left.textContent='해독 규칙 보기';
      left.setAttribute('aria-expanded', rules.hasAttribute('open') ? 'true' : 'false');

      const right=document.createElement('button');
      right.type='button';
      right.id='v80SentenceTopBtn';
      right.className='v80-top-btn';
      right.textContent='문장 선택하기';

      left.addEventListener('click',()=>toggleRules(rules,left));
      right.addEventListener('click',()=>jumpSentence(right));
      row.appendChild(left);
      row.appendChild(right);
    }

    if(grid.firstElementChild !== row){
      grid.insertBefore(row, grid.firstElementChild || null);
    }

    // Keep rules block immediately below the split row
    if(row.nextElementSibling !== rules){
      grid.insertBefore(rules, row.nextElementSibling || null);
    }

    const leftBtn=document.getElementById('v80RulesTopBtn');
    if(leftBtn){
      const isOpen = rules.hasAttribute('open');
      leftBtn.classList.toggle('is-open', isOpen);
      leftBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    }

    const footer=document.querySelector('.footer');
    if(footer){
      footer.innerHTML='백학신서 비상용 독립축 V8.2 FINAL · RAW COMPACT SPACE FREEZE<br>V7.8 기준 기능·배경·좌우 보조버튼 동결 + 상단 해독규칙/문장선택 2분할 적용';
    }
    return true;
  }
  function init(){
    let tries=0;
    const t=setInterval(()=>{
      tries++;
      if(build() || tries>80){
        clearInterval(t);
        setTimeout(build,250);
        setTimeout(build,700);
      }
    },100);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
<style id="v80SentenceJumpPulse">
#v25SentencePanel.v80-jump-highlight{
  box-shadow:0 0 0 1px rgba(255,214,108,.45), 0 0 24px rgba(255,214,108,.12)!important;
  transition:box-shadow .2s ease;
}
</style>



<style id="v81SentencePopdownCSS">
/* V8.1 — 하단 문장선택 중복 제거, 상단 '문장 선택하기' 버튼으로 6버튼 팝다운 */
#v36TopGrid > #v25SentencePanel.v81-top-sentence-panel{
  grid-column:1 / -1!important;
  width:100%!important;
  margin:4px 0 2px!important;
  padding:7px!important;
  border:1px solid rgba(84,165,224,.69)!important;
  border-radius:13px!important;
  background:linear-gradient(180deg,rgba(7,35,56,.96),rgba(4,23,39,.97))!important;
  box-shadow:0 10px 24px rgba(0,0,0,.24)!important;
}
#v36TopGrid > #v25SentencePanel.v81-top-sentence-panel:not(.v81-open){
  display:none!important;
}
#v36TopGrid > #v25SentencePanel.v81-top-sentence-panel #v25SentenceHead,
#v36TopGrid > #v25SentencePanel.v81-top-sentence-panel #v25SentenceViewer{
  display:none!important;
}
#v36TopGrid > #v25SentencePanel.v81-top-sentence-panel #v25SentenceButtons{
  display:grid!important;
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:4px!important;
}
#v36TopGrid > #v25SentencePanel.v81-top-sentence-panel .v25-sbtn{
  min-height:34px!important;
  padding:6px 4px!important;
  font-size:10px!important;
  border-radius:10px!important;
}
#v80SentenceTopBtn.is-open{
  box-shadow:0 0 0 1px rgba(255,214,108,.55),0 0 18px rgba(255,214,108,.14)!important;
}
@media(max-width:390px){
  #v36TopGrid > #v25SentencePanel.v81-top-sentence-panel .v25-sbtn{
    min-height:32px!important;
    font-size:9.5px!important;
  }
}
</style>
<script id="v81SentencePopdownJS">
(function(){
  function setup(){
    const grid=document.getElementById('v36TopGrid');
    const split=document.getElementById('v80TopSplitRow');
    const panel=document.getElementById('v25SentencePanel');
    const sentenceBtn=document.getElementById('v80SentenceTopBtn');
    if(!grid || !split || !panel || !sentenceBtn) return false;

    panel.classList.add('v81-top-sentence-panel');
    panel.classList.remove('v81-open');

    // 기존 하단 위치에서 떼어 상단 2분할 버튼 바로 아래로 이동
    if(panel.parentElement!==grid || panel.previousElementSibling!==split){
      grid.insertBefore(panel, split.nextElementSibling || null);
    }

    if(!sentenceBtn.dataset.v81Bound){
      sentenceBtn.dataset.v81Bound='1';
      sentenceBtn.onclick=(e)=>{
        e.preventDefault();
        e.stopPropagation();
        const open=!panel.classList.contains('v81-open');
        panel.classList.toggle('v81-open',open);
        sentenceBtn.classList.toggle('is-open',open);
        sentenceBtn.setAttribute('aria-expanded',open?'true':'false');
      };
    }

    sentenceBtn.setAttribute('aria-expanded',panel.classList.contains('v81-open')?'true':'false');

    const footer=document.querySelector('.footer');
    if(footer){
      footer.innerHTML='백학신서 비상용 독립축 V8.2 FINAL · RAW COMPACT SPACE FREEZE<br>V8.0 기준 동결 + 하단 문장선택 중복 제거 · 상단 버튼에서 6문장 선택';
    }
    return true;
  }

  function init(){
    let tries=0;
    const timer=setInterval(()=>{
      tries++;
      if(setup() || tries>80){
        clearInterval(timer);
        setTimeout(setup,250);
        setTimeout(setup,700);
      }
    },100);
  }

  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init);
  else init();
})();
</script>



