<style id="v84BottomBlessingStyle">
/* V8.4 — V8.3 동결 + 하단 축복문구 추가 */
#v83BottomWarning{
  width:100%;
  margin:6px 0 6px;
  padding:10px 12px;
  border:1px solid rgba(255,92,92,.92);
  border-radius:14px;
  background:linear-gradient(180deg,rgba(120,18,18,.96),rgba(70,8,8,.97));
  color:#ffdede;
  font-size:13px;
  font-weight:1000;
  line-height:1.22;
  text-align:center;
  letter-spacing:-.2px;
  box-shadow:
    0 0 18px rgba(255,70,70,.22),
    inset 0 1px 0 rgba(255,255,255,.08),
    0 0 6px rgba(255,35,35,.15);
}
#v83BottomWarning strong{
  color:#ff8f8f;
  font-size:14px;
  text-shadow:0 0 10px rgba(255,75,75,.18);
}
#v84FamilyWish{
  width:100%;
  margin:0 0 4px;
  padding:10px 12px;
  border:1px solid rgba(109,199,255,.95);
  border-radius:14px;
  background:linear-gradient(180deg,rgba(10,74,148,.96),rgba(3,44,96,.98));
  color:#d8f1ff;
  font-size:12.5px;
  font-weight:1000;
  line-height:1.35;
  text-align:center;
  letter-spacing:-.1px;
  box-shadow:
    0 0 22px rgba(62,171,255,.22),
    inset 0 1px 0 rgba(255,255,255,.10),
    0 0 10px rgba(72,180,255,.18);
  text-shadow:
    0 0 10px rgba(110,210,255,.42),
    0 0 18px rgba(70,170,255,.28);
  animation:v84twinkle 2.6s ease-in-out infinite alternate;
}
@keyframes v84twinkle{
  from{
    box-shadow:
      0 0 18px rgba(62,171,255,.18),
      inset 0 1px 0 rgba(255,255,255,.08),
      0 0 6px rgba(72,180,255,.12);
    text-shadow:
      0 0 8px rgba(110,210,255,.28),
      0 0 14px rgba(70,170,255,.18);
  }
  to{
    box-shadow:
      0 0 28px rgba(62,171,255,.34),
      inset 0 1px 0 rgba(255,255,255,.12),
      0 0 12px rgba(72,180,255,.22);
