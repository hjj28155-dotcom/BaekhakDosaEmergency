<style id="v48MobileCompactView">
/* V4.8 FINAL — 기능/버튼/데이터/로직은 유지하고 모바일 세로 길이만 축소 */

body{padding:6px 6px 24px!important}
.app{max-width:760px!important}
h1{font-size:20px!important;line-height:1.08!important;margin:0 0 2px!important;letter-spacing:-.2px!important}
.sub{font-size:10.2px!important;line-height:1.28!important;margin:0 0 6px!important}
.card{padding:10px!important;margin:7px 0!important;border-radius:18px!important}
h2,.card h2{font-size:17px!important;line-height:1.1!important;margin:0 0 8px!important}
.small{font-size:9.5px!important;line-height:1.32!important}

/* 상단 2x2 버튼 묶음 세로길이 축소 */
#v36TopGrid{gap:5px!important;margin:5px 0 8px!important;align-items:stretch!important}
#v36TopGrid #v21BadgeMenu > summary,
#v36TopGrid #v20PolicyWrap > summary,
#v36TopGrid .v30-main-btn{
  min-height:42px!important;
  height:42px!important;
  padding:5px 6px!important;
  font-size:10.4px!important;
  line-height:1.08!important;
  border-radius:13px!important;
}
#v36TopGrid #v21BadgeMenu > summary::after{font-size:10px!important;margin-left:3px!important}

/* 이번 회차 높이 축소 */
.round-v17{gap:5px!important}
.round-v17 #round{
  height:40px!important;
  font-size:15px!important;
  padding:6px 4px!important;
  border-radius:12px!important;
}
.round-v17 .btn{
  height:40px!important;
  padding:6px 4px!important;
  font-size:11.8px!important;
  border-radius:12px!important;
}

/* RAW 카드 세로길이 축소: 3번째 문장까지 중심으로 보이도록 조정 */
#raw{
  width:78%!important;
  max-width:78%!important;
  min-height:148px!important;
  height:148px!important;
  max-height:148px!important;
  padding:10px 12px!important;
  font-size:13.4px!important;
  line-height:1.56!important;
  border-radius:14px!important;
  overflow-y:auto!important;
}
#raw + .actions{
  width:78%!important;
  margin:8px auto 0!important;
  gap:6px!important;
}
#raw + .actions .btn{
  min-height:40px!important;
  height:40px!important;
  padding:7px 6px!important;
  font-size:12.2px!important;
  border-radius:12px!important;
}
#raw ~ .small{width:78%!important;margin:6px auto 0!important;font-size:9px!important;line-height:1.28!important}

/* 해독 규칙 / 실전운영 / 기타 버튼 영역 축소 */
#v20RulesWrap>summary,
#v15ProductionCard .btn,
.btn{line-height:1.12!important}
.prod-grid{gap:5px!important}
.prod-box{padding:6px!important;border-radius:10px!important}
.prod-box span{font-size:8.6px!important}
.prod-box b{font-size:10px!important;line-height:1.18!important}
.prod-actions{gap:5px!important;margin-top:6px!important}
.prod-actions .btn{min-height:34px!important;height:34px!important;padding:6px 5px!important;font-size:10.8px!important}
#v15SelfTestStatus{font-size:9px!important;line-height:1.28!important;margin-top:5px!important}

/* 문장선택 버튼 세로길이 축소 */
#sentenceNavWrap .btn,
#sentenceButtons .btn,
#sentenceSelect .btn,
#sentenceChoice .btn{min-height:38px!important}

/* 결과/후보우주/조합 등도 비례 축소 */
.statusline{gap:6px!important}
.kpi{padding:7px!important;border-radius:11px!important}
.kpi span{font-size:8px!important}
.kpi b{font-size:16px!important;margin-top:2px!important}
.gate{padding:10px!important;margin-top:8px!important}
.ball{width:34px!important;height:34px!important;font-size:14px!important}
.rankrow{margin:4px 0!important;padding:5px!important}
.rankmeta{font-size:9.5px!important;line-height:1.28!important}
.game{padding:8px!important;border-radius:13px!important}
.gno{width:22px!important}
.game .ball{width:31px!important;height:31px!important;font-size:11px!important}
.footer{font-size:9px!important;line-height:1.32!important;margin-top:10px!important}

/* 자동구매 오버레이도 비례 축소 */
#v30BuyPanel{padding:12px!important;border-radius:18px!important}
#v30BuyHead{min-height:38px!important;margin-bottom:6px!important}
#v30BuyTitle{font-size:18px!important;padding:0 42px!important;line-height:1.15!important}
#v30BuyClose{width:44px!important;height:44px!important}
#v38CountTabs{gap:5px!important;margin:4px 0 8px!important}
.v38-count-btn{padding:7px 3px!important;font-size:11px!important;border-radius:10px!important}
#v30BuyList .game,
#v30BuyList .buy-row{padding:8px!important}
#v30BuyPanel .actions .btn,
#v30BuyFoot .btn{min-height:40px!important;height:40px!important;font-size:12px!important}

@media(max-width:560px){
  body{padding:5px 5px 20px!important}
  h1{font-size:18px!important}
  .sub{font-size:9.6px!important;margin-bottom:5px!important}
  .card{padding:9px!important;margin:6px 0!important;border-radius:16px!important}
  h2,.card h2{font-size:15px!important;margin-bottom:7px!important}
  #v36TopGrid{gap:4px!important;margin:4px 0 7px!important}
