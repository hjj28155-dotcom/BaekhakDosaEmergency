<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>백학신서 비상용 앱 V8.6 FINAL · LIVE FIREWORKS BANNER</title>
<style>
:root{--bg:#050c14;--p:#0a1b29;--p2:#0e2638;--line:#31556e;--gold:#f0c85f;--gold2:#d9a53b;--text:#f1f6fa;--muted:#9fb0bd;--green:#63d391;--orange:#f2b45f;--red:#ff8181;--blue:#4c91ff}
*{box-sizing:border-box}html,body{margin:0;background:radial-gradient(circle at 12% 0%,#173951,#07131e 43%,#03080d);color:var(--text);font-family:Arial,"Apple SD Gothic Neo","Noto Sans KR",sans-serif}body{padding:14px 9px 38px}.app{max-width:820px;margin:auto}h1{font-size:27px;color:var(--gold);margin:4px 0}.sub{color:#b9cad5;font-size:13px;line-height:1.5;margin-bottom:10px}.badges{display:flex;gap:7px;flex-wrap:wrap;margin:10px 0 14px}.badge{border:1px solid #40647d;background:#0a2132;color:#dce9f1;border-radius:999px;padding:7px 10px;font-size:11px;font-weight:900}.badge.gold{border-color:#8e702c;color:#f4d77e}.notice{background:#f7f6f1;color:#244866;border-radius:20px;padding:17px 14px;text-align:center;font-weight:900;line-height:1.6;margin:13px 0}.notice b{color:#153f60}.notice .line{height:1px;background:#d8dbdc;margin:11px 0}.notice .red{color:#cf5555}.card{background:linear-gradient(180deg,#0e2536,#081925);border:1px solid #2e5068;border-radius:20px;padding:15px;margin:12px 0;box-shadow:0 10px 30px #0004}h2{font-size:20px;margin:0 0 11px;color:#f5f8fb}.round{display:grid;grid-template-columns:1fr 108px;gap:8px}input,textarea{width:100%;background:#061723;color:#fff;border:1px solid #365a72;border-radius:13px;padding:12px;font-size:15px;outline:none}textarea{min-height:180px;line-height:1.6;resize:vertical}.btn{border:0;border-radius:13px;padding:12px 13px;font-weight:900;font-size:14px;cursor:pointer}.btn:active{transform:scale(.985)}.btn.gold{background:linear-gradient(90deg,#dca73d,#f2cf6a);color:#0c1720}.btn.blue{background:linear-gradient(90deg,#276fc5,#4c94ff);color:white}.btn.dark{background:#133149;border:1px solid #365e78;color:white}.btn.red{background:#4b2026;border:1px solid #833943;color:#ffd9dc}.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.small{font-size:11px;color:#94a8b6;line-height:1.45}.rules{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.rule{background:#071a28;border:1px solid #2c4d62;border-radius:13px;padding:10px;font-size:11px;line-height:1.4;color:#c7d5de}.rule b{display:block;color:#f0c968;margin-bottom:3px}.gate{padding:12px;border-radius:14px;margin-top:10px;text-align:center;font-weight:900}.gate.pass{background:#0f3228;border:1px solid #34795a;color:#80e0a8}.gate.hold{background:#352819;border:1px solid #80602e;color:#f4cc7e}.gate.fail{background:#381d22;border:1px solid #80414b;color:#ffb0b0}.sentence{border:1px solid #2e526a;border-radius:15px;padding:11px;margin:8px 0;background:#071925}.sentence h3{font-size:13px;margin:0 0 7px;color:#f0cd72}.evi{font-size:11px;line-height:1.5;color:#c5d4dd;margin:3px 0}.tag{display:inline-block;border:1px solid #42677e;border-radius:999px;padding:2px 6px;font-size:9px;margin-right:4px}.tag.S{color:#ffe083;border-color:#8e6a2d}.tag.A{color:#8ce4af;border-color:#397457}.tag.B{color:#a9c8ff;border-color:#3c5f8c}.candwrap{display:flex;flex-wrap:wrap;gap:7px;margin-top:8px}.ball{display:inline-flex;align-items:center;justify-content:center;width:37px;height:37px;border-radius:50%;background:#102e42;border:1px solid #486e86;color:#fff;font-weight:900}.ball.rank{background:#352d16;border-color:#a57c2d;color:#ffdc79}.rankrow{display:flex;gap:8px;align-items:center;margin:7px 0;padding:7px;border-bottom:1px solid #183548}.rankno{width:26px;color:#8da4b4;font-weight:900}.rankmeta{font-size:10px;color:#92a7b5;line-height:1.35}.games{display:grid;gap:8px}.game{background:#091d2b;border:1px solid #6f5a2c;border-radius:14px;padding:10px;display:flex;align-items:center;gap:8px}.gno{width:25px;text-align:center;color:#a8bac5;font-weight:900}.game .balls{display:flex;gap:5px;flex-wrap:nowrap}.game .ball{width:35px;height:35px;border-color:#8b6f31;color:#f7d97a}.statusline{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.kpi{background:#071a28;border:1px solid #2b4c61;border-radius:12px;padding:9px;text-align:center}.kpi span{display:block;color:#8fa5b3;font-size:9px}.kpi b{display:block;color:#f1cd70;font-size:18px;margin-top:3px}.footer{text-align:center;color:#718b9c;font-size:10px;line-height:1.5;margin-top:18px}.hidden{display:none!important}
@media(max-width:620px){h1{font-size:23px}.card{padding:12px}.rules{grid-template-columns:1fr}.actions{grid-template-columns:1fr}.round{grid-template-columns:1fr 92px}.game{padding:8px}.game .balls{gap:3px}.game .ball{width:32px;height:32px;font-size:12px}}
</style>

<style id="v15ProductionStyle">
.prod-panel{margin-top:10px;border:1px solid #705a2a;border-radius:14px;background:#0e211e;padding:11px}
.prod-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
.prod-box{border:1px solid #294b5d;border-radius:10px;background:#071923;padding:8px;text-align:center}
.prod-box span{display:block;color:#8fa5b3;font-size:9px}
.prod-box b{display:block;color:#f0cd70;font-size:11px;margin-top:4px;word-break:break-word}
.prod-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:9px}
.prod-actions .btn{min-height:42px}
#v15SelfTestStatus{margin-top:8px;font-size:11px;line-height:1.45}
@media(max-width:560px){.prod-grid{grid-template-columns:1fr 1fr}.prod-actions{grid-template-columns:1fr}}
</style>


<style id="v17RoundControlStyle">
/* V1.7 — 이전회차 | 회차번호 | 다음회차 */
.round-v17{
  display:grid!important;
  grid-template-columns:118px minmax(92px,150px) 118px!important;
  gap:8px!important;
  justify-content:start!important;
  align-items:center!important;
}
.round-v17 #round{
  width:100%!important;
  min-width:0!important;
  text-align:center!important;
  font-weight:900!important;
  padding-left:8px!important;
  padding-right:8px!important;
}
.round-v17 .btn{
  width:100%!important;
  white-space:nowrap!important;
}
@media(max-width:620px){
  .round-v17{
    grid-template-columns:minmax(82px,1fr) 88px minmax(82px,1fr)!important;
    gap:6px!important;
  }
  .round-v17 #round{
    font-size:16px!important;
    padding:10px 4px!important;
  }
  .round-v17 .btn{
    font-size:12.5px!important;
    padding:11px 5px!important;
  }
}
@media(max-width:390px){
  .round-v17{
    grid-template-columns:minmax(76px,1fr) 80px minmax(76px,1fr)!important;
    gap:5px!important;
  }
  .round-v17 .btn{font-size:11.5px!important}
}
</style>


<style id="v20CleanUI">
/* V2.0 CLEAN UI — 화면 정리 전용. 엔진/RAW/GATE/PACKER 로직 무변경 */
body{padding-top:8px!important}
.app{max-width:780px!important}
h1{font-size:24px!important;margin:2px 0 2px!important;line-height:1.15!important}
.sub{font-size:11.5px!important;margin:3px 0 7px!important;line-height:1.35!important}
.badges{gap:5px!important;margin:7px 0 9px!important}
.badge{padding:5px 8px!important;font-size:9.5px!important}

.card{margin:8px 0!important;padding:12px!important;border-radius:17px!important}
.card h2{font-size:18px!important;margin-bottom:8px!important}

/* 큰 흰 설명문은 접기형으로 변경 */
#v20PolicyWrap{margin:7px 0!important}
#v20PolicyWrap>summary{
  list-style:none;cursor:pointer;background:#0c2232;border:1px solid #35566e;border-radius:13px;
  color:#f0ca69;font-weight:900;text-align:center;padding:10px 12px;font-size:13px
}
#v20PolicyWrap>summary::-webkit-details-marker{display:none}
#v20PolicyWrap[open]>summary{border-color:#8a6b2c;background:#132a3b}
#v20PolicyWrap .notice{
  margin:7px 0 0!important;padding:12px 11px!important;border-radius:14px!important;
  font-size:11.5px!important;line-height:1.45!important
}

/* 회차 컨트롤 압축 */
.round-v17{
  grid-template-columns:minmax(86px,1fr) 86px minmax(86px,1fr)!important;
  gap:6px!important
}
.round-v17 #round{
  height:44px!important;font-size:17px!important;padding:7px 4px!important;border-radius:12px!important
}
.round-v17 .btn{height:44px!important;padding:7px 5px!important;font-size:12.5px!important;border-radius:12px!important}
.card:has(.round-v17) .small{font-size:10px!important;margin-top:5px!important}

/* RAW 카드: 6문장 확인이 쉬운 높이 */
#raw{
  min-height:230px!important;
  height:230px!important;
  font-size:14px!important;
  line-height:1.48!important;
  padding:12px!important;
  border-radius:14px!important
}
#raw + .actions{grid-template-columns:1.4fr 1fr!important;gap:6px!important;margin-top:8px!important}
#raw + .actions .btn{min-height:42px!important;padding:9px 8px!important;font-size:12.5px!important}
#raw ~ .small{font-size:9.5px!important;margin-top:5px!important}

/* 해독 규칙은 접기형 */
#v20RulesWrap{margin:8px 0!important}
#v20RulesWrap>summary{
  list-style:none;cursor:pointer;background:#0b2030;border:1px solid #31566e;border-radius:13px;
  color:#f0ca69;font-weight:900;padding:10px 12px;font-size:14px;text-align:center
}
#v20RulesWrap>summary::-webkit-details-marker{display:none}
#v20RulesWrap[open]>summary{border-color:#8a6b2c}
#v20RulesWrap .card{margin-top:6px!important}
#v20RulesWrap .rules{gap:5px!important}
#v20RulesWrap .rule{padding:8px!important;font-size:10px!important;line-height:1.35!important}
#v20RulesWrap .rule b{font-size:11px!important}

/* 실전운영 카드도 압축 */
#v15ProductionCard{padding:10px!important}
#v15ProductionCard h2{font-size:16px!important}
.prod-grid{gap:5px!important}
.prod-box{padding:6px!important}
.prod-box b{font-size:9.5px!important}
.prod-actions{gap:5px!important;margin-top:6px!important}
.prod-actions .btn{min-height:36px!important;padding:7px 6px!important;font-size:11px!important}
#v15SelfTestStatus{font-size:9.5px!important;margin-top:5px!important}

/* 결과 화면 압축 */
.sentence{padding:8px!important;margin:5px 0!important}
.sentence h3{font-size:11.5px!important}
.evi{font-size:10px!important;line-height:1.35!important}
.rankrow{margin:4px 0!important;padding:5px!important}
.game{padding:7px!important;margin:5px 0!important}
.game .ball{width:31px!important;height:31px!important;font-size:11px!important}
.footer{margin-top:10px!important}

@media(max-width:560px){
  body{padding:6px 6px 28px!important}
  .card{padding:10px!important;margin:7px 0!important}
  h1{font-size:21px!important}
  .sub{font-size:10.8px!important}
  .badge{font-size:8.8px!important;padding:5px 7px!important}
  #raw{height:220px!important;min-height:220px!important;font-size:13.5px!important}
  #raw + .actions{grid-template-columns:1fr 1fr!important}
  #v20PolicyWrap .notice{font-size:10.8px!important}
}
</style>


<style id="v21BadgeMenuCSS">
/* V2.1 BADGE MENU — 상단 동그라미 묶음 버튼화 */
#v21BadgeMenu{
  margin:8px 0 12px!important;
}
#v21BadgeMenu > summary{
  list-style:none;
  cursor:pointer;
  background:linear-gradient(180deg,#122e44,#0b2334);
  border:1px solid #8a6b2c;
  border-radius:16px;
  color:#f3d16f;
  font-weight:900;
  text-align:center;
  padding:12px 14px;
  font-size:14px;
  box-shadow:0 8px 22px #0005;
}
#v21BadgeMenu > summary::-webkit-details-marker{display:none}
#v21BadgeMenu > summary::after{
  content:" ▼";
  color:#f3d16f;
  font-size:12px;
}
#v21BadgeMenu[open] > summary::after{
  content:" ▲";
}
#v21BadgeMenu .badges{
  margin-top:8px!important;
  padding:10px!important;
  background:rgba(7,22,33,.8);
  border:1px solid #35556a;
  border-radius:16px;
  gap:6px!important;
}
#v21BadgeMenu .badge{
  font-size:10px!important;
  padding:7px 9px!important;
}
@media(max-width:560px){
  #v21BadgeMenu > summary{
    font-size:13px!important;
    padding:10px 12px!important;
  }
  #v21BadgeMenu .badge{
    font-size:9px!important;
    padding:6px 8px!important;
  }
}
</style>


<style id="v23ProductionUI">
/* V2.3 FINAL — UI 정리 전용. 엔진/RAW/GATE/PACKER 로직 무변경 */

/* 경고문 모바일 가독성 */
#v23WarningBox{letter-spacing:-.2px}
@media(max-width:560px){
  #v23WarningBox{font-size:17px!important;padding:10px 9px!important;border-radius:12px!important}
}

/* RAW 6문장: 내용에 맞춰 자동 높이. 너무 커지지 않게 상한 적용 */
#raw{
  width:78%!important;
  max-width:78%!important;
  margin:0 auto!important;
  display:block!important;
  min-height:210px!important;
  height:auto!important;
  max-height:430px!important;
  overflow-y:auto!important;
  resize:none!important;
  padding:14px 15px!important;
  line-height:1.72!important;
  word-break:keep-all!important;
}
#raw + .actions{
  width:78%!important;
  margin:10px auto 0!important;
}
#raw ~ .small{
  width:78%!important;
  margin:8px auto 0!important;
}

/* 회차 컨트롤을 한 화면에서 안정적으로 유지 */
.round-v17{
  position:relative;
  align-items:center!important;
}
.round-v17 #round{
  appearance:textfield;
  -moz-appearance:textfield;
}
.round-v17 #round::-webkit-inner-spin-button,
.round-v17 #round::-webkit-outer-spin-button{
  -webkit-appearance:none;
  margin:0;
}
.round-v17 .btn{
  touch-action:manipulation;
  -webkit-tap-highlight-color:transparent;
}

/* 현재 회차 표시 강조 */
.round-v17 #round{
  border:1.5px solid #8d7130!important;
  color:#fff7d6!important;
  background:#081a28!important;
  box-shadow:inset 0 0 0 1px rgba(240,200,95,.08)!important;
}

/* RAW 카드 상단에 상태칩 */
.v23-raw-status{
  display:flex;gap:6px;flex-wrap:wrap;margin:0 0 8px;
}
.v23-raw-status span{
  display:inline-block;padding:4px 7px;border-radius:999px;
  border:1px solid #35566e;background:#0a2132;
  color:#b8cbd6;font-size:9px;font-weight:900;
}
.v23-raw-status span.ready{
  border-color:#477d5d;color:#84dfaa;background:#0d2c22;
}

/* 실전 버튼 비중 강화 */
#run{
  font-size:14px!important;
  min-height:46px!important;
  box-shadow:0 6px 18px rgba(53,124,255,.22);
}
#loadTxt{min-height:46px!important}

/* 결과가 열린 후 화면 전환을 보기 좋게 */
#resultArea{scroll-margin-top:10px}

/* 상단 제목 약간 압축 */
h1{letter-spacing:.1px!important}
</style>


<style id="v24BlinkWarning">
/* V2.4 FINAL — 경고문 실제 깜빡임 효과. 엔진/RAW/GATE/PACKER 로직 무변경 */
#v23WarningBox{
  animation:v24WarningBlink 1.15s ease-in-out infinite!important;
  will-change:box-shadow,background-color,color,transform,opacity;
}

@keyframes v24WarningBlink{
  0%,100%{
    background:#fff3f2;
    color:#c62828;
    border-color:#d93025;
    box-shadow:
      0 0 0 2px rgba(217,48,37,.08) inset,
      0 0 6px rgba(217,48,37,.22);
    transform:scale(1);
    opacity:1;
  }
  50%{
    background:#ffe0de;
    color:#e00000;
    border-color:#ff1f14;
    box-shadow:
      0 0 0 3px rgba(255,31,20,.18) inset,
      0 0 14px rgba(255,31,20,.75),
      0 0 28px rgba(255,31,20,.42);
    transform:scale(1.015);
    opacity:.93;
  }
}

/* 사용자가 기기에서 애니메이션 감소 설정을 켠 경우에는 정적인 강조만 유지 */
@media (prefers-reduced-motion: reduce){
  #v23WarningBox{
    animation:none!important;
    background:#ffe6e3!important;
    color:#d40000!important;
    border-color:#ff281c!important;
    box-shadow:0 0 12px rgba(255,40,28,.45)!important;
  }
}
</style>


<style id="v25SentenceButtonUI">
/* V2.5 — 문장별 버튼 보기 + 실전운영 카드 버튼화
   엔진/RAW/GATE/PACKER 로직 무변경 */

/* 문장 선택 영역 */
#v25SentencePanel{
  margin:10px 0 12px;
  padding:12px;
  border:1px solid #31566e;
  border-radius:18px;
  background:linear-gradient(180deg,#0d2334,#081925);
}
#v25SentenceHead{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  margin-bottom:10px;
}
#v25SentenceHead b{
  color:#f0ca69;
  font-size:18px;
}
#v25SentenceHead span{
  color:#9fb0bd;
  font-size:10px;
}
#v25SentenceButtons{
  display:grid;
  grid-template-columns:repeat(6,minmax(0,1fr));
  gap:6px;
}
.v25-sbtn{
  border:1px solid #355e78;
  background:#0b2436;
  color:#eef6fb;
  border-radius:12px;
  padding:10px 5px;
  font-size:12px;
  font-weight:900;
  min-width:0;
}
.v25-sbtn.active{
  background:linear-gradient(180deg,#f0cc63,#dda63c);
  border-color:#ffd978;
  color:#0b1720;
  box-shadow:0 0 12px rgba(240,200,95,.25);
}
#v25SentenceViewer{
  margin-top:10px;
  border:1px solid #294d63;
  border-radius:14px;
  background:#061724;
  padding:12px 13px;
  min-height:92px;
}
#v25SentenceViewer .title{
  color:#f0ca69;
  font-size:12px;
  font-weight:900;
  margin-bottom:7px;
}
#v25SentenceViewer .body{
  color:#f4f8fb;
  font-size:15px;
  line-height:1.55;
  word-break:keep-all;
}

/* 실전운영 동결 상태 4개 박스를 버튼처럼 */
#v15ProductionCard .prod-box{
  position:relative;
  cursor:pointer;
  min-height:68px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  border:1px solid #4b89bb!important;
  background:linear-gradient(180deg,#0e2b40,#081b29)!important;
  box-shadow:inset 0 0 0 1px rgba(87,166,230,.12);
  transition:transform .12s ease,border-color .12s ease,background .12s ease;
}
#v15ProductionCard .prod-box:active{
  transform:scale(.985);
  border-color:#f0ca69!important;
}
#v15ProductionCard .prod-box:after{
  content:"›";
  position:absolute;
  right:10px;
  top:50%;
  transform:translateY(-50%);
  color:#f0ca69;
  font-size:24px;
  font-weight:900;
}
#v15ProductionCard .prod-box b{
  color:#f0ca69!important;
  padding-right:16px;
}
#v25ProdDetail{
  display:none;
  margin-top:7px;
  border:1px solid #35566e;
  border-radius:12px;
  background:#061724;
  padding:10px 12px;
  color:#cbd9e1;
  font-size:11px;
  line-height:1.45;
}
#v25ProdDetail.open{display:block}

@media(max-width:620px){
  #v25SentenceButtons{
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:5px;
  }
  .v25-sbtn{
    font-size:11px;
    padding:9px 4px;
  }
  #v25SentenceHead{
    align-items:flex-start;
  }
  #v25SentenceHead b{font-size:16px}
  #v25SentenceHead span{font-size:9px;text-align:right}
  #v25SentenceViewer .body{font-size:14px}
}
</style>


<style id="v26SentenceOverlayCSS">
/* V2.6 — 문장별 해독근거를 최상단 오버레이로 표시
   엔진/RAW/GATE/PACKER 로직 무변경 */

#v26SentenceOverlay{
  display:none;
  position:fixed;
  inset:0;
  z-index:26000;
  background:rgba(2,8,14,.78);
  backdrop-filter:blur(2px);
  -webkit-backdrop-filter:blur(2px);
  padding:14px;
  overflow-y:auto;
  overscroll-behavior:contain;
}
#v26SentenceOverlay.open{display:block}

#v26SentenceModal{
  width:min(100%,760px);
  margin:0 auto;
  background:linear-gradient(180deg,#0d2435,#071925);
  border:1.5px solid #4b8fbe;
  border-radius:20px;
  box-shadow:0 12px 42px rgba(0,0,0,.62),0 0 18px rgba(59,145,204,.20);
  padding:15px;
  position:relative;
}
#v26SentenceModalHead{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:10px;
}
#v26SentenceModalTitle{
  color:#f0ca69;
  font-size:22px;
  font-weight:900;
  line-height:1.15;
}
#v26SentenceClose{
  width:42px;
  height:42px;
  border-radius:50%;
  border:1px solid #5f7e94;
  background:#15354e;
  color:#fff;
  font-size:28px;
  font-weight:900;
  line-height:1;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:0;
  flex:0 0 auto;
}
#v26SentenceSource{
  border:1px solid #31566e;
  border-radius:12px;
  background:#0a2132;
  color:#f1cd70;
  font-size:14px;
  font-weight:900;
  line-height:1.45;
  padding:10px 12px;
  margin-bottom:10px;
}
#v26SentenceEvidence{
  display:grid;
  gap:8px;
}
.v26-evidence-row{
  border-bottom:1px solid #183448;
  padding:8px 3px 10px;
}
.v26-evidence-row:last-child{border-bottom:0}
.v26-evidence-main{
  color:#eaf2f7;
  font-size:13px;
  line-height:1.45;
  font-weight:700;
}
.v26-evidence-sub{
  color:#9fb0bd;
  font-size:11.5px;
  line-height:1.4;
  margin-top:3px;
}
.v26-tag{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:34px;
  height:26px;
  padding:0 8px;
  border-radius:999px;
  margin-right:7px;
  border:1px solid #53758c;
  color:#dce7ee;
  font-size:11px;
  font-weight:900;
}
.v26-tag.S{border-color:#b68a2e;color:#ffe083}
.v26-tag.A{border-color:#3c8b61;color:#8ce4af}
.v26-tag.AUDIT{border-color:#5e7a8c;color:#b9cbd6}

#v26SentenceCloseWide{
  width:100%;
  margin-top:12px;
  background:#15354e;
  border:1px solid #3e6480;
  color:#fff;
  border-radius:13px;
  padding:12px;
  font-size:15px;
  font-weight:900;
}

body.v26-overlay-open{overflow:hidden!important}

@media(max-width:560px){
  #v26SentenceOverlay{padding:8px}
  #v26SentenceModal{padding:12px;border-radius:16px}
  #v26SentenceModalTitle{font-size:19px}
  #v26SentenceClose{width:38px;height:38px;font-size:25px}
  #v26SentenceSource{font-size:12.5px}
  .v26-evidence-main{font-size:12px}
  .v26-evidence-sub{font-size:10.5px}
}
</style>


<style id="v27OverlayOnlyCSS">
/* V2.7 — 전체 P1~P6 목록은 화면에서 숨기고, 버튼 + 최상단 오버레이만 사용 */
.v27-source-evidence-card{
  display:none!important;
}
#v25SentencePanel{
  display:block!important;
}
</style>


<style id="v28RankOverlayCSS">
/* V2.8 — 후보순위 상세목록을 본문에서 숨기고 버튼 + 최상단 오버레이로 표시
   엔진/RAW/GATE/PACKER 로직 무변경 */

#v28RankButton{
  width:100%;
  margin:10px 0 6px;
  border:1px solid #8a6b2c;
  background:linear-gradient(180deg,#122e44,#0b2334);
  color:#f2cf70;
  border-radius:14px;
  padding:12px 14px;
  font-size:14px;
  font-weight:900;
  text-align:center;
  cursor:pointer;
}
#v28RankButton:active{transform:scale(.99)}

#rankList{display:none!important;}

#v28RankOverlay{
  display:none;
  position:fixed;
  inset:0;
  z-index:28000;
  background:rgba(2,8,14,.80);
  backdrop-filter:blur(2px);
  -webkit-backdrop-filter:blur(2px);
  padding:12px;
  overflow-y:auto;
  overscroll-behavior:contain;
}
#v28RankOverlay.open{display:block}
#v28RankModal{
  width:min(100%,760px);
  margin:0 auto;
  background:linear-gradient(180deg,#0d2435,#071925);
  border:1.5px solid #4b8fbe;
  border-radius:20px;
  box-shadow:0 12px 42px rgba(0,0,0,.65),0 0 18px rgba(59,145,204,.18);
  padding:14px;
  position:relative;
}
#v28RankHead{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:10px;
}
#v28RankTitle{
  color:#f0ca69;
  font-size:22px;
  font-weight:900;
}
#v28RankClose{
  width:40px;height:40px;border-radius:50%;
  border:1px solid #5f7e94;background:#15354e;color:#fff;
  font-size:27px;font-weight:900;display:flex;align-items:center;justify-content:center;padding:0;
}
#v28RankSummary{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:6px;
  margin-bottom:10px;
}
.v28-rank-kpi{
  border:1px solid #294d63;
  border-radius:11px;
  background:#081a28;
  padding:7px 5px;
  text-align:center;
}
.v28-rank-kpi span{display:block;color:#8fa5b3;font-size:9px}
.v28-rank-kpi b{display:block;color:#f0ca69;font-size:15px;margin-top:2px}
#v28RankRows{display:grid;gap:5px}
.v28-rank-row{
  display:grid;
  grid-template-columns:32px 42px 1fr;
  gap:8px;
  align-items:center;
  border-bottom:1px solid #183448;
  padding:7px 2px;
}
.v28-rank-row:last-child{border-bottom:0}
.v28-pos{color:#94a9b7;font-weight:900;text-align:center}
.v28-ball{
  width:38px;height:38px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:#102f43;border:1px solid #4a7895;color:#fff;font-weight:900
}
.v28-meta{font-size:11.5px;color:#c9d6de;line-height:1.35}
.v28-meta b{color:#f2cf70}
#v28RankCloseWide{
  width:100%;margin-top:10px;background:#15354e;border:1px solid #3e6480;
  color:#fff;border-radius:13px;padding:11px;font-size:14px;font-weight:900
}
body.v28-overlay-open{overflow:hidden!important}

@media(max-width:560px){
  #v28RankOverlay{padding:7px}
  #v28RankModal{padding:11px;border-radius:16px}
  #v28RankTitle{font-size:19px}
  #v28RankSummary{grid-template-columns:repeat(4,minmax(0,1fr));gap:4px}
  .v28-rank-kpi{padding:6px 3px}
  .v28-rank-kpi span{font-size:8px}
  .v28-rank-kpi b{font-size:13px}
  .v28-rank-row{grid-template-columns:28px 38px 1fr;gap:6px}
  .v28-ball{width:34px;height:34px}
  .v28-meta{font-size:10.5px}
}
</style>


<style id="v29U10OverlayCSS">
/* V2.9 — 후보우주·U10 전체영역을 버튼 + 최상단 오버레이로 전환
   엔진/RAW/GATE/PACKER 로직 무변경 */

.v29-u10-source-card{display:none!important;}

#v29U10Button{
  width:100%;
  margin:10px 0 12px;
  border:1px solid #8a6b2c;
  background:linear-gradient(180deg,#122e44,#0b2334);
  color:#f2cf70;
  border-radius:15px;
  padding:13px 14px;
  font-size:15px;
  font-weight:900;
  text-align:center;
  cursor:pointer;
}
#v29U10Button:active{transform:scale(.99)}

#v29U10Overlay{
  display:none;
  position:fixed;
  inset:0;
  z-index:29000;
  background:rgba(2,8,14,.80);
  backdrop-filter:blur(2px);
  -webkit-backdrop-filter:blur(2px);
  padding:12px;
  overflow-y:auto;
  overscroll-behavior:contain;
}
#v29U10Overlay.open{display:block}

#v29U10Modal{
  width:min(100%,760px);
  margin:0 auto;
  background:linear-gradient(180deg,#0d2435,#071925);
  border:1.5px solid #4b8fbe;
  border-radius:20px;
  box-shadow:0 12px 42px rgba(0,0,0,.65),0 0 18px rgba(59,145,204,.18);
  padding:14px;
  position:relative;
}
#v29U10Head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:10px;
}
#v29U10Title{
  color:#f0ca69;
  font-size:22px;
  font-weight:900;
}
#v29U10Close{
  width:40px;height:40px;border-radius:50%;
  border:1px solid #5f7e94;background:#15354e;color:#fff;
  font-size:27px;font-weight:900;display:flex;align-items:center;justify-content:center;padding:0;
}
#v29U10Kpis{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:7px;
  margin-bottom:10px;
}
.v29-kpi{
  border:1px solid #294d63;
  border-radius:12px;
  background:#081a28;
  padding:9px 6px;
  text-align:center;
}
.v29-kpi span{display:block;color:#8fa5b3;font-size:9px}
.v29-kpi b{display:block;color:#f0ca69;font-size:20px;margin-top:3px}

#v29U10Gate{
  border-radius:14px;
  padding:12px 10px;
  text-align:center;
  font-weight:900;
  font-size:14px;
  line-height:1.35;
  margin:8px 0 10px;
}
#v29U10Gate.pass{
  background:#0f3328;border:1px solid #34795a;color:#80e0a8;
}
#v29U10Gate.hold{
  background:#352819;border:1px solid #80602e;color:#f4cc7e;
}
#v29U10Gate.fail{
  background:#381d22;border:1px solid #80414b;color:#ffb0b0;
}

#v29U10Candidates{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  padding:8px 0 4px;
}
.v29-cand{
  width:40px;height:40px;border-radius:50%;
  display:inline-flex;align-items:center;justify-content:center;
  background:#342d17;border:1px solid #9b762d;color:#f4d476;font-weight:900;
}

#v29OpenRank{
  width:100%;
  margin-top:10px;
  border:1px solid #8a6b2c;
  background:#10283a;
  color:#f0ca69;
  border-radius:12px;
  padding:10px 12px;
  font-size:13px;
  font-weight:900;
}
#v29U10CloseWide{
  width:100%;
  margin-top:8px;
  background:#15354e;border:1px solid #3e6480;
  color:#fff;border-radius:13px;padding:11px;font-size:14px;font-weight:900;
}
body.v29-overlay-open{overflow:hidden!important}

@media(max-width:560px){
  #v29U10Overlay{padding:7px}
  #v29U10Modal{padding:11px;border-radius:16px}
  #v29U10Title{font-size:19px}
  #v29U10Kpis{gap:5px}
  .v29-kpi{padding:7px 4px}
  .v29-kpi b{font-size:18px}
  .v29-cand{width:36px;height:36px;font-size:13px}
}
</style>


<style id="v30WeeklyBuyMenuCSS">
/* V3.0 — 금주의 구매용 조합 메뉴
   기존 해독 Final5는 "원문분석 5조합"으로 이동.
   자동구매 20조합은 버튼형 5/10/15/20 보기로 분리.
*/

.v30-hide-original-final-card{display:none!important;}

#v30WeeklyBuyCard{
  margin:12px 0;
  padding:14px;
  border:1px solid #31566e;
  border-radius:20px;
  background:linear-gradient(180deg,#0e2536,#081925);
}
#v30WeeklyBuyCard h2{
  margin:0 0 11px;
  color:#f4f8fb;
  font-size:21px;
}
#v30BuyTopButtons{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.v30-main-btn{
  min-height:52px;
  border-radius:14px;
  border:1px solid #4a7895;
  background:#12324a;
  color:#f6f8fb;
  font-size:15px;
  font-weight:900;
}
.v30-main-btn.gold{
  border-color:#9a772e;
  color:#f3d16f;
  background:linear-gradient(180deg,#2a2a18,#182417);
}
#v30AutoSubmenu{
  display:none;
  margin-top:9px;
  grid-template-columns:repeat(4,1fr);
  gap:7px;
}
#v30AutoSubmenu.open{display:grid}
.v30-count-btn{
  border:1px solid #355e78;
  background:#0b2436;
  color:#eef6fb;
  border-radius:12px;
  padding:10px 5px;
  font-size:12px;
  font-weight:900;
}
.v30-count-btn.active{
  background:linear-gradient(180deg,#f0cc63,#dda63c);
  border-color:#ffd978;
  color:#0b1720;
}
#v30BuyHint{
  margin-top:8px;
  color:#91a6b4;
  font-size:10px;
  line-height:1.45;
}

/* 조합 표시 overlay */
#v30BuyOverlay{
  display:none;
  position:fixed;
  inset:0;
  z-index:30000;
  background:rgba(2,8,14,.80);
  backdrop-filter:blur(2px);
  -webkit-backdrop-filter:blur(2px);
  padding:12px;
  overflow-y:auto;
}
#v30BuyOverlay.open{display:block}
#v30BuyModal{
  width:min(100%,760px);
  margin:0 auto;
  background:linear-gradient(180deg,#0d2435,#071925);
  border:1.5px solid #4b8fbe;
  border-radius:20px;
  box-shadow:0 12px 42px rgba(0,0,0,.65),0 0 18px rgba(59,145,204,.18);
  padding:14px;
}
#v30BuyHead{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:10px;
}
#v30BuyTitle{
  color:#f0ca69;
  font-size:22px;
  font-weight:900;
}
#v30BuyClose{
  width:40px;height:40px;border-radius:50%;
  border:1px solid #5f7e94;background:#15354e;color:#fff;
  font-size:27px;font-weight:900;padding:0;
}
#v30BuyMeta{
  color:#9fb0bd;
  font-size:10.5px;
  line-height:1.45;
  margin-bottom:8px;
}
#v30BuyGames{
  display:grid;
  gap:8px;
}
.v30-buy-game{
  border:1px solid #705a2a;
  border-radius:13px;
  background:#091d2b;
  padding:9px;
  display:flex;
  align-items:center;
  gap:8px;
}
.v30-buy-no{
  width:28px;
  text-align:center;
  color:#9fb3c0;
  font-weight:900;
}
.v30-buy-balls{
  display:flex;
  gap:5px;
  flex-wrap:wrap;
}
.v30-buy-ball{
  width:34px;height:34px;border-radius:50%;
  display:inline-flex;align-items:center;justify-content:center;
  background:#102c3f;border:1px solid #80662d;color:#f6d675;
  font-weight:900;font-size:12px;
}
#v30BuyActions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
  margin-top:10px;
}
#v30BuyActions button{
  border-radius:12px;
  padding:10px;
  font-weight:900;
  border:1px solid #365e78;
  background:#15354e;
  color:#fff;
}
body.v30-overlay-open{overflow:hidden!important}

@media(max-width:560px){
  #v30BuyTopButtons{grid-template-columns:1fr}
  #v30AutoSubmenu{grid-template-columns:repeat(4,1fr);gap:5px}
  .v30-count-btn{font-size:11px;padding:9px 3px}
  #v30BuyOverlay{padding:7px}
  #v30BuyModal{padding:11px;border-radius:16px}
  #v30BuyTitle{font-size:19px}
  .v30-buy-ball{width:31px;height:31px;font-size:11px}
}
</style>


<style id="v31BuyOverlaySizeFix">
/* V3.1 — 구매조합 오버레이 위치/크기 미세조정
   로직/조합생성/RAW/U10/Final5 값은 전혀 변경하지 않음 */

#v30BuyOverlay{
  padding:
    max(10px, env(safe-area-inset-top))
    10px
    max(12px, env(safe-area-inset-bottom))!important;
  display:none;
  align-items:flex-start;
  justify-content:center;
}
#v30BuyOverlay.open{
  display:flex!important;
}

#v30BuyModal{
  width:min(96vw,720px)!important;
  max-height:86dvh!important;
  margin:6px auto 0!important;
  padding:12px!important;
  border-radius:18px!important;
  overflow:hidden!important;
  display:flex!important;
  flex-direction:column!important;
}

#v30BuyHead{
  position:sticky;
  top:0;
  z-index:2;
  margin-bottom:7px!important;
  padding-bottom:6px;
  background:linear-gradient(180deg,#0d2435 88%,rgba(13,36,53,0));
}
#v30BuyTitle{
  font-size:19px!important;
}
#v30BuyClose{
  width:38px!important;
  height:38px!important;
  font-size:25px!important;
  flex:0 0 auto;
}

#v30BuyMeta{
  font-size:10px!important;
  margin-bottom:6px!important;
  line-height:1.35!important;
}

#v30BuyGames{
  overflow-y:auto!important;
  overscroll-behavior:contain;
  padding-right:2px;
  flex:1 1 auto;
  gap:6px!important;
}

.v30-buy-game{
  min-height:62px!important;
  padding:7px 9px!important;
  border-radius:12px!important;
  gap:6px!important;
}
.v30-buy-no{
  width:24px!important;
  font-size:15px!important;
}
.v30-buy-balls{
  gap:4px!important;
  flex-wrap:nowrap!important;
}
.v30-buy-ball{
  width:32px!important;
  height:32px!important;
  font-size:11px!important;
  flex:0 0 32px!important;
}

#v30BuyActions{
  position:sticky;
  bottom:0;
  z-index:2;
  margin-top:8px!important;
  padding-top:6px;
  background:linear-gradient(0deg,#071925 88%,rgba(7,25,37,0));
}
#v30BuyActions button{
  min-height:44px!important;
  padding:9px!important;
  font-size:13px!important;
}

@media(max-width:430px){
  #v30BuyModal{
    width:calc(100vw - 14px)!important;
    max-height:88dvh!important;
    margin-top:2px!important;
    padding:10px!important;
  }
  #v30BuyTitle{font-size:18px!important}
  .v30-buy-game{min-height:58px!important;padding:6px 7px!important}
  .v30-buy-ball{
    width:30px!important;
    height:30px!important;
    flex-basis:30px!important;
    font-size:10.5px!important;
  }
  .v30-buy-no{width:22px!important;font-size:14px!important}
}

@media(max-height:740px){
  #v30BuyModal{max-height:84dvh!important}
  .v30-buy-game{min-height:54px!important}
}
</style>


<style id="v32LeftMenuWidthFix">
/* V3.2 — 상단 메뉴 버튼 폭 축소 + 좌측 정렬
   엔진 / 원문 / 해독 / 조합 로직은 전혀 변경하지 않음 */

#v21BadgeMenu,
#v20PolicyWrap{
  margin:8px 0 12px !important;
}

#v21BadgeMenu > summary,
#v20PolicyWrap > summary{
  display:inline-flex !important;
  align-items:center !important;
  justify-content:center !important;
  width:auto !important;
  min-width:230px !important;
  max-width:min(82vw, 360px) !important;
  padding:12px 18px !important;
  margin:0 auto 0 0 !important;
  text-align:center !important;
  white-space:nowrap !important;
  border-radius:16px !important;
}

#v21BadgeMenu > summary::after{
  margin-left:2px;
}

@media (max-width: 560px){
  #v21BadgeMenu > summary,
  #v20PolicyWrap > summary{
    min-width:210px !important;
    max-width:min(84vw, 320px) !important;
    padding:11px 16px !important;
    font-size:13px !important;
  }
}

@media (max-width: 390px){
  #v21BadgeMenu > summary,
  #v20PolicyWrap > summary{
    min-width:196px !important;
    max-width:min(86vw, 300px) !important;
    padding:10px 14px !important;
    font-size:12.5px !important;
  }
}
</style>


<style id="v33BuyButtonRightAlign">
/* V3.3 — 금주의 구매용 조합 2개 버튼 폭 축소 + 우측 정렬
   엔진/조합생성/RAW/U10 로직 무변경 */

