#v38CountTabs{gap:4px!important;margin:2px 0 5px!important}
.v38-count-btn{padding:5px 2px!important;font-size:9px!important;border-radius:8px!important}
.v30-buy-game{min-height:44px!important;padding:5px 6px!important;border-radius:9px!important}.v30-buy-no{width:18px!important;font-size:11px!important}.v30-buy-balls{gap:3px!important}.v30-buy-ball{width:25px!important;height:25px!important;flex-basis:25px!important;font-size:9px!important}
#v30BuyActions{gap:5px!important;margin-top:5px!important;padding-top:4px!important}#v30BuyActions button{min-height:32px!important;padding:5px!important;font-size:10px!important;border-radius:9px!important}

@media(max-width:390px){
  h1{font-size:16px!important}.sub{font-size:8.4px!important}
  #v36TopGrid #v21BadgeMenu > summary,#v36TopGrid #v20PolicyWrap > summary,#v36TopGrid .v30-main-btn{height:32px!important;min-height:32px!important;font-size:8.4px!important}
  .round-v17 #round,.round-v17 .btn{height:30px!important}.round-v17 #round{font-size:12px!important}.round-v17 .btn{font-size:9.2px!important}
  #raw{min-height:112px!important;height:112px!important;max-height:112px!important;font-size:10.7px!important;line-height:1.34!important}
  #raw + .actions .btn{height:30px!important;min-height:30px!important;font-size:9.2px!important}
