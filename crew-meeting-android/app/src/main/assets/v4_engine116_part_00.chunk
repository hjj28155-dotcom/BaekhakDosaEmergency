  border-radius:11px!important;
}
#v36TopGrid #v21BadgeMenu > summary::after{font-size:8px!important;margin-left:2px!important}

/* 이번 회차 카드 */
.round-v17{gap:4px!important}
.round-v17 #round{height:32px!important;font-size:12.5px!important;padding:4px 3px!important;border-radius:10px!important}
.round-v17 .btn{height:32px!important;padding:4px 3px!important;font-size:9.8px!important;border-radius:10px!important}
.card:has(.round-v17) .small{font-size:8.2px!important;margin-top:3px!important}

/* RAW 카드 — 3번째 문장까지 보이는 높이 */
#raw{
  width:76%!important;max-width:76%!important;
  min-height:118px!important;height:118px!important;max-height:118px!important;
