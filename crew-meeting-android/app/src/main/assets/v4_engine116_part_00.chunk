/* 남겨둔 실전운영 버튼 영역 */
#v15ProductionCard{padding:6px 8px!important;margin:5px 0!important}
#v15ProductionCard .prod-actions{gap:4px!important;margin-top:0!important}
#v15ProductionCard .prod-actions .btn{min-height:30px!important;height:30px!important;padding:4px 4px!important;font-size:9.5px!important;border-radius:9px!important}
#v15SelfTestStatus{font-size:7.9px!important;line-height:1.18!important;margin-top:3px!important}

/* 후보우주 상세버튼 등 */
#v29U10Button,#v28RankButton{padding:8px 10px!important;font-size:11px!important;margin:6px 0!important;border-radius:11px!important}

/* 결과 영역 전체 비례 축소 */
.statusline{gap:4px!important}.kpi{padding:5px!important;border-radius:9px!important}.kpi span{font-size:7px!important}.kpi b{font-size:13px!important;margin-top:1px!important}
.gate{padding:7px!important;margin-top:5px!important;font-size:10px!important;border-radius:10px!important}
.candwrap{gap:5px!important;margin-top:5px!important}.ball{width:28px!important;height:28px!important;font-size:11px!important}
.rankrow{margin:3px 0!important;padding:4px!important;gap:5px!important}.rankmeta{font-size:8.2px!important;line-height:1.18!important}
.game{padding:5px!important;gap:5px!important;border-radius:10px!important}.gno{width:18px!important}.game .ball{width:27px!important;height:27px!important;font-size:9.5px!important}
.footer{font-size:7.6px!important;line-height:1.18!important;margin-top:6px!important}

/* 자동구매 오버레이 */
#v30BuyModal{padding:9px!important;border-radius:14px!important;max-height:90dvh!important}
#v30BuyHead{min-height:32px!important;margin-bottom:4px!important}
#v30BuyTitle{font-size:15px!important;padding:0 38px!important;line-height:1.05!important}
