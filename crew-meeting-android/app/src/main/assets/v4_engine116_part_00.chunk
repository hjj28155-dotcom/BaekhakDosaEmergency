<style id="v50UltraCompactMobile">
/* V5.0 FINAL — 기능/버튼/데이터/로직 불변, 모바일 세로폭만 추가 축소 */
body{padding:4px 5px 18px!important}
.app{max-width:760px!important}
h1{font-size:17px!important;line-height:1.05!important;margin:0 0 1px!important;letter-spacing:-.25px!important}
.sub{font-size:8.9px!important;line-height:1.18!important;margin:0 0 4px!important}
.card{padding:8px!important;margin:5px 0!important;border-radius:15px!important}
h2,.card h2{font-size:14px!important;line-height:1.05!important;margin:0 0 6px!important}
.small{font-size:8.6px!important;line-height:1.22!important}

/* 상단 2x2 4버튼 */
#v36TopGrid{gap:4px!important;margin:3px 0 6px!important}
#v36TopGrid #v21BadgeMenu > summary,
#v36TopGrid #v20PolicyWrap > summary,
#v36TopGrid .v30-main-btn{
  min-height:34px!important;height:34px!important;
