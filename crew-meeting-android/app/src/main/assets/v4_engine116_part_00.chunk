    min-width:210px!important;
  }
}
</style>


<style id="v34TopSideBuyMenuCSS">
/* V3.4 — 기존 상단 2버튼을 살리고, 그 옆에 구매용 4버튼 배치
   하단의 중복 구매영역은 없음: 동일 카드 자체를 최상단으로 이동함 */

#v34TopHub{
  display:grid;
  grid-template-columns:minmax(180px, .85fr) minmax(0, 1.35fr);
  gap:10px;
  align-items:stretch;
  margin:8px 0 12px;
}
#v34TopLeft{
  display:flex;
  flex-direction:column;
  gap:8px;
  min-width:0;
}
#v34TopRight{
  min-width:0;
}

/* 왼쪽: 기존 2버튼 그대로 유지 */
#v34TopLeft #v21BadgeMenu,
#v34TopLeft #v20PolicyWrap{
  margin:0!important;
  width:100%!important;
}
#v34TopLeft #v21BadgeMenu > summary,
#v34TopLeft #v20PolicyWrap > summary{
  width:100%!important;
  min-width:0!important;
  max-width:none!important;
  min-height:62px!important;
  margin:0!important;
  padding:10px 8px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  text-align:center!important;
  white-space:normal!important;
  line-height:1.25!important;
  font-size:12px!important;
  border-radius:14px!important;
}

/* 오른쪽: 구매용 4버튼 한 묶음 */
#v34TopRight #v30WeeklyBuyCard{
  margin:0!important;
  padding:9px!important;
  height:100%;
  border-radius:16px!important;
}
#v34TopRight #v30WeeklyBuyCard h2{
  font-size:13px!important;
  margin:0 0 7px!important;
  color:#f0ca69!important;
}
#v34TopRight #v30BuyTopButtons{
  display:grid!important;
  grid-template-columns:1fr 1fr!important;
  gap:6px!important;
}
#v34TopRight .v30-main-btn,
#v34TopRight .v30-count-btn{
  width:100%!important;
  min-width:0!important;
  max-width:none!important;
  min-height:48px!important;
  margin:0!important;
  padding:8px 5px!important;
  border-radius:12px!important;
  font-size:11px!important;
  line-height:1.2!important;
  text-align:center!important;
}
#v34TopRight #v30AutoSubmenu{
  display:grid!important;
  grid-template-columns:1fr 1fr!important;
  gap:6px!important;
  width:100%!important;
  margin:6px 0 0!important;
}
#v34TopRight #v30BuyHint{
  display:none!important;
}

/* 이 버전에서는 정확히 4버튼만 노출:
   원문해독5 / 자동구매20 / 10 / 15 */
#v34TopRight #v30AutoSubmenu .v30-count-btn[data-count="5"],
#v34TopRight #v30AutoSubmenu .v30-count-btn[data-count="20"]{
  display:none!important;
}

/* 구매 카드가 원래 있던 하단 자리는 이동되므로 자동으로 사라짐 */
@media(max-width:560px){
  #v34TopHub{
    grid-template-columns:34% 66%;
    gap:7px;
  }
  #v34TopLeft #v21BadgeMenu > summary,
  #v34TopLeft #v20PolicyWrap > summary{
    min-height:58px!important;
    font-size:10.5px!important;
    padding:8px 5px!important;
  }
  #v34TopRight #v30WeeklyBuyCard{
    padding:7px!important;
  }
  #v34TopRight #v30WeeklyBuyCard h2{
    font-size:11px!important;
    margin-bottom:5px!important;
  }
  #v34TopRight .v30-main-btn,
  #v34TopRight .v30-count-btn{
    min-height:44px!important;
    font-size:10px!important;
    padding:7px 3px!important;
  }
}
@media(max-width:390px){
  #v34TopHub{grid-template-columns:35% 65%;gap:5px}
  #v34TopLeft #v21BadgeMenu > summary,
  #v34TopLeft #v20PolicyWrap > summary{
    font-size:9.8px!important;
  }
  #v34TopRight .v30-main-btn,
  #v34TopRight .v30-count-btn{
    font-size:9.5px!important;
  }
}
</style>


<style id="v35Top4ButtonFinalFix">
/* V3.5 FINAL
   상단 최종 2x2:
   [핵심 기능·버전 묶음 보기] [원문분석 5조합]
   [앱 운영원칙 보기]       [자동구매 20조합]
