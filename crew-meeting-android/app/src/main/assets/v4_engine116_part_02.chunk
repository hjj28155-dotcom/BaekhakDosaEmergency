    linear-gradient(180deg,#03101f 0%,#05213a 42%,#020b15 100%)!important;
}
.app{
  padding-top:0 !important;
}
#v77HeroBanner{
  display:block;
  width:calc(100% + 18px);
  margin:-14px -9px 10px -9px;
