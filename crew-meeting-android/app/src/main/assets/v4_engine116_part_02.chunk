<script id="v75RulesTopMoveJS">
(function(){
  function moveRulesTop(){
    const grid=document.getElementById('v36TopGrid');
    const rules=document.getElementById('v20RulesWrap');
    if(!grid || !rules) return false;
    if(grid.firstElementChild !== rules){
      grid.insertBefore(rules, grid.firstElementChild || null);
    }
    const footer=document.querySelector('.footer');
    if(footer){
      footer.innerHTML='백학신서 비상용 독립축 V7.5 FINAL · RULE BUTTON TOP<br>당첨을 보장하는 기능이 아니라 결과전 해독 절차를 보존하는 보조도구입니다.';
    }
    return true;
  }

  function init(){
    let tries=0;
    const timer=setInterval(()=>{
      tries++;
      if(moveRulesTop() || tries>50) clearInterval(timer);
    },100);
  }

  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>


